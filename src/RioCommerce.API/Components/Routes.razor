@* Admin/Auth/Franchise pages live in RioCommerce.Web; public storefront pages live in
   RioCommerce.Web.Storefront. Both assemblies are scanned for @page routes. *@
<Router AppAssembly="typeof(MainLayout).Assembly"
        AdditionalAssemblies="new[] { typeof(RioCommerce.Web.Storefront.Components.Pages.Public.Home).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <div style="text-align:center;padding:80px 20px">
                        <h1>403 — Not Authorized</h1>
                        <p style="color:var(--gray-500)">You don't have access to this page.</p>
                        <a href="/" class="btn btn-primary" style="margin-top:16px">Back to Home</a>
                    </div>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div style="text-align:center;padding:80px 20px">
                <h1>404 — Page Not Found</h1>
                <p style="color:var(--gray-500)">The page you're looking for doesn't exist.</p>
                <a href="/" class="btn btn-primary" style="margin-top:16px">Back to Home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
