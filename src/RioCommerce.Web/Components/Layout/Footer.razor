@inject INewsletterService Newsletter
@inject ISiteSettingsService Settings

<footer class="footer">
    <div class="footer__newsletter">
        <div class="footer__newsletter-text">
            <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg> Stay in the loop</h4>
            <p>New batch alerts, offers &amp; exam tips — straight to your inbox.</p>
        </div>
        <div class="footer__newsletter-form">
            @if (subscribed)
            {
                <span class="footer__newsletter-done">@message</span>
            }
            else
            {
                <input type="email" placeholder="Your email address" value="@email" @oninput="e => email = e.Value?.ToString() ?? string.Empty" @onkeydown="OnKey" />
                <button class="btn btn-primary" disabled="@busy" @onclick="Subscribe">@(busy ? "…" : "Subscribe")</button>
            }
        </div>
        @if (!subscribed && message != null) { <div class="footer__newsletter-msg">@message</div> }
    </div>

    <div class="footer__inner">
        <div class="footer__col">
            <img src="@LogoSrc" alt="@(cfg?.CompanyName ?? "Vijaypath")" class="footer__logo" />
            <p class="footer__tagline">Synthesis of Science and Spirituality in the Service of Mankind.</p>
        </div>
        <div class="footer__col">
            <h4>Quick Links</h4>
            <a href="/">Home</a>
            <a href="/about">About Us</a>
            <a href="/courses">Courses</a>
            <a href="/scholarship-exam">Scholarship Exam</a>
            <a href="/contact">Contact Us</a>
        </div>
        <div class="footer__col">
            <h4>Information</h4>
            <a href="/page/terms-and-conditions">Terms &amp; Conditions</a>
            <a href="/page/privacy-policy">Privacy Policy</a>
            <a href="/page/refund-policy">Refund Policy</a>
            @if (!string.IsNullOrWhiteSpace(cfg?.ContactEmail))
            {
                <a href="mailto:@cfg.ContactEmail">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                    @cfg.ContactEmail
                </a>
            }
        </div>
        <div class="footer__col">
            <h4>Find Us</h4>
            @if (!string.IsNullOrWhiteSpace(cfg?.Address))
            {
                <p>@cfg.Address</p>
            }
            <div class="footer__phones">
                @if (!string.IsNullOrWhiteSpace(cfg?.ContactPhone1)) { <a href="tel:@cfg.ContactPhone1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>@cfg.ContactPhone1</a> }
                @if (!string.IsNullOrWhiteSpace(cfg?.ContactPhone2)) { <a href="tel:@cfg.ContactPhone2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>@cfg.ContactPhone2</a> }
                @if (!string.IsNullOrWhiteSpace(cfg?.ContactPhone3)) { <a href="tel:@cfg.ContactPhone3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>@cfg.ContactPhone3</a> }
            </div>
            <div class="footer__social">
                <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><path d="M17.5 6.5h.01"/></svg></a>
                <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
                <a href="#" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17Z"/><path d="m10 15 5-3-5-3z"/></svg></a>
            </div>
        </div>
    </div>
    @* VIJAYPATH decorative watermark *@
    <div class="footer__watermark" aria-hidden="true">
        <svg viewBox="0 0 700 80" xmlns="http://www.w3.org/2000/svg"><text x="50%" y="65" text-anchor="middle" font-family="'Google Sans Flex', system-ui, sans-serif" font-size="120" font-weight="700" fill="#2a2f35">VIJAYPATH</text></svg>
    </div>
    <div class="footer__bottom"><p>&copy; @DateTime.Now.Year @(cfg?.CopyrightText ?? cfg?.CompanyName ?? "Vijaypath"). All Rights Reserved.</p></div>
</footer>

@code {
    private string email = "";
    private bool busy, subscribed;
    private string? message;
    private SiteSettings? cfg;
    private const string FallbackLogo = "_content/RioCommerce.Web.Storefront/images/vijaypath-header-logo.svg";
    private string LogoSrc => string.IsNullOrWhiteSpace(cfg?.LogoUrl) ? FallbackLogo : cfg!.LogoUrl!;

    protected override async Task OnInitializedAsync()
    {
        try { cfg = await Settings.GetAsync(); } catch { }
    }

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Subscribe(); }

    private async Task Subscribe()
    {
        if (string.IsNullOrWhiteSpace(email)) { message = "Please enter your email address."; return; }
        busy = true; message = null;
        var (ok, msg) = await Newsletter.SubscribeAsync(new SubscribeRequest(email, null, "footer"));
        busy = false;
        message = msg;
        subscribed = ok;
    }
}
