@using RioCommerce.Core.Constants
@inject ISiteSettingsService SettingsSvc

@*
    Top contact bar. The phone and email were previously rendered ONLY when the matching
    site setting was filled in — and those settings are blank, so the bar showed a lone
    phone icon with no number and no email at all. They now fall back to the official
    public details, so the bar is never empty; anything set in Admin → Settings still wins.
*@

<div class="contact-strip">
    <div class="contact-strip__inner">
        <div class="contact-strip__phones">
            <a class="contact-strip__item" href="tel:@PublicContactDefaults.TelHref(Phone1)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
                <span>@Phone1</span>
            </a>

            @* Extra numbers stay optional — only shown when actually configured. *@
            @if (!string.IsNullOrWhiteSpace(cfg?.ContactPhone2))
            {
                <a class="contact-strip__item" href="tel:@PublicContactDefaults.TelHref(cfg!.ContactPhone2)"><span>@cfg!.ContactPhone2</span></a>
            }

            <span class="contact-strip__sep" aria-hidden="true"></span>

            <a class="contact-strip__item" href="mailto:@Email">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                <span>@Email</span>
            </a>
        </div>
        <div class="contact-strip__social">
            @if (!string.IsNullOrWhiteSpace(cfg?.InstagramUrl))
            {
                <a href="@cfg.InstagramUrl" target="_blank" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/></svg></a>
            }
            @if (!string.IsNullOrWhiteSpace(cfg?.YoutubeUrl))
            {
                <a href="@cfg.YoutubeUrl" target="_blank" aria-label="YouTube"><svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48" fill="#1a3a5c"/></svg></a>
            }
            @if (!string.IsNullOrWhiteSpace(cfg?.TelegramUrl))
            {
                <a href="@cfg.TelegramUrl" target="_blank" aria-label="Telegram"><svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M21.2 2.43a2.24 2.24 0 0 0-1.02.22l-8.61 3.33c-2.07.8-4.13 1.6-5.72 2.21-.95.37-1.86.72-2.85 1.09-.42.15-.99.33-1.47.9-.73.86.07 1.64.36 1.87l4.02 2.77.88 2.89c.17.58.59 1.1.83.19.28-.05.5-.15.76-.38.26-.23 1.08-.95 1.55-1.37l3.43 2.51c.37.27.95.68 1.66.59.72-.08 1.15-.61 1.35-1.08.2-.47.34-1.04.46-1.8.13-.77 1.11-7.01 1.49-9.46.19-1.22.35-2.38.17-3.22-.09-.42-.29-.85-.72-1.13a1.5 1.5 0 0 0-.55-.24z"/></svg></a>
            }
        </div>
    </div>
</div>

@code {
    private SiteSettings? cfg;

    // Configured value wins; the official detail is the fallback so the bar is never blank.
    private string Phone1 => string.IsNullOrWhiteSpace(cfg?.ContactPhone1)
        ? PublicContactDefaults.Phone : cfg!.ContactPhone1!;
    // Blank OR a seeded example.com placeholder both count as "not configured".
    private string Email =>
        string.IsNullOrWhiteSpace(cfg?.ContactEmail) || PublicContactDefaults.IsPlaceholderEmail(cfg!.ContactEmail)
            ? PublicContactDefaults.Email : cfg!.ContactEmail!;

    protected override async Task OnInitializedAsync()
    {
        try { cfg = await SettingsSvc.GetAsync(); } catch { }
    }
}
