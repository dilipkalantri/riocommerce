@inject IJSRuntime JS
@inject ISiteSettingsService SettingsSvc

<div class="floating-dock@(collapsed ? " floating-dock--collapsed" : "")">
    <div class="floating-btns">
        <button type="button" class="float-min" @onclick="Collapse"
                aria-label="Minimize contact options" title="Minimize">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
        </button>

        @if (!string.IsNullOrWhiteSpace(callPhone))
        {
            <a href="tel:@callPhone" class="float-btn float-btn--call" title="Call Us" aria-label="Call">
                <svg viewBox="0 0 24 24" fill="#fff"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span class="float-btn__label">Call us</span>
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(waHref))
        {
            <a href="@waHref" target="_blank" class="float-btn float-btn--whatsapp" title="WhatsApp" aria-label="WhatsApp">
                <svg viewBox="0 0 24 24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                <span class="float-btn__label">Chat on WhatsApp</span>
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(telegramUrl))
        {
            <a href="@telegramUrl" target="_blank" class="float-btn float-btn--telegram" title="Telegram" aria-label="Telegram">
                <svg viewBox="0 0 24 24" fill="#fff"><path d="M21.198 2.433a2.242 2.242 0 0 0-1.022.215l-8.609 3.33c-2.068.8-4.133 1.598-5.724 2.21a405.15 405.15 0 0 1-2.849 1.09c-.42.147-.99.332-1.473.901-.728.855.075 1.644.357 1.866l4.024 2.773.883 2.89c.174.582.591 1.101.826.191.277-.046.497-.153.757-.382.26-.228 1.078-.95 1.545-1.365l3.434 2.511c.373.272.945.675 1.661.592.716-.083 1.154-.614 1.354-1.084.2-.47.335-1.036.464-1.802.128-.765 1.11-7.012 1.487-9.458.188-1.223.349-2.378.167-3.217-.092-.419-.285-.85-.724-1.131a1.507 1.507 0 0 0-.549-.236z"/></svg>
                <span class="float-btn__label">Telegram</span>
            </a>
        }
    </div>

    <button type="button" class="float-fab" @onclick="Expand"
            aria-label="Show contact options" aria-expanded="@((!collapsed).ToString().ToLowerInvariant())"
            title="Contact us">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
    </button>
</div>

@code {
    private const string StateKey = "rc_dock_collapsed";
    private bool collapsed = true;
    private string? callPhone, waHref, telegramUrl;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cfg = await SettingsSvc.GetAsync();
            callPhone = cfg.ContactPhone1;
            telegramUrl = cfg.TelegramUrl;
            if (!string.IsNullOrWhiteSpace(cfg.WhatsappNumber))
            {
                var num = cfg.WhatsappNumber.TrimStart('+');
                if (!num.StartsWith("91")) num = "91" + num;
                var msg = Uri.EscapeDataString(cfg.WhatsappMessage ?? "Hi! I'd like to enquire about your courses.");
                waHref = $"https://wa.me/{num}?text={msg}";
            }
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var raw = await JS.InvokeAsync<string?>("sessionStorage.getItem", StateKey);
            var wantCollapsed = raw != "0";
            if (wantCollapsed != collapsed)
            {
                collapsed = wantCollapsed;
                StateHasChanged();
            }
        }
        catch { }
    }

    private Task Collapse() => SetCollapsed(true);
    private Task Expand() => SetCollapsed(false);

    private async Task SetCollapsed(bool value)
    {
        collapsed = value;
        try { await JS.InvokeVoidAsync("sessionStorage.setItem", StateKey, value ? "1" : "0"); }
        catch { }
    }
}
