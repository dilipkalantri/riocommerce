@code {
    // ── Excel import state ───────────────────────────────────────────────────────────────────
    // The preview lives HERE, in server memory, for the life of this circuit. That is what makes
    // the confirm step safe: the browser is never handed the parsed rows, so it cannot edit a
    // status or a field and post it back. Even if it could, ImportAsync only acts on rows the
    // server marked Valid and routes every one through AddAsync, which takes the school and
    // AddedByUserId from the authenticated user rather than the row.
    private bool importOpen, parsing, importing;
    private string? importError;
    private SchoolStudentImportPreview? preview;
    private SchoolStudentImportResult? importResult;
    private List<SchoolStudentImportRow> skippedRows = new();

    /// <summary>Guards against a huge upload before it ever reaches the parser.</summary>
    private const long MaxImportBytes = 5 * 1024 * 1024;

    private void OpenImport()
    {
        importOpen = true;
        preview = null; importResult = null; importError = null;
        skippedRows = new();
    }

    private void CloseImport()
    {
        importOpen = false;
        preview = null; importResult = null; importError = null;
        skippedRows = new();
    }

    private static string StatusClass(SchoolStudentImportStatus s) => s switch
    {
        SchoolStudentImportStatus.Valid => "ok",
        SchoolStudentImportStatus.Invalid => "bad",
        _ => "dup",
    };

    private static string StatusText(SchoolStudentImportStatus s) => s switch
    {
        SchoolStudentImportStatus.Valid => "Valid",
        SchoolStudentImportStatus.Invalid => "Invalid",
        SchoolStudentImportStatus.DuplicateInFile => "Duplicate",
        _ => "Already exists",
    };

    private async Task OnImportFileChosen(InputFileChangeEventArgs e)
    {
        importError = null;
        preview = null;
        importResult = null;

        var file = e.File;
        if (file is null) return;

        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            importError = "Please choose an .xlsx file. Older .xls files are not supported.";
            return;
        }
        if (file.Size > MaxImportBytes)
        {
            importError = "That file is larger than 5 MB. Please split it into smaller batches.";
            return;
        }

        parsing = true;
        try
        {
            // Copied to memory first: ClosedXML needs a seekable stream, and the browser stream is
            // forward-only. The size cap above is what keeps this bounded.
            using var ms = new MemoryStream();
            await using (var src = file.OpenReadStream(MaxImportBytes))
                await src.CopyToAsync(ms);
            ms.Position = 0;

            preview = await Students.ParseImportAsync(actingUserId, ms);
            if (!preview.Ok)
            {
                importError = preview.Error;
                preview = null;
            }
        }
        catch (Exception)
        {
            importError = "That file could not be read. Please use the sample template (.xlsx).";
            preview = null;
        }
        finally
        {
            parsing = false;
        }
    }

    private async Task ConfirmImport()
    {
        if (preview is null || importing) return;

        importing = true;
        try
        {
            var result = await Students.ImportAsync(actingUserId, preview.Rows);

            // Everything the writer should see as "not imported": rows the file failed validation
            // on, plus any row the server refused at save time.
            skippedRows = preview.Rows.Where(r => !r.WillImport)
                .Concat(result.FailedRows)
                .OrderBy(r => r.ExcelRow)
                .ToList();

            importResult = result;
            await Reload();
        }
        finally
        {
            importing = false;
        }
    }

    private bool loading = true, addOpen, saving, ok;
    private Guid actingUserId;
    private Guid? schoolId;
    private string? message;
    private string search = "";
    private List<SchoolStudentListItem> rows = new();

    /// <summary>School-paid status keyed by student. Absent = no school enrolment order exists.</summary>
    private Dictionary<Guid, SchoolStudentPaymentStatus> payStatus = new();
    private string payFilter = "All";

    /// <summary>Rows after the payment filter. `rows` is already scoped to this school.</summary>
    private List<SchoolStudentListItem> Visible =>
        rows.Where(r => Matches(r, payFilter)).ToList();

    private bool Matches(SchoolStudentListItem r, string filter)
    {
        if (filter == "All") return true;
        var has = payStatus.TryGetValue(r.UserId, out var p);
        return filter switch
        {
            "Paid" => has && p!.IsPaid,
            "Failed" => has && p!.IsFailed,
            // A student with no school order counts as Pending: the school has not paid for them.
            "Pending" => !has || (!p!.IsPaid && !p.IsFailed),
            _ => true,
        };
    }

    private int CountFor(string filter) => rows.Count(r => Matches(r, filter));

    // Bulk-add state. bulkRows is the working grid. `saveRan` flips to true after a save so
    // the row-status column switches from "waiting for input" (idle) to "missing fields" (warn)
    // for the row where a required field is still empty — no red before the writer has tried.
    private List<BulkRow> bulkRows = new();
    private bool saveRan;
    private string defaultClass = "";

    private int ReadyCount => bulkRows.Count(IsRowReady);
    // A row is "incomplete" only after the writer has engaged with it — an untouched empty
    // row shouldn't inflate the counter. Once Save has been clicked once, every not-ready
    // row counts, so the writer can see how many they still owe.
    private int IncompleteCount => bulkRows.Count(r =>
        !IsRowReady(r)
        && string.IsNullOrEmpty(r.Error)
        && (saveRan || HasAnyInput(r)));
    private int ErrorCount => bulkRows.Count(r => !string.IsNullOrEmpty(r.Error));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (uid != null && Guid.TryParse(uid, out var parsed))
        {
            actingUserId = parsed;
            schoolId = await Students.ResolveSchoolIdAsync(actingUserId);
            // Goes through Reload() rather than calling ListAsync directly: Reload also loads the
            // payment verdicts. Loading the roster on its own left payStatus empty on first paint,
            // so every student rendered as "Pending" even when the school had paid for them.
            if (schoolId is not null) await Reload();
        }
        loading = false;
    }

    private async Task Reload()
    {
        rows = await Students.ListAsync(actingUserId, search);
        // Re-read the payment verdicts alongside the roster so a settled payment is reflected
        // immediately after any refresh.
        payStatus = await Enrollment.GetStudentPaymentStatusesAsync(actingUserId);
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Reload();
    }

    private void OpenAdd()
    {
        addOpen = true; saveRan = false;
        bulkRows = new() { NewRow(), NewRow(), NewRow() };
    }
    private void CloseAdd() { addOpen = false; }

    private BulkRow NewRow() => new BulkRow
    {
        StudentClass = string.IsNullOrEmpty(defaultClass) ? null : defaultClass
    };

    private void AddBulkRow() { bulkRows.Add(NewRow()); }

    private void RemoveBulkRow(int i)
    {
        if (i >= 0 && i < bulkRows.Count) bulkRows.RemoveAt(i);
        if (bulkRows.Count == 0) bulkRows.Add(NewRow());
    }

    private static bool HasAnyInput(BulkRow r) =>
        !string.IsNullOrWhiteSpace(r.FullName) || !string.IsNullOrWhiteSpace(r.Email)
        || !string.IsNullOrWhiteSpace(r.Phone) || r.DateOfBirth.HasValue
        || !string.IsNullOrWhiteSpace(r.Gender) || !string.IsNullOrWhiteSpace(r.StudentClass);

    // Required fields: Name, Mobile, DOB, Gender. Email and Class are optional — a row with just
    // those four filled is submittable. Kept in sync with the server-side AddAsync gate, so a row
    // that reads "ready" on the client does actually save.
    private static bool IsRowReady(BulkRow r) =>
        !string.IsNullOrWhiteSpace(r.FullName)
        && !string.IsNullOrWhiteSpace(r.Phone)
        && r.DateOfBirth.HasValue
        && !string.IsNullOrWhiteSpace(r.Gender);

    private string RowStatusClass(BulkRow r)
    {
        if (!string.IsNullOrEmpty(r.Error)) return "err";
        if (IsRowReady(r)) return "ok";
        // Warn only when the writer has typed something or has tried saving — a fresh empty row is idle.
        if (saveRan || HasAnyInput(r)) return "warn";
        return "idle";
    }
    private string RowStatusText(BulkRow r) => RowStatusClass(r) switch
    {
        "ok" => "Ready to save",
        "warn" => "Missing required fields",
        "err" => r.Error ?? "Server rejected this row",
        _ => "Empty row"
    };
    private string RowStatusIcon(BulkRow r) => RowStatusClass(r) switch
    {
        "ok" => "✓", "warn" => "!", "err" => "✕", _ => "·"
    };

    // A field is drawn red only after the writer has engaged with the row (typed anything
    // or hit save). Otherwise every fresh row would light up entirely red. Only the four
    // mandatory fields can trigger a red state — Email and Class stay neutral.
    private bool RowFieldError(BulkRow r, string field)
    {
        if (!saveRan && !HasAnyInput(r)) return false;
        if (!string.IsNullOrEmpty(r.Error)) return false; // server errors are shown as a strip, not per-cell
        return field switch
        {
            nameof(BulkRow.FullName)    => string.IsNullOrWhiteSpace(r.FullName),
            nameof(BulkRow.Phone)       => string.IsNullOrWhiteSpace(r.Phone),
            nameof(BulkRow.DateOfBirth) => !r.DateOfBirth.HasValue,
            nameof(BulkRow.Gender)      => string.IsNullOrWhiteSpace(r.Gender),
            _ => false
        };
    }

    private async Task SaveBulk()
    {
        saveRan = true;
        // Ready-only rows are submitted; incomplete rows stay in the grid with their warn state.
        var payload = new BulkAddSchoolStudentRequest
        {
            Rows = bulkRows.Where(IsRowReady).Select(r => new AddSchoolStudentRequest
            {
                FullName = r.FullName!.Trim(),
                // Email is OPTIONAL, so it is genuinely null on most rows. `r.Email!.Trim()` used
                // to sit here and threw a NullReferenceException the moment a principal saved a row
                // without one — which made an "optional" column compulsory in practice. Blank is
                // normalised to null so the service skips its email lookup and stores NULL, which
                // is what the partial unique index IX_users_Email requires.
                Email = string.IsNullOrWhiteSpace(r.Email) ? null : r.Email.Trim(),
                Phone = r.Phone!.Trim(),
                DateOfBirth = r.DateOfBirth,
                Gender = r.Gender,
                StudentClass = r.StudentClass
                // Section / RollNumber are no longer collected here. They stay on the DTO and the
                // entity so existing rows keep their values; this screen simply sends nothing.
            }).ToList()
        };
        if (payload.Rows.Count == 0) return;

        saving = true;
        // Clear previous per-row server errors before this attempt.
        foreach (var r in bulkRows) r.Error = null;

        var result = await Students.AddManyAsync(actingUserId, payload);
        saving = false;

        // Map server results back to grid rows. Ready rows are indexed IN ORDER in the payload,
        // so a zip against the ready subset gives each grid row its outcome.
        var readySubset = bulkRows.Where(IsRowReady).ToList();
        for (int i = 0; i < result.Rows.Count && i < readySubset.Count; i++)
        {
            var rr = result.Rows[i];
            var target = readySubset[i];
            if (!rr.Ok) target.Error = rr.Error;
        }

        // Successful rows drop from the grid; failing rows stay so the writer can fix + retry.
        bulkRows = bulkRows.Where(r => !string.IsNullOrEmpty(r.Error) || !IsRowReady(r)).ToList();
        if (bulkRows.Count == 0) bulkRows.Add(NewRow());

        var savedTotal = result.Created + result.Linked;
        ok = result.Failed == 0;
        var parts = new List<string>();
        if (result.Created > 0) parts.Add($"{result.Created} added");
        if (result.Linked > 0)  parts.Add($"{result.Linked} linked to existing account{(result.Linked == 1 ? "" : "s")}");
        if (result.Failed > 0)  parts.Add($"{result.Failed} not saved (see the grid)");
        message = parts.Count > 0 ? string.Join(" · ", parts) : null;

        if (savedTotal > 0) await Reload();
        if (result.Failed == 0) addOpen = false;
    }

    private async Task Remove(SchoolStudentListItem r)
    {
        var (removed, err) = await Students.RemoveAsync(actingUserId, r.Id);
        ok = removed;
        message = removed ? $"{r.FullName} removed from your roll." : err;
        if (removed) await Reload();
    }

    private class BulkRow
    {
        public string? FullName { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public DateTime? DateOfBirth { get; set; }
        public string? Gender { get; set; }
        public string? StudentClass { get; set; }
        public string? Error { get; set; }
    }
}

