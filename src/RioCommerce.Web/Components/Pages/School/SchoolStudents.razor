@page "/school/students"
@layout SchoolLayout
@using RioCommerce.Core.DTOs.School
@attribute [Authorize(Roles = "school_principal,school_coordinator")]
@inject ISchoolStudentService Students
@inject AuthenticationStateProvider AuthProvider

@* Fills the /school/students route that the sidebar links to. Wrapped by SchoolLayout,
   which supplies the portal sidebar and topbar so the page only owns its content. *@

<PageTitle>Students — School Portal</PageTitle>

<div class="page__header">
    <h1>Students</h1>
</div>

    @if (loading)
    {
        <p style="color:var(--gray-400);padding:30px 0">Loading…</p>
    }
    else if (schoolId is null)
    {
        @* Belt and braces: the [Authorize] above already gates the role, this covers a user who
           holds the role but has no active school link. *@
        <p style="color:var(--gray-400);padding:30px 0">Your account is not linked to a school.</p>
    }
    else
    {
        <div class="ss-bar">
            <div class="ss-bar__search">
                <input class="form-input" placeholder="Search name, email, phone or roll no."
                       @bind="search" @bind:event="oninput" @onkeydown="OnSearchKey" />
            </div>
            <button class="btn btn-primary" @onclick="OpenAdd">+ Add Students</button>
        </div>

        @if (message != null)
        {
            <div class="inline-alert @(ok ? "inline-alert--ok" : "inline-alert--err")" style="margin-bottom:14px">@message</div>
        }

        @if (rows.Count == 0)
        {
            <div class="ss-empty">
                <p>No students on your roll yet.</p>
                <button class="btn btn-primary" @onclick="OpenAdd">+ Add your first student</button>
            </div>
        }
        else
        {
            <div class="ss-table-wrap">
                <table class="ss-table">
                    <thead>
                        <tr>
                            <th>Student</th><th>Contact</th><th>Class</th><th>Section</th>
                            <th>Roll No.</th><th>Status</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            <tr>
                                <td>
                                    <div class="ss-name">@r.FullName</div>
                                    <div class="ss-sub">Added @r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <div class="ss-sub">@(r.Email ?? "—")</div>
                                    <div class="ss-sub">@(r.Phone ?? "—")</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(r.StudentClass) ? "—" : r.StudentClass)</td>
                                <td>@(string.IsNullOrWhiteSpace(r.Section) ? "—" : r.Section)</td>
                                <td>@(string.IsNullOrWhiteSpace(r.RollNumber) ? "—" : r.RollNumber)</td>
                                <td>
                                    @* IsVerified is the activation signal: it flips to true only when
                                       the student completes the OTP and sets their own password. *@
                                    <span class="ss-pill @(r.IsVerified ? "ss-pill--ok" : "ss-pill--wait")"
                                          title="@(r.IsVerified ? "Account activated by the student" : "Student has not activated the account yet")">
                                        @(r.IsVerified ? "Active" : "Pending")
                                    </span>
                                </td>
                                <td style="text-align:right">
                                    <button class="btn btn-outline btn-sm" @onclick="() => Remove(r)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="ss-count">@rows.Count student@(rows.Count == 1 ? "" : "s")</p>
        }
    }

@if (addOpen)
{
    <div class="ss-modal-backdrop" @onclick="CloseAdd"></div>
    <div class="bulk-modal" role="dialog" aria-label="Add students">
        <div class="bulk-modal__head">
            <div style="display:flex;align-items:center;gap:12px">
                <h3 class="bulk-modal__title">Add Students</h3>
                <span class="bulk-chip">Bulk entry</span>
            </div>
            <p class="bulk-modal__lede">
                Add several students at once — one per row. They all join <strong>your</strong> school
                automatically. Existing accounts (matched by email or mobile) are linked instead of duplicated.
                Fill every column marked <span class="required">*</span>. Rows with missing fields are skipped and stay
                on the grid so you can fix them and re-save.
            </p>
        </div>

        <div class="bulk-toolbar">
            <span class="bulk-toolbar__lbl">Defaults for new rows —</span>
            <label class="bulk-toolbar__pill">
                Class
                <select @bind="defaultClass">
                    <option value="">—</option>
                    @for (var c = 1; c <= 12; c++) { <option value="@c">@c</option> }
                </select>
            </label>
            <label class="bulk-toolbar__pill">
                Section
                <select @bind="defaultSection">
                    <option value="">—</option>
                    @foreach (var sec in new[] { "A", "B", "C", "D", "E", "F" }) { <option value="@sec">@sec</option> }
                </select>
            </label>
        </div>

        <div class="bulk-grid-wrap">
            <table class="bulk-grid">
                <thead>
                    <tr>
                        <th class="c-st"></th>
                        <th class="c-no">#</th>
                        <th class="c-name">Student Name <span class="required">*</span></th>
                        <th class="c-email">Email</th>
                        <th class="c-phone">Mobile <span class="required">*</span></th>
                        <th class="c-dob">Date of Birth <span class="required">*</span></th>
                        <th class="c-gen">Gender <span class="required">*</span></th>
                        <th class="c-cls">Class</th>
                        <th class="c-sec">Section</th>
                        <th class="c-roll">Roll No.</th>
                        <th class="c-act"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < bulkRows.Count; i++)
                    {
                        var idx = i;
                        var row = bulkRows[idx];
                        <tr>
                            <td>
                                <span class="rst rst--@RowStatusClass(row)" title="@RowStatusText(row)">
                                    @RowStatusIcon(row)
                                </span>
                            </td>
                            <td class="rnum">@(idx + 1)</td>
                            <td class="cell @(RowFieldError(row, "FullName") ? "cell--err" : "")">
                                <input @bind="row.FullName" placeholder="Full name" />
                            </td>
                            <td class="cell @(RowFieldError(row, "Email") ? "cell--err" : "")">
                                <input type="email" @bind="row.Email" placeholder="student@school.in" />
                            </td>
                            <td class="cell mono @(RowFieldError(row, "Phone") ? "cell--err" : "")">
                                <input @bind="row.Phone" placeholder="10-digit mobile" />
                            </td>
                            <td class="cell @(RowFieldError(row, "DateOfBirth") ? "cell--err" : "")">
                                <input type="date" @bind="row.DateOfBirth" />
                            </td>
                            <td class="cell @(RowFieldError(row, "Gender") ? "cell--err" : "")">
                                <select @bind="row.Gender">
                                    <option value="">Select</option>
                                    <option>Male</option><option>Female</option><option>Other</option>
                                </select>
                            </td>
                            <td class="cell @(RowFieldError(row, "StudentClass") ? "cell--err" : "")">
                                <select @bind="row.StudentClass">
                                    <option value="">—</option>
                                    @for (var c = 1; c <= 12; c++) { <option value="@c">@c</option> }
                                </select>
                            </td>
                            <td class="cell @(RowFieldError(row, "Section") ? "cell--err" : "")">
                                <select @bind="row.Section">
                                    <option value="">—</option>
                                    @foreach (var sec in new[] { "A", "B", "C", "D", "E", "F" }) { <option value="@sec">@sec</option> }
                                </select>
                            </td>
                            <td class="cell mono @(RowFieldError(row, "RollNumber") ? "cell--err" : "")">
                                <input @bind="row.RollNumber" placeholder="Roll" />
                            </td>
                            <td>
                                <button class="row-del" title="Remove row" @onclick="() => RemoveBulkRow(idx)" disabled="@saving">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                                </button>
                            </td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(row.Error))
                        {
                            <tr class="row-error-line">
                                <td></td>
                                <td colspan="10"><span class="row-error-line__msg">@row.Error</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="bulk-addrow">
            <button class="bulk-addrow__btn" @onclick="AddBulkRow" disabled="@saving">+ Add another row</button>
            <span class="bulk-addrow__hint">Batch limit: 100 rows per submit.</span>
        </div>

        <div class="bulk-modal__foot">
            <div class="bulk-legend">
                <span><span class="dot dot--ok"></span>Ready</span>
                <span><span class="dot dot--warn"></span>Missing fields</span>
                <span><span class="dot dot--err"></span>Server error</span>
            </div>
            <span style="flex:1"></span>
            <div class="bulk-count">
                <strong>@ReadyCount</strong> ready
                @if (IncompleteCount > 0) { <span>&nbsp;·&nbsp;@IncompleteCount incomplete</span> }
                @if (ErrorCount > 0) { <span>&nbsp;·&nbsp;@ErrorCount errored</span> }
            </div>
            <button class="btn btn-outline" @onclick="CloseAdd" disabled="@saving">Cancel</button>
            <button class="btn btn-primary" @onclick="SaveBulk" disabled="@(saving || ReadyCount == 0)">
                @(saving ? "Saving…" : $"Save {ReadyCount} student{(ReadyCount == 1 ? "" : "s")}")
            </button>
        </div>
    </div>
}

<style>
    .ss-bar{display:flex;gap:12px;align-items:center;justify-content:space-between;margin:18px 0 14px;flex-wrap:wrap}
    .ss-bar__search{flex:1 1 260px;max-width:380px}
    .ss-table-wrap{overflow-x:auto;border:1px solid var(--gray-200);border-radius:14px;background:#fff}
    .ss-table{width:100%;border-collapse:collapse;min-width:720px}
    .ss-table th{text-align:left;font-size:11.5px;letter-spacing:.6px;text-transform:uppercase;color:var(--gray-500);
        padding:12px 14px;border-bottom:1px solid var(--gray-200);white-space:nowrap}
    .ss-table td{padding:12px 14px;border-bottom:1px solid var(--gray-100);font-size:14px;vertical-align:top}
    .ss-table tbody tr:last-child td{border-bottom:none}
    .ss-name{font-weight:600;color:var(--vp-ink)}
    .ss-sub{font-size:12.5px;color:var(--gray-500)}
    .ss-pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11.5px;font-weight:700}
    .ss-pill--ok{background:#e8f5e9;color:#2e7d32}
    .ss-pill--wait{background:#fff4e5;color:#b45309}
    .ss-count{margin-top:10px;font-size:13px;color:var(--gray-500)}
    .ss-empty{padding:44px 20px;text-align:center;border:1px dashed var(--gray-200);border-radius:14px;background:#fff}
    .ss-empty p{color:var(--gray-500);margin-bottom:14px}

    .ss-modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1000}

    /* ── Bulk-add modal ── */
    .bulk-modal{position:fixed;z-index:1001;left:50%;top:50%;transform:translate(-50%,-50%);
        width:min(1150px,calc(100vw - 32px));max-height:calc(100vh - 48px);
        background:#fff;border-radius:14px;display:flex;flex-direction:column;overflow:hidden;
        box-shadow:0 40px 80px -30px rgba(15,23,42,.55)}
    .bulk-modal__head{padding:20px 24px 14px;border-bottom:1px solid var(--gray-200)}
    .bulk-modal__title{margin:0;font-size:18px;font-weight:700;color:var(--vp-ink)}
    .bulk-modal__lede{margin:6px 0 0;font-size:13px;color:var(--gray-500);line-height:1.5}
    .bulk-chip{display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;background:#FEEEDB;color:#e8720a}

    .bulk-toolbar{display:flex;align-items:center;gap:10px;padding:12px 24px;border-bottom:1px solid var(--gray-200);background:#fbfcfe;flex-wrap:wrap}
    .bulk-toolbar__lbl{color:var(--gray-500);font-size:12px}
    .bulk-toolbar__pill{display:inline-flex;align-items:center;gap:6px;padding:4px 8px;background:#fff;border:1px solid var(--gray-200);border-radius:6px;font-size:12.5px;color:var(--gray-500)}
    .bulk-toolbar__pill select{border:0;background:transparent;font:inherit;font-weight:600;color:var(--vp-ink);outline:none;padding:2px 4px}

    .bulk-grid-wrap{overflow:auto;flex:1}
    .bulk-grid{width:100%;border-collapse:separate;border-spacing:0;font-size:13px;min-width:1080px}
    .bulk-grid th{text-align:left;padding:10px 10px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--gray-500);background:#fafbfd;border-bottom:1px solid var(--gray-200);position:sticky;top:0;z-index:2}
    .bulk-grid td{padding:6px 6px;border-bottom:1px solid var(--gray-100);vertical-align:middle}
    .bulk-grid tr:last-child td{border-bottom:0}
    .bulk-grid th.c-st{width:40px}
    .bulk-grid th.c-no{width:36px}
    .bulk-grid th.c-name{min-width:180px}
    .bulk-grid th.c-email{min-width:190px}
    .bulk-grid th.c-phone{min-width:130px}
    .bulk-grid th.c-dob{width:150px}
    .bulk-grid th.c-gen{width:110px}
    .bulk-grid th.c-cls{width:88px}
    .bulk-grid th.c-sec{width:78px}
    .bulk-grid th.c-roll{width:96px}
    .bulk-grid th.c-act{width:44px}

    .rst{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;font-size:11px;font-weight:700}
    .rst--idle{background:#eef1f6;color:#6b7891}
    .rst--ok{background:#DCFCE7;color:#16a34a}
    .rst--warn{background:#FEF3C7;color:#d97706}
    .rst--err{background:#FEE2E2;color:#dc2626}
    .rnum{font-variant-numeric:tabular-nums;color:var(--gray-500);font-size:12px;text-align:center}

    .bulk-grid .cell input,.bulk-grid .cell select{width:100%;padding:8px 10px;font:inherit;font-size:13px;color:var(--vp-ink);background:#fff;border:1px solid var(--gray-200);border-radius:6px;outline:none}
    .bulk-grid .cell input:focus,.bulk-grid .cell select:focus{border-color:var(--orange);box-shadow:0 0 0 3px #FEEEDB}
    .bulk-grid .cell.mono input{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px}
    .bulk-grid .cell--err input,.bulk-grid .cell--err select{border-color:#dc2626;background:#FFF7F7}

    .row-del{width:28px;height:28px;border-radius:6px;background:transparent;border:1px solid transparent;color:var(--gray-500);cursor:pointer;display:grid;place-items:center}
    .row-del:hover{background:#F1F5F9;color:#dc2626;border-color:var(--gray-200)}
    .row-error-line td{padding:2px 10px 8px;border-bottom:1px solid var(--gray-100);background:#FFF7F7}
    .row-error-line__msg{color:#b91c1c;font-size:12px;font-weight:500}

    .bulk-addrow{display:flex;align-items:center;gap:10px;padding:10px 24px;border-top:1px solid var(--gray-200);background:#fbfcfe}
    .bulk-addrow__btn{background:#fff;border:1px dashed var(--gray-300);color:var(--vp-ink);padding:8px 14px;border-radius:8px;font:inherit;font-size:13px;font-weight:500;cursor:pointer}
    .bulk-addrow__btn:hover{border-color:var(--orange);color:#e8720a}
    .bulk-addrow__hint{color:var(--gray-500);font-size:12px;margin-left:auto}

    .bulk-modal__foot{display:flex;align-items:center;gap:12px;padding:14px 24px;border-top:1px solid var(--gray-200);background:#fff}
    .bulk-legend{display:flex;gap:14px;align-items:center;font-size:12px;color:var(--gray-500)}
    .bulk-legend .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle}
    .bulk-legend .dot--ok{background:#16a34a}
    .bulk-legend .dot--warn{background:#d97706}
    .bulk-legend .dot--err{background:#dc2626}
    .bulk-count{color:var(--vp-ink);font-size:13px}
</style>

@code {
    private bool loading = true, addOpen, saving, ok;
    private Guid actingUserId;
    private Guid? schoolId;
    private string? message;
    private string search = "";
    private List<SchoolStudentListItem> rows = new();

    // Bulk-add state. bulkRows is the working grid. `saveRan` flips to true after a save so
    // the row-status column switches from "waiting for input" (idle) to "missing fields" (warn)
    // for the row where a required field is still empty — no red before the writer has tried.
    private List<BulkRow> bulkRows = new();
    private bool saveRan;
    private string defaultClass = "";
    private string defaultSection = "";

    private int ReadyCount => bulkRows.Count(IsRowReady);
    // A row is "incomplete" only after the writer has engaged with it — an untouched empty
    // row shouldn't inflate the counter. Once Save has been clicked once, every not-ready
    // row counts, so the writer can see how many they still owe.
    private int IncompleteCount => bulkRows.Count(r =>
        !IsRowReady(r)
        && string.IsNullOrEmpty(r.Error)
        && (saveRan || HasAnyInput(r)));
    private int ErrorCount => bulkRows.Count(r => !string.IsNullOrEmpty(r.Error));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (uid != null && Guid.TryParse(uid, out var parsed))
        {
            actingUserId = parsed;
            schoolId = await Students.ResolveSchoolIdAsync(actingUserId);
            if (schoolId is not null) rows = await Students.ListAsync(actingUserId);
        }
        loading = false;
    }

    private async Task Reload() => rows = await Students.ListAsync(actingUserId, search);

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Reload();
    }

    private void OpenAdd()
    {
        addOpen = true; saveRan = false;
        bulkRows = new() { NewRow(), NewRow(), NewRow() };
    }
    private void CloseAdd() { addOpen = false; }

    private BulkRow NewRow() => new BulkRow
    {
        StudentClass = string.IsNullOrEmpty(defaultClass) ? null : defaultClass,
        Section = string.IsNullOrEmpty(defaultSection) ? null : defaultSection
    };

    private void AddBulkRow() { bulkRows.Add(NewRow()); }

    private void RemoveBulkRow(int i)
    {
        if (i >= 0 && i < bulkRows.Count) bulkRows.RemoveAt(i);
        if (bulkRows.Count == 0) bulkRows.Add(NewRow());
    }

    private static bool HasAnyInput(BulkRow r) =>
        !string.IsNullOrWhiteSpace(r.FullName) || !string.IsNullOrWhiteSpace(r.Email)
        || !string.IsNullOrWhiteSpace(r.Phone) || r.DateOfBirth.HasValue
        || !string.IsNullOrWhiteSpace(r.Gender) || !string.IsNullOrWhiteSpace(r.StudentClass)
        || !string.IsNullOrWhiteSpace(r.Section) || !string.IsNullOrWhiteSpace(r.RollNumber);

    // Required fields: Name, Mobile, DOB, Gender. Email / Class / Section / Roll No are optional
    // — a row with just those four filled is submittable. Kept in sync with the server-side
    // AddAsync gate, so a row that reads "ready" on the client does actually save.
    private static bool IsRowReady(BulkRow r) =>
        !string.IsNullOrWhiteSpace(r.FullName)
        && !string.IsNullOrWhiteSpace(r.Phone)
        && r.DateOfBirth.HasValue
        && !string.IsNullOrWhiteSpace(r.Gender);

    private string RowStatusClass(BulkRow r)
    {
        if (!string.IsNullOrEmpty(r.Error)) return "err";
        if (IsRowReady(r)) return "ok";
        // Warn only when the writer has typed something or has tried saving — a fresh empty row is idle.
        if (saveRan || HasAnyInput(r)) return "warn";
        return "idle";
    }
    private string RowStatusText(BulkRow r) => RowStatusClass(r) switch
    {
        "ok" => "Ready to save",
        "warn" => "Missing required fields",
        "err" => r.Error ?? "Server rejected this row",
        _ => "Empty row"
    };
    private string RowStatusIcon(BulkRow r) => RowStatusClass(r) switch
    {
        "ok" => "✓", "warn" => "!", "err" => "✕", _ => "·"
    };

    // A field is drawn red only after the writer has engaged with the row (typed anything
    // or hit save). Otherwise every fresh row would light up entirely red. Only the four
    // mandatory fields can trigger a red state — Email / Class / Section / Roll No stay neutral.
    private bool RowFieldError(BulkRow r, string field)
    {
        if (!saveRan && !HasAnyInput(r)) return false;
        if (!string.IsNullOrEmpty(r.Error)) return false; // server errors are shown as a strip, not per-cell
        return field switch
        {
            nameof(BulkRow.FullName)    => string.IsNullOrWhiteSpace(r.FullName),
            nameof(BulkRow.Phone)       => string.IsNullOrWhiteSpace(r.Phone),
            nameof(BulkRow.DateOfBirth) => !r.DateOfBirth.HasValue,
            nameof(BulkRow.Gender)      => string.IsNullOrWhiteSpace(r.Gender),
            _ => false
        };
    }

    private async Task SaveBulk()
    {
        saveRan = true;
        // Ready-only rows are submitted; incomplete rows stay in the grid with their warn state.
        var payload = new BulkAddSchoolStudentRequest
        {
            Rows = bulkRows.Where(IsRowReady).Select(r => new AddSchoolStudentRequest
            {
                FullName = r.FullName!.Trim(),
                Email = r.Email!.Trim(),
                Phone = r.Phone!.Trim(),
                DateOfBirth = r.DateOfBirth,
                Gender = r.Gender,
                StudentClass = r.StudentClass,
                Section = r.Section,
                RollNumber = r.RollNumber
            }).ToList()
        };
        if (payload.Rows.Count == 0) return;

        saving = true;
        // Clear previous per-row server errors before this attempt.
        foreach (var r in bulkRows) r.Error = null;

        var result = await Students.AddManyAsync(actingUserId, payload);
        saving = false;

        // Map server results back to grid rows. Ready rows are indexed IN ORDER in the payload,
        // so a zip against the ready subset gives each grid row its outcome.
        var readySubset = bulkRows.Where(IsRowReady).ToList();
        for (int i = 0; i < result.Rows.Count && i < readySubset.Count; i++)
        {
            var rr = result.Rows[i];
            var target = readySubset[i];
            if (!rr.Ok) target.Error = rr.Error;
        }

        // Successful rows drop from the grid; failing rows stay so the writer can fix + retry.
        bulkRows = bulkRows.Where(r => !string.IsNullOrEmpty(r.Error) || !IsRowReady(r)).ToList();
        if (bulkRows.Count == 0) bulkRows.Add(NewRow());

        var savedTotal = result.Created + result.Linked;
        ok = result.Failed == 0;
        var parts = new List<string>();
        if (result.Created > 0) parts.Add($"{result.Created} added");
        if (result.Linked > 0)  parts.Add($"{result.Linked} linked to existing account{(result.Linked == 1 ? "" : "s")}");
        if (result.Failed > 0)  parts.Add($"{result.Failed} not saved (see the grid)");
        message = parts.Count > 0 ? string.Join(" · ", parts) : null;

        if (savedTotal > 0) await Reload();
        if (result.Failed == 0) addOpen = false;
    }

    private async Task Remove(SchoolStudentListItem r)
    {
        var (removed, err) = await Students.RemoveAsync(actingUserId, r.Id);
        ok = removed;
        message = removed ? $"{r.FullName} removed from your roll." : err;
        if (removed) await Reload();
    }

    private class BulkRow
    {
        public string? FullName { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
