@page "/school/coordinators"
@layout SchoolLayout
@using RioCommerce.Core.DTOs.School
@attribute [Authorize(Roles = "school_principal")]
@inject ISchoolRegistrationService RegSvc
@inject AuthenticationStateProvider AuthProvider

@* Principal-only screen. Coordinators added here get their own login (email/phone +
   password) and land on the same /school portal with the school_coordinator role.
   Wrapped by SchoolLayout, which supplies the portal sidebar and topbar. *@

<PageTitle>Coordinators — School Portal</PageTitle>

<div class="page__header">
    <h1>Coordinators</h1>
</div>

    @if (loading)
    {
        <p style="color:var(--gray-400);padding:30px 0">Loading…</p>
    }
    else
    {
        <div class="ss-bar">
            <div style="font-size:14px;color:var(--gray-500)">
                Coordinators help you manage students and enrollments. Each coordinator gets their own login.
            </div>
            <button class="btn btn-primary" @onclick="() => showForm = !showForm">
                @(showForm ? "Cancel" : "+ Add Coordinator")
            </button>
        </div>

        @if (message != null)
        {
            <div class="inline-alert @(ok ? "inline-alert--ok" : "inline-alert--err")" style="margin-bottom:14px">@message</div>
        }

        @if (showForm)
        {
            <div class="form-card" style="margin-bottom:20px">
                <div class="form-card__title">New Coordinator</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Coordinator Name <span class="required">*</span></label>
                        <input class="form-input" @bind="req.FullName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Mobile Number <span class="required">*</span></label>
                        <input class="form-input" @bind="req.Phone" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email ID <span class="required">*</span></label>
                        <input class="form-input" type="email" @bind="req.Email" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Standard <span class="required">*</span></label>
                        <select class="form-input" @bind="req.Standard">
                            <option value="">Select Standard</option>
                            <option value="All">All Classes</option>
                            @if (scope != null)
                            {
                                @for (var c = scope.LowestClass; c <= scope.HighestClass; c++)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Medium <span class="required">*</span></label>
                        <select class="form-input" @bind="req.Medium">
                            <option value="">Select Medium</option>
                            @if (scope != null)
                            {
                                @foreach (var m in scope.Mediums)
                                {
                                    <option value="@m">@m</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div style="font-size:12px;color:var(--gray-400);margin:-4px 0 12px">
                    A temporary password is generated and emailed to the coordinator. They can change it after first sign-in.
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" disabled="@saving" @onclick="Save">
                        @(saving ? "Saving..." : "Create Coordinator")
                    </button>
                    <button class="btn btn-ghost" @onclick="CancelForm">Cancel</button>
                </div>
            </div>
        }

        @if (rows.Count == 0)
        {
            <div class="ss-empty">
                <p>No coordinators yet.</p>
                <button class="btn btn-primary" @onclick="() => showForm = true">+ Add your first coordinator</button>
            </div>
        }
        else
        {
            <div class="ss-table-wrap">
                <table class="ss-table">
                    <thead>
                        <tr>
                            <th>Coordinator</th><th>Contact</th><th>Standard</th><th>Medium</th>
                            <th>Added</th><th>Status</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            @* data-label feeds the mobile card layout (erp-styles.css); the first
                               cell is the card title so it carries none. *@
                            <tr>
                                <td class="td-title"><div class="ss-name">@r.FullName</div></td>
                                <td data-label="Contact">
                                    <div class="ss-sub">@(r.Email ?? "—")</div>
                                    <div class="ss-sub">@(r.Phone ?? "—")</div>
                                </td>
                                <td data-label="Standard">@(string.IsNullOrWhiteSpace(r.Standard) ? "—" : r.Standard)</td>
                                <td data-label="Medium">@(string.IsNullOrWhiteSpace(r.Medium) ? "—" : r.Medium)</td>
                                <td data-label="Added"><div class="ss-sub">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div></td>
                                <td data-label="Status">
                                    <span class="ss-pill @(r.IsActive ? "ss-pill--ok" : "ss-pill--wait")">
                                        @(r.IsActive ? "Active" : "Disabled")
                                    </span>
                                </td>
                                <td class="td-action">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => Toggle(r.UserId)">
                                        @(r.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

<style>
    /* Seven columns need roughly this much room before the cells start clipping. The wrapper's
       scroll behaviour comes from erp-styles.css (.admin-layout .ss-table-wrap) so it is shared
       with /school/students rather than copied; only this page's own width lives here, because
       the two tables have different column counts. */
    .ss-table { min-width: 700px; }
    .ss-table th { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--gray-200);
        color: var(--gray-500); text-transform: uppercase; letter-spacing: .5px; white-space: nowrap }
    .ss-table td { padding: 12px 14px; border-bottom: 1px solid var(--gray-100); font-size: 14px;
        vertical-align: top }
    .ss-table tbody tr:last-child td { border-bottom: none }
    .ss-name { font-weight: 600; color: var(--vp-ink) }
    .ss-sub { font-size: 12.5px; color: var(--gray-500) }
    .ss-pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-weight: 700; white-space: nowrap }
    .ss-pill--ok { background: #e8f5e9; color: #2e7d32 }
    .ss-pill--wait { background: #fff4e5; color: #b45309 }
</style>

@code {
    private bool loading = true, saving, showForm, ok;
    private string? message;
    private Guid principalUserId;
    private List<SchoolCoordinatorListItem> rows = new();
    private SchoolCoordinatorCreateRequest req = new();
    private SchoolCoordinatorScope? scope;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (uid != null && Guid.TryParse(uid, out var id))
        {
            principalUserId = id;
            scope = await RegSvc.GetCoordinatorScopeAsync(principalUserId);
            await Load();
        }
        loading = false;
    }

    private async Task Load() => rows = await RegSvc.ListCoordinatorsAsync(principalUserId);

    private async Task Save()
    {
        message = null; saving = true;
        var (success, error) = await RegSvc.AddCoordinatorAsync(principalUserId, req);
        saving = false;
        if (success)
        {
            ok = true; message = "Coordinator added. Login details have been emailed.";
            req = new();
            showForm = false;
            await Load();
        }
        else { ok = false; message = error; }
    }

    private void CancelForm()
    {
        showForm = false;
        req = new();
        message = null;
    }

    private async Task Toggle(Guid coordinatorUserId)
    {
        var (success, error) = await RegSvc.ToggleCoordinatorAsync(principalUserId, coordinatorUserId);
        if (success) { ok = true; message = "Coordinator updated."; await Load(); }
        else { ok = false; message = error; }
    }
}
