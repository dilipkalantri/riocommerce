@page "/school/enrollment"
@layout SchoolLayout
@using RioCommerce.Core.DTOs.School
@* Principals and coordinators both reach this page. Their views are DIFFERENT: a coordinator's
   roster is filtered server-side to the students they themselves added — a principal sees the
   whole school. Both the page-side query (ISchoolStudentService.ListAsync via the scope helper)
   and the placement side (SchoolEnrollmentService.PlaceAsync's ownership check) enforce that;
   the [Authorize] here is only the route-level admittance. *@
@attribute [Authorize(Roles = "school_principal,school_coordinator")]
@inject ISchoolStudentService Students
@inject ISchoolEnrollmentService Enrollment
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

@* Fills the /school/enrollment route. Wrapped by SchoolLayout, which supplies the
   portal sidebar and topbar so this file only owns page content.
   The course list and every price come from ISchoolEnrollmentService, which projects
   the live Products table — nothing in this file names a course or an amount. *@

<PageTitle>Enroll Students — School Portal</PageTitle>

<div class="page__header">
    <h1>Enroll Students</h1>
</div>

    @if (loading)
    {
        <div class="se-skeleton" aria-live="polite" aria-busy="true">
            <span class="se-skeleton__bar"></span>
            <span class="se-skeleton__bar se-skeleton__bar--short"></span>
            <p class="se-skeleton__text">Loading courses…</p>
        </div>
    }
    else if (schoolId is null)
    {
        <p class="se-note">Your account is not linked to a school.</p>
    }
    else
    {
        @* ── Summary cards ─────────────────────────────────────────────── *@
        <div class="se-stats">
            <div class="se-stat">
                <span class="se-stat__ico se-stat__ico--purple" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <span class="se-stat__value">@roster.Count</span>
                <span class="se-stat__label">Students Added</span>
            </div>
            <div class="se-stat">
                <span class="se-stat__ico se-stat__ico--green" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                </span>
                <span class="se-stat__value">@SelectedCount</span>
                <span class="se-stat__label">Confirmed</span>
            </div>
            <div class="se-stat">
                <span class="se-stat__ico se-stat__ico--orange" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </span>
                <span class="se-stat__value se-stat__value--text" title="@(Chosen?.Title ?? "")">@(Chosen?.Title ?? "—")</span>
                <span class="se-stat__label">Course</span>
            </div>
            <div class="se-stat">
                <span class="se-stat__ico se-stat__ico--rose" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12"/><path d="M6 8h12"/><path d="m6 13 8.5 8"/><path d="M6 13h3a4.5 4.5 0 1 0 0-9"/></svg>
                </span>
                <span class="se-stat__value">@Money.Inr0(TotalPayable)</span>
                <span class="se-stat__label">Total Payable</span>
            </div>
        </div>

        @if (submitted is not null)
        {
            <div class="se-success" role="status">
                <span class="se-success__ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                </span>
                <div>
                    <h2 class="se-success__title">Enrollment submitted successfully.</h2>
                    <p class="se-success__line">
                        Order <strong>#@submitted.OrderNumber</strong> ·
                        @submitted.StudentCount student@(submitted.StudentCount == 1 ? "" : "s") ·
                        @Money.Inr0(submitted.Total)
                    </p>
                    <p class="se-success__line">
                        Payment status: <span class="se-pill se-pill--wait">Pending</span>
                        Our team will process the payment separately.
                    </p>
                    <button class="btn btn-primary" @onclick="StartAnother">Enroll more students</button>
                </div>
            </div>
        }
        else
        {
            <section class="se-panel">
                <h2 class="se-panel__title">Enroll Students</h2>

                @* ── Course picker ──────────────────────────────────────── *@
                @if (loadError)
                {
                    <p class="se-alert se-alert--err">Unable to load enrollment products. Please try again.</p>
                    <button class="btn btn-outline" @onclick="ReloadProducts">Retry</button>
                }
                else if (products.Count == 0)
                {
                    <p class="se-alert">No enrollment products are currently available.</p>
                }
                else
                {
                    @* ── Course picker ─────────────────────────────────────────────────────────
                       A CUSTOM dropdown, not a native select element. The course titles run to about 70
                       characters ("7th Scholarship Exam –Online classes I English Medium I Self
                       registration (₹200)"), and a native popup sizes itself to the longest option
                       on ONE line — so it painted far outside the phone viewport with no way to
                       constrain it, because the popup is drawn by the browser, not the page.

                       This panel is ordinary DOM, so it obeys max-width and wraps. Behaviour and
                       binding are unchanged: it writes the same `productId` string and calls the
                       same OnCourseChanged path, so pricing, validation and submission are
                       untouched. *@
                    <div class="se-field">
                        <span class="form-label" id="se-course-label">Select Course *</span>
                        <div class="se-select @(courseOpen ? "se-select--open" : "")">
                            @if (courseOpen)
                            {
                                @* Full-screen catcher: a tap anywhere else closes the panel. Sits
                                   BELOW the panel so option clicks still land on the option. *@
                                <div class="se-select__backdrop" @onclick="CloseCourse"></div>
                            }
                            <button type="button" id="se-course" class="se-select__input"
                                    @onclick="ToggleCourse" @onkeydown="OnCourseKeyDown"
                                    aria-haspopup="listbox" aria-expanded="@courseOpen"
                                    aria-labelledby="se-course-label">
                                <span class="se-select__ico" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                                </span>
                                <span class="se-select__text @(Chosen is null ? "se-select__text--ph" : "")">
                                    @(Chosen is null ? "Choose a course…" : $"{Chosen.Title} ({Money.Inr0(Chosen.Price)})")
                                </span>
                                <span class="se-select__chev" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                </span>
                            </button>

                            @if (courseOpen)
                            {
                                <div class="se-select__panel" role="listbox" aria-labelledby="se-course-label">
                                    <button type="button" role="option" aria-selected="@(Chosen is null)"
                                            class="se-opt @(Chosen is null ? "se-opt--on" : "")"
                                            @onclick="() => PickCourse(null)">
                                        Choose a course…
                                    </button>
                                    @foreach (var p in products)
                                    {
                                        var prod = p;
                                        <button type="button" role="option" aria-selected="@(Chosen?.Id == prod.Id)"
                                                class="se-opt @(Chosen?.Id == prod.Id ? "se-opt--on" : "")"
                                                @onclick="() => PickCourse(prod.Id)">
                                            <span class="se-opt__name">@prod.Title</span>
                                            <span class="se-opt__price">@Money.Inr0(prod.Price)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (Chosen is not null)
                    {
                        <div class="se-chosen">
                            <span class="se-chosen__label">Selected Course</span>
                            <span class="se-chosen__name">@Chosen.Title</span>
                            <span class="se-chosen__price">@Money.Inr0(Chosen.Price) / student</span>
                        </div>
                    }
                }

                @* ── Roster ─────────────────────────────────────────────── *@
                <div class="se-sub">
                    <h3 class="se-sub__title">Select Students</h3>
                    <a class="btn btn-outline se-sub__add" href="/school/students">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
                        Add student
                    </a>
                </div>

                @* Paid students are gone from this list: `Pending` excludes anyone the school has
                   already paid for, and that verdict comes from the persisted Order status — so a
                   student drops out the moment their payment settles, with no manual refresh. *@
                @if (roster.Count == 0)
                {
                    <div class="se-empty">
                        <p>No students on your roll yet.</p>
                        <a class="btn btn-primary" href="/school/students">Add your first student</a>
                    </div>
                }
                else if (Pending.Count == 0)
                {
                    <div class="se-empty">
                        <p>Every student on your roll has already been paid for.</p>
                        <a class="btn btn-outline" href="/school/billing">View payments &amp; invoices</a>
                    </div>
                }
                else
                {
                    <div class="se-table-wrap">
                        <table class="se-table">
                            <thead>
                                <tr>
                                    <th class="se-table__check">
                                        <input type="checkbox" aria-label="Select all students"
                                               checked="@AllSelected" @onchange="ToggleAll" />
                                    </th>
                                    <th class="se-table__num">#</th>
                                    <th>Student Name</th>
                                    <th>Class</th>
                                    <th>Division</th>
                                    <th>Roll No.</th>
                                    <th>Mobile Number</th>
                                    <th>Course</th>
                                    <th>Price</th>
                                    <th>Payment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var n = 0; }
                                @foreach (var r in Pending)
                                {
                                    var isOn = selected.Contains(r.UserId);
                                    n++;
                                    @* data-label feeds the mobile card layout below. The checkbox,
                                       row number and name form the card's header and carry none. *@
                                    <tr class="@(isOn ? "is-on" : null)">
                                        <td class="se-table__check">
                                            <input type="checkbox" checked="@isOn"
                                                   aria-label="@("Select " + r.FullName)"
                                                   @onchange="e => Toggle(r.UserId, e)" />
                                        </td>
                                        <td class="se-table__num">@n</td>
                                        <td class="se-name">@r.FullName</td>
                                        <td data-label="Class">@(string.IsNullOrWhiteSpace(r.StudentClass) ? "—" : r.StudentClass)</td>
                                        <td data-label="Division">@(string.IsNullOrWhiteSpace(r.Section) ? "—" : r.Section)</td>
                                        <td data-label="Roll No.">@(string.IsNullOrWhiteSpace(r.RollNumber) ? "—" : r.RollNumber)</td>
                                        <td data-label="Mobile Number">@(string.IsNullOrWhiteSpace(r.Phone) ? "—" : r.Phone)</td>
                                        <td data-label="Course">@(Chosen?.Title ?? "—")</td>
                                        <td data-label="Price">@(Chosen is null ? "—" : Money.Inr0(Chosen.Price))</td>
                                        <td data-label="Payment">
                                            @* Failed attempts stay selectable — they still owe — but are
                                               labelled honestly rather than shown as merely pending. *@
                                            @if (payStatus.TryGetValue(r.UserId, out var ps) && ps.IsFailed)
                                            {
                                                <span class="se-pill se-pill--fail">Failed</span>
                                            }
                                            else
                                            {
                                                <span class="se-pill se-pill--wait">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (error != null)
                {
                    <p class="se-alert se-alert--err" role="alert">@error</p>
                }

                @* ── Total + submit ─────────────────────────────────────── *@
                <div class="se-foot">
                    <div class="se-total">
                        <div class="se-total__row"><span>Fee per student</span><span>@(Chosen is null ? "—" : Money.Inr0(Chosen.Price))</span></div>
                        <div class="se-total__row"><span>Students selected</span><span>@SelectedCount</span></div>
                        <div class="se-total__row se-total__row--sum"><span>Total Payable</span><span>@Money.Inr0(TotalPayable)</span></div>
                        <p class="se-total__hint">You will be redirected to secure payment after submitting the enrollment.</p>
                    </div>
                    <button class="btn btn-primary se-submit" disabled="@(!CanSubmit || saving)" @onclick="Submit">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="m9 14 2 2 4-4"/></svg>
                        @(saving ? "Opening secure payment…" : "Proceed to Payment")
                    </button>
                </div>
            </section>
        }
    }

<style>
    .se-note{color:var(--gray-400);padding:30px 0}

    .se-skeleton{padding:26px 0}
    .se-skeleton__bar{display:block;height:14px;border-radius:8px;margin-bottom:10px;max-width:420px;
        background:linear-gradient(90deg,var(--gray-100),var(--gray-200),var(--gray-100));
        background-size:200% 100%;animation:se-shim 1.3s linear infinite}
    .se-skeleton__bar--short{max-width:240px}
    .se-skeleton__text{color:var(--gray-500);font-size:13.5px;margin:12px 0 0}
    @@keyframes se-shim{0%{background-position:200% 0}100%{background-position:-200% 0}}

    /* ── summary cards: 4 → 2×2 → 2/1 ── */
    .se-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0 22px}
    .se-stat{display:flex;flex-direction:column;gap:2px;padding:18px;border:1px solid var(--gray-200);
        border-radius:16px;background:#fff;min-width:0}
    .se-stat__ico{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;margin-bottom:8px}
    .se-stat__ico--purple{background:#efeaff;color:#5d38de}
    .se-stat__ico--green{background:#e8f5e9;color:#2e7d32}
    .se-stat__ico--orange{background:#fff3e0;color:#e65100}
    .se-stat__ico--rose{background:#fce4ec;color:#c62828}
    .se-stat__value{font-size:26px;font-weight:600;color:var(--vp-ink);line-height:1.15}
    .se-stat__value--text{font-size:15px;font-weight:600;line-height:1.35;
        display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .se-stat__label{font-size:13px;color:var(--gray-500)}

    .se-panel{border:1px solid var(--gray-200);border-radius:18px;background:#fff;padding:24px}
    .se-panel__title{margin:0 0 18px;font-size:22px;font-weight:600;color:var(--vp-ink)}

    .se-field{max-width:520px;margin-bottom:14px}
    .se-select{position:relative;display:flex;align-items:center}
    .se-select__ico{position:absolute;left:13px;color:#5d38de;display:grid;place-items:center;pointer-events:none}
    .se-select__chev{position:absolute;right:13px;color:var(--gray-500);display:grid;place-items:center;pointer-events:none}
    .se-select__input{width:100%;height:48px;padding:0 42px 0 42px;border:1px solid var(--gray-200);
        border-radius:12px;background:#fff;font-family:var(--font-primary);font-size:14.5px;color:var(--vp-ink);
        appearance:none;-webkit-appearance:none;cursor:pointer;transition:border-color .2s,box-shadow .2s;
        display:flex;align-items:center;text-align:left}
    .se-select__input:hover{border-color:#c9bef4}
    .se-select__input:focus,.se-select__input:focus-visible{outline:none;border-color:#5d38de;
        box-shadow:0 0 0 3px rgba(93,56,222,.16)}
    /* The closed control shows one line and ellipsises — the full title is always visible in the
       open panel and in the "Selected Course" strip below, so nothing is lost. */
    .se-select__text{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .se-select__text--ph{color:var(--gray-500)}
    .se-select--open .se-select__input{border-color:#5d38de;box-shadow:0 0 0 3px rgba(93,56,222,.16)}
    .se-select--open .se-select__chev{transform:rotate(180deg)}
    .se-select__chev{transition:transform .18s}

    /* THE FIX. A native select element's popup is drawn by the BROWSER, sized to the longest
       option on one line, and cannot be constrained by CSS — which is why 70-character course
       titles spilled far outside the phone screen. This panel is ordinary DOM: bounded by the
       field, never wider than the viewport, and long titles WRAP instead of forcing width.
       (Razor parses this style block as markup, so an angle-bracketed tag name cannot appear
       even inside a CSS comment — it is read as a real unclosed element.) */
    .se-select__backdrop{position:fixed;inset:0;z-index:40}
    .se-select__panel{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:41;
        width:100%;max-width:min(100%,calc(100vw - 24px));
        max-height:min(52vh,340px);overflow-y:auto;overscroll-behavior:contain;
        background:#fff;border:1px solid var(--gray-200);border-radius:14px;
        box-shadow:0 22px 44px -18px rgba(15,23,42,.4)}
    .se-opt{display:flex;flex-direction:column;gap:2px;width:100%;padding:11px 14px;border:0;
        background:none;font:inherit;font-size:14px;color:var(--vp-ink);text-align:left;cursor:pointer;
        border-bottom:1px solid var(--gray-100)}
    .se-opt:last-child{border-bottom:0}
    .se-opt:hover{background:#f6f2ff}
    .se-opt--on{background:#efeaff}
    .se-opt__name{line-height:1.35;overflow-wrap:anywhere}
    .se-opt__price{font-size:13px;font-weight:700;color:#e0441f}

    .se-chosen{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;max-width:520px;
        padding:14px 16px;border-radius:14px;border:1px solid #ded4fb;
        background:linear-gradient(135deg,#f6f2ff,#fff7f4)}
    .se-chosen__label{flex:0 0 100%;font-size:11.5px;font-weight:700;letter-spacing:.7px;
        text-transform:uppercase;color:#6b5bb5}
    .se-chosen__name{font-size:15px;font-weight:600;color:var(--vp-ink)}
    .se-chosen__price{font-size:14px;font-weight:600;color:#e0441f}

    .se-sub{display:flex;align-items:center;justify-content:space-between;gap:12px;
        flex-wrap:wrap;margin:26px 0 12px}
    .se-sub__title{margin:0;font-size:17px;font-weight:600;color:var(--vp-ink)}
    .se-sub__add{display:inline-flex;align-items:center;gap:7px}

    .se-table-wrap{overflow-x:auto;border:1px solid var(--gray-200);border-radius:14px;background:#fff}
    .se-table{width:100%;border-collapse:collapse;min-width:760px}
    .se-table th{text-align:left;font-size:11.5px;letter-spacing:.6px;text-transform:uppercase;
        color:var(--gray-500);padding:13px 14px;border-bottom:1px solid var(--gray-200);
        white-space:nowrap;background:var(--gray-50,#fafafa)}
    .se-table td{padding:13px 14px;border-bottom:1px solid var(--gray-100);font-size:14px}
    .se-table tbody tr:last-child td{border-bottom:none}
    .se-table tbody tr:hover{background:#faf8ff}
    .se-table tbody tr.is-on{background:#f6f2ff}
    .se-table__check{width:44px}
    .se-table__num{width:52px;color:var(--gray-500)}
    .se-name{font-weight:600;color:var(--vp-ink)}

    .se-empty{padding:40px 20px;text-align:center;border:1px dashed var(--gray-200);
        border-radius:14px;background:#fff}
    .se-empty p{color:var(--gray-500);margin-bottom:14px}

    .se-alert{margin:14px 0 0;padding:12px 14px;border-radius:12px;font-size:13.5px;
        background:var(--gray-100);color:var(--gray-600,#555)}
    .se-alert--err{background:#fdecea;color:#b3261e}

    .se-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;
        flex-wrap:wrap;margin-top:22px}
    .se-total{min-width:260px;flex:1 1 260px;max-width:360px;padding:16px 18px;border-radius:14px;
        border:1px solid var(--gray-200);background:var(--gray-50,#fafafa)}
    .se-total__row{display:flex;justify-content:space-between;gap:14px;font-size:14px;
        color:var(--gray-600,#555);padding:5px 0}
    .se-total__row--sum{border-top:1px solid var(--gray-200);margin-top:6px;padding-top:11px;
        font-size:17px;font-weight:700;color:var(--vp-ink)}
    .se-total__hint{margin:10px 0 0;font-size:12px;line-height:1.55;color:var(--gray-500)}
    .se-submit{display:inline-flex;align-items:center;gap:9px;height:48px;padding:0 26px}
    .se-submit:disabled{opacity:.55;cursor:not-allowed}

    .se-success{display:flex;gap:16px;align-items:flex-start;padding:24px;border-radius:18px;
        border:1px solid #cfe9d4;background:#f4fbf5}
    .se-success__ico{flex:none;width:44px;height:44px;border-radius:13px;display:grid;place-items:center;
        background:#e0f2e2;color:#2e7d32}
    .se-success__title{margin:0 0 8px;font-size:20px;font-weight:600;color:var(--vp-ink)}
    .se-success__line{margin:0 0 8px;font-size:14px;color:var(--gray-600,#555);line-height:1.6}
    .se-pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11.5px;font-weight:700;
        margin-right:6px}
    .se-pill--wait{background:#fff4e5;color:#b45309}

    /* icons keep a fixed size: responsive-normalize.css clamps bare svgs globally */
    .se-select .se-select__ico svg:not([width]):not([data-large]):not(.svg-noclamp),
    .se-select .se-select__chev svg:not([width]):not([data-large]):not(.svg-noclamp){width:18px;height:18px}
    .se-stats .se-stat .se-stat__ico svg:not([width]):not([data-large]):not(.svg-noclamp){width:19px;height:19px}
    .se-foot .se-submit svg:not([width]):not([data-large]):not(.svg-noclamp),
    .se-sub .se-sub__add svg:not([width]):not([data-large]):not(.svg-noclamp){width:17px;height:17px;flex:none}
    .se-success .se-success__ico svg:not([width]):not([data-large]):not(.svg-noclamp){width:22px;height:22px}

    .se-pill--fail{background:#FEE2E2;color:#991B1B}

    /* ══ RESPONSIVE ═══════════════════════════════════════════════════════════════════════════
       Every selector below is .se-* prefixed, so this block is effectively scoped to this page:
       it cannot reach the admin shell, the other school pages, or the public site.
       Breakpoints: 1024 (tablet) · 768 (phone) · 560 (stack the footer) · 420 · 340. */

    @@media (max-width:1024px){
        .se-stats{grid-template-columns:repeat(2,minmax(0,1fr))}
    }

    /* ── Phone: compact everything ────────────────────────────────────────────────────────────
       The four summary cards were ~180px tall each and, below 400px, stacked one per row — so
       the four of them pushed the actual enrolment form more than a full screen down. They are
       now a 2×2 grid of ~120px cards, which keeps the form reachable without scrolling. */
    @@media (max-width:768px){
        .se-stats{gap:12px;margin:14px 0 18px}
        .se-stat{padding:16px;border-radius:16px}
        .se-stat__ico{width:34px;height:34px;border-radius:10px;margin-bottom:8px}
        .se-stats .se-stat .se-stat__ico svg:not([width]):not([data-large]):not(.svg-noclamp){width:17px;height:17px}
        .se-stat__value{font-size:22px}
        .se-stat__value--text{font-size:13.5px;line-height:1.3}
        .se-stat__label{font-size:12.5px;line-height:1.3}

        .se-panel{padding:18px;border-radius:18px}
        .se-panel__title{font-size:20px;margin-bottom:14px}

        /* 50px clears the 44px touch floor and matches the field height used elsewhere. */
        .se-select__input{height:50px;font-size:15px}
        .se-field{max-width:none;margin-bottom:16px}
        .se-chosen{max-width:none}

        /* ── Student picker becomes cards ─────────────────────────────────────────────────────
           Ten columns in a 760px table meant swiping to see one student's class, division, roll
           number and mobile — while the tick box that actually matters sat off to the left. Each
           student is now a card: tick box, number and name across the top, details beneath.
           No horizontal scrolling, no hidden columns. */
        .se-table-wrap{max-width:100%;overflow-x:visible;border:0;background:transparent}
        .se-table,.se-table tbody,.se-table tr,.se-table td{display:block;width:auto}
        .se-table{min-width:0}
        .se-table thead{display:none}

        .se-table tbody tr{position:relative;margin:0 0 12px;padding:52px 14px 12px;
            border:1px solid var(--gray-200);border-radius:14px;background:#fff}
        .se-table tbody tr:last-child{margin-bottom:0}
        .se-table tbody tr.is-on{background:#f8f5ff;border-color:#c9bef4}

        /* Card header: tick box, number, name. */
        .se-table td.se-table__check{position:absolute;top:13px;left:12px;width:auto;padding:0;border:0}
        .se-table td.se-table__check input[type=checkbox]{width:22px;height:22px}
        .se-table td.se-table__num{position:absolute;top:16px;left:46px;width:auto;padding:0;border:0;
            font-size:13px;font-weight:700;color:var(--gray-500)}
        .se-table td.se-name{position:absolute;top:14px;left:72px;right:14px;padding:0;border:0;
            font-size:15px;font-weight:600;overflow-wrap:anywhere}

        /* Detail lines: caption left, value right. */
        .se-table tbody td[data-label]{display:flex;align-items:flex-start;justify-content:space-between;
            gap:14px;padding:6px 0;border:0;font-size:13.5px;white-space:normal;overflow-wrap:anywhere}
        .se-table tbody td[data-label]::before{content:attr(data-label);flex:0 0 40%;
            font-size:12px;font-weight:700;color:var(--gray-500)}
        .se-table tbody tr td[data-label]:first-of-type{border-top:1px solid var(--gray-100);padding-top:10px}

        .se-total{padding:18px;border-radius:16px}
        .se-total__row{font-size:14px}
        .se-total__row--sum{font-size:20px}
        .se-total__hint{font-size:12.5px}
    }

    @@media (max-width:560px){
        .se-foot{flex-direction:column;align-items:stretch;gap:14px}
        .se-total{max-width:none;min-width:0}
        .se-submit{width:100%;justify-content:center;height:50px}
    }

    /* ── Narrow: give "Add student" its own line rather than squeezing the heading ── */
    @@media (max-width:420px){
        .se-sub{flex-direction:column;align-items:stretch;gap:10px;margin:20px 0 12px}
        .se-sub__add{width:100%;justify-content:center;min-height:44px}
        .se-panel{padding:16px}
    }

    /* ── Very narrow: two cards per row finally become too cramped to read. ── */
    @@media (max-width:340px){
        .se-stats{grid-template-columns:minmax(0,1fr)}
    }
</style>

@code {
    private bool loading = true, saving, loadError;
    private Guid actingUserId;
    private Guid? schoolId;
    private string? error;

    private string productId = "";
    private List<SchoolEnrollmentProduct> products = new();
    /// <summary>Every student on the school roll (principal- and coordinator-added alike).</summary>
    private List<SchoolStudentListItem> roster = new();

    /// <summary>School-paid status per student, from persisted orders. Absent = never enrolled.</summary>
    private Dictionary<Guid, SchoolStudentPaymentStatus> payStatus = new();

    /// <summary>
    /// The selectable list: students the school has NOT already paid for. A pupil whose school
    /// payment succeeded drops out here automatically once the order settles — the status comes
    /// from the Order row, so nothing has to be refreshed by hand. Failed and pending attempts
    /// stay, because they still owe.
    /// </summary>
    private List<SchoolStudentListItem> Pending =>
        roster.Where(s => !(payStatus.TryGetValue(s.UserId, out var p) && p.IsPaid)).ToList();
    private readonly HashSet<Guid> selected = new();
    private PlaceSchoolEnrollmentResult? submitted;

    private SchoolEnrollmentProduct? Chosen =>
        Guid.TryParse(productId, out var id) ? products.FirstOrDefault(p => p.Id == id) : null;

    /// <summary>
    /// THE single source of truth for "how many, and which, students are actually being billed".
    ///
    /// `selected` records every id a checkbox has ever ticked, but the only ids that may count are
    /// ones currently on THIS list — <see cref="Pending"/>. Without that intersection, a ticked id
    /// that stops being Pending (their payment settles, or the roster reloads after an interrupted
    /// submit) stays in `selected` forever with nothing to remove it, and everything downstream —
    /// the displayed count, Total Payable, and the ids actually sent to the server — silently drifts
    /// away from what the table shows checked. That mismatch, not a duplicate id, is what produced
    /// "2 rows checked" next to "Students selected: 4" in the screenshot this fixes: the school's
    /// roster held 4 students, 2 of them already paid and hidden from the table, and "Select All"
    /// (see below) had ticked all 4 — `selected.Count` doesn't know two of them are no longer
    /// choices at all.
    ///
    /// Every reader — the two "selected" stats, TotalPayable, AllSelected, CanSubmit, and the ids
    /// Submit() posts to PlaceAsync — goes through this ONE property, computed fresh each time. That
    /// is what guarantees the four can never again disagree with each other, regardless of how
    /// `selected` got into whatever state it is in.
    /// </summary>
    private List<Guid> SelectedIds
    {
        get
        {
            var pendingIds = new HashSet<Guid>(Pending.Select(p => p.UserId));
            return selected.Where(pendingIds.Contains).ToList();
        }
    }

    private int SelectedCount => SelectedIds.Count;

    // Total Payable = selected course's catalogue price × students actually billable. Never a literal.
    private decimal TotalPayable => (Chosen?.Price ?? 0m) * SelectedCount;

    private bool AllSelected => Pending.Count > 0 && SelectedCount == Pending.Count;
    private bool CanSubmit => !saving && Chosen is not null && SelectedCount > 0;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (uid != null && Guid.TryParse(uid, out var parsed))
        {
            actingUserId = parsed;
            // The school is resolved from the signed-in user, never from the URL or a form field.
            schoolId = await Students.ResolveSchoolIdAsync(actingUserId);
            if (schoolId is not null)
            {
                roster = await Students.ListAsync(actingUserId);
                // Without this the paid-student filter has nothing to filter ON, so students the
                // school has already paid for stay selectable and could be charged twice.
                payStatus = await Enrollment.GetStudentPaymentStatusesAsync(actingUserId);
                PruneSelection();   // no-op here (selected starts empty) — see the reload path below
                await LoadProductsAsync();
            }
        }
        loading = false;
    }

    private async Task LoadProductsAsync()
    {
        loadError = false;
        try { products = await Enrollment.ListProductsAsync(actingUserId); }
        catch { products = new(); loadError = true; }   // the reason stays server-side
    }

    private async Task ReloadProducts() => await LoadProductsAsync();

    /// <summary>Open state of the custom course dropdown. Presentation only.</summary>
    private bool courseOpen;

    private void ToggleCourse() => courseOpen = !courseOpen;
    private void CloseCourse() => courseOpen = false;

    /// <summary>
    /// Picks a course. Writes exactly what the old &lt;select&gt; wrote — the product id as a
    /// string, or "" for none — so every downstream rule (Chosen, TotalPayable, CanSubmit,
    /// Submit) behaves identically. Nothing here decides a price.
    /// </summary>
    private void PickCourse(Guid? id)
    {
        productId = id?.ToString() ?? "";
        error = null;
        courseOpen = false;
    }

    /// <summary>Keyboard parity with the native control it replaced.</summary>
    private void OnCourseKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                courseOpen = false;
                break;
            case "Enter":
            case " ":
            case "ArrowDown":
                courseOpen = true;
                break;
        }
    }

    private void Toggle(Guid userId, ChangeEventArgs e)
    {
        if (e.Value is bool on && on) selected.Add(userId);
        else selected.Remove(userId);
        error = null;
    }

    /// <summary>
    /// THE root cause of the reported bug: this used to add every id in <c>roster</c> — the whole
    /// school roll, including students already paid for and therefore not in <see cref="Pending"/>
    /// — while the table only ever renders and ticks <c>Pending</c> rows. A roster of 4 with 2
    /// already paid meant Select All added 4 ids to `selected` while only 2 checkboxes existed to
    /// show it, so "Students selected" read 4 against 2 visibly ticked rows.
    ///
    /// It now adds exactly the ids the checkboxes on screen represent — nothing more — so "select
    /// every currently visible/available student exactly once" is enforced by the source, not by a
    /// display-side correction. Ticking All twice cannot grow the count either: `selected` is a
    /// HashSet, and Clear()-then-add from the same Pending list lands on the same ids both times.
    /// </summary>
    private void ToggleAll(ChangeEventArgs e)
    {
        selected.Clear();
        if (e.Value is bool on && on)
            foreach (var r in Pending) selected.Add(r.UserId);
        error = null;
    }

    /// <summary>
    /// Drops any id from `selected` that is no longer in <see cref="Pending"/> — called whenever
    /// <see cref="roster"/> or <see cref="payStatus"/> is reloaded. <see cref="SelectedIds"/> already
    /// filters these out for every display and for Submit(), so nothing is ever shown or billed
    /// incorrectly even without this; this exists so the raw `selected` set itself stays honest
    /// rather than quietly accumulating ids for students who are no longer choices.
    /// </summary>
    private void PruneSelection()
    {
        var pendingIds = new HashSet<Guid>(Pending.Select(p => p.UserId));
        selected.RemoveWhere(id => !pendingIds.Contains(id));
    }

    private void StartAnother()
    {
        submitted = null;
        selected.Clear();
        productId = "";
        error = null;
    }

    /// <summary>Client-side result routes for the shared Razorpay helper, so a dismissed or failed
    /// popup returns to the School portal. Success is routed by the server's verify response.</summary>
    private static readonly object SchoolPaymentRoutes = new
    {
        cancelled = "/school/enrollment/payment-cancelled",
        failed = "/school/enrollment/payment-failed",
    };

    private async Task Submit()
    {
        if (!CanSubmit) return;              // guards a double-click before the disable lands
        saving = true; error = null;

        // SelectedIds, not `selected` — the same currently-billable set the UI displayed and priced,
        // so what gets submitted can never diverge from what the principal was shown before pressing
        // this button. The service also de-duplicates independently (SchoolEnrollmentService.cs),
        // so a tampered or replayed request is safe regardless of what this page sends.
        var res = await Enrollment.PlaceAsync(actingUserId, new PlaceSchoolEnrollmentRequest
        {
            ProductId = Chosen!.Id,
            StudentUserIds = SelectedIds,
        });

        if (!res.Ok)
        {
            saving = false;
            // Selections are deliberately left intact so nothing has to be re-entered.
            error = res.Error ?? "We could not submit this enrollment. Please try again.";
            return;
        }

        // ── Hand the PENDING order to the existing Razorpay flow ─────────────────────────────
        // rc.retryRazorpay is the same helper the storefront uses to pay an already-created order:
        // it calls /api/payments/razorpay/retry-order, opens the Razorpay popup, and POSTs the
        // result to /api/payments/razorpay/verify. Every state change — PaymentStatus=Success,
        // OrderStatus=Confirmed, enrolments, invoices — happens server-side inside
        // ConfirmPaymentAsync behind signature verification. Nothing here decides payment succeeded,
        // and the browser only follows the redirectUrl the server returns.
        //
        // The order is already persisted at this point, so a closed popup or a dropped browser
        // leaves a recoverable pending order rather than losing the enrolment. `saving` stays true
        // until the redirect so the button cannot be clicked twice; the roster's unique
        // (OrderId, StudentUserId) index is the server-side backstop.
        try
        {
            // Third argument keeps a dismissed/failed popup inside the School portal. Storefront
            // callers omit it and keep the /checkout/* pages unchanged.
            await JS.InvokeVoidAsync("rc.retryRazorpay", res.OrderNumber, null, SchoolPaymentRoutes);
        }
        catch (Exception)
        {
            saving = false;
            submitted = res;   // order exists — show it so the principal can retry payment
            error = "Your enrolment was saved but the payment window could not be opened. "
                  + "Open it again from your orders, or try once more.";
            roster = await Students.ListAsync(actingUserId);
            payStatus = await Enrollment.GetStudentPaymentStatusesAsync(actingUserId);
            // This is the real reload-safety case: the students just submitted are now mid-payment
            // and have dropped out of Pending, but `selected` still holds their ids from before the
            // click. SelectedIds would already filter them out for display, but pruning the
            // underlying set too means a stale id is never sitting there waiting to resurface.
            PruneSelection();
        }
    }
}



