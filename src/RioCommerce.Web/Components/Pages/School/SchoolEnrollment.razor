        .se-foot{flex-direction:column;align-items:stretch}
        .se-total{max-width:none}
        .se-submit{width:100%;justify-content:center}
        .se-field{max-width:none}
        .se-chosen{max-width:none}
    }
    @@media (max-width:400px){
        .se-stats{grid-template-columns:minmax(0,1fr)}
    }
    .se-pill--fail{background:#FEE2E2;color:#991B1B}
</style>

@code {
    private bool loading = true, saving, loadError;
    private Guid actingUserId;
    private Guid? schoolId;
    private string? error;

    private string productId = "";
    private List<SchoolEnrollmentProduct> products = new();
    /// <summary>Every student on the school roll (principal- and coordinator-added alike).</summary>
    private List<SchoolStudentListItem> roster = new();

    /// <summary>School-paid status per student, from persisted orders. Absent = never enrolled.</summary>
    private Dictionary<Guid, SchoolStudentPaymentStatus> payStatus = new();

    /// <summary>
    /// The selectable list: students the school has NOT already paid for. A pupil whose school
    /// payment succeeded drops out here automatically once the order settles — the status comes
    /// from the Order row, so nothing has to be refreshed by hand. Failed and pending attempts
    /// stay, because they still owe.
    /// </summary>
    private List<SchoolStudentListItem> Pending =>
        roster.Where(s => !(payStatus.TryGetValue(s.UserId, out var p) && p.IsPaid)).ToList();
    private readonly HashSet<Guid> selected = new();
    private PlaceSchoolEnrollmentResult? submitted;

    private SchoolEnrollmentProduct? Chosen =>
        Guid.TryParse(productId, out var id) ? products.FirstOrDefault(p => p.Id == id) : null;

    // Total Payable = selected course's catalogue price × students ticked. Never a literal.
    private decimal TotalPayable => (Chosen?.Price ?? 0m) * selected.Count;

    private bool AllSelected => Pending.Count > 0 && selected.Count == Pending.Count;
    private bool CanSubmit => !saving && Chosen is not null && selected.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (uid != null && Guid.TryParse(uid, out var parsed))
        {
            actingUserId = parsed;
            // The school is resolved from the signed-in user, never from the URL or a form field.
            schoolId = await Students.ResolveSchoolIdAsync(actingUserId);
            if (schoolId is not null)
            {
                roster = await Students.ListAsync(actingUserId);
                // Without this the paid-student filter has nothing to filter ON, so students the
                // school has already paid for stay selectable and could be charged twice.
                payStatus = await Enrollment.GetStudentPaymentStatusesAsync(actingUserId);
                await LoadProductsAsync();
            }
        }
        loading = false;
    }

    private async Task LoadProductsAsync()
    {
        loadError = false;
        try { products = await Enrollment.ListProductsAsync(); }
        catch { products = new(); loadError = true; }   // the reason stays server-side
    }

    private async Task ReloadProducts() => await LoadProductsAsync();

    private void OnCourseChanged(ChangeEventArgs e)
    {
        productId = e.Value?.ToString() ?? "";
        error = null;
    }

    private void Toggle(Guid userId, ChangeEventArgs e)
    {
        if (e.Value is bool on && on) selected.Add(userId);
        else selected.Remove(userId);
        error = null;
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        selected.Clear();
        if (e.Value is bool on && on)
            foreach (var r in roster) selected.Add(r.UserId);
        error = null;
    }

    private void StartAnother()
    {
        submitted = null;
        selected.Clear();
        productId = "";
        error = null;
    }

    /// <summary>Client-side result routes for the shared Razorpay helper, so a dismissed or failed
    /// popup returns to the School portal. Success is routed by the server's verify response.</summary>
    private static readonly object SchoolPaymentRoutes = new
    {
        cancelled = "/school/enrollment/payment-cancelled",
        failed = "/school/enrollment/payment-failed",
    };

    private async Task Submit()
    {
        if (!CanSubmit) return;              // guards a double-click before the disable lands
        saving = true; error = null;

        var res = await Enrollment.PlaceAsync(actingUserId, new PlaceSchoolEnrollmentRequest
        {
            ProductId = Chosen!.Id,
            StudentUserIds = selected.ToList(),
        });

        if (!res.Ok)
        {
            saving = false;
            // Selections are deliberately left intact so nothing has to be re-entered.
            error = res.Error ?? "We could not submit this enrollment. Please try again.";
            return;
        }

        // ── Hand the PENDING order to the existing Razorpay flow ─────────────────────────────
        // rc.retryRazorpay is the same helper the storefront uses to pay an already-created order:
        // it calls /api/payments/razorpay/retry-order, opens the Razorpay popup, and POSTs the
        // result to /api/payments/razorpay/verify. Every state change — PaymentStatus=Success,
        // OrderStatus=Confirmed, enrolments, invoices — happens server-side inside
        // ConfirmPaymentAsync behind signature verification. Nothing here decides payment succeeded,
        // and the browser only follows the redirectUrl the server returns.
        //
        // The order is already persisted at this point, so a closed popup or a dropped browser
        // leaves a recoverable pending order rather than losing the enrolment. `saving` stays true
        // until the redirect so the button cannot be clicked twice; the roster's unique
        // (OrderId, StudentUserId) index is the server-side backstop.
        try
        {
            // Third argument keeps a dismissed/failed popup inside the School portal. Storefront
            // callers omit it and keep the /checkout/* pages unchanged.
            await JS.InvokeVoidAsync("rc.retryRazorpay", res.OrderNumber, null, SchoolPaymentRoutes);
        }
        catch (Exception)
        {
            saving = false;
            submitted = res;   // order exists — show it so the principal can retry payment
            error = "Your enrolment was saved but the payment window could not be opened. "
                  + "Open it again from your orders, or try once more.";
            roster = await Students.ListAsync(actingUserId);
            payStatus = await Enrollment.GetStudentPaymentStatusesAsync(actingUserId);
        }
    }
}



