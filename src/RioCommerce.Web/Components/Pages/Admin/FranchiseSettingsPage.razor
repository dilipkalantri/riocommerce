@page "/admin/settings/franchise"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin")]
@using RioCommerce.Core.Entities
@inject IFranchiseService Svc
@inject ToastService Toast
<PageTitle>Franchise Settings — RioCommerce Admin</PageTitle>

<div class="page__header">
    <h1>Franchise Settings</h1>
</div>

@if (settings == null)
{
    <p style="color:var(--gray-400);padding:24px 0">Loading…</p>
}
else
{
    <div class="form-card" style="max-width:720px">
        <div class="form-card__title">Product &amp; franchise assignment</div>

        <label class="fs-row">
            <input type="checkbox" @bind="settings.EnableAutomaticAssignment" />
            <span><strong>Enable automatic product assignment</strong><br/>
                <span class="fs-hint">Master switch. When off, the two auto-assign options below are ignored.</span></span>
        </label>

        <label class="fs-row">
            <input type="checkbox" @bind="settings.AutoAssignNewProductsToAllFranchises" disabled="@(!settings.EnableAutomaticAssignment)" />
            <span><strong>Auto-assign new products to all franchises</strong><br/>
                <span class="fs-hint">When a product is created with a default share enabled, seed it to every active franchise.</span></span>
        </label>

        <label class="fs-row">
            <input type="checkbox" @bind="settings.AutoAssignAllProductsToNewFranchise" disabled="@(!settings.EnableAutomaticAssignment)" />
            <span><strong>Auto-assign all products to new franchises</strong><br/>
                <span class="fs-hint">When a franchise is approved, seed every active product's default share to it.</span></span>
        </label>

        <div class="form-card__title" style="margin-top:20px">Commission behaviour</div>

        <label class="fs-row">
            <input type="checkbox" @bind="settings.AllowFranchiseSpecificOverride" />
            <span><strong>Allow franchise-specific share override</strong><br/>
                <span class="fs-hint">When on, a per-franchise commission row takes precedence over the product default. When off, the product default always applies.</span></span>
        </label>

        <label class="fs-row">
            <input type="checkbox" @bind="settings.ApplyShareOnSpecialPrice" />
            <span><strong>Apply share on special price when active</strong><br/>
                <span class="fs-hint">Percentage shares are calculated on the special price while it's running, otherwise on the regular price.</span></span>
        </label>

        @* A wallet top-up isn't tied to a product, so it can't inherit a product's GST rate. *@
        <label class="fs-row" style="align-items:flex-start">
            <input type="number" step="0.01" min="0" max="28" class="form-input" style="width:90px;margin-top:1px"
                   @bind="settings.WalletInvoiceGstRate" />
            <span><strong>GST rate on wallet top-up invoices (%)</strong><br/>
                <span class="fs-hint">
                    Applied when money is added to a franchisee's wallet, which raises an invoice in their name.
                    Course orders are unaffected — they keep using each product's own rate. Check this figure with
                    your accountant before going live.
                </span></span>
        </label>

        <div style="margin-top:20px">
            <button class="btn btn-primary" disabled="@saving" @onclick="Save">@(saving ? "Saving…" : "Save Settings")</button>
        </div>
    </div>
}

<style>
    .fs-row { display:flex; gap:12px; align-items:flex-start; padding:12px 0; border-bottom:1px solid var(--gray-100); font-size:14px; }
    .fs-row input[type=checkbox] { margin-top:3px; width:18px; height:18px; flex-shrink:0; }
    .fs-hint { color:var(--gray-500); font-size:12.5px; }
</style>

@code {
    private FranchiseSettings? settings;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        settings = await Svc.GetSettingsAsync();
    }

    private async Task Save()
    {
        if (settings == null) return;
        saving = true;
        try
        {
            await Svc.SaveSettingsAsync(settings, Guid.Empty);
            Toast.Success("Franchise settings saved.");
        }
        catch (Exception ex) { Toast.Error($"Save failed: {ex.Message}"); }
        finally { saving = false; }
    }
}
