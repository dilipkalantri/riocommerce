@page "/admin/integrations/superclass"
@using System.Text.Json
@using RioCommerce.Core.DTOs.SerialKeys
@using RioCommerce.Core.Enums
@* Alias the DTO — its short name collides with the SerialKeyDetail.razor *page* in this namespace. *@
@using SerialKeyDetailDto = RioCommerce.Core.DTOs.SerialKeys.SerialKeyDetail
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin,operations,support,backend_user")]
@inject ISerialKeyService Svc
@inject ToastService Toast
<PageTitle>Superclass Registrations — RioCommerce Admin</PageTitle>

@*
    Dedicated operational view for the Superclass LMS integration. Lists every registration record
    (student sign-up + course assignment) with its status, student id, subscription, activation and
    expiry — plus a drill-in modal showing the full API request/response for audit, and a Retry action
    for failed/dead-lettered calls. Backed by the shared ISerialKeyService, filtered to the Superclass
    provider, so it inherits the same enqueue/retry/logging engine as RioPlay and Valence.
*@

<style>
    .sc-toolbar { display:flex; gap:10px; flex-wrap:wrap; align-items:center; padding:14px; background:#fff; border:1px solid var(--gray-200); border-radius:12px; margin-bottom:14px }
    .sc-toolbar .form-input, .sc-toolbar .form-select { font-size:13px; padding:7px 10px; min-width:140px }
    .sc-toolbar .form-input[type="search"] { min-width:220px }
    .sc-tbl { width:100%; border-collapse:collapse; font-size:13px; background:#fff; border:1px solid var(--gray-200); border-radius:12px; overflow:hidden }
    .sc-tbl th, .sc-tbl td { padding:10px 12px; border-bottom:1px solid var(--gray-100); text-align:left; vertical-align:middle }
    .sc-tbl th { background:var(--gray-50); font-size:11px; text-transform:uppercase; letter-spacing:.4px; color:var(--gray-500); font-weight:700 }
    .sc-tbl tbody tr:hover td { background:var(--gray-50) }
    .sc-tbl tbody tr:last-child td { border-bottom:0 }
    .sc-status { display:inline-block; padding:3px 9px; border-radius:6px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.3px; white-space:nowrap }
    .sc-status--pending     { background:var(--gray-100); color:var(--gray-600) }
    .sc-status--generating  { background:#DBEAFE; color:#1E40AF }
    .sc-status--generated   { background:#D1FAE5; color:#065F46 }
    .sc-status--activated   { background:#A7F3D0; color:#064E3B }
    .sc-status--failed      { background:#FEF3C7; color:#92400E }
    .sc-status--deadlettered{ background:#FEE2E2; color:#991B1B }
    .sc-status--revoked     { background:var(--gray-200); color:var(--gray-500); text-decoration:line-through }
    .sc-mono { font-family:'JetBrains Mono',ui-monospace,monospace; font-size:12px; color:var(--navy) }
    .sc-err { color:var(--red); font-size:11.5px; margin-top:3px; font-weight:500; max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap }
    .sc-actions { display:flex; gap:4px; justify-content:flex-end }
    .sc-meta { font-size:11.5px; color:var(--gray-500); margin-top:2px }
    .sc-empty { padding:60px 16px; text-align:center; color:var(--gray-400) }
    .sc-modal-overlay { position:fixed; inset:0; background:rgba(15,23,42,.5); display:flex; align-items:center; justify-content:center; z-index:1000; padding:20px }
    .sc-modal { background:#fff; border-radius:16px; max-width:820px; width:100%; max-height:90vh; overflow-y:auto; box-shadow:0 25px 50px -12px rgba(0,0,0,.25) }
    .sc-modal__head { display:flex; align-items:center; justify-content:space-between; padding:16px 22px; border-bottom:1px solid var(--gray-200) }
    .sc-modal__title { font-weight:700; color:var(--navy); font-size:16px }
    .sc-modal__close { background:none; border:0; color:var(--gray-400); font-size:22px; cursor:pointer; padding:0 4px; line-height:1 }
    .sc-modal__body { padding:22px }
    .sc-modal__foot { padding:14px 22px; border-top:1px solid var(--gray-200); display:flex; gap:8px; justify-content:flex-end }
    .sc-dl { display:grid; grid-template-columns:170px 1fr; gap:6px 14px; font-size:13px; margin-bottom:16px }
    .sc-dl dt { color:var(--gray-500); font-weight:600 }
    .sc-dl dd { margin:0; color:var(--navy) }
    .sc-json { background:#0F172A; color:#E2E8F0; border-radius:8px; padding:12px 14px; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:11.5px; overflow-x:auto; white-space:pre; max-height:280px; overflow-y:auto; margin:4px 0 14px }
    .sc-json__label { font-size:11px; text-transform:uppercase; letter-spacing:.4px; color:var(--gray-500); font-weight:700; margin-top:8px }
</style>

<div class="page__header" style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px">
    <div>
        <h1>Superclass Registrations</h1>
        <p style="color:var(--gray-500); font-size:13.5px; margin:4px 0 0">
            Student registrations &amp; course assignments via the Superclass LMS API. Configure credentials at
            <a href="/admin/settings/superclass">Superclass Settings</a>.
        </p>
    </div>
    <button class="btn btn-primary btn-sm" style="white-space:nowrap" @onclick="ProcessNow" disabled="@processing">
        @(processing ? "Processing…" : "⚡ Process Pending Now")
    </button>
</div>

<div class="sc-toolbar">
    <select class="form-select" @bind="statusFilter" @bind:after="Reload">
        <option value="">All statuses</option>
        @foreach (var s in Enum.GetValues<SerialKeyStatus>())
        {
            <option value="@s">@s</option>
        }
    </select>
    <input type="search" class="form-input" placeholder="Order #, customer, or student id…" @bind="search" @bind:after="Reload" />
    <div style="margin-left:auto; font-size:12.5px; color:var(--gray-500)">
        @(items?.Count ?? 0) record@(items?.Count == 1 ? "" : "s")
    </div>
</div>

@if (items == null)
{
    <p style="color:var(--gray-400); padding:30px 0; text-align:center">Loading…</p>
}
else if (items.Count == 0)
{
    <div class="sc-empty">
        <div style="font-size:32px">🎓</div>
        <div style="margin-top:8px; font-size:14px">No Superclass registrations match those filters.</div>
        <div style="margin-top:4px; font-size:12.5px">
            Records are created automatically when a paid order contains a product mapped to
            <a href="/admin/products">Superclass</a>.
        </div>
    </div>
}
else
{
    <table class="sc-tbl">
        <thead>
            <tr>
                <th>Order / Customer</th>
                <th>Course</th>
                <th>Student ID</th>
                <th>Status</th>
                <th>Subscription</th>
                <th>Activated</th>
                <th>Expires</th>
                <th style="text-align:center">Attempts</th>
                <th style="text-align:right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in items)
            {
                <tr>
                    <td>
                        <a href="/admin/orders/@r.OrderId" style="font-weight:600; color:var(--navy); text-decoration:none">@r.OrderNumber</a>
                        <div class="sc-meta">@r.CustomerName</div>
                    </td>
                    <td class="sc-mono">@(string.IsNullOrEmpty(r.ProviderCourseRef) ? "—" : r.ProviderCourseRef)</td>
                    <td class="sc-mono">@(string.IsNullOrEmpty(r.ExternalReference) ? "—" : r.ExternalReference)</td>
                    <td><span class="sc-status sc-status--@r.Status.ToString().ToLowerInvariant()">@r.Status</span></td>
                    <td style="font-size:12px; color:var(--gray-600)">@(string.IsNullOrEmpty(r.SubscriptionStatus) ? "—" : r.SubscriptionStatus)</td>
                    <td style="font-size:12px; color:var(--gray-600)">@(r.ActivatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                    <td style="font-size:12px; color:var(--gray-600)">@(r.ExpiresAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                    <td style="text-align:center">@r.AttemptCount</td>
                    <td>
                        <div class="sc-actions">
                            <button class="btn btn-ghost btn-xs" @onclick="() => OpenDetail(r.Id)">View</button>
                            @if (r.Status == SerialKeyStatus.Failed || r.Status == SerialKeyStatus.DeadLettered || r.Status == SerialKeyStatus.Pending)
                            {
                                <button class="btn btn-primary btn-xs" @onclick="() => Regenerate(r.Id)">Retry</button>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(r.ErrorMessage)) { <div class="sc-err" title="@r.ErrorMessage">@r.ErrorMessage</div> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (detail != null)
{
    <div class="sc-modal-overlay" @onclick="CloseDetail">
        <div class="sc-modal" @onclick:stopPropagation="true">
            <div class="sc-modal__head">
                <div class="sc-modal__title">Registration — @detail.OrderNumber</div>
                <button class="sc-modal__close" @onclick="CloseDetail">×</button>
            </div>
            <div class="sc-modal__body">
                <dl class="sc-dl">
                    <dt>Customer</dt><dd>@detail.CustomerName</dd>
                    <dt>Product</dt><dd>@detail.ProductTitle @(string.IsNullOrEmpty(detail.ModeName) ? "" : $"— {detail.ModeName}")</dd>
                    <dt>Status</dt><dd><span class="sc-status sc-status--@detail.Status.ToString().ToLowerInvariant()">@detail.Status</span></dd>
                    <dt>Student ID</dt><dd class="sc-mono">@(detail.ExternalReference ?? "—")</dd>
                    <dt>Course ref</dt><dd class="sc-mono">@(detail.ProviderCourseRef ?? "—")</dd>
                    <dt>Subscription</dt><dd>@(detail.SubscriptionStatus ?? "—")</dd>
                    <dt>Activated</dt><dd>@(detail.ActivatedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
                    <dt>Expires</dt><dd>@(detail.ExpiresAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</dd>
                    <dt>Attempts</dt><dd>@detail.AttemptCount @(detail.LastAttemptAt != null ? $"(last {detail.LastAttemptAt?.ToLocalTime():dd MMM HH:mm})" : "")</dd>
                    @if (!string.IsNullOrEmpty(detail.ErrorCode) || !string.IsNullOrEmpty(detail.ErrorMessage))
                    {
                        <dt style="color:var(--red)">Last error</dt>
                        <dd style="color:var(--red)">@detail.ErrorCode — @detail.ErrorMessage</dd>
                    }
                </dl>

                <div class="sc-json__label">API request (key redacted)</div>
                <div class="sc-json">@Pretty(detail.ApiRequestPayload)</div>

                <div class="sc-json__label">API response</div>
                <div class="sc-json">@Pretty(detail.ResponsePayload)</div>
            </div>
            <div class="sc-modal__foot">
                @if (detail.Status is SerialKeyStatus.Failed or SerialKeyStatus.DeadLettered or SerialKeyStatus.Pending)
                {
                    <button class="btn btn-primary btn-sm" @onclick="() => Regenerate(detail.Id, closeAfter: true)">Retry now</button>
                }
                <button class="btn btn-ghost btn-sm" @onclick="CloseDetail">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private const string ProviderKey = "superclass";

    private List<SerialKeyListItem>? items;
    private SerialKeyDetailDto? detail;

    private string statusFilter = "";
    private string search = "";
    private bool processing;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        var filter = new SerialKeyListFilter
        {
            ProviderKey = ProviderKey,
            Status = !string.IsNullOrEmpty(statusFilter) && Enum.TryParse<SerialKeyStatus>(statusFilter, out var s) ? s : null,
            Query = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            Page = 1,
            PageSize = 100,
        };
        items = await Svc.ListAsync(filter);
    }

    /// <summary>Run the dispatch loop now instead of waiting for the 60s scheduled task.</summary>
    private async Task ProcessNow()
    {
        processing = true; StateHasChanged();
        try
        {
            var (processed, generated, failed, dead) = await Svc.ProcessDueAsync(200);
            if (processed == 0) Toast.Info("No pending records were due for processing.");
            else Toast.Success($"Processed {processed}: {generated} provisioned, {failed} failed, {dead} dead-lettered.");
            await Reload();
        }
        catch (Exception ex) { Toast.Error($"Processing failed: {ex.Message}"); }
        finally { processing = false; StateHasChanged(); }
    }

    private async Task OpenDetail(Guid id) => detail = await Svc.GetAsync(id);
    private void CloseDetail() => detail = null;

    private async Task Regenerate(Guid recordId, bool closeAfter = false)
    {
        var ok = await Svc.RegenerateAsync(recordId, null);
        if (ok)
        {
            Toast.Success("Queued for retry — runs on the next scheduled-task tick (≤60s).");
            if (closeAfter) CloseDetail();
            await Reload();
        }
        else { Toast.Error("Couldn't queue retry."); }
    }

    /// <summary>Pretty-print a stored jsonb payload; falls back to the raw text if it isn't valid JSON.</summary>
    private static string Pretty(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "—";
        try
        {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch { return json; }
    }
}
