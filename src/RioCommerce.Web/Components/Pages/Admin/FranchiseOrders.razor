@page "/admin/franchise-orders"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin,operations,backend_user")]
@inject IFranchiseService Svc
<PageTitle>Franchise Orders — RioCommerce Admin</PageTitle>

<div class="page__header"><h1>Franchise Order Management</h1></div>

<div class="kpi-grid">
    <div class="kpi-card"><div class="kpi-card__label">Franchise Orders (MTD)</div><div class="kpi-card__value">@(stats?.OrdersMtd ?? 0)</div></div>
    <div class="kpi-card"><div class="kpi-card__label">Franchise Revenue</div><div class="kpi-card__value">₹@FormatMoney(stats?.Revenue ?? 0)</div></div>
    <div class="kpi-card"><div class="kpi-card__label">Active Franchises</div><div class="kpi-card__value">@(stats?.ActiveFranchises ?? 0)</div></div>
    <div class="kpi-card"><div class="kpi-card__label">Pending Approval</div><div class="kpi-card__value" style="color:var(--warning)">@(stats?.PendingApproval ?? 0)</div></div>
</div>

<div class="data-card" style="margin-top:20px">
    <div class="data-card__filters">
        <select class="filter-select" style="font-weight:600" @onchange="OnFranchise">
            <option value="">All Franchises</option>
            @if (cards != null) { @foreach (var f in cards) { <option value="@f.Id">@f.Name — @f.ContactPerson</option> } }
        </select>
        <select class="filter-select" @onchange="OnStatus">
            <option value="">All Status</option>
            @foreach (var s in Enum.GetValues<OrderStatus>()) { <option value="@((int)s)">@s</option> }
        </select>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Order #</th><th>Date</th><th>Franchise</th><th>Student</th><th>Product</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
                @if (orders == null) { <tr><td colspan="7" style="text-align:center;color:var(--gray-400)">Loading…</td></tr> }
                else if (orders.Count == 0) { <tr><td colspan="7" style="text-align:center;color:var(--gray-400)">No franchise orders.</td></tr> }
                else
                {
                    @foreach (var o in orders)
                    {
                        <tr>
                            <td><strong>#@o.OrderNumber</strong></td>
                            <td>@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td><strong>@o.FranchiseName</strong></td>
                            <td>@o.StudentName<br /><span style="font-size:11px;color:var(--gray-400)">@o.StudentPhone</span></td>
                            <td>@o.ProductSummary</td>
                            <td><strong style="color:var(--green)">₹@o.TotalAmount.ToString("N0")</strong></td>
                            <td><span class="status @StatusClass(o.Status)"><span class="dot"></span>@o.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<h3 style="margin:24px 0 12px;font-size:16px;color:var(--navy)">Franchise Summary</h3>
<div class="franchise-cards">
    @if (cards != null)
    {
        @foreach (var f in cards)
        {
            <div class="form-card" style="margin:0">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
                    <div class="sidebar__avatar" style="background:var(--navy)">@f.Code</div>
                    <div><div style="font-weight:700;color:var(--navy)">@f.Name</div><div style="font-size:11px;color:var(--gray-500)">@f.ContactPerson · @f.ContactPhone</div></div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:13px">
                    <div><span style="color:var(--gray-500)">Orders MTD</span><br /><strong>@f.OrdersMtd</strong></div>
                    <div><span style="color:var(--gray-500)">Revenue</span><br /><strong>₹@FormatMoney(f.Revenue)</strong></div>
                    <div><span style="color:var(--gray-500)">Pending</span><br /><strong style="color:var(--warning)">@f.Pending</strong></div>
                    <div><span style="color:var(--gray-500)">Wallet</span><br /><strong style="color:var(--green)">₹@f.Wallet.ToString("N0")</strong></div>
                </div>
            </div>
        }
    }
</div>

@code {
    private FranchiseStats? stats;
    private List<FranchiseCard>? cards;
    private List<FranchiseOrderRow>? orders;
    private Guid? franchiseId;
    private OrderStatus? status;

    protected override async Task OnInitializedAsync()
    {
        stats = await Svc.StatsAsync();
        cards = await Svc.FranchisesAsync();
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        var r = await Svc.OrdersAsync(franchiseId, status, 1, 50);
        orders = r.Items;
    }

    private async Task OnFranchise(ChangeEventArgs e) { franchiseId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await LoadOrders(); }
    private async Task OnStatus(ChangeEventArgs e) { status = int.TryParse(e.Value?.ToString(), out var v) ? (OrderStatus)v : null; await LoadOrders(); }

    private static string FormatMoney(decimal v) => v >= 100000 ? $"{v / 100000m:0.##}L" : v.ToString("N0");
    private static string StatusClass(OrderStatus s) => s switch
    {
        OrderStatus.Confirmed or OrderStatus.Activated or OrderStatus.Delivered => "status--confirmed",
        OrderStatus.Pending or OrderStatus.Draft => "status--pending",
        OrderStatus.Processing => "status--processing",
        _ => "status--cancelled"
    };
}
