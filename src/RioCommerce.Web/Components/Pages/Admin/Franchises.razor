    .fc-dl{display:grid;grid-template-columns:auto 1fr;gap:5px 12px;margin:0;font-size:13px}
    .fc-dl dt{color:var(--gray-500,#868e96)}
    .fc-dl dd{margin:0;font-weight:600;color:var(--gray-900,#111827);overflow-wrap:anywhere}
    .fc-id{font-size:11px;font-weight:400}
    .fc-tag{font-size:10px;font-weight:700;background:#FDE68A;color:#92400E;padding:1px 6px;border-radius:999px}
    .fc-type{background:#EFF6FF;color:#1E40AF;font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:999px}
    .fc-note{margin:12px 0 0;font-size:13px;color:var(--gray-600,#4b5563);line-height:1.55}
    .fc-err{margin-top:12px;background:#FEF2F2;border:1px solid #FECACA;color:#991B1B;
            padding:10px 12px;border-radius:8px;font-size:13px}

    .fc-danger{margin-top:16px;border:1px solid #FECACA;background:#FEF2F2;border-radius:10px;padding:14px}
    .fc-danger__title{font-weight:800;color:#991B1B;font-size:14px;margin-bottom:6px}
    .fc-danger__text{font-size:12.5px;color:#7F1D1D;line-height:1.55;margin:0 0 10px}
    .fc-check{display:flex;gap:8px;align-items:flex-start;font-size:13px;margin-top:7px;cursor:pointer}
    .fc-check code{font-size:12px;background:#fff;padding:1px 5px;border-radius:4px;border:1px solid #FECACA}
    .fc-check--confirm{margin-top:12px;padding-top:10px;border-top:1px dashed #FECACA;font-weight:600;color:#991B1B}

    .fc-btn-danger{color:#991B1B;border-color:#FECACA}
    .fc-btn-danger--solid{background:#B91C1C;color:#fff;border:1px solid #B91C1C}
    .fc-btn-danger--solid:disabled{opacity:.55}

    @@media(max-width:560px){
        .fc-modal__foot{justify-content:stretch}
        .fc-modal__foot .btn{flex:1 1 auto;text-align:center}
        .fc-dl{grid-template-columns:1fr;gap:2px 0}
        .fc-dl dt{margin-top:6px}
    }
</style>

@code {
    private List<FranchiseApplicationRow>? items;
    private string search = "";
    private FranchiseStatus? status;
    private int page = 1, total;
    private const int pageSize = 20;
    private int TotalPages => (int)Math.Ceiling(total / (double)pageSize);

    private Guid? approveId, rejectId, adjustId, editId;
    private FranchiseProfileEdit? edit;
    private string approveCode = "", approveRemarks = "", rejectRemarks = "", adjustReason = "";
    // Credit Limit starts at 0 on the approval form: granting a credit line is a deliberate act,
    // not a default. It used to pre-fill ₹50,000, so every approval silently issued that much credit.
    private decimal approveCredit = 0, approveOpening = 0, adjustAmount = 0;
    private bool adjustIsCredit = true;
    // A credit is money in by default and gets invoiced; refunds/corrections untick this.
    private bool adjustMoneyReceived = true;
    private bool busy;
    private string? msg, err;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var r = await Svc.ListApplicationsAsync(status, search, page, pageSize);
        items = r.Items; total = r.TotalCount;
    }

    private void CloseInline() { approveId = null; rejectId = null; adjustId = null; editId = null; edit = null; approveCode = ""; approveRemarks = ""; rejectRemarks = ""; adjustReason = ""; approveCredit = 0; approveOpening = 0; adjustAmount = 0; adjustIsCredit = true; adjustMoneyReceived = true; err = null; }

    /// <summary>Loads the franchise's current particulars into the inline form. Read first, so the
    /// admin edits what is actually stored rather than the abbreviated list row.</summary>
    private async Task OpenEdit(Guid id)
    {
        CloseInline();
        var d = await Svc.GetDetailAsync(id);
        if (d == null) { err = "Franchise not found."; return; }
        edit = new FranchiseProfileEdit
        {
            FranchiseId = d.Id, Name = d.Name, BusinessName = d.BusinessName,
            ContactPerson = d.ContactPerson, ContactPhone = d.ContactPhone,
            AddressLine = d.AddressLine, City = d.City, State = d.State, PinCode = d.PinCode,
            Gstin = d.Gstin, Pan = d.Pan,
        };
        editId = id;
    }

    private async Task DoSaveProfile()
    {
        if (edit == null) return;
        busy = true; err = null; msg = null;
        try
        {
            var (ok, error) = await Svc.UpdateProfileAsync(edit, Guid.Empty);
            if (!ok) { err = error; return; }
        }
        catch (Exception ex)
        {
            err = $"Save failed: {ex.Message}";
            return;
        }
        finally { busy = false; }

        msg = "Franchise details updated.";
        CloseInline();
        await Load();
    }
    private void OpenApprove(Guid id) { CloseInline(); approveId = id; }
    private void OpenReject(Guid id) { CloseInline(); rejectId = id; }
    private void OpenAdjust(Guid id) { CloseInline(); adjustId = id; }

    private async Task VerifyApp(Guid id)
    {
        busy = true; err = null; msg = null;
        var (ok, error) = await Svc.AdminVerifyApplicationAsync(id, Guid.Empty);
        busy = false;
        if (!ok) { err = error; return; }
        msg = "Application verified — it's now Pending and ready to approve.";
        // Jump to the Pending list so the just-verified application (and its Approve button) is visible.
        status = FranchiseStatus.Pending;
        await Load();
    }

    private async Task DoAdjust()
    {
        if (adjustId is not Guid id) return;
        busy = true; err = null; msg = null;
        var invoiced = adjustIsCredit && adjustMoneyReceived;
        var (ok, error) = await Svc.AdjustWalletAsync(new AdjustWalletRequest
        {
            FranchiseId = id, IsCredit = adjustIsCredit, Amount = adjustAmount, Reason = adjustReason,
            MoneyReceived = invoiced
        }, Guid.Empty);
        busy = false;
        if (!ok) { err = error; return; }
        msg = (adjustIsCredit ? (invoiced ? "Wallet credited and invoice raised." : "Wallet credited (no invoice).") : "Wallet debited.")
            + " Open 👛 Wallet to see the ledger entry.";
        CloseInline();
        await Load();
    }

    // ── Existing-account conflict state ─────────────────────────────────────────────────────────
    private FranchiseApprovalConflict? conflict;
    private bool showReplacePanel, confirmReplace, replaceEmail, replacePhone;
    private string? conflictErr;

    /// <summary>One shape for every account card, so a two-account conflict reads the same as one.</summary>
    private RenderFragment AccountCard(ExistingAccountInfo a) =>
        @<dl class="fc-dl">
            <dt>Name</dt><dd>@a.FullName</dd>
            <dt>Phone</dt><dd>@(a.Phone ?? "—") @if (a.MatchedOnPhone) { <span class="fc-tag">match</span> }</dd>
            <dt>Email</dt><dd>@(a.Email ?? "—") @if (a.MatchedOnEmail) { <span class="fc-tag">match</span> }</dd>
            <dt>Type</dt><dd><span class="fc-type">@a.AccountType</span></dd>
            <dt>Status</dt><dd>@(a.IsActive ? "Active" : "Inactive")</dd>
            <dt>User ID</dt><dd><code class="fc-id">@a.UserId</code></dd>
            <dt>Since</dt><dd>@a.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>
        </dl>;

    private void ResetConflict()
    {
        conflict = null; conflictErr = null;
        showReplacePanel = false; confirmReplace = false; replaceEmail = false; replacePhone = false;
    }

    /// <summary>Cancel: closes the dialog and leaves the database exactly as it was.</summary>
    private void CancelConflict() { ResetConflict(); CloseInline(); }

    /// <summary>Back to the approval form with everything the admin already typed still there, so the
    /// contact details can be corrected without re-entering code, credit limit and remarks.</summary>
    private void ChangeContactDetails() { ResetConflict(); }

    private Task UseExistingAccount() => RunApproval(FranchiseAccountResolution.UseExistingAccount);
    private Task ReplaceContactAndApprove() => RunApproval(FranchiseAccountResolution.ReplaceExistingContact);

    private async Task DoApprove()
    {
        if (approveId is not Guid id) return;

        // Look before writing. This is a pure read; if anything already owns the contact details the
        // admin sees it and decides, and nothing has touched the database yet.
        busy = true; err = null; msg = null; conflictErr = null;
        try
        {
            var found = await Svc.CheckApprovalConflictAsync(id);
            if (found.HasConflict) { conflict = found; return; }
        }
        catch (Exception ex)
        {
            err = $"Could not check for existing accounts: {ex.Message}";
            return;
        }
        finally { busy = false; }

        await RunApproval(FranchiseAccountResolution.None);
    }

    /// <summary>
    /// The single path to approval, whichever button reached it.
    ///
    /// <para>try/finally rather than a bare await: an exception escaping the service used to skip
    /// `busy = false` and leave the button reading "Approving…" for ever, with no error shown and
    /// nothing saved. Every exit — success, validation failure, conflict, exception — resets it.</para>
    /// </summary>
    private async Task RunApproval(FranchiseAccountResolution resolution)
    {
        if (approveId is not Guid id) return;
        busy = true; err = null; conflictErr = null;

        var chosen = conflict?.EmailOwner ?? conflict?.PhoneOwner;
        try
        {
            var (ok, error) = await Svc.ApproveAsync(new FranchiseApprovalRequest
            {
                FranchiseId = id, Code = approveCode, CreditLimit = approveCredit,
                OpeningBalance = approveOpening > 0 ? approveOpening : null, Remarks = approveRemarks,
                AccountResolution = resolution,
                ExistingUserId = chosen?.UserId,
                ConfirmContactReplacement = confirmReplace,
                ReplaceEmail = replaceEmail,
                ReplacePhone = replacePhone,
            }, Guid.Empty);   // actor resolved server-side in JWT controller path; cookie path passes empty (audit logs admin)

            if (!ok)
            {
                // Keep a failure inside the dialog it came from, so the admin can adjust and retry
                // rather than losing the comparison they were reading.
                if (conflict != null) conflictErr = error; else err = error;
                return;
            }
        }
        catch (Exception ex)
        {
            var text = $"Approval failed: {ex.Message}";
            if (conflict != null) conflictErr = text; else err = text;
            return;
        }
        finally { busy = false; }

        msg = resolution == FranchiseAccountResolution.None
            ? "Franchise approved. Login credentials emailed to the applicant."
            : "Franchise approved using the existing account. Its password was not changed.";
        ResetConflict();
        CloseInline();
        await Load();
    }

    private async Task DoReject()
    {
        if (rejectId is not Guid id) return;
        busy = true; err = null; msg = null;
        try
        {
            var (ok, error) = await Svc.RejectAsync(new FranchiseRejectionRequest { FranchiseId = id, Remarks = rejectRemarks }, Guid.Empty);
            if (!ok) { err = error; return; }
        }
        catch (Exception ex)
        {
            err = $"Rejection failed: {ex.Message}";
            return;
        }
        finally { busy = false; }

        msg = "Application rejected. Remarks emailed to the applicant.";
        CloseInline();
        await Load();
    }

    private async Task Toggle(Guid id, bool active)
    {
        err = null; msg = null;
        var (ok, error) = await Svc.SetActiveAsync(id, active, Guid.Empty);
        if (!ok) { err = error; return; }
        msg = active ? "Franchise activated." : "Franchise deactivated (login disabled).";
        await Load();
    }

    private async Task ResetPw(Guid id)
    {
        err = null; msg = null;
        var (ok, error) = await Svc.ResetPasswordAsync(id, Guid.Empty);
        if (!ok) { err = error; return; }
        msg = "Password reset. New password emailed to the franchisee.";
    }

    private async Task OnStatus(ChangeEventArgs e) { status = int.TryParse(e.Value?.ToString(), out var v) ? (FranchiseStatus)v : null; page = 1; await Load(); }
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") { page = 1; await Load(); } }
    private async Task Go(int p) { if (p < 1 || p > TotalPages) return; page = p; await Load(); }

    private static MarkupString StatusBadge(FranchiseApplicationRow f) => new(f.Status switch
    {
        FranchiseStatus.Pending => "<span class=\"status status--pending\"><span class=\"dot\"></span>Pending</span>",
        FranchiseStatus.Unverified => "<span class=\"status status--pending\"><span class=\"dot\"></span>Unverified</span>",
        FranchiseStatus.Approved when f.IsActive => "<span class=\"status status--confirmed\"><span class=\"dot\"></span>Active</span>",
        FranchiseStatus.Approved => "<span class=\"status status--cancelled\"><span class=\"dot\"></span>Inactive</span>",
        FranchiseStatus.Rejected => "<span class=\"status status--cancelled\"><span class=\"dot\"></span>Rejected</span>",
        _ => f.Status.ToString()
    });
}
