@page "/admin/franchises"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin,backend_user")]
@inject IFranchiseService Svc
<PageTitle>Franchises — RioCommerce Admin</PageTitle>

<div class="page__header">
    <h1>Franchises</h1>
    <a href="/franchisee/register" target="_blank" class="btn btn-outline">Open public registration ↗</a>
</div>

<div class="data-card">
    <div class="data-card__filters">
        <input type="text" class="filter-input" placeholder="Search name, business, phone, email…" style="flex:1;min-width:200px" @bind="search" @bind:event="oninput" @onkeydown="OnKey" />
        <select class="filter-select" @onchange="OnStatus">
            <option value="">All Status</option>
            <option value="3" selected="@(status == FranchiseStatus.Unverified)">Unverified (new registrations)</option>
            <option value="0" selected="@(status == FranchiseStatus.Pending)">Pending</option>
            <option value="1" selected="@(status == FranchiseStatus.Approved)">Approved</option>
            <option value="2" selected="@(status == FranchiseStatus.Rejected)">Rejected</option>
        </select>
    </div>

    @if (msg != null) { <div class="inline-alert inline-alert--ok" style="margin:0 16px 12px">@msg</div> }
    @if (err != null) { <div class="inline-alert inline-alert--err" style="margin:0 16px 12px">@err</div> }

    <div class="table-wrap">
        <table>
            <thead><tr><th>Date</th><th>Name / Business</th><th>City</th><th>Contact</th><th>Status</th><th>Wallet</th><th>Actions</th></tr></thead>
            <tbody>
                @if (items == null) { <tr><td colspan="7" style="text-align:center;color:var(--gray-400)">Loading…</td></tr> }
                else if (items.Count == 0) { <tr><td colspan="7" style="text-align:center;color:var(--gray-400)">No franchises found.</td></tr> }
                else
                {
                    @foreach (var f in items)
                    {
                        <tr>
                            <td>@f.RegisteredAt.ToLocalTime().ToString("dd MMM, HH:mm")</td>
                            <td><strong>@f.Name</strong>@if (!string.IsNullOrWhiteSpace(f.BusinessName)) { <br /><span style="font-size:11px;color:var(--gray-500)">@f.BusinessName</span> }</td>
                            <td>@f.City</td>
                            <td><span style="font-size:12px">@f.ContactPhone</span><br /><span style="font-size:11px;color:var(--gray-500)">@f.ContactEmail</span></td>
                            <td>@StatusBadge(f)</td>
                            <td>₹@f.WalletBalance.ToString("N0")</td>
                            <td>
                                @if (f.Status == FranchiseStatus.Unverified)
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => VerifyApp(f.Id)">✓ Verify</button>
                                    <button class="btn btn-sm btn-outline" @onclick="() => OpenReject(f.Id)">Reject</button>
                                }
                                else if (f.Status == FranchiseStatus.Pending)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => OpenApprove(f.Id)">Approve</button>
                                    <button class="btn btn-sm btn-outline" @onclick="() => OpenReject(f.Id)">Reject</button>
                                }
                                else if (f.Status == FranchiseStatus.Approved)
                                {
                                    <a href="@($"/admin/franchises/{f.Id}/commissions")" class="btn btn-sm btn-outline">💰 Commissions</a>
                                    <a href="@($"/admin/franchises/{f.Id}/wallet")" class="btn btn-sm btn-outline">👛 Wallet</a>
                                    <button class="btn btn-sm btn-outline" @onclick="() => OpenAdjust(f.Id)">💵 Adjust</button>
                                    @if (f.IsActive)
                                    { <button class="btn btn-sm btn-outline" @onclick="() => Toggle(f.Id, false)">Deactivate</button> }
                                    else
                                    { <button class="btn btn-sm btn-primary" @onclick="() => Toggle(f.Id, true)">Activate</button> }
                                    <button class="btn btn-sm btn-outline" @onclick="() => OpenEdit(f.Id)">✎ Edit</button>
                                    <button class="btn btn-sm btn-ghost" @onclick="() => ResetPw(f.Id)">Reset PW</button>
                                }
                            </td>
                        </tr>
                        @* Particulars only — no wallet, credit limit, commission, status or login
                           email here, so editing a franchisee's GSTIN can never move their money. *@
                        @if (editId == f.Id && edit != null)
                        {
                            <tr><td colspan="7" style="background:var(--orange-light)">
                                <div class="form-grid form-grid--3col" style="padding:8px 4px">
                                    <div class="form-group"><label class="form-label">Franchisee name <span class="required">*</span></label><input class="form-input" @bind="edit.Name" /></div>
                                    <div class="form-group"><label class="form-label">Business name</label><input class="form-input" @bind="edit.BusinessName" /></div>
                                    <div class="form-group"><label class="form-label">Contact person</label><input class="form-input" @bind="edit.ContactPerson" /></div>
                                    <div class="form-group"><label class="form-label">Contact phone</label><input class="form-input" @bind="edit.ContactPhone" placeholder="10 digits" /></div>
                                    <div class="form-group"><label class="form-label">GSTIN</label><input class="form-input" @bind="edit.Gstin" placeholder="15 chars · e.g. 08ABCDE1234F1Z5" /></div>
                                    <div class="form-group"><label class="form-label">PAN</label><input class="form-input" @bind="edit.Pan" placeholder="10 chars · e.g. ABCDE1234F" /></div>
                                    <div class="form-group form-group--full"><label class="form-label">Address</label><input class="form-input" @bind="edit.AddressLine" /></div>
                                    <div class="form-group"><label class="form-label">City <span class="required">*</span></label><input class="form-input" @bind="edit.City" /></div>
                                    <div class="form-group"><label class="form-label">State</label><input class="form-input" @bind="edit.State" /></div>
                                    <div class="form-group"><label class="form-label">PIN code</label><input class="form-input" @bind="edit.PinCode" placeholder="6 digits" /></div>
                                </div>
                                <div class="form-actions" style="padding:0 4px 8px">
                                    <button class="btn btn-primary" disabled="@busy" @onclick="DoSaveProfile">@(busy ? "Saving…" : "💾 Save details")</button>
                                    <button class="btn btn-ghost" @onclick="CloseInline">Cancel</button>
                                    <span style="margin-left:auto;font-size:12px;color:var(--gray-500)">
                                        Wallet, credit limit, commissions and login email are not changed here.
                                    </span>
                                </div>
                            </td></tr>
                        }
                        else if (approveId == f.Id)
                        {
                            <tr><td colspan="7" style="background:var(--orange-light)">
                                <div class="form-grid form-grid--3col" style="padding:8px 4px">
                                    <div class="form-group"><label class="form-label">Code (auto if blank)</label><input class="form-input" @bind="approveCode" placeholder="e.g. PUN" /></div>
                                    <div class="form-group"><label class="form-label">Credit Limit (₹)</label><input type="number" class="form-input" @bind="approveCredit" /></div>
                                    <div class="form-group"><label class="form-label">Opening Balance (₹)</label><input type="number" class="form-input" @bind="approveOpening" /></div>
                                    <div class="form-group form-group--full"><label class="form-label">Remarks (optional)</label><input class="form-input" @bind="approveRemarks" /></div>
                                </div>
                                <div class="form-actions" style="padding:0 4px 8px">
                                    <button class="btn btn-primary" disabled="@busy" @onclick="DoApprove">@(busy ? "Approving…" : "✓ Approve & Email Credentials")</button>
                                    <button class="btn btn-ghost" @onclick="CloseInline">Cancel</button>
                                </div>
                            </td></tr>
                        }
                        else if (rejectId == f.Id)
                        {
                            <tr><td colspan="7" style="background:var(--orange-light)">
                                <div class="form-group" style="padding:8px 4px"><label class="form-label">Rejection Remarks <span class="required">*</span></label><textarea class="form-input" rows="2" @bind="rejectRemarks" placeholder="Reason shown to the applicant by email"></textarea></div>
                                <div class="form-actions" style="padding:0 4px 8px">
                                    <button class="btn btn-primary" disabled="@busy" @onclick="DoReject">@(busy ? "Rejecting…" : "Reject Application")</button>
                                    <button class="btn btn-ghost" @onclick="CloseInline">Cancel</button>
                                </div>
                            </td></tr>
                        }
                        else if (adjustId == f.Id)
                        {
                            <tr><td colspan="7" style="background:var(--orange-light)">
                                <div class="form-grid form-grid--3col" style="padding:8px 4px">
                                    <div class="form-group">
                                        <label class="form-label">Type</label>
                                        <select class="form-input" @bind="adjustIsCredit">
                                            <option value="true">Credit (top-up / refund)</option>
                                            <option value="false">Debit (correction)</option>
                                        </select>
                                    </div>
                                    <div class="form-group"><label class="form-label">Amount (₹) <span class="required">*</span></label><input type="number" step="1" class="form-input" @bind="adjustAmount" /></div>
                                    <div class="form-group form-group--full"><label class="form-label">Reason <span class="required">*</span></label><input class="form-input" @bind="adjustReason" placeholder="e.g. Cash deposit / Refund: order FRN-1005" /></div>
                                    @if (adjustIsCredit)
                                    {
                                        @* Money in raises a tax invoice; a refund or correction must not. *@
                                        <div class="form-group form-group--full">
                                            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px">
                                                <input type="checkbox" @bind="adjustMoneyReceived" />
                                                <span>Money received — raise a tax invoice <span style="color:var(--gray-500)">(untick for a refund or correction)</span></span>
                                            </label>
                                        </div>
                                    }
                                </div>
                                <div class="form-actions" style="padding:0 4px 8px">
                                    <button class="btn btn-primary" disabled="@busy" @onclick="DoAdjust">@(busy ? "Saving…" : "Apply Adjustment")</button>
                                    <button class="btn btn-ghost" @onclick="CloseInline">Cancel</button>
                                </div>
                            </td></tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
    @if (total > pageSize)
    {
        <div class="table-footer">
            <span>Showing @items?.Count of @total</span>
            <div class="table-pagination">
                <button disabled="@(page <= 1)" @onclick="() => Go(page - 1)">‹</button>
                <span style="padding:0 10px">@(page) / @TotalPages</span>
                <button disabled="@(page >= TotalPages)" @onclick="() => Go(page + 1)">›</button>
            </div>
        </div>
    }
</div>


@* ── Existing-account conflict ────────────────────────────────────────────────────────────────
   Approval provisions a login, and a franchisee usually already has an account here from buying as
   a student. Rather than guessing — or failing on a unique-index violation the way this screen used
   to — the decision is put in front of the admin with both records side by side. Nothing has been
   written to the database at the point this appears. *@
@if (conflict is { HasConflict: true })
{
    <div class="fc-backdrop" @onclick="CancelConflict">
        <div class="fc-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="fc-modal__head">
                <span class="fc-modal__icon">⚠️</span>
                <div>
                    <h2 class="fc-modal__title">
                        @(conflict.Kind switch
                        {
                            FranchiseApprovalConflictKind.MultipleAccounts    => "Multiple Account Conflict",
                            FranchiseApprovalConflictKind.DuplicateFranchise  => "Franchise Already Exists",
                            _                                                => "Existing Account Found"
                        })
                    </h2>
                    <p class="fc-modal__sub">@conflict.Message</p>
                </div>
            </div>

            <div class="fc-modal__body">
                @if (conflict.Kind == FranchiseApprovalConflictKind.DuplicateFranchise)
                {
                    var d = conflict.DuplicateFranchise!;
                    <div class="fc-card fc-card--warn">
                        <div class="fc-card__title">Existing Franchise</div>
                        <dl class="fc-dl">
                            <dt>Name</dt><dd>@d.Name</dd>
                            <dt>Code</dt><dd>@(d.Code ?? "—")</dd>
                            <dt>Phone</dt><dd>@(d.ContactPhone ?? "—")</dd>
                            <dt>Email</dt><dd>@(d.ContactEmail ?? "—")</dd>
                            <dt>Status</dt><dd>@d.Status</dd>
                        </dl>
                    </div>
                    <p class="fc-note">
                        @(d.IsPending
                            ? "That application is still pending — approve it instead of creating a second franchise."
                            : "A duplicate franchise would split this partner's orders and commission across two records.")
                    </p>
                }
                else
                {
                    <div class="fc-compare">
                        @if (conflict.Kind == FranchiseApprovalConflictKind.MultipleAccounts)
                        {
                            <div class="fc-card fc-card--warn">
                                <div class="fc-card__title">Phone belongs to</div>
                                @AccountCard(conflict.PhoneOwner!)
                            </div>
                            <div class="fc-card fc-card--warn">
                                <div class="fc-card__title">Email belongs to</div>
                                @AccountCard(conflict.EmailOwner!)
                            </div>
                        }
                        else
                        {
                            var acct = conflict.EmailOwner ?? conflict.PhoneOwner!;
                            <div class="fc-card fc-card--warn">
                                <div class="fc-card__title">Existing Account</div>
                                @AccountCard(acct)
                            </div>
                            <div class="fc-card">
                                <div class="fc-card__title">New Franchise</div>
                                <dl class="fc-dl">
                                    <dt>Name</dt><dd>@conflict.FranchiseName</dd>
                                    <dt>Phone</dt><dd>@(conflict.FranchisePhone ?? "—")</dd>
                                    <dt>Email</dt><dd>@(conflict.FranchiseEmail ?? "—")</dd>
                                </dl>
                            </div>
                        }
                    </div>
                }

                @* The destructive path stays folded away until it is deliberately opened. *@
                @if (showReplacePanel && conflict.Kind == FranchiseApprovalConflictKind.ExistingAccount)
                {
                    var acct = conflict.EmailOwner ?? conflict.PhoneOwner!;
                    <div class="fc-danger">
                        <div class="fc-danger__title">⚠️ Replace Existing Contact Details</div>
                        <p class="fc-danger__text">
                            This changes the contact information on an account that already exists. The account,
                            its orders, wallet, course access, serial keys and history are all kept — only the
                            fields you tick below are overwritten.
                        </p>
                        <label class="fc-check">
                            <input type="checkbox" @bind="replaceEmail"
                                   disabled="@(string.Equals(acct.Email, conflict.FranchiseEmail, StringComparison.OrdinalIgnoreCase))" />
                            <span>Email &nbsp;<code>@(acct.Email ?? "—")</code> → <code>@(conflict.FranchiseEmail ?? "—")</code></span>
                        </label>
                        <label class="fc-check">
                            <input type="checkbox" @bind="replacePhone"
                                   disabled="@(string.Equals(acct.Phone, conflict.FranchisePhone, StringComparison.Ordinal))" />
                            <span>Phone &nbsp;<code>@(acct.Phone ?? "—")</code> → <code>@(conflict.FranchisePhone ?? "—")</code></span>
                        </label>
                        <label class="fc-check fc-check--confirm">
                            <input type="checkbox" @bind="confirmReplace" />
                            <span>I understand that the existing account contact information may be changed.</span>
                        </label>
                    </div>
                }

                @if (conflictErr != null)
                {
                    <div class="fc-err">@conflictErr</div>
                }
            </div>

            <div class="fc-modal__foot">
                @if (conflict.Kind == FranchiseApprovalConflictKind.ExistingAccount)
                {
                    @if (!showReplacePanel)
                    {
                        <button class="btn btn-primary" disabled="@busy" @onclick="UseExistingAccount">
                            @(busy ? "Approving…" : "Use Existing Account")
                        </button>
                        <button class="btn btn-outline fc-btn-danger" disabled="@busy" @onclick="() => showReplacePanel = true">
                            Replace Contact Details…
                        </button>
                    }
                    else
                    {
                        <button class="btn fc-btn-danger--solid" disabled="@(busy || !confirmReplace || (!replaceEmail && !replacePhone))"
                                @onclick="ReplaceContactAndApprove">
                            @(busy ? "Approving…" : "Replace & Continue")
                        </button>
                        <button class="btn btn-ghost" disabled="@busy" @onclick="() => showReplacePanel = false">Back</button>
                    }
                    <button class="btn btn-outline" disabled="@busy" @onclick="ChangeContactDetails">Change Contact Details</button>
                }
                else if (conflict.Kind == FranchiseApprovalConflictKind.DuplicateFranchise && conflict.DuplicateFranchise is { } dup)
                {
                    <a class="btn btn-primary" href="@($"/admin/franchises?focus={dup.FranchiseId}")">Open Existing Franchise</a>
                }
                <button class="btn btn-ghost" disabled="@busy" @onclick="CancelConflict">Cancel</button>
            </div>
        </div>
    </div>
}


<style>
    .fc-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.55);display:flex;align-items:center;
                 justify-content:center;padding:16px;z-index:1200}
    .fc-modal{background:#fff;border-radius:14px;width:min(760px,100%);max-height:90vh;overflow:auto;
              box-shadow:0 24px 60px rgba(0,0,0,.28)}
    .fc-modal__head{display:flex;gap:12px;align-items:flex-start;padding:18px 20px;
                    background:#FFFBEB;border-bottom:1px solid #FDE68A;border-radius:14px 14px 0 0}
    .fc-modal__icon{font-size:22px;line-height:1.2}
    .fc-modal__title{margin:0;font-size:17px;font-weight:800;color:#92400E}
    .fc-modal__sub{margin:4px 0 0;font-size:13px;color:#92400E;line-height:1.5}
    .fc-modal__body{padding:18px 20px}
    .fc-modal__foot{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;padding:14px 20px;
                    border-top:1px solid var(--gray-100,#f1f3f5)}

    .fc-compare{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
    .fc-card{border:1px solid var(--gray-200,#e5e7eb);border-radius:10px;padding:12px 14px;min-width:0}
    .fc-card--warn{border-color:#FDE68A;background:#FFFBEB}
    .fc-card__title{font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;
