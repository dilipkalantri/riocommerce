@page "/admin/settings/finance"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin,backend_user")]
@inject IFinanceSettingsService Svc
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toast
<PageTitle>Finance Settings — RioCommerce Admin</PageTitle>

<style>
    .set-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;align-items:start}
    .set-card{background:#fff;border:1px solid var(--gray-200);border-radius:12px;padding:18px}
    .set-card h3{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:4px}
    .set-card p.sub{font-size:12px;color:var(--gray-400);margin-bottom:14px}
    .set-row{margin-bottom:14px}
    .set-row label{display:block;font-size:12.5px;font-weight:600;color:var(--gray-600);margin-bottom:4px}
    .set-row .hint{font-size:11.5px;color:var(--gray-400);margin-top:3px}
    .set-row .err{font-size:11.5px;color:var(--error);margin-top:3px}
    .set-input-suffix{position:relative}
    .set-input-suffix .suffix{position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--gray-400);font-size:12px;pointer-events:none}
    .set-toggle{display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:500;color:var(--navy)}
    .settings-savebar{position:sticky;bottom:0;margin-top:18px;background:#fff;border:1px solid var(--gray-200);border-radius:12px;
        padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;box-shadow:0 -4px 14px rgba(15,23,42,.06);z-index:5}
    .settings-savebar .msg{font-size:13px}
    .hist-row{display:flex;gap:10px;font-size:12.5px;padding:6px 0;border-bottom:1px solid var(--gray-50);flex-wrap:wrap}
    .hist-row .k{font-weight:600;color:var(--navy);min-width:200px}
</style>

<div class="page__header"><h1>Finance Settings</h1></div>

@if (finance == null || payout == null)
{
    <p style="color:var(--gray-400);padding:30px 0">Loading…</p>
}
else
{
    <div class="set-grid">
        @* ── Commissions & tax ── *@
        <div class="set-card">
            <h3>Commissions &amp; Tax</h3>
            <p class="sub">Defaults that drive payout calculation and tax handling.</p>

            <div class="set-row">
                <label title="Commission % paid to franchises on attributed order revenue. 0 = no franchise commission.">Franchise commission %</label>
                <div class="set-input-suffix"><input type="number" step="0.01" class="form-input" @bind="finance.FranchiseCommissionPct" /><span class="suffix">%</span></div>
                <div class="hint">Applied to franchise-attributed order revenue when generating payouts. 0 disables it.</div>
                @if (Err("franchise") is { } e1) { <div class="err">@e1</div> }
            </div>

            <div class="set-row">
                <label title="Tax deducted at source on faculty/affiliate net earnings.">TDS %</label>
                <div class="set-input-suffix"><input type="number" step="0.01" class="form-input" @bind="finance.TdsPct" /><span class="suffix">%</span></div>
                <div class="hint">Withheld from faculty &amp; affiliate payouts. 0 disables TDS.</div>
                @if (Err("tds") is { } e2) { <div class="err">@e2</div> }
            </div>

            <div class="set-row">
                <label title="Fallback GST rate where a product has no specific rate.">Default GST %</label>
                <div class="set-input-suffix"><input type="number" step="0.01" class="form-input" @bind="finance.DefaultGstPct" /><span class="suffix">%</span></div>
                <div class="hint">Used as the default when a product doesn't define its own GST rate.</div>
                @if (Err("gst") is { } e3) { <div class="err">@e3</div> }
            </div>

            <div class="set-row">
                <label>Tax mode</label>
                <select class="form-input" @bind="finance.TaxMode">@foreach (var m in Enum.GetValues<TaxMode>()) { <option value="@m">@m</option> }</select>
                <div class="hint">Whether listed prices are tax-exclusive or tax-inclusive.</div>
            </div>

            <div class="set-row">
                <label>Rounding</label>
                <select class="form-input" @bind="finance.RoundingMode">@foreach (var m in Enum.GetValues<RoundingMode>()) { <option value="@m">@m</option> }</select>
                <div class="hint">Rounding applied to computed money amounts (to the nearest rupee).</div>
            </div>
        </div>

        @* ── Approval thresholds ── *@
        <div class="set-card">
            <h3>Approval Thresholds</h3>
            <p class="sub">Amounts above these route through the approval workflow.</p>

            <div class="set-row">
                <label title="Settlement batches with a net above this require approval.">Settlement approval threshold</label>
                <div class="set-input-suffix"><input type="number" step="1" class="form-input" @bind="finance.SettlementApprovalThreshold" /><span class="suffix">₹</span></div>
                <div class="hint">Batches above this net amount (or adjustment-heavy batches) need approval.</div>
                @if (Err("settle") is { } e4) { <div class="err">@e4</div> }
            </div>

            <div class="set-row">
                <label title="Refunds above this require approval before processing.">Refund approval threshold</label>
                <div class="set-input-suffix"><input type="number" step="1" class="form-input" @bind="finance.RefundApprovalThreshold" /><span class="suffix">₹</span></div>
                <div class="hint">Refunds above this amount are held for approval; smaller ones auto-process.</div>
                @if (Err("refund") is { } e5) { <div class="err">@e5</div> }
            </div>
        </div>

        @* ── Payouts ── *@
        <div class="set-card">
            <h3>Payouts</h3>
            <p class="sub">Settlement generation rules. Auto-settlement runs a future scheduler.</p>

            <div class="set-row">
                <label class="set-toggle"><input type="checkbox" @bind="payout.AutoSettlementEnabled" /> Enable auto-settlement</label>
                <div class="hint">When on, a scheduler will generate batches on the cadence below.</div>
            </div>

            <div class="set-row">
                <label>Payout frequency</label>
                <select class="form-input" @bind="payout.Frequency">@foreach (var f in Enum.GetValues<PayoutFrequency>()) { <option value="@f">@f</option> }</select>
            </div>

            <div class="set-row">
                <label title="Beneficiaries below this net are skipped when generating a batch.">Minimum payout amount</label>
                <div class="set-input-suffix"><input type="number" step="1" class="form-input" @bind="payout.MinimumPayoutAmount" /><span class="suffix">₹</span></div>
                <div class="hint">Net amounts below this are not settled (rolled to a later batch).</div>
                @if (Err("minpay") is { } e6) { <div class="err">@e6</div> }
            </div>

            <div class="set-row">
                <label>Max payout retries</label>
                <input type="number" step="1" class="form-input" @bind="payout.MaxRetries" />
                @if (Err("retries") is { } e7) { <div class="err">@e7</div> }
            </div>

            <div class="set-row">
                <label>Retry interval (hours)</label>
                <input type="number" step="1" class="form-input" @bind="payout.RetryIntervalHours" />
                @if (Err("interval") is { } e8) { <div class="err">@e8</div> }
            </div>
        </div>
    </div>

    @* ── Change history ── *@
    <div class="set-card" style="margin-top:16px">
        <h3 style="cursor:pointer" @onclick="ToggleHistory">@(historyOpen ? "▾" : "▸") Change history</h3>
        @if (historyOpen)
        {
            @if (history == null) { <div class="skel" style="height:40px"></div> }
            else if (history.Count == 0) { <p class="sub" style="margin:8px 0 0">No changes recorded yet.</p> }
            else
            {
                @foreach (var h in history)
                {
                    <div class="hist-row">
                        <span class="k">@h.Key</span>
                        <span>@(h.OldValue ?? "∅") → <strong>@(h.NewValue ?? "∅")</strong></span>
                        <span style="color:var(--gray-400);margin-left:auto">@h.ChangedByName · @h.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                    </div>
                }
            }
        }
    </div>

    @* ── Sticky save bar ── *@
    <div class="settings-savebar">
        <span class="msg" style="color:@(errors.Count > 0 ? "var(--error)" : "var(--gray-400)")">
            @(errors.Count > 0 ? $"{errors.Count} validation issue(s) — fix before saving" : "Changes are applied immediately across the platform on save.")
        </span>
        <button class="btn btn-primary" disabled="@(saving || errors.Count > 0)" @onclick="Save">@(saving ? "Saving…" : "💾 Save settings")</button>
    </div>
}

@code {
    private FinanceSettings? finance;
    private PayoutSettings? payout;
    private List<SettingHistoryDto>? history;
    private readonly Dictionary<string, string> errors = new();
    private bool saving, historyOpen;
    private Guid? actorId; private string actorName = "admin";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        actorId = Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        actorName = state.User.Identity?.Name ?? "admin";
        finance = await Svc.GetFinanceAsync();
        payout = await Svc.GetPayoutAsync();
    }

    private string? Err(string key) => errors.TryGetValue(key, out var v) ? v : null;

    private void Validate()
    {
        errors.Clear();
        if (finance == null || payout == null) return;
        void Pct(string k, decimal v, string label) { if (v < 0 || v > 100) errors[k] = $"{label} must be between 0 and 100."; }
        void NonNeg(string k, decimal v, string label) { if (v < 0) errors[k] = $"{label} cannot be negative."; }

        Pct("franchise", finance.FranchiseCommissionPct, "Franchise commission");
        Pct("tds", finance.TdsPct, "TDS");
        Pct("gst", finance.DefaultGstPct, "Default GST");
        NonNeg("settle", finance.SettlementApprovalThreshold, "Settlement threshold");
        NonNeg("refund", finance.RefundApprovalThreshold, "Refund threshold");
        NonNeg("minpay", payout.MinimumPayoutAmount, "Minimum payout");
        if (payout.MaxRetries < 0) errors["retries"] = "Max retries cannot be negative.";
        if (payout.RetryIntervalHours < 1) errors["interval"] = "Retry interval must be at least 1 hour.";
    }

    private async Task Save()
    {
        Validate();
        if (errors.Count > 0) { Toast.Error("Please fix the highlighted fields."); return; }
        saving = true;
        await Svc.SaveFinanceAsync(finance!, actorId, actorName);
        await Svc.SavePayoutAsync(payout!, actorId, actorName);
        saving = false;
        if (historyOpen) history = await Svc.GetHistoryAsync();
        Toast.Success("Finance settings saved.");
    }

    private async Task ToggleHistory()
    {
        historyOpen = !historyOpen;
        if (historyOpen && history == null) history = await Svc.GetHistoryAsync();
    }
}
