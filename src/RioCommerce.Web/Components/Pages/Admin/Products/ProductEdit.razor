    private Task Save() => DoSave(stay: false);
    private Task SaveContinue() => DoSave(stay: true);

    private async Task DoSave(bool stay)
    {
        if (model == null) return;
        if (string.IsNullOrWhiteSpace(model.Title)) { error = "Product name is required."; if (!IsCollapsed("info")) {} collapsed.Remove("info"); return; }
        if (model.SellingPrice <= 0) { error = "Price must be greater than 0."; collapsed.Remove("prices"); return; }
        // ── 📦 Estimated Delivery Information validation (matches the spec: required + max lengths). ──
        if (string.IsNullOrWhiteSpace(model.LectureAccessTiming)) { error = "Lecture Access Timing is required."; collapsed.Remove("delivery"); return; }
        if (model.LectureAccessTiming.Trim().Length > 100) { error = "Lecture Access Timing is too long (max 100 characters)."; collapsed.Remove("delivery"); return; }
        if (string.IsNullOrWhiteSpace(model.NotesDispatchTimeline)) { error = "Notes Dispatch Timeline is required."; collapsed.Remove("delivery"); return; }
        if (model.NotesDispatchTimeline.Trim().Length > 100) { error = "Notes Dispatch Timeline is too long (max 100 characters)."; collapsed.Remove("delivery"); return; }
        if (model.EstimatedDeliveryMessage is { Length: > 500 }) { error = "Additional Delivery Message is too long (max 500 characters)."; collapsed.Remove("delivery"); return; }
        if (!ValidateTestimonials(out var tErr))
        {
            testimonialError = tErr;
            collapsed.Remove("testimonials");
            error = tErr;
            return;
        }
        testimonialError = null;
        error = null; saving = true;
        try
        {
            var newId = await Svc.SaveAsync(model);
            // New product with default share enabled → auto-assign to franchises (honours settings).
            if (IsNew && model.EnableDefaultFranchiseShare)
            {
                try { await FranchiseSvc.AutoAssignProductToFranchisesAsync(newId); } catch { }
            }
            saving = false;
            Toast.Success("Product saved.");
            if (!stay) { Nav.NavigateTo("/admin/products"); return; }
            if (IsNew) Nav.NavigateTo($"/admin/products/{newId}");        // switch into edit mode
            else { model = await Svc.GetForEditAsync(Id); images = await Svc.ListImagesAsync(Id); spAudit = await Svc.GetSpecialPriceAuditAsync(Id); }
        }
        catch (Exception ex)
        {
            // Walk inner exceptions — EF wraps the real DB error (e.g. NOT NULL / FK violation) inside its generic message.
            var msg = ex.Message;
            var inner = ex.InnerException;
            while (inner != null) { msg += "  →  " + inner.Message; inner = inner.InnerException; }
            error = msg; saving = false; Toast.Error(msg);
        }
    }

