    /// <summary>
    /// Pre-flight validation called by <see cref="DoSave"/> before invoking
    /// the service. Rejects rows whose URL doesn't parse to a YouTube video id.
    /// </summary>
    private bool ValidateTestimonials(out string? err)
    {
        if (model == null) { err = null; return true; }
        for (var i = 0; i < model.Testimonials.Count; i++)
        {
            var t = model.Testimonials[i];
            if (string.IsNullOrWhiteSpace(t.YoutubeUrl)) continue;   // blank rows get skipped on save
            var (id, _) = YouTubeUrlHelpers.Parse(t.YoutubeUrl);
            if (id == null)
            {
                err = $"Row {i + 1}: Please enter a valid YouTube video URL.";
                return false;
            }
        }
        err = null;
        return true;
    }

    private async Task OnBookPreviewPdfUpload(InputFileChangeEventArgs e)
    {
        if (IsNew || bookPreview == null) return;
        var file = e.File;
        if (file == null) return;
        const long maxBytes = 50 * 1024 * 1024;   // 50 MB — configurable later via Settings
        if (file.Size > maxBytes) { bpMsg = "PDF too large — max 50 MB."; return; }

        bpUploadingPdf = true; bpMsg = null;
        StateHasChanged();                       // make "Uploading…" appear immediately

        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            var (ok, err) = await BookPreviewSvc.AttachPdfAsync(Id, stream, file.Name);
            if (!ok)
            {
                bpMsg = err;
                Toast.Error(err ?? "Upload failed.");
                return;
            }
            // Re-fetch so the editor reflects the new PdfRelativePath.
            bookPreview = await BookPreviewSvc.GetForAdminAsync(Id) ?? bookPreview;
            bpMsg = "Book Preview updated successfully.";
            Toast.Success("Book Preview updated successfully.");
        }
        catch (Exception ex)
        {
            // Surface the failure instead of letting Blazor swallow it — without this,
            // an exception thrown during AttachPdfAsync would leave the upload button
            // stuck on "Uploading…" because the finally would never run if the page
            // was disposed mid-flight.
            bpMsg = $"Upload failed: {ex.Message}";
            Toast.Error(bpMsg);
            Console.Error.WriteLine($"[rc.bp] Upload exception: {ex}");
        }
        finally
        {
            bpUploadingPdf = false;
            StateHasChanged();                   // force the button back to "Upload PDF"
        }
    }

    private async Task OnBookPreviewCoverUpload(InputFileChangeEventArgs e)
    {
        if (IsNew || bookPreview == null) return;
        var file = e.File;
        if (file == null) return;
        const long maxBytes = 4 * 1024 * 1024;
        if (file.Size > maxBytes) { bpMsg = "Cover too large — max 4 MB."; return; }
        var ext = System.IO.Path.GetExtension(file.Name);
        bpUploadingCover = true; bpMsg = null;
        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            // Cover reuses the existing product-asset uploader so the URL is directly browser-renderable.
            var (ok, err, url) = await Svc.UploadHomeCardImageAsync(Id, ext, stream);
            if (ok && !string.IsNullOrWhiteSpace(url)) { bookPreview.CoverImageUrl = url; bpMsg = "Cover updated."; }
            else { bpMsg = err ?? "Upload failed."; }
        }
        finally { bpUploadingCover = false; }
    }

