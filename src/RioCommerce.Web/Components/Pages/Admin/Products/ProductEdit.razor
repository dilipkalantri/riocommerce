    private void ToggleRecoDropdown() => recoDropOpen = !recoDropOpen;

    private void AddRecoHit(RecommendationSearchHit h)
    {
        if (recoItems.Any(x => x.RecommendedProductId == h.Id)) return;   // already selected — guarded by UI too
        var nextOrder = recoItems.Count == 0 ? 1 : recoItems.Max(x => x.DisplayOrder) + 1;
        recoItems.Add(new ProductRecommendationItem
        {
            Id = Guid.Empty,
            RecommendedProductId = h.Id,
            RecommendedTitle = h.Title,
            RecommendedThumbUrl = h.ThumbUrl,
            RecommendedFacultyName = h.FacultyName,
            RecommendedPrice = h.Price,
            DisplayOrder = nextOrder,
            Type = RecommendationType.StudentsAlsoAdded,
            IsActive = true
        });
        // Multi-select UX: keep the dropdown open + keep the query so the admin can add a few in a row.
    }

    // ── HTML5 drag & drop on the selected list ──
    private void OnRecoDragStart(int idx) => recoDraggingIdx = idx;

    private void OnRecoDrop(int targetIdx)
    {
        if (recoDraggingIdx is not int from || from == targetIdx) { recoDragOverIdx = null; return; }
        var moving = recoItems[from];
        recoItems.RemoveAt(from);
        var to = targetIdx > from ? targetIdx - 1 : targetIdx;
        if (to < 0) to = 0; if (to > recoItems.Count) to = recoItems.Count;
        recoItems.Insert(to, moving);
        // Renumber DisplayOrder by new visual position so the saved set keeps the dragged order on reload.
        for (int i = 0; i < recoItems.Count; i++) recoItems[i].DisplayOrder = i + 1;
        recoDraggingIdx = null; recoDragOverIdx = null;
    }

    private void OnRecoDragEnd() { recoDraggingIdx = null; recoDragOverIdx = null; }

    private async Task SaveRecommendations()
    {
        if (model?.Id is not Guid pid) return;
        recoSaving = true; recoMsg = null;
        var actor = await GetActorIdAsync();
        var (ok, err) = await RecoSvc.SaveAsync(pid, recoItems, actor);
        recoSaving = false;
        recoOk = ok;
        recoMsg = ok ? "Offer / Combo Recommendations saved successfully." : (err ?? "Could not save recommendations.");
        if (ok)
        {
            await LoadRecommendationsAsync();   // refresh server-assigned ids
            try { Toast.Success("Offer / Combo Recommendations saved successfully."); } catch { /* host not mounted */ }
        }
        else
        {
            try { Toast.Error(err ?? "Could not save recommendations."); } catch { }
        }
    }

    private async Task<Guid?> GetActorIdAsync()
    {
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            return System.Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        }
        catch { return null; }
    }

