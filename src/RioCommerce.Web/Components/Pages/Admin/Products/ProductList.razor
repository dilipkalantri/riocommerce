@page "/admin/products"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin,operations,faculty,franchise_admin,backend_user")]
@inject IProductAdminService Svc
@inject ToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Products — RioCommerce Admin</PageTitle>

<style>
    .bs-pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;letter-spacing:.4px;padding:3px 10px;border-radius:999px;line-height:1.4;white-space:nowrap;border:1px solid transparent}
    .bs-pill--upcoming{background:#FFF3E0;color:#F57C00;border-color:rgba(245,124,0,.25)}
    .bs-pill--ongoing{background:#E8F5E9;color:#2E7D32;border-color:rgba(46,125,50,.25)}
    .bs-pill--prerec{background:#E3F2FD;color:#1565C0;border-color:rgba(21,101,192,.25)}
    .bs-pill--oos{background:#FFEBEE;color:#C62828;border-color:rgba(198,40,40,.25)}
    .bs-pill--soon{background:#F3E5F5;color:#7B1FA2;border-color:rgba(123,31,162,.25)}
    .psearch{background:#fff;border:1px solid var(--gray-200);border-radius:14px;margin-top:16px;overflow:hidden;box-shadow:0 1px 2px rgba(15,23,42,.04)}
    .psearch__head{display:flex;align-items:center;justify-content:space-between;padding:13px 18px;cursor:pointer;font-weight:700;color:var(--navy);font-size:15px;border-bottom:1px solid var(--gray-100);background:linear-gradient(180deg,#fff,var(--gray-50))}
    .psearch__head .chev{color:var(--gray-400);font-size:12px;transition:transform .18s}
    .psearch.is-collapsed .psearch__head{border-bottom:0}
    .psearch.is-collapsed .psearch__head .chev{transform:rotate(-90deg)}
    .psearch.is-collapsed .psearch__body{display:none}
    .psearch__body{padding:18px}
    .psearch__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px 28px}
    .psearch__fg{display:flex;flex-direction:column;gap:5px;min-width:0}
    .psearch__fg label{font-size:12.5px;font-weight:600;color:var(--gray-600)}
    .psearch__chk{display:flex;align-items:center;gap:8px;font-size:13.5px;color:var(--gray-700);cursor:pointer}
    .psearch__sku{display:flex}
    .psearch__sku .form-input{border-top-right-radius:0;border-bottom-right-radius:0;border-right:0}
    .psearch__sku .btn{border-top-left-radius:0;border-bottom-left-radius:0;white-space:nowrap;padding-inline:16px}
    .psearch__actions{display:flex;justify-content:center;gap:10px;margin-top:20px;flex-wrap:wrap}
</style>

<div class="page__header"><h1>Product Management</h1></div>

<div class="kpi-grid">
    <div class="kpi-card"><div class="kpi-card__label">Total Products</div><div class="kpi-card__value">@(stats?.Total ?? 0)</div></div>
    <div class="kpi-card"><div class="kpi-card__label">Active</div><div class="kpi-card__value" style="color:var(--green)">@(stats?.Active ?? 0)</div></div>
    <div class="kpi-card"><div class="kpi-card__label">CA Foundation</div><div class="kpi-card__value">@(stats?.Foundation ?? 0)</div></div>
    <div class="kpi-card"><div class="kpi-card__label">CA Intermediate</div><div class="kpi-card__value">@(stats?.Intermediate ?? 0)</div></div>
</div>

@* ── nopCommerce-style search panel ── *@
<div class="psearch @(searchOpen ? "" : "is-collapsed")">
    <div class="psearch__head" @onclick="() => searchOpen = !searchOpen">
        <span>🔍 Search</span><span class="chev">▾</span>
    </div>
    <div class="psearch__body">
        <div class="psearch__grid">
            <div class="psearch__fg"><label>Product name</label>
                <input class="form-input" placeholder="Search by name…" @bind="search" @bind:event="oninput" @onkeydown="OnKey" />
            </div>
            <div class="psearch__fg"><label>Product type</label>
                <select class="form-input" @bind="courseTypeStr">
                    <option value="">All</option>
                    @foreach (var t in Enum.GetValues<CourseType>()) { <option value="@((int)t)">@t</option> }
                </select>
            </div>

            <div class="psearch__fg"><label>Category</label>
                <select class="form-input" @bind="categoryStr" @bind:after="CascadeFilters">
                    <option value="">All</option>
                    @if (meta != null) { @foreach (var c in meta.Categories) { <option value="@c.Id">@c.Name</option> } }
                </select>
            </div>
            <div class="psearch__fg"><label>Published</label>
                <select class="form-input" @bind="statusStr">
                    <option value="">All</option><option value="0">Active</option><option value="1">Draft</option><option value="2">Archived</option>
                </select>
            </div>
            <div class="psearch__fg"><label>Batch Status</label>
                <select class="form-input" @bind="batchStr">
                    <option value="">All</option>
                    <option value="0">Upcoming</option>
                    <option value="1">Ongoing</option>
                    <option value="2">Pre-Recorded</option>
                    <option value="3">Out Of Stock</option>
                    <option value="4">Coming Soon</option>
                </select>
            </div>

            <div class="psearch__fg"><label>&nbsp;</label>
                <label class="psearch__chk"><input type="checkbox" @bind="searchSubcats" /> Search subcategories</label>
            </div>
            <div class="psearch__fg"><label>Level</label>
                <select class="form-input" @bind="levelStr" @bind:after="CascadeFilters">
                    <option value="">All</option>
                    @* Values come from the enum itself. The old markup listed the ordinals 0–3 by
                       hand and simply stopped before CaFinal (4), so CA Final could never be
                       filtered for. Casting removes the possibility of that drifting again. *@
                    @foreach (var l in LevelFilterOrder) { <option value="@((int)l)">@LevelLabel(l)</option> }
                </select>
            </div>

            <div class="psearch__fg"><label>Faculty</label>
                <select class="form-input" @bind="facultyStr" @bind:after="CascadeFilters">
                    <option value="">All</option>
                    @if (meta != null) { @foreach (var f in meta.Faculties) { <option value="@f.Id">@f.Name</option> } }
                </select>
            </div>
            <div class="psearch__fg"><label>Go directly to product SKU</label>
                <div class="psearch__sku">
                    <input class="form-input" placeholder="Exact SKU…" @bind="skuGo" @onkeydown="OnSkuKey" />
                    <button class="btn btn-primary" @onclick="GoToSku">Go</button>
                </div>
            </div>

            <div class="psearch__fg"><label>Subject</label>
                <select class="form-input" @bind="subjectStr" @bind:after="CascadeFilters">
                    <option value="">All</option>
                    @if (meta != null) { @foreach (var s in meta.Subjects) { <option value="@s.Id">@s.Name</option> } }
                </select>
            </div>
        </div>
        <div class="psearch__actions">
            <button class="btn btn-primary" @onclick="DoSearch">🔍 Search</button>
            <button class="btn btn-ghost" @onclick="ClearFilters">Clear filters</button>
        </div>
    </div>
</div>

<div style="margin-top:16px">
    <AdminGrid TItem="ProductListItem" GridId="products" Items="items" Columns="cols" RowId="@(p => p.Id)"
               Page="page" PageSize="pageSize" Total="total" OnPageChange="Go" OnPageSizeChange="SetPageSize"
               EmptyText="No products match your filters.">
        <Toolbar>
            <a href="/admin/products/new" class="btn btn-primary btn-sm">➕ Add Product</a>
            @* Exports whatever the filters above select, unpaged — not just the page on screen. *@
            <button class="btn btn-success btn-sm" disabled="@exporting" @onclick="ExportExcel">
                @(exporting ? "Exporting…" : "⤓ Export to Excel")
            </button>
        </Toolbar>
        <RowActions Context="p"><a href="/admin/products/@p.Id" class="btn btn-ghost btn-sm">✏️ Edit</a></RowActions>
    </AdminGrid>
</div>

@code {
    private List<ProductListItem>? items;
    private AdminProductStats? stats;
    private ProductFilterMeta? meta;
    private int page = 1, total;
    private int pageSize = 10;
    private bool searchOpen = true;
    private List<AdminGridColumn<ProductListItem>> cols = new();

    // raw form values (parsed on Search)
    private string search = "";
    private string categoryStr = "", facultyStr = "", subjectStr = "", courseTypeStr = "", levelStr = "", statusStr = "", batchStr = "";
    private bool searchSubcats;
    private string skuGo = "";

    // parsed filters in effect
    private Guid? categoryId, facultyId, subjectId;
    private CourseType? courseType;
    private CourseLevel? level;
    private ProductStatus? status;
    private BatchStatus? batchStatus;

    protected override async Task OnInitializedAsync()
    {
        BuildColumns();
        meta = await Svc.GetFilterMetaAsync();
        stats = await Svc.StatsAsync();
        await Load();
    }

    private void BuildColumns() => cols = new()
    {
        new("Product") { Cell = p => @<div class="ag-clamp2" style="max-width:300px" title="@p.Title"><strong>@p.Title</strong>@if (!string.IsNullOrEmpty(p.Badge)) { <span style="margin-left:6px;font-size:10px;color:var(--orange)">@p.Badge</span> }</div> },
        new("Level") { Priority = GridPriority.Medium, Cell = p => @<text>@LevelLabel(p.Level)</text> },
        new("Faculty") { Priority = GridPriority.Low, Cell = p => @<text>@(p.FacultyName ?? "—")</text> },
        new("MRP") { Priority = GridPriority.Low, Align = "right", Cell = p => @<text>@(p.Mrp > 0 ? $"₹{p.Mrp:N0}" : "—")</text> },
        new("Price") { Align = "right", Cell = p => @<span class="ag-amount">₹@p.SellingPrice.ToString("N0")</span> },
        new("Orders") { Priority = GridPriority.Medium, Align = "center", Cell = p => @<text>@p.TotalOrders</text> },
        new("Home Page") { Priority = GridPriority.Low, Align = "center", Cell = p => @<text>@(p.IsFeatured ? "✓" : "—")</text> },
        new("Home Order") { Priority = GridPriority.Low, Align = "center", Cell = p => @<text>@(p.IsFeatured ? p.HomePageDisplayOrder.ToString() : "—")</text> },
        new("Batch Status") { Priority = GridPriority.Medium, Align = "center", Cell = p => @<span class="bs-pill bs-pill--@BatchClass(p.BatchStatus)">@BatchDot(p.BatchStatus) @BatchShort(p.BatchStatus)</span> },
        new("Status") { Align = "center", Cell = p => @<label class="toggle-switch" @onclick:stopPropagation="true"><input type="checkbox" checked="@(p.Status == ProductStatus.Active)" @onchange="() => Toggle(p)" /><span class="toggle-slider"></span></label> },
    };

    private static string BatchClass(BatchStatus s) => s switch
    {
        BatchStatus.Upcoming => "upcoming",
        BatchStatus.Ongoing => "ongoing",
        BatchStatus.PreRecorded => "prerec",
        BatchStatus.OutOfStock => "oos",
        BatchStatus.ComingSoon => "soon",
        _ => "upcoming"
    };
    private static string BatchDot(BatchStatus s) => s switch
    {
        BatchStatus.Upcoming => "🟠",
        BatchStatus.Ongoing => "🟢",
        BatchStatus.PreRecorded => "🔵",
        BatchStatus.OutOfStock => "🔴",
        BatchStatus.ComingSoon => "🟣",
        _ => "•"
    };
    private static string BatchShort(BatchStatus s) => s switch
    {
        BatchStatus.Upcoming => "Upcoming",
        BatchStatus.Ongoing => "Ongoing",
        BatchStatus.PreRecorded => "Pre-Recorded",
        BatchStatus.OutOfStock => "Out Of Stock",
        BatchStatus.ComingSoon => "Coming Soon",
        _ => s.ToString()
    };

    private async Task Load()
    {
        var r = await Svc.ListAsync(new ProductFilterRequest
        {
            Search = search, Level = level, CourseType = courseType, CategoryId = categoryId,
            SearchSubcategories = searchSubcats, FacultyId = facultyId, SubjectId = subjectId,
            Status = status, BatchStatus = batchStatus, Page = page, PageSize = pageSize
        });
        items = r.Items; total = r.TotalCount;
    }

    private async Task DoSearch()
    {
        categoryId = ParseGuid(categoryStr);
        facultyId = ParseGuid(facultyStr);
        subjectId = ParseGuid(subjectStr);
        courseType = ParseEnum<CourseType>(courseTypeStr);
        level = ParseEnum<CourseLevel>(levelStr);
        status = ParseEnum<ProductStatus>(statusStr);
        batchStatus = ParseEnum<BatchStatus>(batchStr);
        page = 1;
        await Load();
    }

    private bool exporting;

    /// <summary>
    /// Downloads every field of every product the current filters select, as a .xlsx workbook.
    ///
    /// <para>The same filter object the grid uses, so the download matches the screen — but unpaged,
    /// because "export what I filtered to" means all of it, not the twenty rows on view.</para>
    /// </summary>
    private async Task ExportExcel()
    {
        exporting = true;
        try
        {
            var bytes = await Svc.ExportExcelAsync(new ProductFilterRequest
            {
                Search = search, Level = level, CourseType = courseType, CategoryId = categoryId,
                SearchSubcategories = searchSubcats, FacultyId = facultyId, SubjectId = subjectId,
                Status = status, BatchStatus = batchStatus,
            });

            // Base64 because a zip container cannot cross the circuit as text.
            await JS.InvokeVoidAsync("hjc.downloadBytes",
                $"products-{DateTime.Now:yyyyMMdd-HHmm}.xlsx",
                Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Toast.Success($"Exported {total} product(s).");
        }
        catch (Exception)
        {
            // Never leave the button stuck on "Exporting…" with nothing said.
            Toast.Error("Could not build the export. Please try again.");
        }
        finally { exporting = false; }
    }

    private async Task ClearFilters()
    {
        search = ""; categoryStr = facultyStr = subjectStr = courseTypeStr = levelStr = statusStr = batchStr = ""; searchSubcats = false; skuGo = "";
        categoryId = facultyId = subjectId = null; courseType = null; level = null; status = null;
        page = 1;
        // Nothing narrows the pickers any more, so the full lists have to come back with it.
        meta = await Svc.GetFilterMetaAsync();
        await Load();
    }

    // ── Cascading Category ↔ Level ↔ Faculty ↔ Subject ──────────────────────────────────────────
    // Course type, status, batch, SKU and the text search are untouched by this and keep filtering
    // the results exactly as they did. Level participates as an input only — its own dropdown is a
    // hardcoded list this change deliberately leaves alone.

    /// <summary>
    /// Re-reads the option lists for whatever is now picked, then drops only the selections the new
    /// lists no longer offer. Everything else the admin set stays exactly as it was.
    /// </summary>
    private async Task CascadeFilters()
    {
        meta = await Svc.GetFilterMetaAsync(
            ParseGuid(categoryStr), ParseGuid(subjectStr), ParseGuid(facultyStr), ParseEnum<CourseLevel>(levelStr));

        if (meta == null) return;
        categoryStr = Kept(categoryStr, meta.Categories);
        subjectStr = Kept(subjectStr, meta.Subjects);
        facultyStr = Kept(facultyStr, meta.Faculties);

        // Returns the selection if the new list still offers it, otherwise blank.
        static string Kept(string selected, List<IdName> available)
            => string.IsNullOrEmpty(selected) || available.Any(o => o.Id.ToString() == selected)
                ? selected
                : "";
    }

    private async Task GoToSku()
    {
        if (string.IsNullOrWhiteSpace(skuGo)) return;
        var id = await Svc.FindBySkuAsync(skuGo);
        if (id is Guid g) Nav.NavigateTo($"/admin/products/{g}");
        else Toast.Error($"No product found with SKU \"{skuGo.Trim()}\".");
    }

    private async Task Toggle(ProductListItem p) { await Svc.ToggleStatusAsync(p.Id); stats = await Svc.StatsAsync(); await Load(); }
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoSearch(); }
    private async Task OnSkuKey(KeyboardEventArgs e) { if (e.Key == "Enter") await GoToSku(); }
    private async Task Go(int p) { page = p; await Load(); }
    private async Task SetPageSize(int n) { pageSize = n; page = 1; await Load(); }

    private static Guid? ParseGuid(string s) => Guid.TryParse(s, out var g) ? g : null;
    private static T? ParseEnum<T>(string s) where T : struct, Enum
        => int.TryParse(s, out var n) && Enum.IsDefined(typeof(T), n) ? (T)(object)n : null;

    /// <summary>
    /// The order the Level filter offers its options in — every member of <see cref="CourseLevel"/>,
    /// none omitted.
    ///
    /// <para>It is written out rather than taken from <c>Enum.GetValues</c> because the enum is
    /// declared append-only: its ordinals are serialised into public search URLs, so CaFinal sits at
    /// the end of the declaration even though it belongs after CaIntermediate on screen. The enum's
    /// own remarks say where a level appears is the dropdown's business, and this is the same
    /// sequence the product editor and <see cref="LevelLabel"/> already use.</para>
    /// </summary>
    private static readonly CourseLevel[] LevelFilterOrder =
    {
        CourseLevel.CaFoundation,
        CourseLevel.CaIntermediate,
        CourseLevel.CaFinal,
        CourseLevel.Books,
        CourseLevel.TestSeries,
    };

    private static string LevelLabel(CourseLevel l) => l switch
    {
        CourseLevel.CaFoundation => "CA Foundation",
        CourseLevel.CaIntermediate => "CA Intermediate",
        CourseLevel.CaFinal => "CA Final",
        CourseLevel.Books => "Books",
        CourseLevel.TestSeries => "Test Series",
        _ => l.ToString()
    };
}
