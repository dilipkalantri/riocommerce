@page "/admin/returns"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin,operations,backend_user")]
@inject IOperationsService Svc
<PageTitle>Returns — RioCommerce Admin</PageTitle>

<div class="page__header"><h1>Returns &amp; Refunds</h1></div>

@if (msg != null) { <div class="inline-alert @(msgOk ? "inline-alert--ok" : "inline-alert--err")" style="margin-bottom:12px">@msg</div> }

<div class="form-card">
    <div class="form-card__title">Log a Return / Refund Request</div>
    <div class="form-grid">
        <div class="form-group"><label class="form-label">Order Number <span class="required">*</span></label><input class="form-input" @bind="req.OrderNumber" placeholder="RIO-1043" /></div>
        <div class="form-group"><label class="form-label">Refund Amount (₹)</label><input type="number" step="0.01" class="form-input" @bind="req.RefundAmount" placeholder="blank = full order" /></div>
        <div class="form-group form-group--full"><label class="form-label">Reason <span class="required">*</span></label><input class="form-input" @bind="req.Reason" /></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" disabled="@saving" @onclick="Create">@(saving ? "Saving…" : "Log Return")</button></div>
</div>

<div class="data-card" style="margin-top:20px">
    <div class="table-wrap"><table>
        <thead><tr><th>Order</th><th>Student</th><th>Reason</th><th>Refund</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
        <tbody>
            @if (items == null) { <tr><td colspan="7" style="text-align:center;color:var(--gray-400)">Loading…</td></tr> }
            else if (items.Count == 0) { <tr><td colspan="7" style="text-align:center;color:var(--gray-400)">No return requests.</td></tr> }
            else
            {
                @foreach (var r in items)
                {
                    <tr>
                        <td><strong>#@r.OrderNumber</strong></td>
                        <td>@r.StudentName</td>
                        <td style="max-width:260px">@r.Reason</td>
                        <td>₹@r.RefundAmount.ToString("N0")</td>
                        <td><span class="status @StatusClass(r.Status)"><span class="dot"></span>@r.Status</span></td>
                        <td>@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>
                            @if (r.Status == "Requested")
                            {
                                <div style="display:flex;gap:6px">
                                    <button class="btn btn-success btn-sm" @onclick="() => Resolve(r.Id, true)">Approve &amp; Refund</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => Resolve(r.Id, false)">Reject</button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table></div>
</div>

@code {
    private List<ReturnItem>? items;
    private CreateReturnRequest req = new();
    private bool saving, msgOk;
    private string? msg;

    protected override async Task OnInitializedAsync() => await Reload();
    private async Task Reload() => items = await Svc.ReturnsAsync();

    private async Task Create()
    {
        saving = true; msg = null;
        var (ok, error) = await Svc.CreateReturnAsync(req);
        saving = false;
        if (ok) { req = new CreateReturnRequest(); await Reload(); Flash(true, "Return logged."); }
        else Flash(false, error!);
    }

    private async Task Resolve(Guid id, bool approve)
    {
        var (ok, error) = await Svc.ResolveReturnAsync(id, approve);
        await Reload();
        Flash(ok, ok ? (approve ? "Refund processed — order marked Refunded." : "Return rejected.") : error!);
    }

    private void Flash(bool ok, string m) { msgOk = ok; msg = m; }

    private static string StatusClass(string s) => s switch
    {
        "Refunded" => "status--confirmed",
        "Requested" => "status--pending",
        "Approved" => "status--processing",
        _ => "status--cancelled"
    };
}
