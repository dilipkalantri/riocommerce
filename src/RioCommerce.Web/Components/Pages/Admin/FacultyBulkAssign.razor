@page "/admin/faculty/bulk-assign"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin")]
@using RioCommerce.Core.DTOs.Faculty
@using RioCommerce.Core.DTOs.Products
@using RioCommerce.Core.DTOs.Meta
@inject IFacultySharingService Svc
@inject IProductAdminService Products
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toast
<PageTitle>Bulk Assign Faculty Shares — RioCommerce Admin</PageTitle>

@*
    The faculty counterpart of Franchise → Bulk Assign: set one rate across many (product × faculty)
    pairs at once.

    The difference that shapes this whole page: a product has ONE franchisee, so a franchise bulk
    assign can never combine. A product can have MANY faculty, so 30% × 3 faculty puts a course at 90%
    of its taxable base. Hence Preview is a first-class step here rather than a nicety — you see the
    per-product before/after allocation before committing anything.
*@

<style>
    .fba-chk { display:flex; align-items:center; gap:10px; padding:6px 8px; border-radius:8px; font-size:13.5px; cursor:pointer }
    .fba-chk:hover { background:var(--gray-50) }
    .fba-note { font-size:12px; color:var(--gray-500); line-height:1.5 }
    .fba-filters { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:12px; margin-bottom:14px }
    @@media (max-width:900px){ .fba-filters{ grid-template-columns:1fr 1fr } }
    @@media (max-width:560px){ .fba-filters{ grid-template-columns:1fr } }
    .fba-badge { font-size:11.5px; font-weight:700; padding:2px 9px; border-radius:999px; white-space:nowrap }
    .fba-badge--default { background:var(--gray-100); color:#475569 }
    .fba-badge--custom { background:#eef2ff; color:#3730a3 }
    .fba-badge--gst { background:#D1FAE5; color:#065F46 }
    .fba-badge--warn { background:#FEF3C7; color:#92400E }
    .fba-badge--plain { background:var(--gray-100); color:var(--gray-600) }
    .fba-edit { display:flex; gap:6px; align-items:center }
    .fba-edit select { width:66px; min-width:66px; padding-left:8px; padding-right:4px }
    .fba-edit input { width:92px; min-width:92px }
    .fba-actions { display:flex; flex-wrap:wrap; gap:6px }
    .fba-wrap { overflow-x:auto }
    .fba-wrap table { min-width:980px }
    .ta-r { text-align:right }
    .fba-sub { font-size:11px; color:var(--gray-500); display:flex; align-items:center; gap:5px; margin-top:2px }
    .fba-pct--over { color:#B91C1C; font-weight:800 }
    .fba-arrow { color:var(--gray-400); padding:0 4px }
    .fba-prow--skip { opacity:.6 }
    .fba-prow--over { background:#FEF2F2 }
</style>

<div class="page__header">
    <h1>Bulk Assign Faculty Shares</h1>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
        <a href="/admin/faculty-sharing" class="btn btn-ghost btn-sm">‹ Faculty Revenue Sharing</a>
        <a href="/admin/revenue-sharing" class="btn btn-ghost btn-sm">Bulk Import / Export ›</a>
    </div>
</div>

@* ── Rate to apply ── *@
<div class="form-card" style="margin-bottom:16px">
    <div class="form-card__title">Rate to apply</div>
    <div class="form-grid form-grid--3col">
        <div class="form-group">
            <label class="form-label">Type</label>
            <select class="form-input" @bind="shareType">
                <option value="@SharingType.Percentage">Percentage (%)</option>
                <option value="@SharingType.FixedAmount">Fixed (₹/unit)</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Value</label>
            <input type="number" step="0.01" min="0" class="form-input" @bind="shareValue" />
        </div>
        <div class="form-group">
            <label class="form-label">Effective from</label>
            <input type="date" class="form-input" @bind="effectiveFrom" />
        </div>
        <div class="form-group">
            <label class="form-label">Effective to</label>
            <input type="date" class="form-input" @bind="effectiveTo" />
            <small class="fba-note">Blank = runs indefinitely.</small>
        </div>
        <div class="form-group" style="grid-column:span 2">
            <div class="fba-note" style="margin-bottom:8px">
                <strong>Which pairs are eligible:</strong> a rate is <strong>created</strong> only where the
                faculty is on the product's Faculty list, and <strong>updated</strong> wherever a rate already
                exists. Everything else is skipped and counted in the preview. To give a new faculty a share,
                add them to the product first.
            </div>
            <label class="fba-chk" style="padding-left:0">
                <input type="checkbox" @bind="skipOverCap" />
                <span>Skip products that would exceed the share limit</span>
            </label>
            <div class="fba-note" style="padding-left:28px">
                Off (default): the whole operation is rejected if any product would breach, so you never
                get a half-applied change. On: the breaching products are skipped and listed.
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn btn-ghost" disabled="@(busy || !CanApply)" @onclick="Preview">
            @(busy && lastWasDryRun ? "Previewing…" : "Preview impact")
        </button>
        <button class="btn btn-primary" disabled="@(busy || !CanApply)" @onclick="Apply">
            @(busy && !lastWasDryRun ? "Applying…" : ApplyLabel)
        </button>
    </div>
    <div class="fba-note">
        Sets the same rate on every selected pair. Existing rates are updated, new ones created.
        A percentage applies to the <strong>pre-GST base</strong>; GST is added on top only for
        GST-registered faculty.
    </div>
</div>

@* ── Preview / result ── *@
@if (result != null)
{
    var hasRows = result.Rows.Count > 0;
    <div class="form-card" style="margin-bottom:16px;@(result.Ok ? "" : "border-color:#FCA5A5")">
        <div class="form-card__title">
            @(result.DryRun ? "Preview" : result.Ok ? "✓ Applied" : "Not applied")
        </div>

        @if (!string.IsNullOrEmpty(result.Error))
        {
            <p style="color:var(--error);font-weight:600;margin:0 0 12px">@result.Error</p>
        }
        else
        {
            <div class="fba-note" style="margin-bottom:12px">
                @if (result.DryRun)
                {
                    <text><strong>@result.ProductsApplied</strong> product(s) would be updated
                        · <strong>@result.ProductsSkipped</strong> skipped. Nothing has been written yet.</text>
                }
                else
                {
                    <text><strong>@result.PairsApplied</strong> pair(s) applied across
                        <strong>@result.ProductsApplied</strong> product(s)
                        · <strong>@result.ProductsSkipped</strong> skipped.</text>
                }
            </div>
        }

        @if (hasRows)
        {
            <div class="table-wrap fba-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="ta-r">New</th>
                            <th class="ta-r">Updated</th>
                            <th class="ta-r">Not attached</th>
                            <th class="ta-r">Allocation</th>
                            <th class="ta-r">Payout / unit</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in result.Rows.OrderByDescending(r => r.ExceedsCap).ThenBy(r => r.ProductTitle))
                        {
                            <tr class="@(row.ExceedsCap ? "fba-prow--over" : row.WillApply ? "" : "fba-prow--skip")">
                                <td>
                                    <strong>@row.ProductTitle</strong>
                                    <div class="fba-sub">@(string.IsNullOrWhiteSpace(row.Sku) ? "no SKU" : row.Sku)</div>
                                </td>
                                <td class="ta-r">@row.RulesCreated</td>
                                <td class="ta-r">@row.RulesUpdated</td>
                                <td class="ta-r">@(row.SkippedNotAttached > 0 ? row.SkippedNotAttached.ToString() : "—")</td>
                                <td class="ta-r" style="white-space:nowrap">
                                    <span style="color:var(--gray-500)">@row.CurrentSharePct.ToString("0.##")%</span>
                                    <span class="fba-arrow">→</span>
                                    <span class="@(row.ExceedsCap ? "fba-pct--over" : "")">@row.ResultingSharePct.ToString("0.##")%</span>
                                    <div class="fba-sub" style="justify-content:flex-end">limit @row.MaxTotalSharePct.ToString("0.##")%</div>
                                </td>
                                <td class="ta-r">₹@row.ResultingPayoutPerUnit.ToString("N2")</td>
                                <td>
                                    @if (row.SkipReason != null)
                                    {
                                        <span class="fba-badge fba-badge--warn">Skipped</span>
                                        <div class="fba-sub">@row.SkipReason</div>
                                    }
                                    else if (result.DryRun)
                                    {
                                        <span class="fba-badge fba-badge--custom">Will apply</span>
                                    }
                                    else
                                    {
                                        <span class="status status--confirmed"><span class="dot"></span>Applied</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@* ── Selection ── *@
<div class="form-grid form-grid--2col" style="gap:16px">
    <div class="form-card">
        <div class="form-card__title">Faculty</div>
        <label class="fba-chk" style="font-weight:600">
            <input type="checkbox" checked="@allFaculty" @onchange="ToggleAllFaculty" />
            <span>All active faculty</span>
        </label>
        <div style="max-height:320px;overflow:auto;margin-top:8px;@(allFaculty ? "opacity:.5;pointer-events:none" : "")">
            @if (faculty == null) { <p style="color:var(--gray-400)">Loading…</p> }
            else if (faculty.Count == 0) { <p style="color:var(--gray-400)">No active faculty.</p> }
            else
            {
                @foreach (var f in faculty)
                {
                    <label class="fba-chk">
                        <input type="checkbox" checked="@selectedFaculty.Contains(f.Id)" @onchange="() => ToggleFaculty(f.Id)" />
                        <span>@f.Name</span>
                    </label>
                }
            }
        </div>
        <div class="fba-note">@FacultySelectionLabel</div>
    </div>

    <div class="form-card">
        <div class="form-card__title">Products</div>
        <input class="form-input" placeholder="🔍 Filter products…" @bind="productFilter"
               @bind:event="oninput" @bind:after="ApplyProductFilter" style="margin-bottom:8px" />
        <label class="fba-chk" style="font-weight:600">
            <input type="checkbox" checked="@AllVisibleProductsChecked" @onchange="ToggleAllVisibleProducts" />
            <span>Select all shown</span>
        </label>
        <div style="max-height:320px;overflow:auto;margin-top:8px">
            @if (products == null) { <p style="color:var(--gray-400)">Loading…</p> }
            else if (visibleProducts.Count == 0) { <p style="color:var(--gray-400)">No products match.</p> }
            else
            {
                @foreach (var p in visibleProducts)
                {
                    <label class="fba-chk">
                        <input type="checkbox" checked="@selectedProducts.Contains(p.Id)" @onchange="() => ToggleProduct(p.Id)" />
                        <span>@p.Title</span>
                    </label>
                }
            }
        </div>
        <div class="fba-note">@selectedProducts.Count product(s) selected.</div>
    </div>
</div>

@* ── Existing assignments ── *@
<div class="form-card" style="margin-top:20px">
    <div class="form-card__title">Assigned Faculty Shares</div>
    <div class="fba-filters">
        <div class="form-group">
            <label class="form-label">Faculty</label>
            <select class="form-input" @bind="fltFaculty" @bind:after="StateHasChanged">
                <option value="">All faculty</option>
                @if (faculty != null) { @foreach (var f in faculty) { <option value="@f.Id">@f.Name</option> } }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Product</label>
            <select class="form-input" @bind="fltProduct" @bind:after="StateHasChanged">
                <option value="">All products</option>
                @if (products != null) { @foreach (var p in products) { <option value="@p.Id">@p.Title</option> } }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-input" @bind="fltStatus" @bind:after="StateHasChanged">
                <option value="">Any status</option>
                <option value="active">Enabled</option>
                <option value="inactive">Disabled</option>
                <option value="scheduled">Not yet / no longer in effect</option>
                <option value="overcap">On an over-allocated product</option>
                <option value="detached">Faculty not on the product</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Rate (min–max)</label>
            <div style="display:flex;gap:6px;align-items:center">
                <input type="number" class="form-input" placeholder="min" @bind="fltMin" @bind:after="StateHasChanged" />
                <span>–</span>
                <input type="number" class="form-input" placeholder="max" @bind="fltMax" @bind:after="StateHasChanged" />
            </div>
        </div>
    </div>

    <div class="table-wrap fba-wrap">
        <table>
            <thead>
                <tr>
                    <th>Faculty</th>
                    <th>Product</th>
                    <th>Rate</th>
                    <th>Source</th>
                    <th class="ta-r">Share (₹)</th>
                    <th class="ta-r">GST (₹)</th>
                    <th class="ta-r">Payout (₹)</th>
                    <th class="ta-r">Product total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (assignments == null)
                {
                    <tr><td colspan="10" style="text-align:center;color:var(--gray-400)">Loading…</td></tr>
                }
                else
                {
                    var shown = FilteredAssignments;
                    if (shown.Count == 0)
                    {
                        <tr><td colspan="10" style="text-align:center;color:var(--gray-400)">No assignments match.</td></tr>
                    }
                    else
                    {
                        @foreach (var a in shown)
                        {
                            var key = (a.ProductId, a.FacultyId);
                            <tr>
                                <td>
                                    <strong>@a.FacultyName</strong>
                                    <div class="fba-sub">
                                        @a.FacultyShortCode
                                        @if (a.FacultyIsGstRegistered) { <span class="fba-badge fba-badge--gst">GST</span> }
                                        else { <span class="fba-badge fba-badge--plain">No GST</span> }
                                    </div>
                                </td>
                                <td>
                                    <a href="/admin/products/@a.ProductId">@a.ProductTitle</a>
                                    <div class="fba-sub">
                                        @(string.IsNullOrWhiteSpace(a.Sku) ? "no SKU" : a.Sku)
                                        @if (!a.IsAttachedToProduct) { <span class="fba-badge fba-badge--warn" title="This faculty is not listed on the product, but the rule is a live agreement and still pays out">not on product</span> }
                                    </div>
                                </td>
                                <td>
                                    @if (editKey == key)
                                    {
                                        <div class="fba-edit">
                                            <select class="form-input" @bind="editType">
                                                <option value="@SharingType.Percentage">%</option>
                                                <option value="@SharingType.FixedAmount">₹</option>
                                            </select>
                                            <input type="number" step="0.01" min="0" class="form-input" @bind="editValue" placeholder="0" />
                                        </div>
                                    }
                                    else
                                    {
                                        @(a.Type == SharingType.Percentage
                                            ? a.AssignedValue.ToString("0.##") + "%"
                                            : "₹" + a.AssignedValue.ToString("N2"))
                                    }
                                </td>
                                <td>
                                    @if (a.IsCustom) { <span class="fba-badge fba-badge--custom">Custom</span> }
                                    else { <span class="fba-badge fba-badge--default">Default</span> }
                                </td>
                                <td class="ta-r">@a.ShareAmount.ToString("N2")</td>
                                <td class="ta-r">@a.GstOnShare.ToString("N2")</td>
                                <td class="ta-r"><strong>@a.TotalPayout.ToString("N2")</strong></td>
                                <td class="ta-r">
                                    <span class="@(a.ProductExceedsCap ? "fba-pct--over" : "")">@a.ProductTotalSharePct.ToString("0.##")%</span>
                                    @if (a.WasCapped) { <div class="fba-sub" style="justify-content:flex-end;color:#B45309">capped</div> }
                                </td>
                                <td>
                                    @if (!a.IsActive) { <span class="status status--pending"><span class="dot"></span>Disabled</span> }
                                    else if (!a.IsInEffect) { <span class="fba-badge fba-badge--warn" title="Active, but outside its effective window">Scheduled</span> }
                                    else { <span class="status status--confirmed"><span class="dot"></span>Enabled</span> }
                                    @if (a.EffectiveFrom.HasValue || a.EffectiveTo.HasValue)
                                    {
                                        <div class="fba-sub">
                                            @(a.EffectiveFrom?.ToLocalTime().ToString("dd MMM yy") ?? "—")
                                            → @(a.EffectiveTo?.ToLocalTime().ToString("dd MMM yy") ?? "∞")
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (editKey == key)
                                    {
                                        <div class="fba-actions">
                                            <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="SaveEdit">Save</button>
                                            <button class="btn btn-ghost btn-sm" @onclick="CancelEdit">Cancel</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fba-actions">
                                            <button class="btn btn-ghost btn-sm" @onclick="() => BeginEdit(a)">Edit</button>
                                            <button class="btn btn-ghost btn-sm" disabled="@busy" @onclick="() => Toggle(a)">@(a.IsActive ? "Disable" : "Enable")</button>
                                            <button class="btn btn-ghost btn-sm" disabled="@busy" style="color:#b91c1c" @onclick="() => Remove(a)">Remove</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="fba-note" style="margin-top:8px">
        @(assignments?.Count ?? 0) total assignment(s) · @FilteredAssignments.Count shown.
        Removing an assignment lets the faculty fall back to the product's default share, if one is enabled.
    </div>
</div>

@code {
    private List<IdName>? faculty;
    private List<ProductListItem>? products;
    private List<ProductListItem> visibleProducts = new();

    private readonly HashSet<Guid> selectedFaculty = new();
    private readonly HashSet<Guid> selectedProducts = new();
    private bool allFaculty;

    private SharingType shareType = SharingType.Percentage;
    private decimal shareValue;
    private DateTime? effectiveFrom, effectiveTo;
    private bool skipOverCap;
    private string productFilter = "";
    private bool busy, lastWasDryRun;
    private FacultyBulkAssignResult? result;

    // ── Assignments grid ──
    private List<FacultyAssignmentRow>? assignments;
    private string fltFaculty = "", fltProduct = "", fltStatus = "";
    private decimal? fltMin, fltMax;
    private (Guid, Guid)? editKey;
    private SharingType editType = SharingType.Percentage;
    private decimal editValue;

    private bool CanApply =>
        (allFaculty || selectedFaculty.Count > 0) && selectedProducts.Count > 0 && shareValue > 0;

    private string ApplyLabel
    {
        get
        {
            var count = allFaculty ? (faculty?.Count ?? 0) : selectedFaculty.Count;
            return $"Apply to {count} faculty × {selectedProducts.Count} product(s)";
        }
    }

    private string FacultySelectionLabel =>
        allFaculty ? "Applies to ALL active faculty." : $"{selectedFaculty.Count} faculty selected.";

    private bool AllVisibleProductsChecked =>
        visibleProducts.Count > 0 && visibleProducts.All(p => selectedProducts.Contains(p.Id));

    private List<FacultyAssignmentRow> FilteredAssignments
    {
        get
        {
            if (assignments == null) return new();
            IEnumerable<FacultyAssignmentRow> q = assignments;
            if (Guid.TryParse(fltFaculty, out var fid)) q = q.Where(a => a.FacultyId == fid);
            if (Guid.TryParse(fltProduct, out var pid)) q = q.Where(a => a.ProductId == pid);
            q = fltStatus switch
            {
                "active" => q.Where(a => a.IsActive),
                "inactive" => q.Where(a => !a.IsActive),
                "scheduled" => q.Where(a => a.IsActive && !a.IsInEffect),
                "overcap" => q.Where(a => a.ProductExceedsCap),
                "detached" => q.Where(a => !a.IsAttachedToProduct),
                _ => q
            };
            if (fltMin.HasValue) q = q.Where(a => a.AssignedValue >= fltMin.Value);
            if (fltMax.HasValue) q = q.Where(a => a.AssignedValue <= fltMax.Value);
            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var options = await Svc.OptionsAsync();
        faculty = options.Faculty;
        var page = await Products.ListAsync(new ProductFilterRequest { Page = 1, PageSize = 500 });
        products = page.Items.ToList();
        visibleProducts = products;
        assignments = await Svc.ListAssignmentsAsync();
    }

    private void ToggleAllFaculty(ChangeEventArgs e)
    {
        allFaculty = e.Value is true;
        if (allFaculty) selectedFaculty.Clear();
    }

    private void ToggleFaculty(Guid id) { if (!selectedFaculty.Add(id)) selectedFaculty.Remove(id); }
    private void ToggleProduct(Guid id) { if (!selectedProducts.Add(id)) selectedProducts.Remove(id); }

    private void ToggleAllVisibleProducts(ChangeEventArgs e)
    {
        if (e.Value is true) foreach (var p in visibleProducts) selectedProducts.Add(p.Id);
        else foreach (var p in visibleProducts) selectedProducts.Remove(p.Id);
    }

    private void ApplyProductFilter()
    {
        if (products == null) { visibleProducts = new(); return; }
        visibleProducts = string.IsNullOrWhiteSpace(productFilter)
            ? products
            : products.Where(p => p.Title.Contains(productFilter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private BulkAssignFacultySharesRequest BuildRequest() => new()
    {
        AllFaculty = allFaculty,
        FacultyIds = selectedFaculty.ToList(),
        ProductIds = selectedProducts.ToList(),
        Type = shareType,
        Value = shareValue,
        EffectiveFrom = effectiveFrom,
        EffectiveTo = effectiveTo,
        SkipProductsOverCap = skipOverCap
    };

    private async Task Preview() => await Run(dryRun: true);
    private async Task Apply() => await Run(dryRun: false);

    private async Task Run(bool dryRun)
    {
        if (!CanApply) return;
        busy = true; lastWasDryRun = dryRun;
        try
        {
            var actor = await GetActorIdAsync() ?? Guid.Empty;
            result = await Svc.BulkAssignSharesAsync(BuildRequest(), actor, dryRun);

            if (!result.Ok) Toast.Error(result.Error ?? (dryRun ? "Preview failed." : "Apply failed."));
            else if (dryRun) Toast.Info($"Preview: {result.ProductsApplied} product(s) would change.");
            else
            {
                Toast.Success($"Applied to {result.PairsApplied} pair(s).");
                assignments = await Svc.ListAssignmentsAsync();
            }
        }
        catch (Exception ex) { Toast.Error($"{(dryRun ? "Preview" : "Apply")} failed: {ex.Message}"); }
        finally { busy = false; }
    }

    // ── Row actions ──
    private void BeginEdit(FacultyAssignmentRow a)
    {
        editKey = (a.ProductId, a.FacultyId);
        editType = a.Type;
        editValue = a.AssignedValue;
    }

    private void CancelEdit() => editKey = null;

    private async Task SaveEdit()
    {
        if (editKey is not { } key) return;
        busy = true;
        try
        {
            var actor = await GetActorIdAsync() ?? Guid.Empty;
            var (ok, err) = await Svc.UpdateAssignmentAsync(new UpdateFacultyAssignmentRequest
            {
                ProductId = key.Item1, FacultyId = key.Item2, Type = editType, Value = editValue
            }, actor);

            if (!ok) { Toast.Error(err ?? "Update failed."); return; }
            Toast.Success("Rate updated.");
            editKey = null;
            assignments = await Svc.ListAssignmentsAsync();
        }
        catch (Exception ex) { Toast.Error($"Update failed: {ex.Message}"); }
        finally { busy = false; }
    }

    private async Task Toggle(FacultyAssignmentRow a)
    {
        busy = true;
        try
        {
            var actor = await GetActorIdAsync() ?? Guid.Empty;
            var (ok, err) = await Svc.ToggleAssignmentAsync(a.ProductId, a.FacultyId, !a.IsActive, actor);
            if (!ok) { Toast.Error(err ?? "Update failed."); return; }
            assignments = await Svc.ListAssignmentsAsync();
        }
        catch (Exception ex) { Toast.Error($"Update failed: {ex.Message}"); }
        finally { busy = false; }
    }

    private async Task Remove(FacultyAssignmentRow a)
    {
        busy = true;
        try
        {
            var actor = await GetActorIdAsync() ?? Guid.Empty;
            var (ok, err) = await Svc.RemoveAssignmentAsync(a.ProductId, a.FacultyId, actor);
            if (!ok) { Toast.Error(err ?? "Remove failed."); return; }
            Toast.Success("Assignment removed.");
            assignments = await Svc.ListAssignmentsAsync();
        }
        catch (Exception ex) { Toast.Error($"Remove failed: {ex.Message}"); }
        finally { busy = false; }
    }

    private async Task<Guid?> GetActorIdAsync()
    {
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            return Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        }
        catch { return null; }
    }
}
