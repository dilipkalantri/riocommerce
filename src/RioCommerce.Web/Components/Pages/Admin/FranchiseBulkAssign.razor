@page "/admin/franchises/bulk-assign"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin")]
@using RioCommerce.Core.DTOs.Franchise
@using RioCommerce.Core.DTOs.Products
@using RioCommerce.Core.Enums
@inject IFranchiseService Svc
@inject IProductAdminService Products
@inject ToastService Toast
<PageTitle>Bulk Assign Products — RioCommerce Admin</PageTitle>

@*
    Requirement 2: assign products to MULTIPLE or ALL franchisees at once with a default
    %/fixed share. Per-franchisee customisation afterwards is done on each franchise's
    own commission page; bulk import/export lives on /admin/revenue-sharing.
*@

<div class="page__header">
    <h1>Bulk Assign Products to Franchisees</h1>
    <a href="/admin/revenue-sharing" class="btn btn-ghost">Bulk Import / Export ›</a>
</div>

<div class="form-card" style="margin-bottom:16px;border:1px solid var(--gray-200)">
    <div class="form-card__title">Import from old ERP</div>
    <div class="form-hint" style="margin-bottom:10px">
        Reads <code>ProductFranchiseeShare</code> (active) from the old ERP and maps each rule to the new
        system — matched by product SKU and franchisee email. eSharingType 1 = Percent, 2 = Fixed.
        Existing rules are updated. Unmatched product/franchise rows are skipped and listed.
    </div>
    <div class="form-group" style="margin-bottom:10px">
        <label class="form-label">ERP SQL Server connection string</label>
        <input class="form-input" type="password" @bind="erpConn"
               placeholder="Server=...,1433;Database=erp_riocommerce_com;User Id=...;Password=...;TrustServerCertificate=True;Encrypt=False" />
    </div>
    <div style="display:flex;gap:10px">
        <button class="btn btn-ghost" @onclick="ErpPreview" disabled="@erpBusy">@(erpBusy && erpDry ? "Previewing…" : "Dry run (preview)")</button>
        <button class="btn btn-primary" @onclick="ErpRun" disabled="@erpBusy">@(erpBusy && !erpDry ? "Importing…" : "Run import")</button>
    </div>

    @if (erpResult != null)
    {
        @if (erpResult.Error != null) { <pre class="form-hint" style="color:var(--danger,#DC2626);margin-top:10px;white-space:pre-wrap;font-family:ui-monospace,monospace;font-size:12px;max-height:300px;overflow:auto;padding:8px;background:#fff8f8;border:1px solid #f5c6c6;border-radius:4px">@erpResult.Error</pre> }
        else
        {
            <div class="form-hint" style="margin-top:10px">
                <strong>@(erpResult.DryRun ? "Preview" : "Import")</strong> — Mapped @erpResult.Mapped · Skipped @erpResult.Skipped · Errors @erpResult.Errors of @erpResult.Read.
                @if (erpResult.Items.Count < (erpResult.Skipped + erpResult.Errors + erpResult.Mapped))
                {
                    <span style="color:var(--gray-400)"> (showing first @erpResult.Items.Count rows — counts above are the full totals)</span>
                }
            </div>
            <div class="table-wrap" style="margin-top:8px;max-height:320px;overflow:auto"><table>
                <thead><tr><th>SKU</th><th>Franchisee email</th><th>Outcome</th><th>Note</th></tr></thead>
                <tbody>
                    @foreach (var i in erpResult.Items)
                    {
                        <tr>
                            <td>@i.Sku</td>
                            <td style="color:var(--gray-500)">@i.FranchiseeEmail</td>
                            <td>
                                @if (i.Outcome == "mapped") { <span class="status status--success"><span class="dot"></span>Mapped</span> }
                                else if (i.Outcome == "skipped") { <span style="color:var(--gray-500)">Skipped</span> }
                                else { <span style="color:var(--danger,#DC2626)">Error</span> }
                            </td>
                            <td style="font-size:12px;color:var(--gray-500)">@i.Message</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    }
</div>

<div class="form-card" style="margin-bottom:16px">
    <div class="form-card__title">Default share to apply</div>
    <div class="form-grid form-grid--3col">
        <div class="form-group">
            <label class="form-label">Type</label>
            <select class="form-input" @bind="shareType">
                <option value="@CommissionType.Percent">Percent (%)</option>
                <option value="@CommissionType.Fixed">Fixed (₹/unit)</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Value</label>
            <input type="number" step="0.01" min="0" class="form-input" @bind="shareValue" />
        </div>
        <div class="form-group" style="display:flex;align-items:flex-end">
            <button class="btn btn-primary" disabled="@(busy || !CanApply)" @onclick="Apply">
                @(busy ? "Applying…" : ApplyLabel)
            </button>
        </div>
    </div>
    <div class="form-hint">Sets the same default share for every selected franchisee × product pair. Existing rules are updated; new ones are created.</div>
</div>

<div class="form-grid form-grid--2col" style="gap:16px">
    @* ── Franchisees ── *@
    <div class="form-card">
        <div class="form-card__title">Franchisees</div>
        <label class="chk-row" style="font-weight:600">
            <input type="checkbox" checked="@allFranchisees" @onchange="ToggleAllFranchisees" />
            <span>All franchisees</span>
        </label>
        <div style="max-height:320px;overflow:auto;margin-top:8px;@(allFranchisees ? "opacity:.5;pointer-events:none" : "")">
            @if (franchises == null) { <p style="color:var(--gray-400)">Loading…</p> }
            else if (franchises.Count == 0) { <p style="color:var(--gray-400)">No franchisees.</p> }
            else
            {
                @foreach (var f in franchises)
                {
                    <label class="chk-row">
                        <input type="checkbox" checked="@selectedFranchises.Contains(f.Id)"
                               @onchange="() => ToggleFranchise(f.Id)" />
                        <span>@f.Name <span style="color:var(--gray-500)">· @f.Code · @f.City</span></span>
                    </label>
                }
            }
        </div>
        <div class="form-hint">@FranchiseSelectionLabel</div>
    </div>

    @* ── Products ── *@
    <div class="form-card">
        <div class="form-card__title">Products</div>
        <input class="form-input" placeholder="🔍 Filter products…" @bind="productFilter" @bind:event="oninput" @bind:after="ApplyProductFilter" style="margin-bottom:8px" />
        <label class="chk-row" style="font-weight:600">
            <input type="checkbox" checked="@AllVisibleProductsChecked" @onchange="ToggleAllVisibleProducts" />
            <span>Select all shown</span>
        </label>
        <div style="max-height:320px;overflow:auto;margin-top:8px">
            @if (products == null) { <p style="color:var(--gray-400)">Loading…</p> }
            else if (visibleProducts.Count == 0) { <p style="color:var(--gray-400)">No products match.</p> }
            else
            {
                @foreach (var p in visibleProducts)
                {
                    <label class="chk-row">
                        <input type="checkbox" checked="@selectedProducts.Contains(p.Id)"
                               @onchange="() => ToggleProduct(p.Id)" />
                        <span>@p.Title</span>
                    </label>
                }
            }
        </div>
        <div class="form-hint">@selectedProducts.Count product(s) selected.</div>
    </div>
</div>

<style>
    .chk-row { display:flex; align-items:center; gap:10px; padding:6px 8px; border-radius:8px; font-size:13.5px; cursor:pointer }
    .chk-row:hover { background:var(--gray-50) }
    .ap-filters { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:12px; margin-bottom:14px }
    @@media (max-width:900px){ .ap-filters{ grid-template-columns:1fr 1fr } }
    @@media (max-width:560px){ .ap-filters{ grid-template-columns:1fr } }
    .ap-badge { font-size:11.5px; font-weight:700; padding:2px 9px; border-radius:999px }
    .ap-badge--default { background:var(--gray-100); color:var(--gray-600,#475569) }
    .ap-badge--custom { background:#eef2ff; color:#3730a3 }
    .ap-inline { display:flex; gap:6px; align-items:center }
    .ap-inline select, .ap-inline input { max-width:110px }
    .ap-edit { display:flex; gap:6px; align-items:center }
    .ap-edit select { width:64px; min-width:64px; padding-left:8px; padding-right:4px }
    .ap-edit input { width:90px; min-width:90px }
    .ap-actions { display:flex; flex-wrap:wrap; gap:6px }
    .ap-table-wrap { overflow-x:auto }
    .ap-table-wrap table { min-width:880px }
</style>
@* ── Existing assignments management grid ── *@
<div class="form-card" style="margin-top:20px">
    <div class="form-card__title">Assigned Products</div>
    <div class="ap-filters">
        <div class="form-group">
            <label class="form-label">Franchise</label>
            <select class="form-input" @bind="fltFranchise" @bind:after="StateHasChanged">
                <option value="">All franchisees</option>
                @if (franchises != null) { @foreach (var f in franchises) { <option value="@f.Id">@f.Name (@f.Code)</option> } }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Product</label>
            <select class="form-input" @bind="fltProduct" @bind:after="StateHasChanged">
                <option value="">All products</option>
                @if (products != null) { @foreach (var p in products) { <option value="@p.Id">@p.Title</option> } }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-input" @bind="fltStatus" @bind:after="StateHasChanged">
                <option value="">Any status</option>
                <option value="active">Enabled</option>
                <option value="inactive">Disabled</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Share % (min–max)</label>
            <div class="ap-inline">
                <input type="number" class="form-input" placeholder="min" @bind="fltShareMin" @bind:after="StateHasChanged" style="max-width:none" />
                <span>–</span>
                <input type="number" class="form-input" placeholder="max" @bind="fltShareMax" @bind:after="StateHasChanged" style="max-width:none" />
            </div>
        </div>
    </div>

    <div class="table-wrap ap-table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Franchise</th>
                    <th>Product</th>
                    <th>Assigned Share</th>
                    <th>Share Type</th>
                    <th>Assigned</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (assignments == null) { <tr><td colspan="7" style="text-align:center;color:var(--gray-400)">Loading…</td></tr> }
                else if (FilteredAssignments.Count == 0) { <tr><td colspan="7" style="text-align:center;color:var(--gray-400)">No assignments match.</td></tr> }
                else
                {
                    @foreach (var a in FilteredAssignments)
                    {
                        var key = (a.FranchiseId, a.ProductId);
                        <tr>
                            <td><strong>@a.FranchiseName</strong><br /><span style="font-size:11px;color:var(--gray-500)">@a.FranchiseCode</span></td>
                            <td>@a.ProductTitle</td>
                            <td>
                                @if (editKey == key)
                                {
                                    <div class="ap-edit">
                                        <select class="form-input" @bind="editType">
                                            <option value="@CommissionType.Percent">%</option>
                                            <option value="@CommissionType.Fixed">₹</option>
                                        </select>
                                        <input type="number" step="0.01" min="0" class="form-input" @bind="editValue" placeholder="0" />
                                    </div>
                                }
                                else
                                {
                                    @(a.Type == CommissionType.Percent ? a.AssignedValue.ToString("0.##") + "%" : "₹" + a.AssignedValue.ToString("N0"))
                                }
                            </td>
                            <td>
                                @if (a.IsCustom) { <span class="ap-badge ap-badge--custom">Custom</span> }
                                else { <span class="ap-badge ap-badge--default">Default</span> }
                            </td>
                            <td><span style="font-size:12px">@a.AssignedAt.ToLocalTime().ToString("dd MMM yyyy")</span></td>
                            <td>
                                @if (a.IsActive) { <span class="status status--confirmed"><span class="dot"></span>Enabled</span> }
                                else { <span class="status status--pending"><span class="dot"></span>Disabled</span> }
                            </td>
                            <td>
                                @if (editKey == key)
                                {
                                    <div class="ap-actions">
                                        <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="SaveEdit">Save</button>
                                        <button class="btn btn-ghost btn-sm" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="ap-actions">
                                        <button class="btn btn-ghost btn-sm" @onclick="() => BeginEdit(a)">Edit</button>
                                        <button class="btn btn-ghost btn-sm" disabled="@busy" @onclick="() => Toggle(a)">@(a.IsActive ? "Disable" : "Enable")</button>
                                        <button class="btn btn-ghost btn-sm" disabled="@busy" @onclick="() => Remove(a)" style="color:#b91c1c">Remove</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="form-hint" style="margin-top:8px">@(assignments?.Count ?? 0) total assignment(s) · @FilteredAssignments.Count shown.</div>
</div>

@code {
    // ── ERP franchise-share import ──
    private string? erpConn;
    private bool erpBusy, erpDry;
    private ErpShareImportResult? erpResult;

    private async Task ErpPreview()
    {
        if (string.IsNullOrWhiteSpace(erpConn)) { Toast.Error("Enter the ERP connection string."); return; }
        erpBusy = true; erpDry = true;
        try
        {
            erpResult = await Svc.ImportErpFranchiseSharesAsync(new ErpShareImportRequest { SourceConnectionString = erpConn!, DryRun = true }, Guid.Empty);
            if (erpResult.Ok) Toast.Success("Preview complete — review, then run.");
            else Toast.Error("Preview failed — see details.");
        }
        catch (Exception ex) { Toast.Error($"Preview failed: {ex.Message}"); }
        finally { erpBusy = false; }
    }

    private async Task ErpRun()
    {
        if (string.IsNullOrWhiteSpace(erpConn)) { Toast.Error("Enter the ERP connection string."); return; }
        erpBusy = true; erpDry = false;
        try
        {
            erpResult = await Svc.ImportErpFranchiseSharesAsync(new ErpShareImportRequest { SourceConnectionString = erpConn!, DryRun = false }, Guid.Empty);
            if (erpResult.Ok) { Toast.Success($"Imported {erpResult.Mapped} share rule(s)."); assignments = await Svc.ListAssignmentsAsync(); }
            else Toast.Error("Import failed — see details.");
        }
        catch (Exception ex) { Toast.Error($"Import failed: {ex.Message}"); }
        finally { erpBusy = false; }
    }

    private List<FranchiseCard>? franchises;
    private List<ProductListItem>? products;
    private List<ProductListItem> visibleProducts = new();

    private readonly HashSet<Guid> selectedFranchises = new();
    private readonly HashSet<Guid> selectedProducts = new();
    private bool allFranchisees;

    private CommissionType shareType = CommissionType.Percent;
    private decimal shareValue;
    private string productFilter = "";
    private bool busy;

    // ── Assigned-products grid ──
    private List<FranchiseAssignmentRow>? assignments;
    private string fltFranchise = "";
    private string fltProduct = "";
    private string fltStatus = "";
    private decimal? fltShareMin, fltShareMax;
    private (Guid, Guid)? editKey;
    private CommissionType editType = CommissionType.Percent;
    private decimal editValue;

    private List<FranchiseAssignmentRow> FilteredAssignments
    {
        get
        {
            if (assignments == null) return new();
            IEnumerable<FranchiseAssignmentRow> q = assignments;
            if (Guid.TryParse(fltFranchise, out var fid)) q = q.Where(a => a.FranchiseId == fid);
            if (Guid.TryParse(fltProduct, out var pid)) q = q.Where(a => a.ProductId == pid);
            if (fltStatus == "active") q = q.Where(a => a.IsActive);
            else if (fltStatus == "inactive") q = q.Where(a => !a.IsActive);
            if (fltShareMin.HasValue) q = q.Where(a => a.AssignedValue >= fltShareMin.Value);
            if (fltShareMax.HasValue) q = q.Where(a => a.AssignedValue <= fltShareMax.Value);
            return q.ToList();
        }
    }

    private bool CanApply =>
        (allFranchisees || selectedFranchises.Count > 0)
        && selectedProducts.Count > 0
        && shareValue >= 0;

    private string ApplyLabel
    {
        get
        {
            var fCount = allFranchisees ? (franchises?.Count ?? 0) : selectedFranchises.Count;
            return $"Apply to {fCount} franchisee(s) × {selectedProducts.Count} product(s)";
        }
    }

    private string FranchiseSelectionLabel =>
        allFranchisees ? "Applies to ALL active franchisees." : $"{selectedFranchises.Count} franchisee(s) selected.";

    private bool AllVisibleProductsChecked =>
        visibleProducts.Count > 0 && visibleProducts.All(p => selectedProducts.Contains(p.Id));

    protected override async Task OnInitializedAsync()
    {
        franchises = await Svc.FranchisesAsync();
        var page = await Products.ListAsync(new ProductFilterRequest { Page = 1, PageSize = 500 });
        products = page.Items.ToList();
        visibleProducts = products;
        assignments = await Svc.ListAssignmentsAsync();
    }

    private void ToggleAllFranchisees(ChangeEventArgs e)
    {
        allFranchisees = e.Value is true;
        if (allFranchisees) selectedFranchises.Clear();
    }

    private void ToggleFranchise(Guid id)
    {
        if (!selectedFranchises.Add(id)) selectedFranchises.Remove(id);
    }

    private void ToggleProduct(Guid id)
    {
        if (!selectedProducts.Add(id)) selectedProducts.Remove(id);
    }

    private void ToggleAllVisibleProducts(ChangeEventArgs e)
    {
        if (e.Value is true) foreach (var p in visibleProducts) selectedProducts.Add(p.Id);
        else foreach (var p in visibleProducts) selectedProducts.Remove(p.Id);
    }

    private void ApplyProductFilter()
    {
        if (products == null) { visibleProducts = new(); return; }
        visibleProducts = string.IsNullOrWhiteSpace(productFilter)
            ? products
            : products.Where(p => p.Title.Contains(productFilter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task Apply()
    {
        if (!CanApply) return;
        busy = true;
        try
        {
            var (ok, error, n) = await Svc.BulkAssignAcrossFranchiseesAsync(new BulkAssignAcrossFranchiseesRequest
            {
                AllFranchisees = allFranchisees,
                FranchiseIds = selectedFranchises.ToList(),
                ProductIds = selectedProducts.ToList(),
                Type = shareType,
                Value = shareValue,
            }, actorUserId: Guid.Empty);

            if (ok) { Toast.Success($"Applied to {n} franchise-product pair(s)."); assignments = await Svc.ListAssignmentsAsync(); }
            else Toast.Error(error ?? "Apply failed.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Apply failed: {ex.Message}");
        }
        finally { busy = false; }
    }

    // ── Assignment row actions ──
    private void BeginEdit(FranchiseAssignmentRow a)
    {
        editKey = (a.FranchiseId, a.ProductId);
        editType = a.Type;
        editValue = a.AssignedValue;
    }

    private void CancelEdit() => editKey = null;

    private async Task SaveEdit()
    {
        if (editKey is not { } key) return;
        busy = true;
        try
        {
            var (ok, err) = await Svc.UpdateAssignmentAsync(new UpdateAssignmentRequest
            {
                FranchiseId = key.Item1, ProductId = key.Item2, Type = editType, Value = editValue
            }, Guid.Empty);
            if (ok) { Toast.Success("Share updated."); editKey = null; assignments = await Svc.ListAssignmentsAsync(); }
            else Toast.Error(err ?? "Update failed.");
        }
        catch (Exception ex) { Toast.Error($"Update failed: {ex.Message}"); }
        finally { busy = false; }
    }

    private async Task Toggle(FranchiseAssignmentRow a)
    {
        busy = true;
        try
        {
            var (ok, err) = await Svc.ToggleAssignmentAsync(a.FranchiseId, a.ProductId, !a.IsActive, Guid.Empty);
            if (ok) { assignments = await Svc.ListAssignmentsAsync(); }
            else Toast.Error(err ?? "Update failed.");
        }
        catch (Exception ex) { Toast.Error($"Update failed: {ex.Message}"); }
        finally { busy = false; }
    }

    private async Task Remove(FranchiseAssignmentRow a)
    {
        busy = true;
        try
        {
            var (ok, err) = await Svc.RemoveAssignmentAsync(a.FranchiseId, a.ProductId, Guid.Empty);
            if (ok) { Toast.Success("Assignment removed."); assignments = await Svc.ListAssignmentsAsync(); }
            else Toast.Error(err ?? "Remove failed.");
        }
        catch (Exception ex) { Toast.Error($"Remove failed: {ex.Message}"); }
        finally { busy = false; }
    }
}
