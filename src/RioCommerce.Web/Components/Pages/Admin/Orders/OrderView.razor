    // Serial-key status → the shared admin status pill. The Serial Keys screen has its own
    // sk-status--* classes but they are page-scoped, so the global status--* set is used here.
    private static string KeyStatusClass(SerialKeyStatus s) => s switch
    {
        SerialKeyStatus.Activated => "status--confirmed",
        SerialKeyStatus.Generated => "status--success",
        SerialKeyStatus.Generating => "status--processing",
        SerialKeyStatus.Pending => "status--pending",
        SerialKeyStatus.Failed => "status--warning",
        SerialKeyStatus.DeadLettered => "status--danger",
        SerialKeyStatus.Revoked => "status--cancelled",
        _ => "status--neutral",
    };

    // "DeadLettered" is accurate but opaque to a non-engineer reading an order — it means the
    // retries are exhausted and it will not try again on its own.
    private static string KeyStatusLabel(SerialKeyStatus s) => s switch
    {
        SerialKeyStatus.Activated => "Activated",
        SerialKeyStatus.Generated => "Generated",
        SerialKeyStatus.Generating => "Generating…",
        SerialKeyStatus.Pending => "Waiting to dispatch",
        SerialKeyStatus.Failed => "Failed — will retry",
        SerialKeyStatus.DeadLettered => "Failed — retries exhausted",
        SerialKeyStatus.Revoked => "Revoked",
        _ => s.ToString(),
    };

