    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        actorId = Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        actorName = state.User.Identity?.Name ?? "admin";
        // Cancel and delete are super-admin only. This hides the affordances; the service enforces
        // the same rule, so nothing is riding on the UI alone.
        isSuperAdmin = state.User.IsInRole("super_admin");
        // Staff roles win: a user who is admin or super admin is treated as staff even if they also
        // carry a franchise role, so franchise access can never quietly remove admin rights.
        isFranchiseUser = state.User.IsInRole("franchise_admin")
                          && !state.User.IsInRole("super_admin")
                          && !state.User.IsInRole("admin");
