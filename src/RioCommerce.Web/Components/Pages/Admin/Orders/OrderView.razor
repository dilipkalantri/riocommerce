    private static (string cat, string icon, string color, string dot) TimelineMeta(string a)
    {
        if (a.StartsWith("OrderStatus") || a == "OrderBulkStatusChanged") return ("status", "🔄", "amber", "#D97706");
        if (a.StartsWith("OrderItem")) return ("items", "📦", "purple", "#7c3aed");
        if (a == "ManualPaymentRecorded") return ("payments", "💳", "blue", "#2563EB");
        if (a.StartsWith("Refund")) return ("refunds", "↩", "red", "#DC2626");
        if (a == "OrderEnrollmentActivated") return ("enrollment", "🎓", "green", "#16a34a");
        if (a.StartsWith("OrderNote")) return ("notes", "📝", "gray", "#6B7280");
        if (a.StartsWith("Attachment")) return ("attachments", "📎", "teal", "#0d9488");
        return ("system", "🧾", "gray", "#6B7280");
    }

    private static (Dictionary<string, string> before, Dictionary<string, string> after)? ParseDiff(string? details)
    {
        if (string.IsNullOrEmpty(details)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(details);
            var root = doc.RootElement;
            if (root.ValueKind != System.Text.Json.JsonValueKind.Object) return null;
            if (root.TryGetProperty("Before", out var b) && root.TryGetProperty("After", out var af)
                && b.ValueKind == System.Text.Json.JsonValueKind.Object && af.ValueKind == System.Text.Json.JsonValueKind.Object)
                return (ToDict(b), ToDict(af));
            return null;
        }
        catch { return null; }
    }
    private static Dictionary<string, string> ToDict(System.Text.Json.JsonElement el)
    {
        var d = new Dictionary<string, string>();
        foreach (var p in el.EnumerateObject()) d[p.Name] = p.Value.ToString();
        return d;
    }
    private static string PrettyDetails(string? details)
    {
        if (string.IsNullOrEmpty(details)) return "";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(details);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) return details;
            return string.Join("   ·   ", doc.RootElement.EnumerateObject().Select(p => $"{p.Name}: {p.Value}"));
        }
        catch { return details; }
    }
    private static string Ago(DateTime utc)
    {
        var s = DateTime.UtcNow - utc;
        if (s.TotalMinutes < 1) return "just now";
        if (s.TotalMinutes < 60) return $"{(int)s.TotalMinutes}m ago";
        if (s.TotalHours < 24) return $"{(int)s.TotalHours}h ago";
        return utc.ToLocalTime().ToString("dd MMM yyyy, HH:mm");
    }

