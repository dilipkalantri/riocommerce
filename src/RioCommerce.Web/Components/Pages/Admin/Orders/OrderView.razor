            history = await Svc.GetHistoryAsync(Id);
            txns = await Txns.ListAsync(Id);
            refundSummary = await Refunds.GetSummaryAsync(Id);
            attachments = await Attachments.ListForOrderAsync(Id);
            // Best-effort: a serial-key provider being unreachable must never stop the order page
            // from rendering. An empty list reads as "nothing issued", which is the honest fallback.
            try { serialKeys = (await SerialKeys.ListAsync(new SerialKeyListFilter { OrderId = Id, PageSize = 100 })) ?? new(); }
