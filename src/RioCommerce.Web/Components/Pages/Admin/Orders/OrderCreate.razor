    protected override async Task OnInitializedAsync()
    {
        try { referralOptions = await Referrals.ListActiveAsync(); }
        catch { referralOptions = new(); }
        // Recent customers seed — appears when the dropdown opens with no query.
        try { customerSuggestions = await Users.RecentCustomersAsync(10); }
        catch { customerSuggestions = new(); }
        // Payment modes for a COUNTER order: the configured gateways (Razorpay/Easebuzz per
        // /admin/payment-settings) plus BankTransfer, Cash and UPI — staff are taking the money in
        // person here, so cash in hand and a UPI transfer are both real options. The franchise order
        // form and the Orders filter keep the narrower GetAvailableAsync list.
        try { allowedPaymentModes = await PaymentModes.GetCounterAsync(); }
        catch { allowedPaymentModes = new() { PaymentMode.Cash, PaymentMode.Upi, PaymentMode.BankTransfer }; }
        // Installment configuration — drives whether the section appears + default counts/minimums.
        try { settings = await Installments.GetSettingsAsync(); }
        catch { settings = new InstallmentSettingsModel { AllowInstallments = false }; }
    }

    // ── Installment state ──────────────────────────────────────────────
    private InstallmentSettingsModel? settings;
