    private async Task SelectProduct(ProductPickItem p)
    {
        ClosePicker();
        // Load detail (modes + attributes)
        if (!lineDetails.ContainsKey(p.Id))
        {
            var d = await Orders.GetProductPickDetailAsync(p.Id);
            if (d != null) lineDetails[p.Id] = d;
        }
        var detail = lineDetails.GetValueOrDefault(p.Id);
        var firstMode = detail?.Modes.FirstOrDefault();
        var preselected = detail?.Attributes
            .SelectMany(a => a.Values.Where(v => v.IsPreSelected).Select(v => v.Id))
            .ToList() ?? new();
        req.Items.Add(new CreateOrderLineV2
        {
            ProductId = p.Id,
            ProductModeId = firstMode?.Id,
            Quantity = 1,
            SelectedAttributeValueIds = preselected,
        });
        SyncPaymentAmount();
        StateHasChanged();
    }

