    private static bool IsMulti(string controlType) =>
        controlType?.Equals("Checkboxes", StringComparison.OrdinalIgnoreCase) == true;

    private void ToggleAttribute(int lineIdx, Guid mappingId, Guid valueId, bool multi)
    {
        var line = req.Items[lineIdx];
        var detail = lineDetails.GetValueOrDefault(line.ProductId);
        var group = detail?.Attributes.FirstOrDefault(a => a.MappingId == mappingId);
        if (group == null) return;
        var siblingIds = group.Values.Select(v => v.Id).ToHashSet();

        if (multi)
        {
            if (line.SelectedAttributeValueIds.Contains(valueId)) line.SelectedAttributeValueIds.Remove(valueId);
            else line.SelectedAttributeValueIds.Add(valueId);
        }
        else
        {
            // Drop any other selection from this group, then add the chosen one
            line.SelectedAttributeValueIds = line.SelectedAttributeValueIds.Where(id => !siblingIds.Contains(id)).ToList();
            line.SelectedAttributeValueIds.Add(valueId);
        }
        SyncPaymentAmount();
    }

