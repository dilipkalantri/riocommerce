    private string? NameError =>
        string.IsNullOrEmpty(newCustomer.FullName) ? null
        : newCustomer.FullName.Trim().Length < 2 ? "Enter the customer's full name."
        : null;

    private string? PhoneError =>
        string.IsNullOrEmpty(newCustomer.Phone) ? null
        : newCustomer.Phone.Length != 10 ? "Mobile must be exactly 10 digits."
        : null;

    private string? EmailError =>
        string.IsNullOrEmpty(newCustomer.Email) ? null
        : !IsValidEmail(newCustomer.Email) ? "Enter a valid email address."
        : null;

    private static bool IsValidEmail(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return false;
        var at = s.IndexOf('@');
        return at > 0 && at < s.Length - 3 && s.IndexOf('.', at) > 0 && !s.Contains(' ');
    }

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(newCustomer.FullName) && newCustomer.FullName.Trim().Length >= 2
        && newCustomer.Phone?.Length == 10
        && IsValidEmail(newCustomer.Email)
        // Address, city and PIN are mandatory here too: this customer is being created mid-order, and
        // the order copies these straight into its billing address. Letting them through blank just
        // moves the missing-address problem to Dispatch.
        && !string.IsNullOrWhiteSpace(newCustomer.Address)
        && !string.IsNullOrWhiteSpace(newCustomer.City)
        && IsValidPincode(newCustomer.Pincode)
        && (!newCustomer.IsBusinessInvoice || !string.IsNullOrWhiteSpace(newCustomer.GstNumber));

    private string? PreviewInitials
    {
        get
        {
            var name = newCustomer.FullName ?? "";
            if (string.IsNullOrWhiteSpace(name)) return null;
            var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
            return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
        }
    }

