@code {
    // ── Wizard state ────────────────────────────────────────────────
    private CreateOrderRequestV2 req = new()
    {
        Payments = new() { new() { Mode = PaymentMode.BankTransfer, Amount = 0 } }
    };
    private int step = 1;
    private bool saving;
    private string? error;

