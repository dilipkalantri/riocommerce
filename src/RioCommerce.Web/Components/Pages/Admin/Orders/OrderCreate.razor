    private async Task OnCustomerSearch()
    {
        ddOpen = true;
        activeIndex = 0;
        customerCts?.Cancel();
        customerCts = new CancellationTokenSource();
        var ct = customerCts.Token;
        var q = (customerQuery ?? "").Trim();

        if (q.Length == 0)
        {
            // Empty → reload recents (don't clear the dropdown).
            try { customerSuggestions = await Users.RecentCustomersAsync(10); } catch { }
            return;
        }
        if (q.Length < 2) return; // 1 char → wait for second
        customerSearching = true;
        try
        {
            await Task.Delay(300, ct);
            if (ct.IsCancellationRequested) return;
            customerSuggestions = await Users.SearchCustomersAsync(q, 15);
        }
        catch (OperationCanceledException) { }
        finally { if (!ct.IsCancellationRequested) customerSearching = false; }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (!ddOpen || customerSuggestions == null) return;
        var max = customerSuggestions.Count - 1;
        if (max < 0) return;
        switch (e.Key)
        {
            case "ArrowDown": activeIndex = Math.Min(max, activeIndex + 1); break;
            case "ArrowUp":   activeIndex = Math.Max(0, activeIndex - 1); break;
            case "Enter":     await SelectCustomer(customerSuggestions[activeIndex]); break;
            case "Escape":    ddOpen = false; break;
        }
    }

    private async Task SelectCustomer(CustomerSuggestion c)
    {
        ddOpen = false;
        customerQuery = "";
        // Pull the rich profile (orders/lifetime/last + default address).
        try { selectedProfile = await Users.GetCustomerOrderProfileAsync(c.Id); }
        catch { selectedProfile = null; }
        if (selectedProfile == null) return;

        req.UserId = selectedProfile.Id;
        req.StudentName = selectedProfile.FullName;
        req.StudentEmail = selectedProfile.Email;
        req.StudentPhone = selectedProfile.Phone ?? "";

        // Auto-populate the Billing step's fields from the customer's default address.
        if (!string.IsNullOrEmpty(selectedProfile.Address)) req.BillingAddress = selectedProfile.Address;
        if (!string.IsNullOrEmpty(selectedProfile.City))    req.BillingCity    = selectedProfile.City;
        if (!string.IsNullOrEmpty(selectedProfile.State))   req.BillingState   = selectedProfile.State!;
        if (!string.IsNullOrEmpty(selectedProfile.Pincode)) req.BillingPincode = selectedProfile.Pincode;
        if (!string.IsNullOrEmpty(selectedProfile.GstNumber)) req.GstNumber    = selectedProfile.GstNumber;
        SyncPaymentAmount();
    }

