    private void OnNameInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        // Title-case each word, preserve multiple spaces while typing
        var parts = raw.Split(' ');
        for (var i = 0; i < parts.Length; i++)
            if (parts[i].Length > 0)
                parts[i] = char.ToUpper(parts[i][0]) + (parts[i].Length > 1 ? parts[i][1..] : string.Empty);
        newCustomer.FullName = string.Join(' ', parts);
    }

