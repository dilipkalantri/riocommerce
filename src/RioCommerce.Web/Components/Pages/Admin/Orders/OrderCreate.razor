    // Wrap the matching substring in <mark> so the user sees what matched.
    private string Highlight(string? text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        var q = (customerQuery ?? "").Trim();
        if (q.Length < 2) return System.Net.WebUtility.HtmlEncode(text);
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        var encodedQ = System.Net.WebUtility.HtmlEncode(q);
        var idx = encoded.IndexOf(encodedQ, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return encoded;
        return encoded[..idx] + "<mark>" + encoded.Substring(idx, encodedQ.Length) + "</mark>" + encoded[(idx + encodedQ.Length)..];
    }

