    // ── Pricing engine (mirrors what the server will compute) ─────────────
    private decimal LineBaseUnitPrice(CreateOrderLineV2 line, ProductPickDetail? d)
    {
        if (d == null) return 0;
        // Mode is ADDITIVE — base + selected-mode add-on (0 when no mode selected).
        var modeAddOn = line.ProductModeId.HasValue
            ? (d.Modes.FirstOrDefault(m => m.Id == line.ProductModeId.Value)?.Price ?? 0m)
            : 0m;
        var basePrice = d.SellingPrice + modeAddOn;
        decimal adjust = 0;
        foreach (var attr in d.Attributes)
        foreach (var v in attr.Values)
            if (line.SelectedAttributeValueIds.Contains(v.Id))
                adjust += v.PriceAdjustmentUsePercentage
                    ? Math.Round(basePrice * v.PriceAdjustment / 100m, 2)
                    : v.PriceAdjustment;
        return Math.Max(0m, basePrice + adjust);
    }

    private decimal LineTotal(CreateOrderLineV2 line, ProductPickDetail? d)
    {
        var unit = LineBaseUnitPrice(line, d);
        var lineGross = unit * line.Quantity;
        var discount = Math.Clamp(line.Discount, 0m, lineGross);
        return lineGross - discount;
    }

    private decimal Subtotal => req.Items.Sum(l => LineBaseUnitPrice(l, lineDetails.GetValueOrDefault(l.ProductId)) * l.Quantity);
    private decimal TotalDiscount => req.Items.Sum(l => Math.Clamp(l.Discount, 0m, LineBaseUnitPrice(l, lineDetails.GetValueOrDefault(l.ProductId)) * l.Quantity));
    private decimal GrandTotal => req.Items.Sum(l => LineTotal(l, lineDetails.GetValueOrDefault(l.ProductId)));
    private decimal GstAmount => Math.Round(GrandTotal * 18m / 118m, 2);
    private decimal PaymentSum => req.Payments.Sum(p => p.Amount);
    private string PaymentMismatchClass => Math.Abs(PaymentSum - GrandTotal) > 1m ? "mismatch" : "";

    // ── Payment splits ─────────────────────────────────────────────
    private void AddPaymentRow()
    {
        req.Payments.Add(new CreateOrderPaymentV2 { Mode = PaymentMode.BankTransfer, Amount = Math.Max(0, GrandTotal - PaymentSum) });
    }

    private void RemovePaymentRow(int idx)
    {
        if (req.Payments.Count <= 1) return;
        req.Payments.RemoveAt(idx);
    }

    private void SetPaymentMode(int idx, ChangeEventArgs e)
    {
        if (Enum.TryParse<PaymentMode>(e.Value?.ToString(), out var m))
            req.Payments[idx].Mode = m;
    }

    private void SetPaymentAmount(int idx, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var a))
            req.Payments[idx].Amount = a;
    }

    // Keep first-row payment auto-matched to total while user is still mid-wizard,
    // unless they've added a split (then they own the amounts).
    private void SyncPaymentAmount()
    {
        if (req.Payments.Count == 1) req.Payments[0].Amount = GrandTotal;
    }

    // ── Navigation ─────────────────────────────────────────────────
    /// <summary>Six digits, not starting with zero — the same rule the order-address editor applies.</summary>
    private static bool IsValidPincode(string? pin) =>
        !string.IsNullOrWhiteSpace(pin)
        && System.Text.RegularExpressions.Regex.IsMatch(pin.Trim(), @"^[1-9][0-9]{5}$");

    /// <summary>Street, city and PIN all present — enough to actually put on a courier label.</summary>
    private bool HasDeliverableAddress =>
        !string.IsNullOrWhiteSpace(req.BillingAddress)
        && !string.IsNullOrWhiteSpace(req.BillingCity)
        && IsValidPincode(req.BillingPincode);

    private bool CanGoForward()
    {
        return step switch
        {
            1 => selectedProfile != null,
            2 => req.Items.Count > 0 && req.Items.All(l =>
                {
                    var d = lineDetails.GetValueOrDefault(l.ProductId);
                    if (d == null) return false;
                    // Every required attribute group must have a selection
                    return d.Attributes.Where(a => a.IsRequired).All(a => a.Values.Any(v => l.SelectedAttributeValueIds.Contains(v.Id)));
                }),
            // Step 3 also demands a deliverable address. A counter order almost always ships
            // something, and an order captured without street/city/PIN reaches Dispatch with nothing
            // to put on the courier label — which is only discovered days later, at packing time.
            3 => req.ReferralSourceId.HasValue
                 && HasDeliverableAddress
                 && (
                    (inst.Enabled && !InstallmentMismatch && inst.Installments.Count > 0 && inst.DownPayment >= minDownPayment)
                    || (!inst.Enabled && req.Payments.Count > 0 && Math.Abs(PaymentSum - GrandTotal) <= 1m)
                 ),
            4 => true,
            _ => false,
        };
    }

    private void GoBack()
    {
        if (step > 1) step--;
        error = null;
    }

    private async Task GoForward()
    {
        error = null;
        if (step < 4)
        {
            if (!CanGoForward())
            {
                error = step switch
                {
                    1 => "Please select a customer (or add a new one) before continuing.",
                    2 => "Please add at least one product and make sure required attributes are selected.",
                    3 => inst.Enabled
                        ? "Please select a referral source and ensure the down payment + installments equal the grand total (and meet the minimum down payment)."
                        : "Please select a referral source and ensure the payment split equals the grand total.",
                    _ => "Please complete this step before continuing.",
                };
                return;
            }
            step++;
            return;
        }

        // step == 4 → submit
        saving = true;
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            Guid? actorId = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var aid) ? aid : null;
            var actorName = auth.User.Identity?.Name ?? "admin";

            // Online gateway? Create the order as Pending so it isn't marked Paid until the gateway
            // callback confirms payment. (Default Status is Confirmed → PaymentStatus.Success.)
            // Installment orders are counter-collected (down payment now), so they never take the
            // gateway path and stay Confirmed (access granted on the down payment).
            if (inst.Enabled)
            {
                req.Installment = inst;
                req.Status = OrderStatus.Confirmed;
            }
            else if (req.Payments.Any(p => p.Mode is PaymentMode.Razorpay or PaymentMode.Easebuzz))
            {
                req.Status = OrderStatus.Pending;
            }

            var orderId = await Orders.CreateOrderV2Async(req, actorId, actorName);

            // If an online gateway mode was chosen, open the gateway-launch page in a new tab to
            // collect payment (order is Pending; the gateway callback marks it Paid). Other modes
            // (BankTransfer/Cash/Cheque) just record the order as before. Installment orders never
            // use the gateway path.
            var onlineMode = req.Payments.Select(p => p.Mode)
                .FirstOrDefault(m => m is PaymentMode.Razorpay or PaymentMode.Easebuzz);
            var hasOnline = !inst.Enabled && req.Payments.Any(p => p.Mode is PaymentMode.Razorpay or PaymentMode.Easebuzz);

            step = 5;
            StateHasChanged();
            await Task.Delay(700);

            if (hasOnline)
            {
                var detail = await Orders.GetDetailAsync(orderId);
                var orderNo = detail?.OrderNumber;
                if (!string.IsNullOrWhiteSpace(orderNo))
                {
                    var gw = onlineMode == PaymentMode.Easebuzz ? "easebuzz" : "razorpay";
                    var url = $"/admin/orders/pay?order={Uri.EscapeDataString(orderNo)}&gateway={gw}"
                            + $"&name={Uri.EscapeDataString(req.StudentName ?? "")}"
                            + $"&email={Uri.EscapeDataString(req.StudentEmail ?? "")}"
                            + $"&phone={Uri.EscapeDataString(req.StudentPhone ?? "")}";
                    try { await JS.InvokeVoidAsync("window.open", url, "_blank"); } catch { }
                }
                // Admin stays on the order details to watch the payment land.
                Nav.NavigateTo($"/admin/orders/{orderId}");
                return;
            }

            Nav.NavigateTo($"/admin/orders/{orderId}");
        }
        catch (Exception ex)
        {
            // EF wraps DB failures in a generic DbUpdateException whose Message is
            // "An error occurred while saving the entity changes. See the inner exception…".
            // Walk to the innermost exception so the actual cause is shown.
            var root = ex;
            while (root.InnerException != null) root = root.InnerException;
            error = root.Message;
            saving = false;
        }
    }
}
