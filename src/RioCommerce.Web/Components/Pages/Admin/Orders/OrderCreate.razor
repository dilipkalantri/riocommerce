    private async Task ShowToastAsync(string message)
    {
        toastMsg = message;
        var tick = ++toastTick;
        StateHasChanged();
        await Task.Delay(1800);
        if (toastTick == tick) { toastMsg = null; StateHasChanged(); }
    }

    private async Task SaveNewCustomer()
    {
        addCustomerError = null;
        if (!CanSubmit) return;

        addingCustomer = true;
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            Guid actorId = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var aid) ? aid : Guid.Empty;
            var actorName = auth.User.Identity?.Name ?? "admin";
            var (ok, err, newId, dup) = await Users.CreateCustomerForOrderAsync(newCustomer, actorId, actorName);
            if (!ok)
            {
                addCustomerError = err ?? "Could not create customer.";
                // Duplicate? — auto-select the existing customer instead of dead-ending the admin.
                if (dup?.Existing?.Id != null && dup.Existing.Id != Guid.Empty)
                {
                    showAddCustomer = false;
                    var existing = await Users.GetCustomerOrderProfileAsync(dup.Existing.Id);
                    if (existing != null)
                    {
                        await SelectCustomer(new CustomerSuggestion(
                            existing.Id, existing.FullName, existing.Initials, existing.AvatarUrl,
                            existing.Email, existing.Phone, null, null, existing.TotalOrders,
                            existing.IsActive, existing.JoinedDate));
                        await ShowToastAsync($"Customer already exists — {existing.FullName} selected");
                    }
                }
                return;
            }

            // Persist the chosen state so it pre-selects on the next "Add" click.
            try { await JS.InvokeVoidAsync("localStorage.setItem", AcLastStateKey, newCustomer.State); } catch { }

            // Push the modal-picked referral onto the order's referral pick (Step 3).
            if (newCustomer.ReferralSourceId.HasValue)
                req.ReferralSourceId = newCustomer.ReferralSourceId;

            // Success → toast first, then close + auto-select after a beat.
            await ShowToastAsync("✓ Customer created successfully");
            await Task.Delay(900);
            showAddCustomer = false;

            var profile = await Users.GetCustomerOrderProfileAsync(newId);
            if (profile != null)
            {
                await SelectCustomer(new CustomerSuggestion(
                    profile.Id, profile.FullName, profile.Initials, profile.AvatarUrl,
                    profile.Email, profile.Phone, null, null, profile.TotalOrders,
                    profile.IsActive, profile.JoinedDate));
            }
        }
        catch (Exception ex) { addCustomerError = ex.Message; }
        finally { addingCustomer = false; }
    }

