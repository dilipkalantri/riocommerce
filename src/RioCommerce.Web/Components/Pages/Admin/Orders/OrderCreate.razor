    private static readonly PaymentMode[] CounterModes =
        { PaymentMode.Cash, PaymentMode.Upi, PaymentMode.Cheque, PaymentMode.BankTransfer, PaymentMode.RazorpayLink };

    private bool installmentsAllowed => settings?.AllowInstallments == true;
    private decimal minDownPayment => settings is { MinDownPaymentPercent: > 0 }
        ? Math.Round(GrandTotal * settings.MinDownPaymentPercent / 100m, 2) : 0m;
    private decimal InstallmentScheduleSum => inst.DownPayment + inst.Installments.Sum(i => i.Amount);
    private bool InstallmentMismatch => Math.Abs(InstallmentScheduleSum - GrandTotal) > 1m;

    private void OnInstallmentToggle(ChangeEventArgs e)
    {
        inst.Enabled = e.Value is true;
        if (inst.Enabled && inst.Installments.Count == 0)
        {
            // Seed with the configured default count + an auto-distribution from a sensible down payment.
            var count = Math.Max(1, settings?.DefaultInstallmentCount ?? 3);
            inst.DownPayment = minDownPayment;
            SeedInstallments(count);
            AutoDistribute();
        }
    }

    private void OnDownPaymentChanged(ChangeEventArgs e)
    {
        inst.DownPayment = decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Max(0, v) : 0;
    }

    private void OnInstallmentCountChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var n)) return;
        n = Math.Clamp(n, 1, 36);
        SeedInstallments(n);
        AutoDistribute();
    }

    private void SeedInstallments(int count)
    {
        var existing = inst.Installments.ToList();
        inst.Installments = new();
        // UTC-kinded midnight today. (DateTime.UtcNow.Date returns Kind=Unspecified, which Npgsql
        // rejects for a 'timestamp with time zone' column.)
        var start = DateTime.SpecifyKind(DateTime.UtcNow.Date, DateTimeKind.Utc);
        var interval = Math.Max(1, settings?.DefaultIntervalDays ?? 30);
        for (var i = 0; i < count; i++)
        {
            var due = settings?.AutoGenerateDueDates == true
                ? start.AddDays(interval * (i + 1))
                : (existing.ElementAtOrDefault(i)?.DueDate ?? start.AddDays(interval * (i + 1)));
            inst.Installments.Add(new InstallmentLineInput
            {
                DueDate = DateTime.SpecifyKind(due, DateTimeKind.Utc),
                Amount = existing.ElementAtOrDefault(i)?.Amount ?? 0
            });
        }
    }

    private void AddInstallment()
    {
        var last = inst.Installments.LastOrDefault()?.DueDate ?? DateTime.SpecifyKind(DateTime.UtcNow.Date, DateTimeKind.Utc);
        var interval = Math.Max(1, settings?.DefaultIntervalDays ?? 30);
        inst.Installments.Add(new InstallmentLineInput { DueDate = DateTime.SpecifyKind(last.AddDays(interval), DateTimeKind.Utc), Amount = 0 });
    }

    private void RemoveInstallment(int idx)
    {
        if (idx >= 0 && idx < inst.Installments.Count && inst.Installments.Count > 1)
            inst.Installments.RemoveAt(idx);
    }

    private void SetInstallmentDate(int idx, ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            inst.Installments[idx].DueDate = DateTime.SpecifyKind(d, DateTimeKind.Utc);
    }

    private void SetInstallmentAmount(int idx, ChangeEventArgs e)
    {
        inst.Installments[idx].Amount = decimal.TryParse(e.Value?.ToString(), out var v) ? Math.Max(0, v) : 0;
    }

    // Split the (grand total − down payment) evenly across installments; last one absorbs rounding.
    private void AutoDistribute()
    {
        if (inst.Installments.Count == 0) return;
        var balance = Math.Max(0, GrandTotal - inst.DownPayment);
        var n = inst.Installments.Count;
        var per = Math.Round(balance / n, 2);
        decimal running = 0;
        for (var i = 0; i < n; i++)
        {
            if (i == n - 1) inst.Installments[i].Amount = Math.Round(balance - running, 2);
            else { inst.Installments[i].Amount = per; running += per; }
        }
    }

