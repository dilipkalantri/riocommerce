    .fo-prod-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;max-height:55vh;overflow:auto}
    .fo-prod{display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px;border:1px solid #E5ECF4;border-radius:12px;cursor:pointer;transition:border-color .2s,background .2s}
