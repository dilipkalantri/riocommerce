@* ── Add New Customer modal (inline create with duplicate validation) ── *@
@if (showAddCustomer)
{
    <div class="fo-modal-backdrop" @onclick="CloseAddCustomer">
        <div class="fo-modal" @onclick:stopPropagation="true">
            <div class="fo-modal__head">
                <h3>Add New Customer</h3>
                <button class="fo-modal__x" @onclick="CloseAddCustomer">✕</button>
            </div>
            <div class="fo-modal__body">
                @if (addCustomerError != null) { <div class="fo-alert fo-alert--err">@addCustomerError</div> }
                <div class="fo-form-grid">
                    <div class="fo-field fo-field--full">
                        <label>Full name <span class="req">*</span></label>
                        <input class="fo-input" @bind="newCustomer.FullName" @ref="firstFieldRef" placeholder="Customer name" />
                    </div>
                    <div class="fo-field">
                        <label>Mobile <span class="req">*</span></label>
                        <input class="fo-input" @bind="newCustomer.Phone" placeholder="10-digit mobile" maxlength="10" />
                    </div>
                    <div class="fo-field">
                        <label>Email</label>
                        <input class="fo-input" @bind="newCustomer.Email" placeholder="name@example.com" />
                    </div>
                    <div class="fo-field fo-field--full"><label>Address</label><input class="fo-input" @bind="newCustomer.Address" placeholder="Flat / street / area" /></div>
                    <div class="fo-field"><label>City</label><input class="fo-input" @bind="newCustomer.City" /></div>
                    <div class="fo-field"><label>State</label><select class="fo-input" @bind="newCustomer.State">@foreach (var s in States) { <option value="@s">@s</option> }</select></div>
                    <div class="fo-field"><label>Pincode</label><input class="fo-input" @bind="newCustomer.Pincode" maxlength="6" /></div>
                    <div class="fo-field"><label>GST (optional)</label><input class="fo-input" @bind="newCustomer.GstNumber" /></div>
                </div>
            </div>
            <div class="fo-modal__foot">
                <button class="fo-btn fo-btn--ghost" @onclick="CloseAddCustomer" disabled="@addingCustomer">Cancel</button>
                <button class="fo-btn fo-btn--primary" @onclick="SaveNewCustomer" disabled="@addingCustomer">@(addingCustomer ? "Creating…" : "Create & Select")</button>
            </div>
        </div>
    </div>
}

@code {
    private CreateOrderRequestV2 req = new() { Payments = new() { new() { Mode = PaymentMode.BankTransfer, Amount = 0 } } };
    private int step = 1;
    private bool saving;
    private string? error;
    private bool sameAsBilling = true;
    private FranchiseTxnMode txnMode = FranchiseTxnMode.Wallet;

    // Franchise picker
    private List<FranchiseCard>? allFranchises;
    private FranchiseCard? selectedFranchise;
    private string franchiseQuery = "";

    // Customer search
    private string customerQuery = "";
    private List<CustomerSuggestion>? customerSuggestions;
    private bool customerSearching;
    private CancellationTokenSource? customerCts;
    private CustomerOrderProfile? selectedProfile;

    // Product picker
    private bool showPicker;
    private string productQuery = "";
    private List<ProductPickItem>? productResults;
    private bool productSearching;
    private CancellationTokenSource? productCts;

    private readonly Dictionary<Guid, ProductPickDetail> lineDetails = new();
    private List<ReferralSourceOption>? referralOptions;

    private static readonly string[] States =
    {
        "Maharashtra","Andhra Pradesh","Assam","Bihar","Chhattisgarh","Delhi","Goa","Gujarat",
        "Haryana","Himachal Pradesh","Jharkhand","Karnataka","Kerala","Madhya Pradesh","Manipur",
        "Meghalaya","Odisha","Punjab","Rajasthan","Tamil Nadu","Telangana","Uttar Pradesh",
        "Uttarakhand","West Bengal","Other"
    };

    private (int idx, string lbl)[] StepLabels =>
        new[] { (1, "Customer"), (2, "Address"), (3, "Products"), (4, "Payment"), (5, "Review & Create") };

    private (FranchiseTxnMode mode, string desc, string ico)[] TxnModeOptions => new[]
    {
        (FranchiseTxnMode.Wallet,     "Pay from franchisee wallet — instant settlement.", "👛"),
        (FranchiseTxnMode.NetPayment, "Customer pays directly via cash / UPI / online.",   "💳"),
        (FranchiseTxnMode.Postpay,    "Bill the franchisee later — no wallet movement.",   "🗓"),
    };

    protected override async Task OnInitializedAsync()
    {
        try { allFranchises = (await Franchises.FranchisesAsync()).Where(f => f.Wallet >= -100_000_000).ToList(); }
        catch { allFranchises = new(); }
        try { referralOptions = await Referrals.ListActiveAsync(); }
        catch { referralOptions = new(); }
        // Allowed payment modes — Razorpay/Easebuzz only when their gateway is configured + enabled
        // in /admin/payment-settings. BankTransfer is always available.
        try { allowedPaymentModes = await PaymentModes.GetAvailableAsync(); }
        catch { allowedPaymentModes = new() { PaymentMode.BankTransfer }; }
    }

    private List<PaymentMode> allowedPaymentModes = new();

    private IEnumerable<FranchiseCard> FilteredFranchises
    {
        get
        {
            if (allFranchises == null) return Enumerable.Empty<FranchiseCard>();
            if (string.IsNullOrWhiteSpace(franchiseQuery)) return allFranchises;
            var q = franchiseQuery.Trim();
            return allFranchises.Where(f =>
                (f.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.Code?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.City?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private bool LowWallet => selectedFranchise != null && selectedFranchise.Wallet + selectedFranchise.CreditLimit < 1000;

    private void SelectFranchise(FranchiseCard f) { selectedFranchise = f; }
    private void ChangeFranchise() { selectedFranchise = null; step = 1; }

    // ── Customer ────────────────────────────────────────────────
    private async Task OnCustomerSearch()
    {
        customerCts?.Cancel(); customerCts = new();
        var ct = customerCts.Token;
        var q = (customerQuery ?? "").Trim();
        if (q.Length < 2) { customerSuggestions = null; return; }
        customerSearching = true;
        try
        {
            await Task.Delay(300, ct);
            if (ct.IsCancellationRequested) return;
            customerSuggestions = await Users.SearchCustomersAsync(q, 12);
        }
        catch (OperationCanceledException) { }
        finally { if (!ct.IsCancellationRequested) customerSearching = false; }
    }

    private async Task SelectCustomer(CustomerSuggestion c)
    {
        customerSuggestions = null;
        customerQuery = "";
        try { selectedProfile = await Users.GetCustomerOrderProfileAsync(c.Id); } catch { }
        if (selectedProfile == null) return;
        req.UserId = selectedProfile.Id;
        req.StudentName = selectedProfile.FullName;
        req.StudentEmail = selectedProfile.Email;
        req.StudentPhone = selectedProfile.Phone ?? "";
        if (!string.IsNullOrEmpty(selectedProfile.Address)) req.BillingAddress = selectedProfile.Address;
        if (!string.IsNullOrEmpty(selectedProfile.City))    req.BillingCity = selectedProfile.City;
        if (!string.IsNullOrEmpty(selectedProfile.State))   req.BillingState = selectedProfile.State!;
        if (!string.IsNullOrEmpty(selectedProfile.Pincode)) req.BillingPincode = selectedProfile.Pincode;
        SyncPaymentAmount();
    }

    // ── Inline create-new-customer (with duplicate validation) ──
    private bool showAddCustomer;
    private bool addingCustomer;
    private string? addCustomerError;
    private CreateOrderCustomerRequest newCustomer = new();
    private ElementReference firstFieldRef;

    private async Task OpenAddCustomer()
    {
        addCustomerError = null;
        var typedDigits = new string((customerQuery ?? "").Where(char.IsDigit).ToArray());
        newCustomer = new CreateOrderCustomerRequest
        {
            FullName = "",
            // Pre-fill mobile with whatever digits were typed in the search box.
            Phone = typedDigits.Length is > 0 and <= 10 ? typedDigits : "",
            State = "Maharashtra",
        };
        showAddCustomer = true;
        customerSuggestions = null;
        await Task.Yield();
        try { await firstFieldRef.FocusAsync(); } catch { }
    }

    private void CloseAddCustomer()
    {
        showAddCustomer = false;
        addCustomerError = null;
    }

    private async Task SaveNewCustomer()
    {
        addCustomerError = null;
        if (string.IsNullOrWhiteSpace(newCustomer.FullName) || newCustomer.FullName.Trim().Length < 2)
        { addCustomerError = "Enter the customer's full name."; return; }
        var digits = new string((newCustomer.Phone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length != 10)
        { addCustomerError = "Enter a valid 10-digit mobile number."; return; }
        newCustomer.Phone = digits;

        addingCustomer = true;
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            Guid actorId = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var aid) ? aid : Guid.Empty;
            var actorName = auth.User.Identity?.Name ?? "franchise";

            var (ok, err, newId, dup) = await Users.CreateCustomerForOrderAsync(newCustomer, actorId, actorName);
            if (!ok)
            {
                addCustomerError = err ?? "Could not create customer.";
                // Duplicate (mobile/email already exists) → auto-select the existing customer.
                if (dup?.Existing?.Id is { } existingId && existingId != Guid.Empty)
                {
                    var existing = await Users.GetCustomerOrderProfileAsync(existingId);
                    if (existing != null)
                    {
                        showAddCustomer = false;
                        await SelectCustomer(new CustomerSuggestion(
                            existing.Id, existing.FullName, existing.Initials, existing.AvatarUrl,
                            existing.Email, existing.Phone, null, null, existing.TotalOrders,
                            existing.IsActive, existing.JoinedDate));
                    }
                }
                return;
            }

            showAddCustomer = false;
            var profile = await Users.GetCustomerOrderProfileAsync(newId);
            if (profile != null)
            {
                await SelectCustomer(new CustomerSuggestion(
                    profile.Id, profile.FullName, profile.Initials, profile.AvatarUrl,
                    profile.Email, profile.Phone, null, null, profile.TotalOrders,
                    profile.IsActive, profile.JoinedDate));
            }
        }
        catch (Exception ex) { addCustomerError = ex.Message; }
        finally { addingCustomer = false; }
    }

    private void ClearCustomer()
    {
        req.UserId = null; req.StudentName = ""; req.StudentEmail = null; req.StudentPhone = "";
        selectedProfile = null;
    }

    private static string FriendlyId(Guid id) => $"RIO-{id.ToString("N")[..6].ToUpperInvariant()}";

    // ── Products ────────────────────────────────────────────────
    private async Task OpenProductPicker() { showPicker = true; productQuery = ""; await OnProductSearch(); }
    private void ClosePicker() => showPicker = false;

    private async Task OnProductSearch()
    {
        productCts?.Cancel(); productCts = new();
        var ct = productCts.Token;
        productSearching = true;
        try
        {
            await Task.Delay(200, ct);
            if (ct.IsCancellationRequested) return;
            productResults = await Orders.SearchProductsAsync(productQuery, 20);
        }
        catch (OperationCanceledException) { }
        finally { if (!ct.IsCancellationRequested) productSearching = false; }
    }

    private async Task SelectProduct(ProductPickItem p)
    {
        ClosePicker();
        if (!lineDetails.ContainsKey(p.Id))
        {
            var d = await Orders.GetProductPickDetailAsync(p.Id);
            if (d != null) lineDetails[p.Id] = d;
        }
        var detail = lineDetails.GetValueOrDefault(p.Id);
        var firstMode = detail?.Modes.FirstOrDefault();
        var preselected = detail?.Attributes.SelectMany(a => a.Values.Where(v => v.IsPreSelected).Select(v => v.Id)).ToList() ?? new();
        req.Items.Add(new CreateOrderLineV2
        {
            ProductId = p.Id, ProductModeId = firstMode?.Id, Quantity = 1, SelectedAttributeValueIds = preselected,
        });
        SyncPaymentAmount();
        StateHasChanged();
    }

    private void SetMode(int idx, Guid modeId) { req.Items[idx].ProductModeId = modeId; SyncPaymentAmount(); }

    private void ToggleAttribute(int lineIdx, Guid mappingId, Guid valueId, bool multi)
    {
        var line = req.Items[lineIdx];
        var detail = lineDetails.GetValueOrDefault(line.ProductId);
        var group = detail?.Attributes.FirstOrDefault(a => a.MappingId == mappingId);
        if (group == null) return;
        var siblingIds = group.Values.Select(v => v.Id).ToHashSet();
        if (multi)
        {
            if (line.SelectedAttributeValueIds.Contains(valueId)) line.SelectedAttributeValueIds.Remove(valueId);
            else line.SelectedAttributeValueIds.Add(valueId);
        }
        else
        {
            line.SelectedAttributeValueIds = line.SelectedAttributeValueIds.Where(id => !siblingIds.Contains(id)).ToList();
            line.SelectedAttributeValueIds.Add(valueId);
        }
        SyncPaymentAmount();
    }

    private void SetQty(int idx, int q) { req.Items[idx].Quantity = Math.Max(1, q); SyncPaymentAmount(); }
    private void DuplicateLine(int idx)
    {
        var src = req.Items[idx];
        req.Items.Insert(idx + 1, new CreateOrderLineV2 { ProductId = src.ProductId, ProductModeId = src.ProductModeId, Quantity = src.Quantity, Discount = src.Discount, SelectedAttributeValueIds = new List<Guid>(src.SelectedAttributeValueIds) });
        SyncPaymentAmount();
    }
    private void RemoveLine(int idx) { req.Items.RemoveAt(idx); SyncPaymentAmount(); }

    // ── Pricing engine ──────────────────────────────────────────
    private decimal LineBaseUnitPrice(CreateOrderLineV2 line, ProductPickDetail? d)
    {
        if (d == null) return 0;
        // Mode is ADDITIVE — base + selected-mode add-on.
        var modeAddOn = line.ProductModeId.HasValue
            ? (d.Modes.FirstOrDefault(m => m.Id == line.ProductModeId.Value)?.Price ?? 0m)
            : 0m;
        var basePrice = d.SellingPrice + modeAddOn;
        decimal adjust = 0;
        foreach (var attr in d.Attributes)
            foreach (var v in attr.Values)
                if (line.SelectedAttributeValueIds.Contains(v.Id))
                    adjust += v.PriceAdjustmentUsePercentage ? Math.Round(basePrice * v.PriceAdjustment / 100m, 2) : v.PriceAdjustment;
        return Math.Max(0m, basePrice + adjust);
    }

    private decimal LineTotal(CreateOrderLineV2 line, ProductPickDetail? d)
    {
        var unit = LineBaseUnitPrice(line, d);
        var lineGross = unit * line.Quantity;
        return lineGross - Math.Clamp(line.Discount, 0m, lineGross);
    }

    private decimal Subtotal => req.Items.Sum(l => LineBaseUnitPrice(l, lineDetails.GetValueOrDefault(l.ProductId)) * l.Quantity);
    private decimal TotalDiscount => req.Items.Sum(l => Math.Clamp(l.Discount, 0m, LineBaseUnitPrice(l, lineDetails.GetValueOrDefault(l.ProductId)) * l.Quantity));
    private decimal GrandTotal => req.Items.Sum(l => LineTotal(l, lineDetails.GetValueOrDefault(l.ProductId)));
    private decimal GstAmount => Math.Round(GrandTotal * 18m / 118m, 2);
    private decimal PaymentSum => req.Payments.Sum(p => p.Amount);
    private string PaymentMismatchClass => Math.Abs(PaymentSum - GrandTotal) > 1m ? "mismatch" : "";

    // ── Payment splits ──────────────────────────────────────────
    private void SelectTxnMode(FranchiseTxnMode m)
    {
        txnMode = m;
        if (m == FranchiseTxnMode.Wallet)
        {
            req.Payments = new() { new() { Mode = PaymentMode.BankTransfer, Amount = GrandTotal } };
        }
        else if (m == FranchiseTxnMode.Postpay)
        {
            req.Payments = new() { new() { Mode = PaymentMode.BankTransfer, Amount = GrandTotal } };
        }
        else
        {
            // NetPayment: keep at least one row
            if (req.Payments.Count == 0) req.Payments.Add(new() { Mode = PaymentMode.BankTransfer, Amount = GrandTotal });
        }
    }

    private void AddPaymentRow() => req.Payments.Add(new() { Mode = PaymentMode.BankTransfer, Amount = Math.Max(0, GrandTotal - PaymentSum) });
    private void RemovePaymentRow(int idx) { if (req.Payments.Count > 1) req.Payments.RemoveAt(idx); }
    private void SetPaymentMode(int idx, ChangeEventArgs e) { if (Enum.TryParse<PaymentMode>(e.Value?.ToString(), out var m)) req.Payments[idx].Mode = m; }
    private void SetPaymentAmount(int idx, ChangeEventArgs e) { if (decimal.TryParse(e.Value?.ToString(), out var a)) req.Payments[idx].Amount = a; }
    private void SyncPaymentAmount() { if (req.Payments.Count == 1) req.Payments[0].Amount = GrandTotal; }

    // ── Navigation ──────────────────────────────────────────────
    private bool CanGoForward() => step switch
    {
        1 => selectedFranchise != null && selectedProfile != null,
        2 => req.ReferralSourceId.HasValue && !string.IsNullOrWhiteSpace(req.BillingState),
        3 => req.Items.Count > 0 && req.Items.All(l => { var d = lineDetails.GetValueOrDefault(l.ProductId); return d != null && d.Attributes.Where(a => a.IsRequired).All(a => a.Values.Any(v => l.SelectedAttributeValueIds.Contains(v.Id))); }),
        4 => selectedFranchise != null && txnMode switch
        {
            FranchiseTxnMode.Wallet => GrandTotal <= selectedFranchise.Wallet + selectedFranchise.CreditLimit,
            FranchiseTxnMode.NetPayment => req.Payments.Count > 0 && Math.Abs(PaymentSum - GrandTotal) <= 1m,
            FranchiseTxnMode.Postpay => true,
            _ => false
        },
        5 => true,
        _ => false,
    };

    private void GoBack() { if (step > 1) step--; error = null; }

    private async Task GoForward()
    {
        error = null;
        if (step < 5)
        {
            if (!CanGoForward())
            {
                error = step switch
                {
                    1 => "Pick a franchisee and a customer to continue.",
                    2 => "Choose a referral source and fill the billing state.",
                    3 => "Add at least one product and select all required attributes.",
                    4 => "Payment doesn't satisfy this step — check wallet balance or split totals.",
                    _ => "Complete this step before continuing.",
                };
                return;
            }
            step++;
            SyncPaymentAmount();
            return;
        }

        // step == 5 → submit
        saving = true;
        try
        {
            // Mirror shipping fields when "Same as billing"
            if (sameAsBilling)
            {
                req.ShippingAddress = req.BillingAddress;
                req.ShippingCity = req.BillingCity;
                req.ShippingState = req.BillingState;
                req.ShippingPincode = req.BillingPincode;
            }
            req.FranchiseId = selectedFranchise!.Id;
            req.FranchiseTxnMode = txnMode;
            req.Source = OrderSource.Franchisee;

            // For Wallet / Postpay we still send a single payment row so the service can store it.
            if (txnMode != FranchiseTxnMode.NetPayment)
                req.Payments = new() { new() { Mode = PaymentMode.BankTransfer, Amount = GrandTotal } };

            var auth = await AuthProvider.GetAuthenticationStateAsync();
            Guid? actorId = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var aid) ? aid : null;
            var actorName = auth.User.Identity?.Name ?? "admin";

            // Online gateway (net-payment) → create Pending; the gateway callback marks it Paid.
            if (txnMode == FranchiseTxnMode.NetPayment
                && req.Payments.Any(p => p.Mode is PaymentMode.Razorpay or PaymentMode.Easebuzz))
                req.Status = OrderStatus.Pending;

            var orderId = await Orders.CreateOrderV2Async(req, actorId, actorName);

            // Net-payment franchise orders with an online gateway mode → open the gateway-launch
            // page in a new tab to collect payment (order Pending; callback marks it Paid).
            if (txnMode == FranchiseTxnMode.NetPayment)
            {
                var onlineMode = req.Payments.Select(p => p.Mode)
                    .FirstOrDefault(m => m is PaymentMode.Razorpay or PaymentMode.Easebuzz);
                if (req.Payments.Any(p => p.Mode is PaymentMode.Razorpay or PaymentMode.Easebuzz))
                {
                    var detail = await Orders.GetDetailAsync(orderId);
                    var orderNo = detail?.OrderNumber;
                    if (!string.IsNullOrWhiteSpace(orderNo))
                    {
                        var gw = onlineMode == PaymentMode.Easebuzz ? "easebuzz" : "razorpay";
                        var url = $"/admin/orders/pay?order={Uri.EscapeDataString(orderNo)}&gateway={gw}"
                                + $"&name={Uri.EscapeDataString(req.StudentName ?? "")}"
                                + $"&email={Uri.EscapeDataString(req.StudentEmail ?? "")}"
                                + $"&phone={Uri.EscapeDataString(req.StudentPhone ?? "")}";
                        try { await JS.InvokeVoidAsync("window.open", url, "_blank"); } catch { }
                    }
                }
            }
            Nav.NavigateTo($"/admin/orders/{orderId}");
        }
        catch (Exception ex) { error = ex.Message; saving = false; }
    }
}
