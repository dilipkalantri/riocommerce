@page "/admin/orders/{Id:guid}/invoice"
@layout PrintLayout
@attribute [Authorize(Roles = "super_admin,admin,operations,faculty,franchise_admin,backend_user")]
@inject IOrderAdminService Svc
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject ISiteSettingsService Settings
<PageTitle>Invoice @inv?.InvoiceNumber</PageTitle>

<style>
    .inv-wrap{max-width:820px;margin:0 auto;padding:24px;font-family:Inter,system-ui,sans-serif;color:#1f2937}
    .inv-toolbar{display:flex;justify-content:flex-end;gap:8px;margin-bottom:16px}
    .inv-paper{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:36px}
    .inv-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #1f2937;padding-bottom:18px}
    .inv-brand img{height:44px}
    .inv-brand h2{font-size:20px;font-weight:800;margin-top:8px;color:#0f172a}
    .inv-brand p{font-size:12px;color:#6b7280;line-height:1.5}
    .inv-title{text-align:right}
    .inv-title h1{font-size:26px;font-weight:800;letter-spacing:1px;color:#0f172a}
    .inv-title .meta{font-size:12px;color:#6b7280;margin-top:4px;line-height:1.6}
    .inv-parties{display:grid;grid-template-columns:1fr 1fr auto;gap:20px;margin:22px 0}
    .inv-parties h4{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:#9ca3af;margin-bottom:6px}
    .inv-parties p{font-size:13px;line-height:1.6}
    .inv-qr{width:92px;height:92px;border:1px dashed #cbd5e1;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:10px;color:#9ca3af;text-align:center;background:repeating-linear-gradient(45deg,#f8fafc,#f8fafc 4px,#fff 4px,#fff 8px)}
    table.inv-items{width:100%;border-collapse:collapse;margin-top:8px;font-size:13px}
    table.inv-items th{background:#f1f5f9;text-align:left;padding:10px;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#475569}
    table.inv-items td{padding:10px;border-bottom:1px solid #eef2f7}
    table.inv-items td.num,table.inv-items th.num{text-align:right}
    .inv-totals{margin-left:auto;max-width:300px;margin-top:16px;font-size:13px}
    .inv-totals .row{display:flex;justify-content:space-between;padding:4px 0}
    .inv-totals .row.total{border-top:2px solid #1f2937;margin-top:6px;padding-top:8px;font-weight:800;font-size:15px}
    .inv-foot{margin-top:28px;border-top:1px solid #e5e7eb;padding-top:14px;font-size:11px;color:#9ca3af;text-align:center}
    .inv-status{display:inline-block;padding:3px 10px;border-radius:12px;font-size:12px;font-weight:700}
    .inv-status--paid{background:#dcfce7;color:#16a34a}.inv-status--due{background:#fef3c7;color:#d97706}
    @@media print{.inv-toolbar{display:none}.inv-wrap{padding:0}.inv-paper{border:0;padding:0}}
</style>

<div class="inv-wrap">
    @if (notFound)
    {
        <p>Invoice not found. <a href="/admin/orders">Back to orders</a></p>
    }
    else if (inv == null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="inv-toolbar">
            <a href="/admin/orders/@Id" class="btn btn-ghost btn-sm">← Back</a>
            @if (inv.PaymentStatus == PaymentStatus.Success)
            {
                <button class="btn btn-primary btn-sm" @onclick="PrintInvoice">🖨 Print / Save PDF</button>
            }
        </div>

        @if (inv.PaymentStatus != PaymentStatus.Success)
        {
            <div style="background:#FEF3C7;border:1px solid #FDE68A;border-radius:10px;padding:14px 18px;margin-bottom:16px;color:#92400E;font-size:14px">
                <strong>⚠ This order isn't paid yet.</strong>
                A tax invoice is generated only once payment status becomes <strong>Success</strong>.
                What you see below is a draft preview — it has NOT been saved or numbered.
            </div>
        }

        <div class="inv-paper">
            <div class="inv-head">
                <div class="inv-brand">
                    <img src="@LogoSrc" alt="RioCommerce" />
                    <h2>RioCommerce</h2>
                    <p>CA Coaching · Shukrawar Peth, Pune, Maharashtra<br />GSTIN: 27ABCDE1234F1Z5 · support@riocommerce.com</p>
                </div>
                <div class="inv-title">
                    <h1>TAX INVOICE</h1>
                    <div class="meta">
                        Invoice #: <strong>@inv.InvoiceNumber</strong><br />
                        Date: @inv.InvoiceDate.ToString("dd MMM yyyy")<br />
                        Order #: @inv.OrderNumber<br />
                        <span class="inv-status @(inv.PaymentStatus == PaymentStatus.Success ? "inv-status--paid" : "inv-status--due")">
                            @(inv.PaymentStatus == PaymentStatus.Success ? "PAID" : "PAYMENT DUE")
                        </span>
                    </div>
                </div>
            </div>

            @* Paid from the franchise wallet → no invoice by design. Say so, so the missing number
               doesn't read as a fault. *@
            @if (inv.PaidFromWallet)
            {
                <div class="inline-alert inline-alert--ok" style="margin:0 0 16px">
                    <strong>No tax invoice for this order — paid from the franchise wallet.</strong><br />
                    The money was invoiced when it was added to the wallet. See that invoice under
                    <a href="/admin/franchises">Franchises → 👛 Wallet</a>. The customer receipt below still applies.
                </div>
            }

            <div class="inv-parties">
                <div>
                    <h4>Billed To</h4>
                    @if (inv.IsFranchiseOrder)
                    {
                        <p>
                            <strong>@(string.IsNullOrWhiteSpace(inv.FranchiseName) ? "Franchisee" : inv.FranchiseName)</strong><br />
                            @(string.Join(", ", new[] { inv.FranchiseAddress, inv.FranchiseCity, inv.FranchiseState, inv.FranchisePincode }.Where(x => !string.IsNullOrWhiteSpace(x))))
                            @if (!string.IsNullOrWhiteSpace(inv.FranchiseGstin)) { <br /><text>GSTIN: @inv.FranchiseGstin</text> }
                        </p>
                    }
                    else
                    {
                        <p>
                            <strong>@(string.IsNullOrWhiteSpace(inv.StudentName) ? "—" : inv.StudentName)</strong><br />
                            @inv.StudentPhone @(string.IsNullOrEmpty(inv.StudentEmail) ? "" : $"· {inv.StudentEmail}")<br />
                            @(string.Join(", ", new[] { inv.BillingAddress, inv.BillingCity, inv.BillingState, inv.BillingPincode }.Where(x => !string.IsNullOrWhiteSpace(x))))
                            @if (!string.IsNullOrWhiteSpace(inv.GstNumber)) { <br /><text>GSTIN: @inv.GstNumber (@inv.GstClassification)</text> }
                        </p>
                    }
                </div>
                <div>
                    <h4>Details</h4>
                    <p>
                        Order date: @inv.OrderDate.ToLocalTime().ToString("dd MMM yyyy")<br />
                        Payment Gateway: @(inv.PaymentMode?.ToString() ?? "—")<br />
                        @* What the customer actually paid with there — gateway payments only. *@
                        @if (!string.IsNullOrWhiteSpace(inv.GatewayPaymentMode))
                        {
                            <text>Payment Mode: @inv.GatewayPaymentMode<br /></text>
                        }
                        @if (inv.IsFranchiseOrder)
                        {
                            <text>Customer (ref): @inv.StudentName<br /></text>
                            if (!string.IsNullOrWhiteSpace(inv.StudentPhone)) { <text>@inv.StudentPhone<br /></text> }
                        }
                        Place of supply: @(inv.BillingState ?? "Maharashtra")
                    </p>
                </div>
                <div class="inv-qr">Scan&nbsp;to verify</div>
            </div>

            <table class="inv-items">
                <thead><tr><th>#</th><th>Course / Item</th><th>Mode</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr></thead>
                <tbody>
                    @{ var n = 1; }
                    @foreach (var i in inv.Items)
                    {
                        <tr><td>@(n++)</td><td>@i.ProductTitle</td><td>@(i.ModeName ?? "—")</td><td class="num">@i.Quantity</td><td class="num">₹@i.UnitPrice.ToString("N2")</td><td class="num">₹@i.LineTotal.ToString("N2")</td></tr>
                    }
                </tbody>
            </table>

            <div class="inv-totals">
                @if (inv.IsFranchiseOrder && FranchiseShare(inv) > 0)
                {
                    @* Franchise invoice: franchisee share shown as a discount; tax recomputed on the
                       NET amount (matches the order-details page). *@
                    var fShare = FranchiseShare(inv);
                    var fNet = Math.Round(inv.Subtotal - fShare, 2);
                    var fRate = 18m;
                    var fGst = Math.Round(fNet * fRate / (100m + fRate), 2);
                    var fIntra = string.Equals((inv.BillingState ?? "Maharashtra").Trim(), "Maharashtra", StringComparison.OrdinalIgnoreCase);
                    var fUseIgst = inv.IgstAmount > 0 || (inv.CgstAmount <= 0 && inv.SgstAmount <= 0 && !fIntra);
                    var fCgst = Math.Round(fGst / 2m, 2);
                    var fSgst = fGst - fCgst;
                    var fTaxable = Math.Round(fNet - fGst, 2);

                    <div class="row"><span>Amount</span><span>₹@inv.Subtotal.ToString("N2")</span></div>
                    <div class="row" style="color:#065f46"><span>Franchisee Discount</span><span>− ₹@fShare.ToString("N2")</span></div>
                    <div class="row"><span>Net Amount</span><span>₹@fNet.ToString("N2")</span></div>
                    <div class="row"><span>Taxable value</span><span>₹@fTaxable.ToString("N2")</span></div>
                    @if (fUseIgst)
                    {
                        <div class="row"><span>IGST (18%)</span><span>₹@fGst.ToString("N2")</span></div>
                    }
                    else
                    {
                        <div class="row"><span>CGST (9%)</span><span>₹@fCgst.ToString("N2")</span></div>
                        <div class="row"><span>SGST (9%)</span><span>₹@fSgst.ToString("N2")</span></div>
                    }
                    <div class="row total"><span>Grand total</span><span>₹@fNet.ToString("N2")</span></div>
                }
                else
                {
                    <div class="row"><span>Amount</span><span>₹@inv.Subtotal.ToString("N2")</span></div>
                    @if (inv.DiscountAmount > 0)
                    {
                        <div class="row"><span>Discount</span><span>− ₹@inv.DiscountAmount.ToString("N2")</span></div>
                    }
                    <div class="row"><span>Taxable value</span><span>₹@inv.TaxableAmount.ToString("N2")</span></div>
                    @if (inv.IgstAmount > 0)
                    {
                        <div class="row"><span>IGST (18%)</span><span>₹@inv.IgstAmount.ToString("N2")</span></div>
                    }
                    else
                    {
                        <div class="row"><span>CGST (9%)</span><span>₹@inv.CgstAmount.ToString("N2")</span></div>
                        <div class="row"><span>SGST (9%)</span><span>₹@inv.SgstAmount.ToString("N2")</span></div>
                    }
                    <div class="row total"><span>Total</span><span>₹@inv.TotalAmount.ToString("N2")</span></div>
                }
            </div>

            <div class="inv-foot">
                This is a computer-generated invoice and does not require a signature. · RioCommerce · Thank you for learning with us!
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private InvoiceView? inv;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var actorId = Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var g) ? g : (Guid?)null;
        var actorName = state.User.Identity?.Name ?? "admin";
        inv = await Svc.GetOrCreateInvoiceAsync(Id, actorId, actorName);
        notFound = inv == null;
        // Never let a settings hiccup keep an invoice from rendering or printing.
        try { customLogoUrl = (await Settings.GetAsync()).LogoUrl; } catch { }
    }

    // Same source as the storefront header, footer and sign-in page: whatever the admin uploaded on
    // Admin › Settings, falling back to the bundled asset when nothing has been.
    private string? customLogoUrl;
    private const string FallbackLogo = "_content/RioCommerce.Web/assets/logo.png";
    private string LogoSrc => string.IsNullOrWhiteSpace(customLogoUrl) ? FallbackLogo : customLogoUrl!;


    private async Task PrintInvoice() => await JS.InvokeVoidAsync("window.print");

    // Franchisee share for the invoice: prefer the stored share; fall back to (Subtotal − NetPayable)
    // for orders that carry the net but not the share field. Clamped to the subtotal.
    private static decimal FranchiseShare(InvoiceView inv)
    {
        var share = inv.FranchiseShareAmount > 0
            ? inv.FranchiseShareAmount
            : (inv.NetPayable > 0 && inv.NetPayable < inv.Subtotal ? inv.Subtotal - inv.NetPayable : 0m);
        return Math.Min(Math.Max(0m, share), inv.Subtotal);
    }
}
