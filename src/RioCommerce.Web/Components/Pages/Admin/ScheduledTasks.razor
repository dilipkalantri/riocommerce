@code {
    private List<ScheduledTask>? tasks;
    private List<ScheduledTaskRun>? history;
    private bool runningAll, showCreateInfo;
    private Guid? running;
    private string? err;
    private ToastModel? toastMessage;

    // Filters
    private string search = "";
    private string statusFilter = "all";
    private string intervalFilter = "all";
    private bool enabledOnly;

    // Stats
    private int activeCount, failedCount, todayRuns;
    private string? lastExecText;

    // Edit drawer
    private ScheduledTask? editing;
    private int editIntervalValue = 1;
    private string editIntervalUnit = "hours";
    private int editTimeout = 300;
    private bool editEnabled, editStopOnError;

    // History drawer
    private ScheduledTask? historyFor;

    private record ToastModel(string Title, List<KeyValuePair<string, string>> Stats);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        tasks = await Svc.ListAsync();
        var recent = await Svc.ListHistoryAsync(null, take: 250);
        RecomputeStats(recent);
    }

    private void RecomputeStats(List<ScheduledTaskRun> recent)
    {
        if (tasks == null) return;
        activeCount = tasks.Count(t => t.Enabled);
        failedCount = tasks.Count(t => t.LastStatus == ScheduledTaskStatus.Failed);
        var todayLocal = DateTime.Now.Date;
        todayRuns = recent.Count(r => r.StartedAt.ToLocalTime().Date == todayLocal);
        var latest = tasks.Where(t => t.LastRunAt.HasValue).Max(t => t.LastRunAt) ?? (DateTime?)null;
        lastExecText = latest?.ToLocalTime().ToString("h:mm tt");
    }

    // Derived list with search + filters applied
    private IEnumerable<ScheduledTask> FilteredTasks
    {
        get
        {
            if (tasks == null) return Enumerable.Empty<ScheduledTask>();
            var q = (IEnumerable<ScheduledTask>)tasks;
            if (enabledOnly) q = q.Where(t => t.Enabled);
            if (!string.IsNullOrWhiteSpace(search))
            {
                var s = search.Trim();
                q = q.Where(t => (t.Name?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                              || (t.Description?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                              || (t.TaskKey?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            if (statusFilter != "all")
            {
                q = statusFilter switch
                {
                    "running" => q.Where(t => running == t.Id || t.LastStatus == ScheduledTaskStatus.Running),
                    "success" => q.Where(t => t.LastStatus == ScheduledTaskStatus.Success),
                    "idle"    => q.Where(t => t.LastStatus == ScheduledTaskStatus.Idle),
                    "failed"  => q.Where(t => t.LastStatus == ScheduledTaskStatus.Failed),
                    _ => q,
                };
            }
            if (intervalFilter != "all")
            {
                q = intervalFilter switch
                {
                    "30m" => q.Where(t => t.IntervalSeconds <= 30 * 60),
                    "1h"  => q.Where(t => t.IntervalSeconds > 30 * 60 && t.IntervalSeconds <= 60 * 60),
                    "1d"  => q.Where(t => t.IntervalSeconds > 60 * 60 && t.IntervalSeconds <= 24 * 60 * 60),
                    "other" => q.Where(t => t.IntervalSeconds > 24 * 60 * 60),
                    _ => q,
                };
            }
            return q;
        }
    }

    private static string FormatInterval(int seconds) =>
        seconds switch
        {
            >= 7 * 86400 when seconds % (7 * 86400) == 0 => $"Every {seconds / (7 * 86400)} week{(seconds == 7 * 86400 ? "" : "s")}",
            >= 86400 when seconds % 86400 == 0 => $"Every {seconds / 86400} day{(seconds == 86400 ? "" : "s")}",
            >= 3600  when seconds % 3600 == 0  => $"Every {seconds / 3600} hour{(seconds == 3600 ? "" : "s")}",
            >= 60    when seconds % 60 == 0    => $"Every {seconds / 60} minutes",
            _ => $"Every {seconds} seconds"
        };

    private static string IntervalClass(int s) =>
        s <= 30 * 60 ? "fast"
        : s <= 60 * 60 ? "hour"
        : s <= 24 * 60 * 60 ? "day"
        : "week";

    private static string StatusClass(ScheduledTaskStatus s, bool isRunning)
    {
        if (isRunning) return "running";
        return s switch
        {
            ScheduledTaskStatus.Success => "success",
            ScheduledTaskStatus.Failed  => "failed",
            ScheduledTaskStatus.Running => "running",
            ScheduledTaskStatus.Skipped => "disabled",
            _ => "idle"
        };
    }

    private static string IconFor(string key) => key switch
    {
        "PaymentStatusSync" => "💳",
        "WebhookReconciliation" => "🔄",
        "PendingOrderCleanup" => "🗑️",
        "ExpiredCartCleanup" => "🛒",
        _ => "⏱️"
    };

    private sealed record SummaryParts(bool HasSettled, int Settled, bool HasFailed, int Failed, bool HasCancelled, int Cancelled);

    // The PaymentStatusSync task emits an Output like "5 checked · 2 settled · 1 failed · 0 cancelled".
    // We just expose the per-status counts as little pills when those words are present.
    private static SummaryParts ParseSummary(int checkedCount, int updated, string? output)
    {
        if (string.IsNullOrEmpty(output)) return new SummaryParts(false, 0, false, 0, false, 0);
        int Read(string label)
        {
            var idx = output!.IndexOf(label, StringComparison.OrdinalIgnoreCase);
            if (idx < 0) return -1;
            // Walk back to find the leading integer
            var end = idx; var start = idx - 1;
            while (start >= 0 && (char.IsDigit(output[start]) || output[start] == ' ')) start--;
            var slice = output.Substring(start + 1, end - start - 1).Trim();
            return int.TryParse(slice, out var n) ? n : -1;
        }
        var settled = Read("settled");
        var failed  = Read("failed");
        var cancelled = Read("cancelled");
        return new SummaryParts(settled >= 0, Math.Max(0, settled), failed >= 0, Math.Max(0, failed), cancelled >= 0, Math.Max(0, cancelled));
    }

    private async Task RunNow(ScheduledTask t)
    {
        toastMessage = null; err = null;
        running = t.Id;
        StateHasChanged();
        var startedAt = DateTime.UtcNow;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            var summary = await Svc.RunNowAsync(t.Id, null, actor, CancellationToken.None);
            await ReloadAsync();
            if (summary != null)
            {
                var stats = new List<KeyValuePair<string, string>>
                {
                    new("Checked Orders", summary.ItemsChecked.ToString()),
                    new("Updated",        summary.ItemsUpdated.ToString()),
                    new("Execution Time", $"{(int)(DateTime.UtcNow - startedAt).TotalMilliseconds} ms"),
                };
                toastMessage = new ToastModel($"{t.Name} completed successfully", stats);
            }
            else err = "Task could not be executed.";
        }
        catch (Exception ex) { err = ex.Message; }
        finally { running = null; StateHasChanged(); }
    }

    private async Task RunAllAsync()
    {
        if (tasks == null) return;
        toastMessage = null; err = null;
        runningAll = true;
        StateHasChanged();
        var startedAt = DateTime.UtcNow;
        var totalChecked = 0; var totalUpdated = 0; var ran = 0;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name ?? "admin";
            foreach (var t in tasks.Where(x => x.Enabled).ToList())
            {
                running = t.Id;
                StateHasChanged();
                var s = await Svc.RunNowAsync(t.Id, null, actor, CancellationToken.None);
                if (s != null) { totalChecked += s.ItemsChecked; totalUpdated += s.ItemsUpdated; ran++; }
            }
            await ReloadAsync();
            toastMessage = new ToastModel(
                $"{ran} task{(ran == 1 ? "" : "s")} completed",
                new List<KeyValuePair<string, string>>
                {
                    new("Checked Orders", totalChecked.ToString()),
                    new("Updated",        totalUpdated.ToString()),
                    new("Execution Time", $"{(int)(DateTime.UtcNow - startedAt).TotalMilliseconds} ms"),
                });
        }
        catch (Exception ex) { err = ex.Message; }
        finally { runningAll = false; running = null; StateHasChanged(); }
    }

    private void OpenEdit(ScheduledTask t)
    {
        editing = t;
        if (t.IntervalSeconds % 86400 == 0) { editIntervalUnit = "days";    editIntervalValue = t.IntervalSeconds / 86400; }
        else if (t.IntervalSeconds % 3600  == 0) { editIntervalUnit = "hours";   editIntervalValue = t.IntervalSeconds / 3600; }
        else if (t.IntervalSeconds % 60    == 0) { editIntervalUnit = "minutes"; editIntervalValue = t.IntervalSeconds / 60; }
        else                                      { editIntervalUnit = "seconds"; editIntervalValue = t.IntervalSeconds; }
        editTimeout = t.TimeoutSeconds;
        editEnabled = t.Enabled;
        editStopOnError = t.StopOnError;
    }

    private void CloseEdit() => editing = null;

    private async Task SaveEdit()
    {
        if (editing == null) return;
        toastMessage = null; err = null;
        var mul = editIntervalUnit switch { "days" => 86400, "hours" => 3600, "minutes" => 60, _ => 1 };
        var seconds = Math.Max(30, editIntervalValue * mul);
        var ok = await Svc.UpdateAsync(editing.Id, seconds, editEnabled, editTimeout, editStopOnError);
        if (ok)
        {
            toastMessage = new ToastModel($"{editing.Name} updated", new List<KeyValuePair<string, string>>
            {
                new("Interval", FormatInterval(seconds)),
                new("Timeout",  $"{editTimeout} s"),
                new("Enabled",  editEnabled ? "Yes" : "No"),
            });
        }
        else err = "Could not update.";
        editing = null;
        await ReloadAsync();
    }

    private async Task OpenHistory(ScheduledTask t)
    {
        historyFor = t;
        history = null;
        StateHasChanged();
        history = await Svc.ListHistoryAsync(t.Id, 50);
    }

    private void CloseHistory() { historyFor = null; history = null; }
}
