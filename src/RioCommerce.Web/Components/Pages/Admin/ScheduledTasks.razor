@page "/admin/scheduled-tasks"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin,backend_user")]
@using RioCommerce.Core.Entities
@using RioCommerce.Core.Enums
@inject IScheduledTaskService Svc
@inject AuthenticationStateProvider AuthProvider
<PageTitle>Scheduled Tasks — RioCommerce Admin</PageTitle>

<div class="sched-v2">
    @* ─── Page header ─── *@
    <header class="sched-hero">
        <div class="sched-hero__txt">
            <h1 class="sched-hero__title">🕒 Scheduled Tasks</h1>
            <p class="sched-hero__sub">Manage background jobs, payment reconciliation, cleanup tasks and automated system operations.</p>
        </div>
        <div class="sched-hero__actions">
            <button class="sched-btn sched-btn--ghost" @onclick="() => showCreateInfo = true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                Create Task
            </button>
            <button class="sched-btn sched-btn--primary" disabled="@(runningAll || tasks == null)" @onclick="RunAllAsync">
                @if (runningAll)
                {
                    <span class="sched-spinner sched-spinner--sm" aria-hidden="true"></span>
                    <span>Running…</span>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    <span>Run All</span>
                }
            </button>
        </div>
    </header>

    @* ─── Top success/error banner ─── *@
    @if (toastMessage != null)
    {
        <div class="sched-alert sched-alert--ok" role="status">
            <div class="sched-alert__head">
                <span class="sched-alert__ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <strong>@toastMessage.Title</strong>
                <button type="button" class="sched-alert__close" @onclick="() => toastMessage = null" aria-label="Dismiss">×</button>
            </div>
            <div class="sched-alert__stats">
                @foreach (var s in toastMessage.Stats)
                {
                    <span><b>@s.Key:</b> @s.Value</span>
                }
            </div>
        </div>
    }
    @if (err != null)
    {
        <div class="sched-alert sched-alert--err" role="alert">
            <div class="sched-alert__head">
                <span class="sched-alert__ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                </span>
                <strong>@err</strong>
                <button type="button" class="sched-alert__close" @onclick="() => err = null" aria-label="Dismiss">×</button>
            </div>
        </div>
    }

    @if (tasks == null)
    {
        <div class="sched-skeleton-grid">
            @for (var i = 0; i < 4; i++) { <div class="sched-skel sched-skel--card"></div> }
        </div>
    }
    else if (tasks.Count == 0)
    {
        <div class="sched-empty">
            <div class="sched-empty__ico">🕒</div>
            <h2>No scheduled tasks found.</h2>
            <p>Tasks are seeded from registered handlers when the app boots.</p>
            <button class="sched-btn sched-btn--primary" @onclick="() => showCreateInfo = true">Create Task</button>
        </div>
    }
    else
    {
        @* ─── Summary cards ─── *@
        <div class="sched-stats">
            <div class="sched-stat sched-stat--green">
                <div class="sched-stat__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg></div>
                <div class="sched-stat__big">@activeCount</div>
                <div class="sched-stat__lbl">Active Tasks</div>
            </div>
            <div class="sched-stat sched-stat--blue">
                <div class="sched-stat__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
                <div class="sched-stat__big">@(lastExecText ?? "—")</div>
                <div class="sched-stat__lbl">Last Execution</div>
            </div>
            <div class="sched-stat sched-stat--orange">
                <div class="sched-stat__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
                <div class="sched-stat__big">@todayRuns</div>
                <div class="sched-stat__lbl">Today's Runs</div>
            </div>
            <div class="sched-stat sched-stat--red">
                <div class="sched-stat__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg></div>
                <div class="sched-stat__big">@failedCount</div>
                <div class="sched-stat__lbl">Failed Tasks</div>
            </div>
        </div>

        @* ─── Search & filter bar ─── *@
        <div class="sched-filters">
            <div class="sched-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="Search task…" @bind="search" @bind:event="oninput" />
            </div>
            <select class="sched-select" @bind="statusFilter">
                <option value="all">All statuses</option>
                <option value="success">Success</option>
                <option value="running">Running</option>
                <option value="idle">Idle</option>
                <option value="failed">Failed</option>
            </select>
            <select class="sched-select" @bind="intervalFilter">
                <option value="all">All intervals</option>
                <option value="30m">≤ 30 Minutes</option>
                <option value="1h">~ 1 Hour</option>
                <option value="1d">~ 1 Day</option>
                <option value="other">Other</option>
            </select>
            <label class="sched-toggle">
                <input type="checkbox" @bind="enabledOnly" /> Enabled only
            </label>
        </div>

        @* ─── Task cards ─── *@
        <div class="sched-cards">
            @foreach (var t in FilteredTasks)
            {
                var iconEmoji = IconFor(t.TaskKey);
                var status = t.LastStatus;
                var isRunning = running == t.Id || status == ScheduledTaskStatus.Running;
                var parsed = ParseSummary(t.LastItemsChecked, t.LastItemsUpdated, null);
                <article class="sched-card @(isRunning ? "is-running" : "")">
                    <header class="sched-card__head">
                        <span class="sched-card__emoji" aria-hidden="true">@iconEmoji</span>
                        <div class="sched-card__title-block">
                            <h3 class="sched-card__title">@t.Name</h3>
                            <p class="sched-card__desc">@(t.Description ?? "")</p>
                            <code class="sched-card__key">@t.TaskKey</code>
                        </div>
                        <div class="sched-card__enabled">
                            @if (t.Enabled) { <span class="sched-pill sched-pill--ok">Enabled</span> }
                            else { <span class="sched-pill sched-pill--off">Disabled</span> }
                        </div>
                    </header>

                    <div class="sched-card__grid">
                        <div class="sched-meta">
                            <div class="sched-meta__lbl">Status</div>
                            <div class="sched-meta__val">
                                <span class="sched-badge sched-badge--@StatusClass(status, isRunning)">
                                    <span class="sched-badge__dot"></span>
                                    @(isRunning ? "Running" : status.ToString())
                                </span>
                            </div>
                        </div>
                        <div class="sched-meta">
                            <div class="sched-meta__lbl">Interval</div>
                            <div class="sched-meta__val">
                                <span class="sched-iv sched-iv--@IntervalClass(t.IntervalSeconds)">@FormatInterval(t.IntervalSeconds)</span>
                            </div>
                        </div>
                        <div class="sched-meta">
                            <div class="sched-meta__lbl">Last Run</div>
                            <div class="sched-meta__val">
                                @if (t.LastRunAt.HasValue)
                                {
                                    <div>@t.LastRunAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div class="sched-meta__sub">@t.LastRunAt.Value.ToLocalTime().ToString("h:mm tt")</div>
                                }
                                else { <span class="sched-meta__sub">never</span> }
                            </div>
                        </div>
                        <div class="sched-meta">
                            <div class="sched-meta__lbl">Next Run</div>
                            <div class="sched-meta__val">
                                @if (t.NextRunAt.HasValue) { <span>@t.NextRunAt.Value.ToLocalTime().ToString("h:mm tt")</span> }
                                else { <span class="sched-meta__sub">—</span> }
                            </div>
                        </div>
                        <div class="sched-meta">
                            <div class="sched-meta__lbl">Duration</div>
                            <div class="sched-meta__val">@(t.LastDurationMs > 0 ? $"{t.LastDurationMs} ms" : "—")</div>
                        </div>
                    </div>

                    <div class="sched-card__stats">
                        <div class="sched-stat-pill"><span>Checked</span><b>@t.LastItemsChecked</b></div>
                        <div class="sched-stat-pill"><span>Updated</span><b>@t.LastItemsUpdated</b></div>
                        @if (parsed.HasSettled)   { <div class="sched-stat-pill sched-stat-pill--ok"><span>Settled</span><b>@parsed.Settled</b></div> }
                        @if (parsed.HasFailed)    { <div class="sched-stat-pill sched-stat-pill--err"><span>Failed</span><b>@parsed.Failed</b></div> }
                        @if (parsed.HasCancelled) { <div class="sched-stat-pill sched-stat-pill--warn"><span>Cancelled</span><b>@parsed.Cancelled</b></div> }
                    </div>

                    @if (!string.IsNullOrEmpty(t.LastError))
                    {
                        <div class="sched-card__err" title="@t.LastError">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                            @(t.LastError.Length > 90 ? t.LastError[..90] + "…" : t.LastError)
                        </div>
                    }

                    <footer class="sched-card__actions">
                        <button class="sched-btn sched-btn--primary sched-btn--sm" disabled="@(running == t.Id || runningAll)" @onclick="() => RunNow(t)">
                            @if (running == t.Id) { <span class="sched-spinner sched-spinner--sm" aria-hidden="true"></span> <span>Running…</span> }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                <span>Run Now</span>
                            }
                        </button>
                        <button class="sched-btn sched-btn--outline sched-btn--sm" @onclick="() => OpenEdit(t)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                            Edit
                        </button>
                        <button class="sched-btn sched-btn--ghost sched-btn--sm" @onclick="() => OpenHistory(t)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                            History
                        </button>
                    </footer>
                </article>
            }

            @if (!FilteredTasks.Any())
            {
                <div class="sched-empty sched-empty--small">
                    <div class="sched-empty__ico">🔍</div>
                    <h2>No tasks match your filters.</h2>
                    <p>Try clearing the search or filters above.</p>
                </div>
            }
        </div>
    }
</div>

@* ─── Edit drawer ─── *@
@if (editing != null)
{
    <div class="sched-drawer-bg" @onclick="CloseEdit"></div>
    <aside class="sched-drawer" role="dialog" aria-modal="true">
        <header class="sched-drawer__head">
            <div>
                <div class="sched-drawer__eyebrow">EDIT TASK</div>
                <h3 class="sched-drawer__title">@editing.Name</h3>
            </div>
            <button class="sched-drawer__close" @onclick="CloseEdit" aria-label="Close">×</button>
        </header>
        <div class="sched-drawer__body">
            <div class="sched-field">
                <label>Task Name</label>
                <input class="sched-input" value="@editing.Name" disabled />
                <small>Auto-generated from the registered handler.</small>
            </div>
            <div class="sched-field">
                <label>Description</label>
                <textarea class="sched-input sched-input--ta" value="@editing.Description" disabled rows="2"></textarea>
            </div>
            <div class="sched-field">
                <label>Interval</label>
                <div class="sched-field__row">
                    <input class="sched-input" type="number" min="1" @bind="editIntervalValue" style="flex:1" />
                    <select class="sched-input" @bind="editIntervalUnit" style="flex:1">
                        <option value="seconds">seconds</option>
                        <option value="minutes">minutes</option>
                        <option value="hours">hours</option>
                        <option value="days">days</option>
                    </select>
                </div>
                <small>Minimum 30 seconds.</small>
            </div>
            <div class="sched-field">
                <label>Timeout (seconds)</label>
                <input class="sched-input" type="number" min="10" max="3600" @bind="editTimeout" />
                <small>Max time a single run may take before being cancelled.</small>
            </div>
            <div class="sched-field">
                <label>Retry on next tick</label>
                <input class="sched-input" type="number" min="0" max="10" value="1" disabled />
                <small>The runner re-attempts failed tasks on the next interval automatically.</small>
            </div>
            <label class="sched-switch">
                <input type="checkbox" @bind="editEnabled" />
                <span>Enabled</span>
            </label>
            <label class="sched-switch">
                <input type="checkbox" @bind="editStopOnError" />
                <span>Stop on error (auto-disable after a failure)</span>
            </label>
        </div>
        <footer class="sched-drawer__foot">
            <button class="sched-btn sched-btn--ghost" @onclick="CloseEdit">Cancel</button>
            <button class="sched-btn sched-btn--primary" @onclick="SaveEdit">Save</button>
        </footer>
    </aside>
}

@* ─── History slide-over ─── *@
@if (historyFor != null)
{
    <div class="sched-drawer-bg" @onclick="CloseHistory"></div>
    <aside class="sched-drawer sched-drawer--wide" role="dialog" aria-modal="true">
        <header class="sched-drawer__head">
            <div>
                <div class="sched-drawer__eyebrow">HISTORY</div>
                <h3 class="sched-drawer__title">@historyFor.Name</h3>
            </div>
            <button class="sched-drawer__close" @onclick="CloseHistory" aria-label="Close">×</button>
        </header>
        <div class="sched-drawer__body">
            @if (history == null)
            {
                <p class="sched-meta__sub">Loading history…</p>
            }
            else if (history.Count == 0)
            {
                <div class="sched-empty sched-empty--small">
                    <div class="sched-empty__ico">📜</div>
                    <h2>No runs yet.</h2>
                    <p>Run the task once to see its execution history here.</p>
                </div>
            }
            else
            {
                <ul class="sched-history">
                    @foreach (var r in history)
                    {
                        <li class="sched-history__row">
                            <div class="sched-history__when">
                                <strong>@r.StartedAt.ToLocalTime().ToString("dd MMM yyyy")</strong>
                                <span>@r.StartedAt.ToLocalTime().ToString("h:mm:ss tt") · @r.Trigger</span>
                            </div>
                            <span class="sched-badge sched-badge--@StatusClass(r.Status, false)">
                                <span class="sched-badge__dot"></span>@r.Status
                            </span>
                            <div class="sched-history__stats">
                                <span><b>@r.DurationMs</b> ms</span>
                                <span>Checked <b>@r.ItemsChecked</b></span>
                                <span>Updated <b>@r.ItemsUpdated</b></span>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Output))
                            {
                                <div class="sched-history__out">@r.Output</div>
                            }
                            @if (!string.IsNullOrEmpty(r.Error))
                            {
                                <div class="sched-history__err">⚠ @r.Error</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>
}

@* ─── Create Task info modal ─── *@
@if (showCreateInfo)
{
    <div class="sched-drawer-bg" @onclick="() => showCreateInfo = false"></div>
    <div class="sched-modal" role="dialog" aria-modal="true">
        <header class="sched-modal__head">
            <h3>Create a new task</h3>
            <button class="sched-drawer__close" @onclick="() => showCreateInfo = false" aria-label="Close">×</button>
        </header>
        <div class="sched-modal__body">
            <p>Scheduled tasks are defined in code as <code>IScheduledTaskHandler</code> implementations. To add a new one:</p>
            <ol>
                <li>Create a new class in <code>RioCommerce.Infrastructure/Services/ScheduledTasks/</code> implementing <code>IScheduledTaskHandler</code> with a unique <code>Key</code>.</li>
                <li>Register it in <code>Program.cs</code> next to the existing tasks.</li>
                <li>Restart the app. A row is auto-seeded with your default interval; admin edits to interval / enabled are preserved across deploys.</li>
            </ol>
        </div>
        <footer class="sched-modal__foot">
            <button class="sched-btn sched-btn--primary" @onclick="() => showCreateInfo = false">Got it</button>
        </footer>
    </div>
}

<style>
    /* ════════════════════════════════════════════════════════════════
       SCHEDULED TASKS V2 — premium admin redesign (scoped to .sched-v2)
       ════════════════════════════════════════════════════════════════ */
    .sched-v2{--s-ink:#0F1B33;--s-mute:#64748B;--s-line:#E5ECF4;--s-bg:#F8FAFC;--s-card:#fff;--s-primary:#163A70;--s-accent:#F58220;--s-green:#22C55E;--s-blue:#3B82F6;--s-red:#EF4444;--s-orange:#F59E0B;--s-radius:16px;padding:20px 0 60px;color:var(--s-ink);font-size:14px}

    /* ── Hero ── */
    .sched-v2 .sched-hero{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;margin-bottom:22px;flex-wrap:wrap}
    .sched-v2 .sched-hero__title{margin:0;font-size:26px;font-weight:800;letter-spacing:-.4px;display:flex;align-items:center;gap:8px}
    .sched-v2 .sched-hero__sub{margin:6px 0 0;font-size:14px;color:var(--s-mute);max-width:680px;line-height:1.55}
    .sched-v2 .sched-hero__actions{display:flex;gap:10px;flex-wrap:wrap}

    /* ── Buttons ── */
    .sched-v2 .sched-btn{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border-radius:12px;border:1.5px solid transparent;font-size:13.5px;font-weight:700;cursor:pointer;text-decoration:none;background:#fff;color:var(--s-ink);transition:transform .15s,box-shadow .2s,filter .2s,background .2s,border-color .2s}
    .sched-v2 .sched-btn svg{width:15px;height:15px}
    .sched-v2 .sched-btn:hover{transform:translateY(-1px)}
    .sched-v2 .sched-btn[disabled]{opacity:.6;cursor:wait;transform:none}
    .sched-v2 .sched-btn--primary{background:linear-gradient(135deg,#163A70,#1f4d92);color:#fff;box-shadow:0 12px 24px -14px rgba(22,58,112,.5)}
    .sched-v2 .sched-btn--primary:hover{filter:brightness(1.05)}
    .sched-v2 .sched-btn--ghost{background:transparent;border-color:var(--s-line);color:var(--s-ink)}
    .sched-v2 .sched-btn--ghost:hover{background:#F8FAFC;border-color:#cad6e6}
    .sched-v2 .sched-btn--outline{background:#fff;border-color:#DBE5F2;color:var(--s-primary)}
    .sched-v2 .sched-btn--outline:hover{background:#EFF4FB;border-color:var(--s-primary)}
    .sched-v2 .sched-btn--sm{height:34px;padding:0 12px;font-size:12.5px;border-radius:10px}

    /* ── Spinner ── */
    .sched-v2 .sched-spinner{display:inline-block;width:14px;height:14px;border-radius:50%;border:2px solid currentColor;border-top-color:transparent;animation:s-spin .8s linear infinite}
    .sched-v2 .sched-spinner--sm{width:12px;height:12px;border-width:1.8px}
    @@keyframes s-spin{to{transform:rotate(360deg)}}

    /* ── Top alert ── */
    .sched-v2 .sched-alert{border-radius:16px;padding:14px 18px;margin-bottom:18px;animation:s-pop .25s ease both;border:1px solid;position:relative}
    .sched-v2 .sched-alert--ok{background:linear-gradient(135deg,#F0FDF4,#DCFCE7);border-color:#BBF7D0;color:#14532D}
    .sched-v2 .sched-alert--err{background:#FEF2F2;border-color:#FECACA;color:#7F1D1D}
    .sched-v2 .sched-alert__head{display:flex;align-items:center;gap:10px;font-size:14.5px;font-weight:700}
    .sched-v2 .sched-alert__ico{width:28px;height:28px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center}
    .sched-v2 .sched-alert--ok .sched-alert__ico{background:#22C55E;color:#fff}
    .sched-v2 .sched-alert--err .sched-alert__ico{background:#EF4444;color:#fff}
    .sched-v2 .sched-alert__ico svg{width:16px;height:16px}
    .sched-v2 .sched-alert__close{margin-left:auto;border:none;background:transparent;color:inherit;font-size:20px;cursor:pointer;width:24px;height:24px;line-height:1;padding:0;opacity:.6}
    .sched-v2 .sched-alert__close:hover{opacity:1}
    .sched-v2 .sched-alert__stats{display:flex;flex-wrap:wrap;gap:18px;margin:8px 0 0 38px;font-size:13px;color:#15803D}
    .sched-v2 .sched-alert--ok .sched-alert__stats b{font-weight:700;color:#14532D}
    @@keyframes s-pop{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}

    /* ── Summary stat cards ── */
    .sched-v2 .sched-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}
    .sched-v2 .sched-stat{background:var(--s-card);border:1px solid var(--s-line);border-radius:var(--s-radius);padding:18px;box-shadow:0 10px 28px -22px rgba(15,27,51,.22);position:relative;overflow:hidden;transition:transform .15s,box-shadow .2s}
    .sched-v2 .sched-stat:hover{transform:translateY(-2px);box-shadow:0 16px 36px -22px rgba(15,27,51,.28)}
    .sched-v2 .sched-stat__ico{width:40px;height:40px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;color:#fff;margin-bottom:8px}
    .sched-v2 .sched-stat__ico svg{width:20px;height:20px}
    .sched-v2 .sched-stat__big{font-size:30px;font-weight:800;letter-spacing:-.4px;line-height:1}
