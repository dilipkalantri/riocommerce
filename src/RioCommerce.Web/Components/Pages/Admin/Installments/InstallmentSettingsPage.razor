@page "/admin/installments/settings"
@layout AdminLayout
@attribute [Authorize(Roles = "super_admin,admin,operations,backend_user")]
@using RioCommerce.Core.DTOs.Installments
@inject IInstallmentService Svc
<PageTitle>Installment Settings — RioCommerce Admin</PageTitle>

<div class="page__header" style="display:flex;justify-content:space-between;align-items:center">
    <h1>Installment Settings</h1>
    <a href="/admin/installments/reports" class="btn btn-ghost btn-sm">📊 Reports</a>
</div>

@if (msg != null) { <div class="inline-alert inline-alert--ok" style="margin:12px 0">@msg</div> }

@if (m == null) { <p style="color:var(--gray-400)">Loading…</p> }
else
{
    <div class="data-card" style="padding:22px;max-width:640px">
        <div style="display:flex;flex-direction:column;gap:16px">
            <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
                <input type="checkbox" @bind="m.AllowInstallments" /> <span>Allow installment payments on counter orders</span>
            </label>

            <div class="form-group" style="margin:0">
                <label class="form-label">Default number of installments</label>
                <input type="number" class="form-input" style="max-width:160px" min="1" max="36" @bind="m.DefaultInstallmentCount" />
            </div>

            <div class="form-group" style="margin:0">
                <label class="form-label">Minimum down payment (%)</label>
                <input type="number" class="form-input" style="max-width:160px" min="0" max="100" step="0.5" @bind="m.MinDownPaymentPercent" />
                <small style="color:var(--gray-400)">0 = no minimum.</small>
            </div>

            <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
                <input type="checkbox" @bind="m.AutoGenerateDueDates" /> <span>Auto-generate due dates in the wizard</span>
            </label>

            <div class="form-group" style="margin:0">
                <label class="form-label">Interval between due dates (days)</label>
                <input type="number" class="form-input" style="max-width:160px" min="1" max="365" @bind="m.DefaultIntervalDays" />
            </div>

            <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
                <input type="checkbox" @bind="m.AllowManualModification" /> <span>Allow manual editing of installment amounts</span>
            </label>

            <div class="form-group" style="margin:0">
                <label class="form-label">Send reminder days before due date</label>
                <input type="number" class="form-input" style="max-width:160px" min="0" max="60" @bind="m.ReminderDaysBefore" />
                <small style="color:var(--gray-400)">0 = no reminders. The reminder task runs every 6 hours.</small>
            </div>
        </div>

        <div style="margin-top:20px;display:flex;gap:10px">
            <button class="btn btn-primary" @onclick="Save" disabled="@saving">@(saving ? "Saving…" : "Save settings")</button>
        </div>
    </div>
}

@code {
    private InstallmentSettingsModel? m;
    private bool saving;
    private string? msg;

    protected override async Task OnInitializedAsync() => m = await Svc.GetSettingsAsync();

    private async Task Save()
    {
        if (m == null) return;
        saving = true;
        try { await Svc.SaveSettingsAsync(m); msg = "Installment settings saved."; m = await Svc.GetSettingsAsync(); }
        finally { saving = false; }
    }
}
