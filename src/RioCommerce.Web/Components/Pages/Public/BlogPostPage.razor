        .hjb-vc{gap:12px;margin-top:20px}
        .hjb-vc__frame{border-radius:13px}
        .hjb-vc__form{padding:14px;border-radius:14px}
        .hjb-vc__form-title{font-size:15.5px}
        .hjb-vc__form-sub{font-size:12px;margin-bottom:12px}

        .hjb-latest{padding:12px;border-radius:16px}
        .hjb-side__list{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
        .hjb-mini{grid-template-columns:minmax(0,1fr);gap:7px;padding:7px;border-radius:12px}
        .hjb-mini__media{aspect-ratio:16/10;border-radius:9px}
        .hjb-mini__title{font-size:12px;-webkit-line-clamp:2}
        .hjb-mini__meta{font-size:9.5px}

        .hjb-share{margin-top:20px;padding-top:14px;gap:9px}
        .hjb-share__label{font-size:12px;width:100%}
        .hjb-share__btn{width:34px;height:34px;border-radius:10px}
