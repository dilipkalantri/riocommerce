        .hjb-course--img{padding:0;border-radius:12px}

        .hjb-nav{grid-template-columns:1fr;gap:9px}
        .hjb-nav__item--next{text-align:left;align-items:flex-start}

        /* Compact 2-up Latest Blogs tiles — vertical, not horizontal, so the
