        .hjb-hero__img{aspect-ratio:16/10}
        .hjb-hero__title{font-size:clamp(26px,7vw,32px);letter-spacing:-.3px;margin-bottom:9px}
        .hjb-hero__meta{font-size:11.5px;gap:6px 8px;padding-bottom:12px}
        .hjb-hero__cat{font-size:10px;padding:4px 11px}

        .hjb-article{font-size:15.2px;line-height:1.75}

        /* 2-up summary per the spec: 2 + 2 + 1, the fifth card sitting alone on
           the last row. */
        .hjb-sumbox{padding:11px 12px 12px;border-radius:14px;margin-bottom:18px}
        .hjb-sum__head{font-size:13.5px;margin-bottom:10px}
        .hjb-sum{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
        .hjb-sum__card{padding:11px;border-radius:12px}
        .hjb-sum__num{width:21px;height:21px;font-size:11px;margin-bottom:4px}
        .hjb-sum__title{font-size:12.5px}
        .hjb-sum__desc{font-size:11.5px;line-height:1.45}
        /* Compact cue on phones — 11px sits inside the 10–12px band and the label
           still fits one line at 360px. */
        .hjb-dive{margin-top:10px;padding:5px 8px}
        .hjb-dive .hjb-dive__ico,
        .hjb .hjb-sumbox .hjb-dive .hjb-dive__ico:not([width]):not([data-large]):not(.svg-noclamp){
            width:18px;height:18px;
        }
        .hjb-dive__text{font-size:11px;letter-spacing:.5px}
        .hjb-chips{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
        .hjb-chips > li{padding:9px 11px;font-size:12.5px}

        .hjb-callout{padding:13px 14px 11px;border-radius:14px}

        .hjb-courses__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
        .hjb-course{padding:12px 13px;border-radius:13px}
        .hjb-course__name{font-size:13.5px}
        .hjb-course__go{font-size:11px}
        /* The mobile padding above is for the text tile only — an image card must stay
