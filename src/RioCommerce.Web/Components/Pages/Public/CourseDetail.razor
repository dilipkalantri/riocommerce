    // description / max-pages). When set, it takes precedence over the legacy
    // BookPreviewPdfUrl. previewToken is a fresh signed URL fragment issued each
    // time the modal opens — never reused, expires in 15 minutes.
    private RioCommerce.Core.DTOs.Products.ProductBookPreviewPublic? bookPreview;
