    // ── YouTube helpers (extract id → thumbnail + autoplay embed) ──
    private static string? YtId(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        var m = System.Text.RegularExpressions.Regex.Match(url,
            @"(?:youtu\.be/|youtube\.com/(?:watch\?(?:.*&)?v=|embed/|shorts/|live/))([A-Za-z0-9_-]{11})");
        return m.Success ? m.Groups[1].Value : null;
    }
    private static string YtThumb(string id) => $"https://img.youtube.com/vi/{id}/hqdefault.jpg";
    private static string YtEmbed(string id) => $"https://www.youtube.com/embed/{id}?autoplay=1&rel=0&playsinline=1";

    // When special price is active, compare against the higher of MRP or regular SellingPrice.
    private decimal DetailStrikethrough => product?.IsSpecialPriceActive == true
        ? Math.Max(product.Mrp, product.SellingPrice)
        : product?.Mrp ?? 0;

    private int SavePct => DetailStrikethrough > 0 && DetailStrikethrough > EffectivePrice
        ? (int)Math.Round((DetailStrikethrough - EffectivePrice) / DetailStrikethrough * 100) : 0;

    // Maps an inclusion title to a crisp line-icon + colour tone, falling back to the stored emoji/icon.
    private static (MarkupString icon, string tone) IncMeta(string? title, string? fallback)
    {
        var t = (title ?? "").ToLowerInvariant();
        (string svg, string tone)? pick =
            t.Contains("video") || t.Contains("lecture") || t.Contains("recorded") || t.Contains("practical") || t.Contains("demo") ? (SvgVideo, "orange") :
            t.Contains("download") || t.Contains("resource") || t.Contains("note") || t.Contains("pdf") || t.Contains("material") ? (SvgDownload, "blue") :
            t.Contains("test") || t.Contains("quiz") || t.Contains("mock") || t.Contains("mcq") || t.Contains("assignment") ? (SvgTest, "green") :
            t.Contains("zoom") || t.Contains("live") || t.Contains("session") || t.Contains("class") ? (SvgLive, "purple") :
            t.Contains("telegram") || t.Contains("community") || t.Contains("whatsapp") || t.Contains("group") || t.Contains("doubt") || t.Contains("support") || t.Contains("mentor") ? (SvgPeople, "teal") :
            t.Contains("book") || t.Contains("hardcopy") ? (SvgBook, "navy") :
            t.Contains("certificate") || t.Contains("award") ? (SvgAward, "green") :
            ((string, string)?)null;

        if (pick is { } p) return ((MarkupString)p.svg, p.tone);
        return string.IsNullOrWhiteSpace(fallback)
            ? ((MarkupString)SvgCheck, "navy")
            : ((MarkupString)fallback, "navy");   // keep the admin-entered emoji/icon
    }

