    // All page URLs for the active preview, generated server-side when the modal opens.
    private List<string> previewUrls = new();
    private int previewPage = 1;
    /// <summary>"page" → fit by height (no crop); "width" → fit by width (vertical scroll when tall).</summary>
    private string previewFitMode = "page";
    /// <summary>1.0 = fit; user-adjustable in 15% steps via toolbar.</summary>
    private double previewZoom = 1.0;

    // Tab-visibility helpers — only render tabs that have content.
    private bool HasLectures => product != null && YtId(product.LecturesVideoUrl) != null;
    // New entity takes precedence; falls back to the legacy Product.BookPreviewPdfUrl column so
    // courses that haven't migrated yet still render something.
    private bool HasBookPreview => bookPreview != null || !string.IsNullOrWhiteSpace(product?.BookPreviewPdfUrl);

    // Stable key for the modal container — Blazor uses it to reuse the SAME DOM
    // across re-renders while the popup is open, so swipe state / current image
    // never gets torn down by an unrelated parent re-render.
    private const string BookPreviewModalKey = "hjc-book-reader-modal";

    private async Task OpenBookPreviewAsync()
    {
        if (product == null || previewModalOpen || bookPreview == null) return;

        // Issue a single signed token, then expand it to one URL per page right here on
        // the server. Blazor renders the markup with those URLs in <img src=...> attributes
        // and navigation is pure @onclick → re-render. No external JS, no interop, nothing
        // to cache stale.
        var token = await BookPreviewSvc.IssueImageTokenAsync(product.Id);
        if (string.IsNullOrEmpty(token))
        {
            Console.Error.WriteLine("[hjc.br] no token issued — preview not configured");
            return;
        }

        var urls = new List<string>(bookPreview.TotalPages);
        for (var i = 1; i <= bookPreview.TotalPages; i++)
            urls.Add($"/api/bookpreview/image/{token}/{i}");

        previewUrls = urls;
        previewPage = 1;
        previewModalOpen = true;
    }

    private Task CloseBookPreviewAsync()
    {
        previewModalOpen = false;
        previewUrls = new();
        previewPage = 1;
        previewFitMode = "page";
        previewZoom = 1.0;
        return Task.CompletedTask;
    }

    private void PreviewPrev() { if (previewPage > 1) previewPage--; }
    private void PreviewNext() { if (previewPage < previewUrls.Count) previewPage++; }

    private void PreviewFit(string mode)
    {
        previewFitMode = mode == "width" ? "width" : "page";
        previewZoom = 1.0;
    }
    private void PreviewToggleFit() => PreviewFit(previewFitMode == "page" ? "width" : "page");
    private void PreviewZoomIn()  { previewZoom = Math.Min(3.0, previewZoom + 0.15); }
    private void PreviewZoomOut() { previewZoom = Math.Max(0.4, previewZoom - 0.15); }
    private string PreviewZoomLabel => $"{Math.Round(previewZoom * 100)}%";
