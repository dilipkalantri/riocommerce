            {
                <div class="pd-buybox__rating">
                    <span class="stars stars--sm">@Stars(reviews.Summary.AvgRating)</span>
                    <strong>@reviews.Summary.AvgRating.ToString("0.0")</strong>
                    <span style="color:var(--gray-500);font-size:13px">(@reviews.Summary.RatingCount review@(reviews.Summary.RatingCount == 1 ? "" : "s"))</span>
                </div>
            }

            @if (product.Modes.Any())
            {
                <div class="attributes">
                    <label class="form-label">Mode Of Lectures</label>
                    <select class="form-input" @bind="selectedModeId">
                        @foreach (var m in product.Modes)
                        {
                            // Show the effective price = base + this mode's add-on. Matches what
                            // Checkout charges. When special is active, the base is SpecialPrice.
                            var _base = product.IsSpecialPriceActive ? product.SpecialPrice!.Value : product.SellingPrice;
                            var _effective = _base + m.Price;
                            <option value="@m.Id">@m.ModeName — ₹@_effective.ToString("N0")</option>
                        }
                    </select>
                </div>
            }

            @foreach (var g in product.OptionGroups.Where(g => g.Options.Count > 0))
            {
                <div class="attributes">
                    <label class="form-label">@g.Name</label>
                    <select class="form-input" value="@GetSelectedOption(g.Id)"
                            @onchange="e => SetSelectedOption(g.Id, e.Value?.ToString())">
                        <option value="">— Select —</option>
                        @foreach (var o in g.Options)
                        {
                            <option value="@o.Id">@o.Name@(o.PriceAddOn > 0 ? $" (+₹{o.PriceAddOn:N0})" : "")</option>
                        }
                    </select>
                </div>
            }

            @foreach (var a in product.Attributes)
            {
                <div class="attributes">
                    <label class="form-label">@(string.IsNullOrWhiteSpace(a.TextPrompt) ? a.AttributeName : a.TextPrompt) @if (a.IsRequired) { <span style="color:var(--error)">*</span> }</label>
                    @switch (a.ControlType)
                    {
                        case "DropdownList":
                            <select class="form-input" value="@attrSingle.GetValueOrDefault(a.MappingId)" @onchange="e => SetSingle(a.MappingId, e)">
                                @foreach (var v in a.Values) { <option value="@v.Id" selected="@(attrSingle.GetValueOrDefault(a.MappingId) == v.Id)">@v.Name@PriceTag(v)</option> }
                            </select>
                            break;
                        case "RadioList":
                            <div class="attr-options">
                                @foreach (var v in a.Values)
                                {
                                    <label class="attr-option"><input type="radio" name="attr-@a.MappingId" checked="@(attrSingle.GetValueOrDefault(a.MappingId) == v.Id)" @onchange="() => attrSingle[a.MappingId] = v.Id" /> @v.Name@PriceTag(v)</label>
                                }
                            </div>
                            break;
                        case "Checkboxes":
                            <div class="attr-options">
                                @foreach (var v in a.Values)
                                {
                                    <label class="attr-option"><input type="checkbox" checked="@(attrMulti.GetValueOrDefault(a.MappingId)?.Contains(v.Id) == true)" @onchange="e => ToggleMulti(a.MappingId, v.Id, e)" /> @v.Name@PriceTag(v)</label>
                                }
                            </div>
                            break;
                        case "MultilineTextBox":
                            <textarea class="form-input" rows="2" value="@attrText.GetValueOrDefault(a.MappingId)" @onchange="e => attrText[a.MappingId] = e.Value?.ToString()"></textarea>
                            break;
                        case "Datepicker":
                            <input type="date" class="form-input" value="@attrText.GetValueOrDefault(a.MappingId)" @onchange="e => attrText[a.MappingId] = e.Value?.ToString()" />
                            break;
                        default:
                            <input class="form-input" value="@attrText.GetValueOrDefault(a.MappingId)" @onchange="e => attrText[a.MappingId] = e.Value?.ToString()" />
                            break;
                    }
                </div>
            }

            <div class="product-detail__pricing">
                <span class="product-detail__price">₹@EffectivePrice.ToString("N0")</span>
                @if (DetailStrikethrough > EffectivePrice)
                {
                    <span class="product-detail__mrp">₹@DetailStrikethrough.ToString("N0")</span>
                    @if (SavePct > 0) { <span class="pd-save">SAVE @SavePct%</span> }
                }
                <span class="product-detail__tax">Incl. @product.GstRate.ToString("0")% GST</span>
            </div>

            @if (attrError != null) { <div class="inline-alert inline-alert--err" style="margin-top:6px">@attrError</div> }
            @{
                // Spec #10: when BatchStatus == OutOfStock, hide Add To Cart + Buy Now entirely
                // and replace with a red "Out Of Stock" badge + Notify Me button.
                var oos = product.BatchStatus == BatchStatus.OutOfStock;
            }
            @if (isFranchiseUser)
            {
                <div class="pd-franchise-box">
                    <div class="pd-franchise-box__title">🏢 Franchise account</div>
                    <p class="pd-franchise-box__text">
                        Franchise orders are placed through the Franchise Portal at your franchise pricing —
                        not the regular customer cart. This course (with the mode and options selected above)
                        will be added to your order automatically.
                    </p>
                    <a class="btn btn-primary" href="@CurrentFranchiseOrderUrl">Go To Franchise Portal → Place Order</a>
                </div>
            }
            else if (oos)
            {
                <div class="pd-oos-box">
                    <div class="pd-oos-badge"><span class="pd-oos-badge__dot"></span>🔴 @product.BatchStatusText</div>
                    <button class="pd-notify-btn" @onclick="NotifyMe" disabled="@notifying">
                        @if (notifyAcked) { <span>✔ We'll notify you when this batch reopens</span> }
                        else { <span>🔔 Notify Me when available</span> }
                    </button>
                </div>
            }
            else
            {
                <div class="pd-buybox__cta-row">
                    @* Inline SVGs rather than emoji: emoji render as a different
                       glyph on every OS (and in colour), which looked pasted-on
                       next to the site's stroked icon set. The cart path is the
                       same one the header uses, so the two now match exactly. *@
                    <button class="btn btn-primary" disabled="@adding" @onclick="AddToCart">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1"/><circle cx="19" cy="20" r="1"/><path d="M2 3h2.2l2 12.4a2 2 0 0 0 2 1.6h9a2 2 0 0 0 2-1.6L22 7H5.2"/></svg>
                        Add To Cart
                    </button>
                    <button class="btn btn-secondary" disabled="@adding" @onclick="BuyNow">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg>
                        Buy Now
                    </button>
                </div>
            }
            @if (added)
            {
                <div class="added-msg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Added To Cart! <a href="/cart">View Cart →</a></div>
            }

            @if (product.Inclusions.Any())
            {
                <div class="pd-includes" style="margin-top:6px">
                    <h4>This Course Includes</h4>
                    <div class="pd-includes__list">
                        @foreach (var i in product.Inclusions)
                        {
                            var m = IncMeta(i.Title, i.Icon);
                            <div class="pd-inc">
                                <span class="pd-inc__ico pd-inc__ico--@m.tone">@m.icon</span>
                                <span class="pd-inc__txt">@i.Title</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>

    @* ══════════════════════════════════════════════════════════════════════════
       Book Preview reader — image-based, server-driven.
       Server pre-rendered every PDF page to a WebP at upload time. The URLs
       for every page are built server-side when the modal opens, and Blazor
       handles navigation natively via @onclick — no external JS file, no
       cache invalidation, no state machine.
       ══════════════════════════════════════════════════════════════════════════ *@
    @if (previewModalOpen && previewUrls.Count > 0)
    {
        var currentSrc = previewUrls[Math.Clamp(previewPage, 1, previewUrls.Count) - 1];
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var zoomCss = previewZoom.ToString("0.###", inv);
        var fitClass = "br-stage--fit-" + previewFitMode;
        var scrollClass = previewZoom > 1.001 || previewFitMode == "width" ? "br-stage--scroll" : "";
        var progressPct = ((double)previewPage / previewUrls.Count * 100).ToString("0.##", inv);

        <div class="br-modal" role="dialog" aria-modal="true" aria-label="Book preview" @key="@BookPreviewModalKey">
            <div class="br-modal__overlay" @onclick="CloseBookPreviewAsync"></div>
            <div class="br-modal__panel">

                @* ── Sticky header ── *@
                <div class="br-head">
                    <div class="br-head__brand">
                        <span class="br-head__ico" aria-hidden="true">📚</span>
                        <div>
                            <div class="br-head__title">@(bookPreview?.Title ?? "Book Preview")</div>
                            <div class="br-head__progress">Page @previewPage of @previewUrls.Count</div>
                        </div>
                    </div>
                    <button type="button" class="br-head__close" @onclick="CloseBookPreviewAsync" aria-label="Close preview">×</button>
                </div>

                <div class="br-progress">
                    <div class="br-progress__fill" style="width:@(progressPct)%"></div>
                </div>

                @* ── Scrollable stage — only this area scrolls ── *@
                <div class="br-stage @fitClass @scrollClass" style="--br-zoom:@zoomCss">
                    <div class="br-page-pad">
                        <img class="br-page-img"
                             src="@currentSrc"
                             alt="Page @previewPage"
                             @ondblclick="PreviewToggleFit"
                             title="Double-click to toggle Fit Page / Fit Width" />
                    </div>

                    @* Sticky edge nav — stays in place while the page scrolls ── *@
                    <button type="button" class="br-edge br-edge--left"  @onclick="PreviewPrev" disabled="@(previewPage <= 1)"                    aria-label="Previous page">‹</button>
                    <button type="button" class="br-edge br-edge--right" @onclick="PreviewNext" disabled="@(previewPage >= previewUrls.Count)" aria-label="Next page">›</button>
                </div>

                @* ── Sticky toolbar ── *@
                <div class="br-toolbar">
                    <div class="br-tb-group">
                        <button type="button" class="br-tb-btn" @onclick="PreviewPrev" disabled="@(previewPage <= 1)" aria-label="Previous page" title="Previous page">‹</button>
                        <span class="br-tb-pages"><span>@previewPage</span><span class="br-tb-pages-sep">/</span><span>@previewUrls.Count</span></span>
                        <button type="button" class="br-tb-btn" @onclick="PreviewNext" disabled="@(previewPage >= previewUrls.Count)" aria-label="Next page" title="Next page">›</button>
                    </div>
                    <div class="br-tb-spacer"></div>
                    <div class="br-tb-group">
                        <button type="button" class="br-tb-btn" @onclick="PreviewZoomOut" aria-label="Zoom out" title="Zoom out">−</button>
                        <span class="br-tb-zoom">@PreviewZoomLabel</span>
                        <button type="button" class="br-tb-btn" @onclick="PreviewZoomIn"  aria-label="Zoom in"  title="Zoom in">+</button>
                        <button type="button" class="br-tb-pill @(previewFitMode == "page"  ? "is-active" : "")" @onclick='() => PreviewFit("page")'  title="Fit Page">Fit Page</button>
                        <button type="button" class="br-tb-pill @(previewFitMode == "width" ? "is-active" : "")" @onclick='() => PreviewFit("width")' title="Fit Width">Fit Width</button>
                        <button type="button" class="br-tb-btn br-tb-btn--fs" @onclick="PreviewFullscreenAsync" aria-label="Fullscreen" title="Fullscreen">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5"/><path d="M20 9V4h-5"/><path d="M4 15v5h5"/><path d="M20 15v5h-5"/></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════════
       Testimonials player modal.
       Iframe lazy-loads only when the modal opens (autoplay starts on mount).
       Shorts URLs render in a 9:16 portrait frame; standard videos use 16:9.
       Prev/Next + Esc nav. Close clears src so the iframe truly stops playing.
       ══════════════════════════════════════════════════════════════════════════ *@
    @if (testimonialModalOpen && product != null && testimonialIndex >= 0 && testimonialIndex < product.Testimonials.Count)
    {
        var t = product.Testimonials[testimonialIndex];
        // Mute=0, autoplay=1, rel=0 (no related videos), modestbranding=1, controls=1.
        var embedUrl = $"https://www.youtube.com/embed/{t.YoutubeVideoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1";
        <div class="ts-modal" role="dialog" aria-modal="true" aria-label="Testimonial" @key="@TestimonialModalKey">
            <div class="ts-modal__overlay" @onclick="CloseTestimonial"></div>
            <div class="ts-modal__panel @(t.IsShorts ? "ts-modal__panel--reel" : "")">
                <div class="ts-modal__head">
                    <div class="ts-modal__meta">
                        <div class="ts-modal__name">🎥 Testimonial</div>
                    </div>
                    <div class="ts-modal__counter">@(testimonialIndex + 1) / @product.Testimonials.Count</div>
                    <button type="button" class="ts-modal__close" @onclick="CloseTestimonial" aria-label="Close">×</button>
                </div>
                <div class="ts-modal__stage">
                    <button type="button" class="ts-modal__nav ts-modal__nav--prev" @onclick="TestimonialPrev" disabled="@(testimonialIndex <= 0)" aria-label="Previous testimonial">‹</button>
                    <div class="ts-modal__player @(t.IsShorts ? "ts-modal__player--reel" : "")">
                        <iframe src="@embedUrl"
                                title="@($"Testimonial by {t.StudentName}")"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen></iframe>
                    </div>
                    <button type="button" class="ts-modal__nav ts-modal__nav--next" @onclick="TestimonialNext" disabled="@(testimonialIndex >= product.Testimonials.Count - 1)" aria-label="Next testimonial">›</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private ProductDetailResponse? product;
    private bool loading = true, added, adding;
    // True when the signed-in user is a franchise account — such users order via the Franchise
    // Portal, so the customer Add To Cart / Buy Now controls are replaced with a notice.
    private bool isFranchiseUser;
    private Guid? selectedModeId;
    private string tab = "overview";
    private SeoMetadata seo = new();
    private ElementReference galleryEl;
    private bool galleryInit;

    private ProductReviews? reviews;
    private int newRating;
    private string newReviewTitle = "", newReviewComment = "";
    private bool reviewOk;
    private string? reviewMsg;

    // Offer / Combo Recommendations (admin-curated cross-sells)
    private List<RecommendationCard>? recommendations;
    private HashSet<Guid> recoAddingIds = new();

    // Attribute selection state, keyed by mapping id.
    private readonly Dictionary<Guid, Guid?> attrSingle = new();           // dropdown / radio
    private readonly Dictionary<Guid, HashSet<Guid>> attrMulti = new();    // checkboxes
    private readonly Dictionary<Guid, string?> attrText = new();           // text / multiline / date
    private string? attrError;

    // Purchase-option selection state, keyed by group id → chosen option id.
    private readonly Dictionary<Guid, Guid?> optionSingle = new();
    private string? GetSelectedOption(Guid groupId)
        => optionSingle.TryGetValue(groupId, out var v) && v.HasValue ? v.Value.ToString() : "";
    private void SetSelectedOption(Guid groupId, string? optionIdStr)
        => optionSingle[groupId] = Guid.TryParse(optionIdStr, out var g) ? g : (Guid?)null;

    // Sum of add-ons for the currently selected option in each group (server re-validates on checkout).
    private decimal OptionsAddOn
    {
        get
        {
            if (product == null) return 0m;
            decimal sum = 0m;
            foreach (var g in product.OptionGroups)
                if (optionSingle.TryGetValue(g.Id, out var oid) && oid.HasValue)
                    sum += g.Options.FirstOrDefault(o => o.Id == oid.Value)?.PriceAddOn ?? 0m;
            return sum;
        }
    }

    // The option ids selected across all groups — sent to the cart so checkout can price them.
    private List<Guid> SelectedOptionIds()
        => optionSingle.Values.Where(v => v.HasValue).Select(v => v!.Value).ToList();

    // ── Franchise hand-off ────────────────────────────────────────────────────
    // A franchise account can browse the public site but can't use the customer cart, so every
    // franchise path leaves this page for /franchise/order. Carry the course the franchisee was
    // looking at — plus the lecture mode and purchase options picked here — in the query string
    // so the portal opens with that line already added instead of an empty order form.
    private static string FranchiseOrderUrl(Guid productId, Guid? modeId = null, IEnumerable<Guid>? optionIds = null)
    {
        var qs = new List<string> { "product=" + productId.ToString() };
        if (modeId.HasValue) qs.Add("mode=" + modeId.Value.ToString());
        foreach (var o in optionIds ?? Enumerable.Empty<Guid>()) qs.Add("opt=" + o.ToString());
        return "/franchise/order?" + string.Join("&", qs);
    }

    private string CurrentFranchiseOrderUrl
        => product == null ? "/franchise/order" : FranchiseOrderUrl(product.Id, selectedModeId, SelectedOptionIds());

    // Mode price is ADDITIVE — add-on to the regular (or special) base. Matches CheckoutService /
    // CartService / OrderAdminService pricing so what's shown on the product page equals what's charged.
    private decimal CurrentPrice
    {
        get
        {
            if (product == null) return 0m;
            var basePrice = product.IsSpecialPriceActive ? product.SpecialPrice!.Value : product.SellingPrice;
            var modeAddOn = product.Modes.FirstOrDefault(m => m.Id == selectedModeId)?.Price ?? 0m;
            return basePrice + modeAddOn + OptionsAddOn;
        }
    }

    private decimal AttributesAdjustment
    {
        get
        {
            if (product == null) return 0m;
            var basePrice = CurrentPrice;
            decimal sum = 0m;
            foreach (var a in product.Attributes)
            {
                IEnumerable<ProductAttributeValueDto> chosen = a.ControlType switch
                {
                    "DropdownList" or "RadioList" => a.Values.Where(v => attrSingle.GetValueOrDefault(a.MappingId) == v.Id),
                    "Checkboxes" => a.Values.Where(v => attrMulti.GetValueOrDefault(a.MappingId)?.Contains(v.Id) == true),
                    _ => Enumerable.Empty<ProductAttributeValueDto>()
                };
                foreach (var v in chosen)
                    sum += v.PriceAdjustmentUsePercentage ? Math.Round(basePrice * v.PriceAdjustment / 100m, 2) : v.PriceAdjustment;
            }
            return sum;
        }
    }

    private decimal EffectivePrice => CurrentPrice + AttributesAdjustment;

    private MarkupString PriceTag(ProductAttributeValueDto v)
    {
        if (v.PriceAdjustment == 0) return (MarkupString)"";
        var amount = v.PriceAdjustmentUsePercentage ? $"{v.PriceAdjustment:0.##}%" : $"₹{Math.Abs(v.PriceAdjustment):N0}";
        return (MarkupString)$" ({(v.PriceAdjustment > 0 ? "+" : "−")}{amount})";
    }

    private void SetSingle(Guid mappingId, ChangeEventArgs e)
        => attrSingle[mappingId] = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;

    private void ToggleMulti(Guid mappingId, Guid valueId, ChangeEventArgs e)
    {
        var set = attrMulti.TryGetValue(mappingId, out var s) ? s : (attrMulti[mappingId] = new HashSet<Guid>());
        if (e.Value is true) set.Add(valueId); else set.Remove(valueId);
    }

    private void InitAttributeState()
    {
        attrSingle.Clear(); attrMulti.Clear(); attrText.Clear(); attrError = null;
        if (product == null) return;
        foreach (var a in product.Attributes)
        {
            switch (a.ControlType)
            {
                case "DropdownList":
                case "RadioList":
                    var pre = a.Values.FirstOrDefault(v => v.IsPreSelected) ?? (a.ControlType == "DropdownList" ? a.Values.FirstOrDefault() : null);
                    attrSingle[a.MappingId] = pre?.Id;
                    break;
                case "Checkboxes":
                    attrMulti[a.MappingId] = a.Values.Where(v => v.IsPreSelected).Select(v => v.Id).ToHashSet();
                    break;
                default:
                    attrText[a.MappingId] = null;
                    break;
            }
        }
    }

    private List<AttributeSelection> BuildSelections()
    {
        var list = new List<AttributeSelection>();
        if (product == null) return list;
        foreach (var a in product.Attributes)
        {
            switch (a.ControlType)
            {
                case "DropdownList":
                case "RadioList":
                    if (attrSingle.GetValueOrDefault(a.MappingId) is Guid g) list.Add(new AttributeSelection(a.MappingId, g));
                    break;
                case "Checkboxes":
                    if (attrMulti.TryGetValue(a.MappingId, out var set))
                        foreach (var vid in set) list.Add(new AttributeSelection(a.MappingId, vid));
                    break;
                default:
                    if (attrText.GetValueOrDefault(a.MappingId) is { } t && !string.IsNullOrWhiteSpace(t))
                        list.Add(new AttributeSelection(a.MappingId, null, t));
                    break;
            }
        }
        return list;
    }

    private bool ValidateRequired()
    {
        if (product == null) return true;
        foreach (var a in product.Attributes.Where(x => x.IsRequired))
        {
            var has = a.ControlType switch
            {
                "DropdownList" or "RadioList" => attrSingle.GetValueOrDefault(a.MappingId).HasValue,
                "Checkboxes" => attrMulti.GetValueOrDefault(a.MappingId)?.Count > 0,
                _ => !string.IsNullOrWhiteSpace(attrText.GetValueOrDefault(a.MappingId))
            };
            if (!has) { attrError = $"Please choose {a.AttributeName}."; return false; }
        }
        attrError = null;
        return true;
    }
    private string LevelLabel => product?.Level switch
    {
        CourseLevel.CaFoundation => "CA Foundation",
        CourseLevel.CaIntermediate => "CA Intermediate",
        CourseLevel.CaFinal => "CA Final",
        CourseLevel.Books => "Books",
        _ => "Courses"
    };
    private string LevelSlug => product?.Level switch
    {
        CourseLevel.CaIntermediate => "ca-intermediate",
        CourseLevel.CaFinal => "ca-final",
        CourseLevel.Books => "books",
        _ => "ca-foundation"
    };
    private string LevelEmoji => product?.Level switch
    {
        CourseLevel.CaIntermediate => "📈",
        CourseLevel.CaFinal => "🏆",
        CourseLevel.Books => "📚",
        _ => "🎓"
    };
    private string FacultyInitials
    {
        get
        {
            var n = product?.FacultyName;
            if (string.IsNullOrWhiteSpace(n)) return "RC";
            var parts = n.Replace("CA", "").Replace("CS", "").Replace("Prof.", "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpper() : n[..Math.Min(2, n.Length)].ToUpper();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        added = false;
        galleryInit = false;
        tab = "overview";
        reviews = null;
        reviewMsg = null;
        newRating = 0;
        newReviewTitle = newReviewComment = "";
        try
        {
            var uid = await CurrentUserIdAsync();
            isFranchiseUser = uid != null && (await FranchisePortal.ResolveFranchiseIdAsync(uid.Value)) != null;
        }
        catch { isFranchiseUser = false; }
        try
        {
            var r = await Http.GetFromJsonAsync<ApiResponse<ProductDetailResponse>>($"/api/products/{Slug}");
            product = r?.Data;
            if (product != null)
            {
                selectedModeId = product.Modes.FirstOrDefault()?.Id;
                InitAttributeState();
                seo = new() { Title = product.SeoTitle ?? $"{product.Title} — RioCommerce", Description = product.SeoDescription ?? product.ShortDesc ?? "", JsonLd = BuildJsonLd(product) };
                await LoadReviewsAsync();
                try { recommendations = await RecoSvc.GetForProductAsync(product.Id, 8); } catch { recommendations = new(); }
                // Fetch the active Book Preview metadata (cover/title/desc). The PDF itself is
                // never linked — opening the modal requests a fresh signed token each time.
                try { bookPreview = await BookPreviewSvc.GetActiveAsync(product.Id); } catch { bookPreview = null; }
            }
        }
        catch { product = null; }
        loading = false;
    }

    private async Task<Guid?> CurrentUserIdAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        return Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
    }

    private async Task AddToCartReco(Guid productId)
    {
        if (isFranchiseUser) { Nav.NavigateTo(FranchiseOrderUrl(productId)); return; }
        var uid = await CurrentUserIdAsync();
        if (uid == null) { Nav.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString($"/{Slug}")); return; }
        if (recoAddingIds.Contains(productId)) return;
        recoAddingIds.Add(productId);
        try
        {
            var (ok, _) = await Cart.AddAsync(uid.Value, productId, null);
            // silently ignore duplicates for reco cards
        }
        catch { }
        finally { recoAddingIds.Remove(productId); }
    }

    // Enum -> CSS variant only. Display text reads from product.BatchStatusText / rc.BatchStatusText
    // (single source of truth on the DTO — never hardcode the labels here).
    private static string PdBatchClass(BatchStatus s) => s switch
    {
        BatchStatus.Upcoming => "upcoming",
        BatchStatus.Ongoing => "ongoing",
        BatchStatus.PreRecorded => "prerec",
        BatchStatus.OutOfStock => "oos",
        BatchStatus.ComingSoon => "soon",
        _ => "upcoming"
    };

    // Notify Me — local UI state. Shown when BatchStatus == OutOfStock. The button flips to a
    // confirmation label after click so the student gets instant feedback. A server-side
    // subscription record can be wired in later as an additive change.
    private bool notifying, notifyAcked;
    private async Task NotifyMe()
    {
        if (notifyAcked || notifying) return;
        notifying = true;
        try { await Task.Delay(150); notifyAcked = true; }
        finally { notifying = false; }
    }

