@* Rendered by the central PublicSlug resolver at /{slug} (not routed directly). *@
@inject HttpClient Http
@inject ICartService Cart
@inject IReviewService ReviewSvc
@inject IProductRecommendationService RecoSvc
@inject IBookPreviewService BookPreviewSvc
@inject AuthenticationStateProvider AuthProvider
@inject IFranchisePortalService FranchisePortal
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    .attr-options{display:flex;flex-direction:column;gap:6px}
    .attr-option{display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer}
    .specs{margin-top:24px}
    .specs h4{margin-bottom:8px}
    .specs-table{width:100%;border-collapse:collapse;font-size:14px}
    .specs-table td{padding:8px 10px;border-bottom:1px solid var(--gray-200)}
    .specs-table__name{color:var(--gray-500);width:45%}
    /* two-column product layout: LEFT media + tabs, RIGHT sticky buy box */
    .pd--2col{max-width:1180px;display:grid;grid-template-columns:minmax(0,1fr) clamp(320px,32vw,400px);gap:34px;align-items:start}
    .pd-buybox{position:sticky;top:96px;display:flex;flex-direction:column;gap:14px;background:#fff;border:1px solid var(--gray-200);border-radius:18px;padding:22px;box-shadow:0 18px 50px -26px rgba(15,23,42,.5)}
    .pd-buybox__rating{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--gray-500)}
    .pd-buybox__cta-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px}
    .pd-buybox .btn{padding:13px 14px;font-weight:800;font-size:14.5px;border-radius:12px;justify-content:center;display:inline-flex;align-items:center;gap:8px}
    .pd-buybox .btn svg{width:17px;height:17px;flex:none}
    .pd-buybox .btn:disabled{opacity:.55;cursor:not-allowed;filter:grayscale(.2)}
    /* batch badge inherits the canonical .bs-badge palette from home-premium.css — DO NOT redefine colours here. */
    .pd-batch-wrap{align-self:flex-start}
    .pd-oos-msg{font-size:13px;color:#DC2626;background:#FEF2F2;padding:10px 14px;border-radius:12px;border:1px solid rgba(220,38,38,.22);margin:6px 0 0;line-height:1.5}
    /* OOS replacement block — replaces Add To Cart / Buy Now per spec. */
    .pd-oos-box{display:flex;flex-direction:column;gap:10px;background:#FEF2F2;border:1px solid rgba(220,38,38,.22);border-radius:14px;padding:14px}
    .pd-oos-badge{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:800;font-size:14px;letter-spacing:.4px;color:#DC2626;text-transform:uppercase}
    .pd-oos-badge__dot{width:9px;height:9px;border-radius:50%;background:#DC2626;animation:pd-pulse 2s ease-in-out infinite}
    @@keyframes pd-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.55;transform:scale(1.35)}}
    /* Franchise account — replaces Add To Cart / Buy Now; franchisees order via the portal. */
    .pd-franchise-box{display:flex;flex-direction:column;gap:10px;background:#EFF6FF;border:1px solid rgba(31,78,121,.22);border-radius:14px;padding:16px}
    .pd-franchise-box__title{font-weight:800;font-size:15px;color:#1F4E79}
    .pd-franchise-box__text{font-size:13px;color:#334155;line-height:1.5;margin:0}
    .pd-franchise-box .btn{justify-content:center}
    .pd-notify-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 14px;background:#fff;color:#DC2626;border:1px solid #DC2626;border-radius:12px;font-weight:800;font-size:14px;cursor:pointer;transition:all .18s}
    .pd-notify-btn:hover{background:#DC2626;color:#fff;transform:translateY(-1px);box-shadow:0 8px 22px -10px rgba(220,38,38,.55)}
    .pd-buybox .btn-primary{background:linear-gradient(180deg,#0AC7E5,#0AA9C4);box-shadow:0 10px 22px -8px rgba(10,199,229,.6)}
    .pd-buybox .btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 26px -10px rgba(10,199,229,.75);filter:brightness(1.04)}
    .pd-buybox .btn-secondary{background:linear-gradient(180deg,#0A5BCF,var(--navy));color:#fff;box-shadow:0 10px 22px -10px rgba(15,23,42,.6)}
    .pd-buybox .btn-secondary:hover{transform:translateY(-2px);box-shadow:0 14px 26px -10px rgba(15,23,42,.8);filter:brightness(1.08)}
    .pd-media-col{display:flex;flex-direction:column;gap:18px;min-width:0}
    /* media gallery */
    .mg{background:#fff;border:1px solid var(--gray-200);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm)}
    .mg__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
    .mg__track::-webkit-scrollbar{display:none}
    .mg__slide{position:relative;flex:0 0 100%;scroll-snap-align:start;aspect-ratio:16/9;background:linear-gradient(135deg,var(--navy),var(--navy-light));display:flex;align-items:center;justify-content:center;overflow:hidden}
    .mg__slide>img{width:100%;height:100%;object-fit:cover}
    .mg__emoji{font-size:72px;color:rgba(255,255,255,.25)}
    .mg__thumb{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .mg__frame{position:absolute;inset:0;width:100%;height:100%;border:0;z-index:2}
    .mg__play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:1;pointer-events:none}
    .mg__play::before{content:"▶";width:58px;height:58px;border-radius:50%;background:rgba(10,199,229,.95);color:#fff;font-size:22px;display:flex;align-items:center;justify-content:center;padding-left:4px;box-shadow:0 4px 16px rgba(0,0,0,.35)}
    .mg__viewport{position:relative}
    .mg__slide--video{cursor:pointer}
    .mg__nav{position:absolute;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;border:0;background:rgba(255,255,255,.92);color:var(--navy);font-size:22px;font-weight:700;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.25);z-index:4}
    .mg__nav:hover{background:#fff}
    .mg__nav--prev{left:8px}.mg__nav--next{right:8px}
    .mg__badge{position:absolute;top:12px;left:12px;background:var(--orange);color:#fff;font-size:11px;font-weight:700;padding:4px 12px;border-radius:20px;text-transform:uppercase;z-index:3}
    .mg__dots{display:flex;gap:6px;justify-content:center;padding:10px 0 2px}
    .mg__dot{width:8px;height:8px;border-radius:50%;background:var(--gray-300);border:0;cursor:pointer;padding:0;transition:all .2s}
    .mg__dot.active{background:var(--orange);width:22px;border-radius:4px}
    .mg__hint{text-align:center;color:var(--orange);font-weight:700;font-size:13.5px;padding:2px 0 12px}
    .pd-includes{background:#fff;border:1px solid var(--gray-200);border-radius:var(--radius-lg);padding:18px 20px;box-shadow:var(--shadow-sm)}
    .pd-includes h4{font-size:16px;font-weight:800;color:var(--navy);margin-bottom:12px}
    /* ── premium polish ── */
    .pd--2col .breadcrumb{font-size:12.5px;color:var(--gray-400);margin-bottom:10px}
    .pd--2col .breadcrumb a{color:var(--gray-500)} .pd--2col .breadcrumb a:hover{color:var(--orange)}
    .pd-title{font-size:clamp(22px,2.6vw,30px);font-weight:800;letter-spacing:-.4px;line-height:1.18;margin-bottom:8px}
    .pd-subtitle{font-size:15px;color:var(--gray-500);line-height:1.6;margin-bottom:18px}
    /* ── Tab strip — always horizontal, scrolls on overflow, scrollbar hidden.
          The .tabs-wrap parent is positioned so the edge-fade gradients can
          anchor to it on mobile. ── */
    .pd-main .tabs-wrap{position:relative}
    .pd-main .tabs{display:flex;flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;white-space:nowrap;gap:0;border-bottom:1px solid var(--gray-200);scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;scroll-behavior:smooth}
    .pd-main .tabs::-webkit-scrollbar{display:none;width:0;height:0}
    .pd-main .tab-btn{flex:0 0 auto;font-size:14.5px;padding:10px 2px;margin-right:20px}
    .pd-main .tab-btn.active::after{height:3px;border-radius:3px}
    .pd-main .attributes label{font-size:13px;font-weight:700;color:var(--gray-600)}
    .pd-main .attributes .form-input{border-radius:12px;padding:13px 14px;font-weight:600;border:1.5px solid var(--gray-200);box-shadow:var(--shadow-sm)}
    .pd-main .attributes .form-input:focus{border-color:var(--orange)}
    .product-detail__pricing{align-items:baseline;flex-wrap:wrap;gap:10px;margin-top:18px}
    .product-detail__price{font-size:clamp(30px,4vw,40px);font-weight:900;letter-spacing:-.5px;color:var(--navy);line-height:1}
    .product-detail__mrp{font-size:18px}
    .pd-save{display:inline-flex;align-items:center;background:#E6F9FD;color:#0B45AB;font-weight:800;font-size:12px;padding:5px 10px;border-radius:999px;letter-spacing:.3px}
    .product-detail__tax{font-size:12.5px;width:100%;color:var(--gray-400);margin-top:2px}
    .pd-main .btn-primary.btn-lg{margin-top:16px;padding:15px;font-size:16px;font-weight:800;border-radius:14px;background:linear-gradient(180deg,#0AC7E5,#0AA9C4);box-shadow:0 8px 22px -8px rgba(10,199,229,.7);transition:transform .15s,box-shadow .15s,filter .15s}
    .pd-main .btn-primary.btn-lg:hover{transform:translateY(-2px);box-shadow:0 12px 26px -8px rgba(10,199,229,.8);filter:brightness(1.03)}
    .detail-tiles{gap:12px}
    .detail-tile{background:#fff;border:1px solid var(--gray-200);border-radius:14px;padding:14px 16px;box-shadow:var(--shadow-sm);transition:border-color .15s,box-shadow .15s}
    .detail-tile:hover{border-color:var(--gray-300);box-shadow:var(--shadow-md)}
    .detail-tile strong{display:block;font-size:11px;letter-spacing:.5px;color:var(--gray-400);font-weight:700;margin-bottom:4px}
    .detail-tile span{font-size:15px;font-weight:700;color:var(--navy)}
    .detail-tile--full{background:linear-gradient(135deg,var(--navy-dark),var(--navy-light));border:0;border-radius:16px;padding:20px 22px;box-shadow:0 12px 30px -14px rgba(15,23,42,.6)}
    .detail-tile--full h4{font-size:15px;margin-bottom:8px} .detail-tile--full p{font-size:13.5px}
    .pd-includes{border-radius:16px;padding:20px 22px;box-shadow:0 10px 30px -18px rgba(15,23,42,.45)}
    .pd-includes h4{font-size:16px}
    .pd-includes__list{display:flex;flex-direction:column}
    .pd-inc{display:flex;align-items:center;gap:13px;padding:9px 0}
    .pd-inc + .pd-inc{border-top:1px solid var(--gray-100)}
    .pd-inc__ico{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;line-height:1}
    .pd-inc__ico svg{width:20px;height:20px}
    .pd-inc__txt{font-size:14.5px;font-weight:600;color:var(--gray-700)}
    .pd-inc__ico--orange{background:#E6F9FD;color:#0AC7E5}
    .pd-inc__ico--blue{background:#E6F9FD;color:#0AC7E5}
    .pd-inc__ico--green{background:#E6F9FD;color:#0AC7E5}
    .pd-inc__ico--purple{background:#E6F9FD;color:#0AC7E5}
    .pd-inc__ico--teal{background:#E6F9FD;color:#0AC7E5}
    .pd-inc__ico--navy{background:#E6F9FD;color:#0AC7E5}
    .mg{border-radius:16px;box-shadow:0 14px 36px -18px rgba(15,23,42,.5)}
    .mg__badge{box-shadow:0 4px 10px rgba(0,0,0,.2);letter-spacing:.5px}
    .faculty-tab{border-radius:16px} .added-msg{border-radius:12px;font-size:14px;padding:12px}

    /* ── Book Preview card (inside the “Book Preview” tab) ── */
    .bp-card{display:grid;grid-template-columns:160px 1fr;gap:22px;align-items:center;padding:22px;background:linear-gradient(135deg,#FFF7ED 0%,#FFF 60%);border:1px solid var(--gray-200);border-radius:18px;box-shadow:0 14px 32px -22px rgba(15,27,51,.22)}
    .bp-card__cover{position:relative;width:160px;height:200px;border-radius:12px;background:linear-gradient(135deg,#0AA9C4,#5AD9EF);display:flex;align-items:center;justify-content:center;color:#fff;font-size:60px;box-shadow:0 18px 32px -18px rgba(10,169,196,.55);overflow:hidden}
    .bp-card__cover img{width:100%;height:100%;object-fit:cover;display:block}
    .bp-card__cover-fallback{font-size:64px;line-height:1}
    .bp-card__eyebrow{font-size:11px;font-weight:800;color:var(--orange);letter-spacing:1.5px;text-transform:uppercase}
    .bp-card__title{font-size:22px;font-weight:800;color:var(--navy);margin:4px 0 8px;line-height:1.2}
    .bp-card__desc{font-size:14px;color:var(--gray-600);line-height:1.55;margin:0 0 14px;max-width:62ch}
    .bp-card__cta{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#0AC7E5,#0AA9C4);color:#fff;border:0;font-size:14.5px;font-weight:800;padding:11px 18px;border-radius:12px;cursor:pointer;box-shadow:0 12px 26px -10px rgba(10,169,196,.55);transition:transform .2s ease,filter .2s ease}
    .bp-card__cta:hover{transform:translateY(-1px);filter:brightness(1.05)}
    .bp-card__cta svg{width:18px;height:18px}
    .bp-card__perks{display:flex;gap:14px;flex-wrap:wrap;margin-top:12px;font-size:12px;color:var(--gray-500)}
    @@media(max-width:640px){
        .bp-card{grid-template-columns:1fr;padding:18px;text-align:center}
        .bp-card__cover{margin:0 auto}
        .bp-card__perks{justify-content:center}
    }

    /* ════════════════════════════════════════════════════════════════════════
       Book Reader modal — image-based viewer (Kindle / Flipbook style).
       Brand: #0F2D5C navy + #0AA9C4 orange. All chrome animates in via cubic-bezier.
       ════════════════════════════════════════════════════════════════════════ */
    .br-modal{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center}
    .br-modal__overlay{position:absolute;inset:0;background:rgba(15,23,42,.85);backdrop-filter:blur(5px)}
    .br-modal__panel{position:relative;width:95vw;height:92vh;background:#0F2D5C;color:#fff;border-radius:24px;box-shadow:0 50px 110px -20px rgba(0,0,0,.75);display:flex;flex-direction:column;overflow:hidden;animation:brModalIn .35s cubic-bezier(.16,1,.3,1);user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
    @@keyframes brModalIn{from{opacity:0;transform:scale(.94) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}

    /* Header — navy bar with orange brand tile + close. */
    .br-head{display:flex;align-items:center;gap:14px;padding:14px 20px;background:linear-gradient(135deg,#0F2D5C,#163E7A);border-bottom:1px solid rgba(10,169,196,.25)}
    .br-head__brand{flex:1;display:flex;align-items:center;gap:12px;min-width:0}
    .br-head__ico{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,#0AA9C4,#5AD9EF);display:inline-flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto;box-shadow:0 10px 20px -8px rgba(10,169,196,.6)}
    .br-head__title{font-size:17px;font-weight:800;letter-spacing:.2px;line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:60ch}
    .br-head__progress{font-size:11.5px;font-weight:600;color:rgba(255,255,255,.6);letter-spacing:.4px;margin-top:2px}
    .br-head__close{flex:0 0 auto;width:38px;height:38px;border-radius:50%;border:0;background:rgba(255,255,255,.1);color:#fff;font-size:22px;font-weight:800;cursor:pointer;line-height:1;transition:background .15s,transform .15s}
    .br-head__close:hover{background:rgba(255,255,255,.22);transform:scale(1.05)}

    /* Progress bar — thin orange line under header that fills as the user advances. */
    .br-progress{height:3px;background:rgba(255,255,255,.06)}
    .br-progress__fill{height:100%;width:0;background:linear-gradient(90deg,#0AA9C4,#5AD9EF);box-shadow:0 0 12px rgba(10,169,196,.55);transition:width .3s cubic-bezier(.16,1,.3,1)}

    /* ── Stage ────────────────────────────────────────────────────────────
       The stage itself never scrolls — its INNER pad is the scrollable region.
       That keeps the edge nav buttons anchored to the stage while a tall
       page can still scroll vertically. ── */
    .br-stage{position:relative;flex:1;background:#0a1936;overflow:hidden;min-height:0}

    /* The pad fills the stage at fit-page; grows past it (and starts scrolling)
       in fit-width or when zoom > 1. */
    .br-page-pad{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:18px;box-sizing:border-box;overflow:hidden;animation:brPageIn .3s cubic-bezier(.16,1,.3,1)}
    .br-stage--scroll .br-page-pad{overflow:auto;align-items:flex-start}
    @@keyframes brPageIn{from{opacity:0;transform:scale(.98)}to{opacity:1;transform:scale(1)}}

    .br-page-img{display:block;background:#fff;border-radius:8px;box-shadow:0 22px 50px -18px rgba(0,0,0,.65);user-select:none;-webkit-user-drag:none;transition:max-width .25s ease,max-height .25s ease,width .25s ease,height .25s ease;cursor:zoom-in;margin:auto}

    /* ── Fit Page (default desktop) — image fits ENTIRELY inside the stage. ── */
    .br-stage--fit-page .br-page-img{
        max-width:calc(100% * var(--br-zoom,1));
        max-height:calc(100% * var(--br-zoom,1));
        width:auto;
        height:auto;
        object-fit:contain;
    }

    /* ── Fit Width — width matches stage; height scrolls when needed. ── */
    .br-stage--fit-width .br-page-img{
        width:calc(100% * var(--br-zoom,1));
        max-width:none;
        height:auto;
        max-height:none;
        object-fit:contain;
    }

    /* Edge tap zones — anchored to the STAGE (not the scrolling pad). */
    .br-edge{position:absolute;top:0;bottom:0;width:60px;background:transparent;border:0;color:rgba(255,255,255,0);font-size:38px;font-weight:800;cursor:pointer;transition:background .2s ease,color .2s ease;z-index:3;display:flex;align-items:center;justify-content:center}
    .br-edge--left{left:0}
    .br-edge--right{right:0}
    .br-edge:hover{background:linear-gradient(90deg,rgba(10,169,196,.18),transparent);color:rgba(255,255,255,.7)}
    .br-edge--right:hover{background:linear-gradient(-90deg,rgba(10,169,196,.18),transparent)}
    .br-edge:disabled{opacity:0;pointer-events:none}

    /* Toolbar. */
    .br-toolbar{display:flex;align-items:center;gap:10px;padding:10px 16px;background:#0a1936;color:#fff;border-top:1px solid rgba(255,255,255,.06)}
    .br-tb-group{display:flex;align-items:center;gap:6px}
    .br-tb-spacer{flex:1}
    .br-tb-btn{width:38px;height:38px;border-radius:11px;border:0;background:rgba(255,255,255,.08);color:#fff;font-size:18px;font-weight:800;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:background .15s ease,transform .15s ease,box-shadow .15s ease}
    .br-tb-btn:hover{background:linear-gradient(135deg,#0AA9C4,#5AD9EF);transform:translateY(-1px);box-shadow:0 10px 22px -10px rgba(10,169,196,.65)}
    .br-tb-btn:disabled{opacity:.32;cursor:not-allowed;background:rgba(255,255,255,.05);transform:none;box-shadow:none}
    .br-tb-btn--fs svg{width:18px;height:18px}
    .br-tb-pages{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:700;color:#fff;background:rgba(255,255,255,.08);padding:8px 14px;border-radius:11px;min-width:68px;justify-content:center}
    .br-tb-pages-sep{opacity:.45}
    .br-tb-zoom{font-size:12.5px;font-weight:700;color:#fff;background:rgba(255,255,255,.08);padding:8px 14px;border-radius:11px;min-width:58px;text-align:center}

    /* Pill buttons (Fit Page / Fit Width). Active state lights up orange. */
    .br-tb-pill{height:38px;padding:0 14px;border-radius:11px;border:0;background:rgba(255,255,255,.08);color:#fff;font-size:12.5px;font-weight:700;letter-spacing:.2px;cursor:pointer;transition:background .15s ease,transform .15s ease,box-shadow .15s ease}
    .br-tb-pill:hover{background:rgba(255,255,255,.16);transform:translateY(-1px)}
    .br-tb-pill.is-active{background:linear-gradient(135deg,#0AA9C4,#5AD9EF);box-shadow:0 10px 22px -10px rgba(10,169,196,.65)}

    @@media(max-width:768px){
        .br-modal__panel{width:100vw;height:100vh;border-radius:0}
        .br-head__title{font-size:15px;max-width:46vw}
        .br-toolbar{padding:8px 10px;gap:6px;flex-wrap:wrap}
        .br-tb-pages,.br-tb-zoom{padding:7px 10px;min-width:auto}
        .br-tb-btn{width:34px;height:34px;border-radius:9px}
        .br-tb-pill{height:34px;padding:0 10px;font-size:11.5px;border-radius:9px}
        .br-edge{width:46px}
    }

    /* Clickable faculty card. Everything inside is wrapped in an anchor so the entire surface
       is the click target — keyboard users land on it natively via Tab. */
    a.faculty-tab--card{display:flex;gap:18px;align-items:flex-start;padding:18px;background:#fff;border:1px solid var(--gray-200);border-radius:16px;color:inherit;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;cursor:pointer}
    a.faculty-tab--card:hover{transform:translateY(-2px);box-shadow:0 18px 40px -22px rgba(11,31,58,.35);border-color:rgba(10,169,196,.5);text-decoration:none;color:inherit}
    a.faculty-tab--card:focus-visible{outline:3px solid rgba(10,169,196,.45);outline-offset:3px}
    a.faculty-tab--card.faculty-tab--no-link{pointer-events:none;cursor:default}

    .faculty-tab__avatar{flex:0 0 auto;width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--orange),#5AD9EF);color:#fff;font-weight:800;font-size:24px;display:inline-flex;align-items:center;justify-content:center;overflow:hidden}
    .faculty-tab__avatar img{width:100%;height:100%;object-fit:cover;display:block}

    a.faculty-tab--card .faculty-tab__more{display:inline-flex;align-items:center;gap:6px;margin-top:10px;color:var(--orange);font-weight:700;font-size:13.5px;letter-spacing:.2px}
    a.faculty-tab--card:hover .faculty-tab__more{text-decoration:underline}
    /* buy box content */
    .pd-buybox__title{font-size:clamp(18px,1.6vw,22px);font-weight:800;line-height:1.25;color:var(--navy);letter-spacing:-.3px;margin:0}
    .pd-buybox__sub{font-size:13.5px;color:var(--gray-500);line-height:1.55;margin:0}
    .pd-buybox__rating{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--gray-500)}
    .pd-buybox__rating a{color:var(--orange);text-decoration:none;font-weight:600}
    .pd-buybox .attributes label.form-label{font-size:12px;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
    .pd-buybox .attributes .form-input{border-radius:11px;padding:11px 12px;font-weight:600;border:1.5px solid var(--gray-200)}
    .pd-buybox .attributes .form-input:focus{border-color:var(--orange);box-shadow:0 0 0 3px rgba(10,199,229,.18)}
    .pd-buybox .product-detail__pricing{align-items:baseline;flex-wrap:wrap;gap:8px;margin-top:4px}
    .pd-buybox .product-detail__price{font-size:clamp(26px,3vw,32px);font-weight:900;letter-spacing:-.5px;color:var(--navy);line-height:1}
    /* tab content: embeds (YouTube + Google Drive PDF preview) */
    .pd-embed{position:relative;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 14px 36px -18px rgba(15,23,42,.5);margin-top:16px}
    .pd-embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
    .pd-embed--pdf{aspect-ratio:auto;height:min(78vh,820px)}
    .pd-embed__caption{font-size:13px;color:var(--gray-500);margin:10px 2px 0}
    /* video testimonials grid */
    .pd-vid-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-top:16px}
    .pd-vid-tile{position:relative;display:block;border-radius:12px;overflow:hidden;aspect-ratio:16/9;background:#000;box-shadow:0 8px 22px -12px rgba(15,23,42,.45);transition:transform .2s var(--p-ease,ease),box-shadow .2s}
    .pd-vid-tile img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
    .pd-vid-tile:hover{transform:translateY(-3px);box-shadow:0 14px 28px -10px rgba(15,23,42,.55)}
    .pd-vid-tile:hover img{transform:scale(1.05)}
    .pd-vid-tile__play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px}
    .pd-vid-tile__play::before{content:"";position:absolute;width:52px;height:52px;border-radius:50%;background:rgba(10,199,229,.9);box-shadow:0 6px 16px rgba(0,0,0,.4)}
    .pd-vid-tile__play{position:absolute;color:#fff;font-size:18px}
    /* FAQ accordion */
    .pd-faqs{margin-top:16px;display:flex;flex-direction:column;gap:8px}
    .pd-faq{background:#fff;border:1px solid var(--gray-200);border-radius:12px;padding:0;overflow:hidden;transition:box-shadow .2s,border-color .2s}
    .pd-faq[open]{box-shadow:0 8px 22px -14px rgba(15,23,42,.4);border-color:var(--orange-light,#fdf0e8)}
    .pd-faq>summary{list-style:none;cursor:pointer;padding:14px 18px;font-weight:700;color:var(--navy);font-size:14.5px;display:flex;justify-content:space-between;align-items:center;gap:12px}
    .pd-faq>summary::-webkit-details-marker{display:none}
    .pd-faq>summary::after{content:"＋";color:var(--orange);font-weight:700;font-size:18px;transition:transform .2s}
    .pd-faq[open]>summary::after{content:"−"}
    .pd-faq__a{padding:0 18px 16px;font-size:14px;line-height:1.65;color:var(--gray-700);white-space:pre-wrap}
    /* Students Also Enrolled For */
    .pd-related{margin-top:34px;padding-top:26px;border-top:1px solid var(--gray-200)}
    .pd-related h3{font-size:20px;font-weight:800;color:var(--navy);letter-spacing:-.3px;margin-bottom:14px}
    .pd-related .course-grid{grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
    /* Offer / Combo Recommendations (admin-curated) */
    .reco-section{margin-top:34px;padding-top:26px;border-top:1px solid var(--gray-200)}
    .reco-section__title{font-size:21px;font-weight:800;color:var(--navy);letter-spacing:-.3px;margin-bottom:16px}
    .reco-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    @@media(max-width:1023px){.reco-grid{grid-template-columns:repeat(2,1fr)}}
    @@media(max-width:560px){.reco-grid{grid-template-columns:1fr}}
    .reco-card{position:relative;display:flex;flex-direction:column;gap:8px;padding:14px;border-radius:22px;background:rgba(255,255,255,.92);backdrop-filter:saturate(180%) blur(10px);border:1px solid var(--gray-200);box-shadow:0 8px 22px -16px rgba(15,23,42,.3);isolation:isolate;overflow:hidden;transition:transform .3s cubic-bezier(.2,.8,.2,1),box-shadow .3s,border-color .3s}
    .reco-card::before{content:"";position:absolute;inset:0;border-radius:22px;padding:1.5px;pointer-events:none;opacity:0;transition:opacity .3s;background:linear-gradient(135deg,#0AC7E5,#5AD9EF 35%,#2563eb 100%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;z-index:3}
    .reco-card:hover{transform:translateY(-3px) scale(1.01);box-shadow:0 22px 40px -22px rgba(15,23,42,.45);border-color:transparent}
    .reco-card:hover::before{opacity:.75}
    .reco-card__badge{position:absolute;top:10px;right:10px;z-index:4;font-size:10.5px;font-weight:800;letter-spacing:.4px;color:#fff;background:linear-gradient(135deg,#0AC7E5,#5AD9EF);padding:4px 10px;border-radius:999px;box-shadow:0 6px 14px -6px rgba(10,199,229,.6);animation:reco-pulse 2.6s ease-in-out infinite}
    @@keyframes reco-pulse{0%,100%{box-shadow:0 6px 14px -6px rgba(10,199,229,.55)}50%{box-shadow:0 8px 20px -6px rgba(10,199,229,.85)}}
    .reco-card__img-wrap{position:relative;aspect-ratio:16/10;border-radius:14px;overflow:hidden;background:linear-gradient(135deg,#082B73,#0A5BCF);display:flex;align-items:center;justify-content:center;text-decoration:none}
    .reco-card__img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
    .reco-card:hover .reco-card__img-wrap img{transform:scale(1.06)}
    .reco-card__img-blank{font-size:34px;color:#fff;opacity:.55}
    .reco-card__cat{font-size:10.5px;font-weight:800;color:var(--orange);text-transform:uppercase;letter-spacing:1.1px;line-height:1}
    .reco-card__title{font-size:14.5px;font-weight:800;color:var(--navy);line-height:1.3;letter-spacing:-.2px;text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:color .2s}
    .reco-card__title:hover{color:#2563eb}
    .reco-card__faculty{font-size:12px;color:var(--gray-500);font-weight:500}
    .reco-card__pricing{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px;margin-top:auto}
    .reco-card__price{font-size:18px;font-weight:900;letter-spacing:-.3px;background:linear-gradient(120deg,var(--navy),#2563eb);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
    .reco-card__mrp{font-size:12.5px;color:var(--gray-400);text-decoration:line-through;font-weight:600}
    .reco-card__disc{font-size:10.5px;font-weight:800;color:#0B45AB;background:#E6F9FD;padding:2px 8px;border-radius:999px;border:1px solid rgba(11,69,171,.28);text-transform:uppercase;letter-spacing:.4px}
    .reco-card__actions{display:flex;gap:6px;margin-top:4px}
    .reco-card__details{flex:1;padding:9px 12px;text-align:center;font-size:12px;font-weight:700;color:var(--navy);background:#fff;border:1px solid var(--gray-200);border-radius:10px;text-decoration:none;transition:background .2s,transform .2s}
    .reco-card__details:hover{background:var(--gray-50);transform:translateY(-1px)}
    .reco-card__add{flex:1;padding:9px 12px;font-size:12px;font-weight:800;letter-spacing:.3px;color:#fff;background:linear-gradient(135deg,#0AC7E5,#5AD9EF);border:0;border-radius:10px;cursor:pointer;box-shadow:0 6px 14px -6px rgba(10,199,229,.55);transition:transform .2s,box-shadow .2s,filter .2s}
    .reco-card__add:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 10px 22px -8px rgba(10,199,229,.7);filter:brightness(1.05)}
    .reco-card__add:disabled{opacity:.7;cursor:wait}

    /* Mobile: single column. Buybox un-sticks but does NOT take order:-1 anymore —
       the natural DOM order is media → buybox, so the media gallery (course banner / demo)
       now appears ABOVE the product name + buy buttons on mobile, matching the spec. */
    @@media(max-width:900px){.pd--2col{grid-template-columns:1fr;gap:18px}.pd-buybox{position:static}.pd-embed--pdf{height:min(70vh,640px)}}

    /* ═══════════════════════════════════════════════════════════════════════════════
       📱 MOBILE-ONLY FIXES (≤768px)
       Strict scope: nothing here affects tablet (769–1024px) or desktop (≥1025px).
       Each block maps 1:1 to the mobile-fix spec.
       ═══════════════════════════════════════════════════════════════════════════════ */
    @@media(max-width:768px){

      /* 0 ─ DOM-ORDER REWIRE ─ Promote .pd-media-col children to siblings of .pd-buybox so we can
            interleave the buybox between the gallery and the tabs without touching the markup.
            display:contents removes the wrapper from the box tree while keeping its children.
            Then a flex column on .pd--2col + per-child `order` produces:
              breadcrumb → 🖼 gallery → 🛒 buybox → 📑 tabs → tiles → recommendations
            Pure-CSS, only active here at ≤768px — tablet/desktop see the original 2-col grid. */
      .pd--2col{display:flex;flex-direction:column;gap:18px;padding:0 14px}
      .pd-media-col{display:contents}
      .pd-media-col>*{order:4}                       /* default: everything sits AFTER the buybox */
      .pd-media-col>.breadcrumb{order:1}             /* breadcrumb first */
      .pd-media-col>.mg{order:2;margin-bottom:0}     /* gallery second */
      .pd-buybox{order:3}                            /* product information third (immediately after image) */
      /* 1 ─ HERO IMAGE ─ 16:9, rounded, proportional play/nav controls */
      .mg{border-radius:18px;overflow:hidden}
      .mg__slide{aspect-ratio:16/9}
      .mg__slide>img,.mg__thumb{width:100%;height:100%;object-fit:cover}
      .mg__nav{width:32px;height:32px;font-size:18px}
      .mg__play::before{width:48px;height:48px;font-size:16px}
      .mg__dots{padding:8px 0 4px}
      .mg__dot{width:6px;height:6px}
      .mg__dot.active{width:18px}
      .mg__badge{font-size:10px;padding:3px 9px;top:10px;left:10px}
      .mg__hint{font-size:12.5px;padding:2px 12px 10px}

      /* 2 ─ PRODUCT DETAILS ─ tighter spacing, responsive typography */
      .pd--2col .breadcrumb{font-size:11.5px;margin-bottom:8px}
      .pd-buybox{padding:16px 16px 14px;gap:11px;border-radius:16px}
      .pd-buybox__title{font-size:19px;line-height:1.28;letter-spacing:-.2px}
      .pd-buybox__sub{font-size:13px;line-height:1.5}
      .pd-batch-wrap .bs-badge{font-size:11px;padding:5px 12px;gap:6px}
      .pd-buybox__rating{font-size:12px}
      .attributes .form-input{font-size:14px;padding:12px}
      .attributes label{font-size:12.5px}

      /* PRICE row — wraps cleanly, MRP + SAVE pill aligned with the price baseline */
      .product-detail__pricing{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 10px;margin-top:4px}
      .product-detail__price{font-size:24px;font-weight:800}
      .product-detail__mrp{font-size:14px}
      .pd-save{font-size:11px;padding:3px 9px;border-radius:999px}
      .product-detail__tax{font-size:11.5px;width:100%}

      /* 3 ─ ADD TO CART / BUY NOW ─ sticky bottom 56px equal-width buttons */
      .pd-buybox__cta-row{position:fixed;left:0;right:0;bottom:0;z-index:50;
        margin:0;padding:10px 12px calc(10px + env(safe-area-inset-bottom));
        background:rgba(255,255,255,.97);backdrop-filter:saturate(180%) blur(10px);
        border-top:1px solid var(--gray-200);
        box-shadow:0 -10px 28px -10px rgba(15,23,42,.18);
        grid-template-columns:1fr 1fr;gap:10px}
      .pd-buybox .pd-buybox__cta-row .btn{height:56px;padding:0;font-size:15px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;gap:6px}
      .pd-buybox__cta-row .btn svg{width:18px;height:18px}
      /* OOS box (replaces CTA when batch is unavailable) — same sticky treatment */
      .pd-oos-box{position:fixed;left:0;right:0;bottom:0;z-index:50;border-radius:0;
        padding:12px 14px calc(12px + env(safe-area-inset-bottom));
        background:rgba(254,242,242,.97);backdrop-filter:saturate(180%) blur(10px);
        border-top:1px solid rgba(220,38,38,.25);border-left:0;border-right:0}
      /* Page needs bottom padding so the last content isn't hidden by the fixed bar */
      .pd-buybox+.pd-oos-msg,.pd-buybox{margin-bottom:0}
      body{padding-bottom:88px}
      .added-msg{font-size:13px;padding:10px 12px;border-radius:12px}

      /* 4 ─ COURSE INCLUDES ─ full-width tappable rows */
      .pd-includes{padding:14px 14px 16px;border-radius:14px}
      .pd-includes h4{font-size:15px;margin-bottom:10px}
      .pd-includes__list{display:flex;flex-direction:column;gap:8px}
      .pd-inc{padding:10px 12px;font-size:13.5px;min-height:44px}
      .pd-inc__ico{width:30px;height:30px;font-size:16px;flex:none}
      .pd-inc__txt{font-size:13.5px;line-height:1.4}

      /* 5 ─ TABS ─ sticky strip, orange underline, edge-fade gradients hint at horizontal scroll
            so users discover hidden tabs (e.g. Testimonials) instead of assuming there are only 3. */
      .pd-main .tabs-wrap{position:sticky;top:0;z-index:6;background:#fff;margin:0 -14px;padding:6px 14px 0;border-bottom:1px solid var(--gray-200)}
      .pd-main .tabs{position:static;background:transparent;margin:0;padding:0;border:0;overflow-x:auto;overflow-y:hidden;white-space:nowrap;display:flex;flex-wrap:nowrap;gap:0;scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-behavior:smooth}
      .pd-main .tabs::-webkit-scrollbar{display:none;width:0;height:0}
      /* Right-edge fade — always visible; signals "more tabs to the right". */
      .pd-main .tabs-wrap::after{content:"";position:absolute;top:6px;right:0;bottom:0;width:36px;pointer-events:none;background:linear-gradient(to right,rgba(255,255,255,0),#fff 70%);z-index:2}
      /* Left-edge fade — symmetrical hint for when the user has scrolled. */
      .pd-main .tabs-wrap::before{content:"";position:absolute;top:6px;left:0;bottom:0;width:24px;pointer-events:none;background:linear-gradient(to left,rgba(255,255,255,0),#fff 80%);z-index:2}
      .pd-main .tab-btn{font-size:14px;padding:11px 2px;margin-right:22px;flex:0 0 auto}
      .pd-main .tab-btn.active{color:var(--orange)}
      .pd-main .tab-btn.active::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:3px;border-radius:3px;background:var(--orange)}
      .pd-main .tab-btn{position:relative}
      /* Make sure the last tab can fully scroll into the centred view despite the right-fade. */
      .pd-main .tab-btn:last-child{margin-right:38px}
      .pd-prose{font-size:14px;line-height:1.65;margin-top:14px}

      /* 6 ─ COURSE INFO CARDS ─ 2×2 grid on mobile.
            Applicable Attempt · Total Lectures
            Total Hours        · Books
            The "Additional Details" tile (.detail-tile--full) spans both columns so it
            stays one wide card. Equal heights via grid auto-rows + height:100% per cell.
            min-width:0 + overflow-wrap:anywhere keep long values from blowing out the cell. */
      .detail-tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px;align-items:stretch}
      .detail-tile{padding:14px 16px;border-radius:14px;min-width:0;height:100%;display:flex;flex-direction:column;gap:4px;overflow-wrap:anywhere}
      .detail-tile strong{font-size:11.5px}
      .detail-tile span{font-size:14px;line-height:1.35}
      .detail-tile--full{grid-column:1 / -1}     /* Additional Details spans both columns */
      .detail-tile--full h4{font-size:15px}
      .detail-tile--full p{font-size:13.5px;line-height:1.55}
      .contact-line{font-size:12.5px;margin-top:8px}
      /* Estimated Delivery card stacks its 2 columns */
      .ed-card{padding:16px;border-radius:14px;margin-top:16px}
      .ed-card__grid{grid-template-columns:1fr;gap:10px}
      .ed-row{padding:12px 14px;border-radius:12px;gap:10px}
      .ed-row__ico{width:34px;height:34px;font-size:16px}
      .ed-row__label{font-size:11px}
      .ed-row__value{font-size:13.5px}

      /* 7 ─ STUDENTS ALSO ADDED ─ horizontal swipe carousel with peek of next card */
      .reco-section{margin-top:18px;padding:0 14px}
      .reco-section__title{font-size:16px;margin-bottom:10px;padding:0}
      .reco-grid{display:grid;grid-template-columns:none;grid-auto-flow:column;
        grid-auto-columns:calc(85% - 6px);
        gap:12px;
        overflow-x:auto;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;
        padding:4px 14% 12px 0;margin:0 -14px;padding-left:14px;
        scrollbar-width:none}
      .reco-grid::-webkit-scrollbar{display:none}
      .reco-card{scroll-snap-align:start;padding:12px;border-radius:18px}
      .reco-card__img-wrap{aspect-ratio:16/9;border-radius:12px;overflow:hidden}
      .reco-card__title{font-size:13.5px;line-height:1.35}
      .reco-card__pricing{flex-wrap:wrap;gap:6px}
      .reco-card__price{font-size:15px}
      .reco-card__mrp{font-size:12px}
      .reco-card__disc{font-size:10.5px;padding:2px 7px}
      .reco-card__actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px}
      .reco-card__details,.reco-card__quick-add{padding:9px 0;font-size:12.5px;border-radius:10px;justify-content:center;text-align:center;font-weight:700}

      /* 8 ─ FLOATING BUTTONS ─ smaller, raised above sticky CTA */
      .floating-btns{bottom:calc(96px + env(safe-area-inset-bottom));right:10px;gap:8px;padding:0}
      .float-btn{width:42px;height:42px;font-size:17px}
      .float-btn svg{width:18px;height:18px}

      /* 9 ─ HEADER (page-level safety; layout-level rules are already responsive) */
      .pd--2col{padding:0 14px}

      /* 10 ─ GLOBAL MOBILE SAFETY */
      .pd-vid-grid{grid-template-columns:1fr 1fr;gap:10px}
      .pd-faqs summary{font-size:14px;padding:12px 14px}
      .pd-faqs p{font-size:13.5px;padding:0 14px 12px}
      /* Embed iframes (lectures preview / book preview) keep their aspect */
      .pd-embed{border-radius:14px}
      .pd-embed--pdf{height:min(60vh,520px)}
    }

    /* ─── Tiny-phone fallback (≤360 px) ─── Two 50%-cards next to each other still
       work down to ~370 px, but on 360-class devices the cards start looking cramped.
       Drop back to one card per row so labels don't wrap into two lines awkwardly.
       The "Additional Details" full-tile is already 100% so no rule needed for it. */
    @@media(max-width:360px){
      .detail-tiles{grid-template-columns:1fr;gap:10px}
    }

    /* ════════════════════════════════════════════════════════════════════════
       Testimonials tab — reel cards + YouTube popup.
       Navy #0F2D5C + orange #0AA9C4. Lazy-loaded thumbnails.
       ════════════════════════════════════════════════════════════════════════ */
    .ts-section{margin:8px 0 20px}
    .ts-section__head{margin:0 0 18px}
    .ts-section__title{font-size:24px;font-weight:800;color:var(--navy,#0F2D5C);letter-spacing:-.2px;margin:0}
    .ts-section__sub{font-size:14px;color:var(--gray-500);margin:6px 0 0;line-height:1.55}

    .ts-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    @@media(max-width:980px){ .ts-grid{grid-template-columns:repeat(2,1fr)} }
    @@media(max-width:640px){ .ts-grid{grid-template-columns:1fr} }

    .ts-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--gray-200);border-radius:20px;overflow:hidden;cursor:pointer;text-align:left;padding:0;box-shadow:0 14px 32px -22px rgba(15,27,51,.22);transition:transform .25s cubic-bezier(.16,1,.3,1),box-shadow .25s ease,border-color .2s ease}
    .ts-card:hover{transform:translateY(-4px);box-shadow:0 26px 50px -22px rgba(15,27,51,.35);border-color:rgba(10,169,196,.4)}
    .ts-card:focus-visible{outline:3px solid rgba(10,169,196,.45);outline-offset:3px}

    .ts-card__thumb{position:relative;aspect-ratio:16/9;overflow:hidden;background:#0F2D5C}
    .ts-card--reel .ts-card__thumb{aspect-ratio:9/16}
    .ts-card__thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease}
    .ts-card:hover .ts-card__thumb img{transform:scale(1.04)}

    .ts-card__play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:62px;height:62px;border-radius:50%;background:linear-gradient(135deg,#0AA9C4,#5AD9EF);color:#fff;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 18px 36px -10px rgba(10,169,196,.7);transition:transform .25s ease}
    .ts-card__play svg{width:30px;height:30px;margin-left:3px}
    .ts-card:hover .ts-card__play{transform:translate(-50%,-50%) scale(1.08)}

