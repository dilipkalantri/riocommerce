</style>

@* Delegated tab-scroll helper. Self-installs once; on every click inside the
   tabs strip it scrolls the just-clicked button into the centre. Also runs once
   on load to center the currently-active tab so a "Testimonials" deep link
   (or any tab beyond the visible viewport) is visible from the start. *@
<script suppress-error="BL9992">
    (function () {
        if (window.__hjcTabsInstalled) return;
        window.__hjcTabsInstalled = true;
        function center(el) { try { el.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }); } catch (_) { } }
        document.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest ? e.target.closest('.tabs .tab-btn') : null;
            if (btn) center(btn);
        }, true);
        function centerActiveOnce() {
            var active = document.querySelector('.tabs .tab-btn.active');
            if (active) center(active);
        }
        // Run shortly after first paint to catch the initial Blazor render.
        setTimeout(centerActiveOnce, 200);
        document.addEventListener('DOMContentLoaded', centerActiveOnce);
    })();
</script>

