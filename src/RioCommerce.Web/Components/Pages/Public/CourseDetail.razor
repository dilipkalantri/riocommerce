    private async Task LoadReviewsAsync()
    {
        if (product == null) return;
        var uid = await CurrentUserIdAsync();
        reviews = await ReviewSvc.GetForProductAsync(product.Id, uid);
        if (reviews.Mine != null)
        {
            newRating = reviews.Mine.Rating;
            newReviewTitle = reviews.Mine.Title ?? "";
            newReviewComment = reviews.Mine.Comment;
        }
    }

    private async Task SubmitReview()
    {
        if (product == null) return;
        var uid = await CurrentUserIdAsync();
        if (uid == null) { Nav.NavigateTo($"/login?returnUrl=/{Slug}", forceLoad: true); return; }

        reviewMsg = null;
        var (ok, error) = await ReviewSvc.SubmitAsync(uid.Value, new SubmitReviewRequest
        {
            ProductId = product.Id,
            Rating = newRating,
            Title = string.IsNullOrWhiteSpace(newReviewTitle) ? null : newReviewTitle.Trim(),
            Comment = newReviewComment
        });
        reviewOk = ok;
        reviewMsg = ok ? "Thanks! Your review was submitted and will appear here once approved." : error;
        if (ok) await LoadReviewsAsync();
    }

    private static string Stars(decimal rating)
    {
        var filled = Math.Clamp((int)Math.Round(rating, MidpointRounding.AwayFromZero), 0, 5);
        return new string('★', filled) + new string('☆', 5 - filled);
    }

    private static string BuildJsonLd(ProductDetailResponse p)
    {
        var title = p.Title.Replace("\"", "'");
        var desc = (p.ShortDesc ?? p.Title).Replace("\"", "'");
        return "{\"@context\":\"https://schema.org\",\"@type\":\"Course\",\"name\":\"" + title +
               "\",\"description\":\"" + desc +
               "\",\"provider\":{\"@type\":\"Organization\",\"name\":\"RioCommerce\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"" +
               p.SellingPrice.ToString("0") + "\",\"priceCurrency\":\"INR\"}}";
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpper() : name[..Math.Min(2, name.Length)].ToUpper();
    }

    private async Task AddToCart()
    {
        if (product == null) return;
        if (isFranchiseUser) { Nav.NavigateTo(CurrentFranchiseOrderUrl); return; }
        if (!ValidateRequired()) return;
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(id, out var userId))
        {
            Nav.NavigateTo($"/login?returnUrl=/{Slug}", forceLoad: true);
            return;
        }
        adding = true;
        var (ok, err) = await Cart.AddAsync(userId, product.Id, selectedModeId, BuildSelections(), SelectedOptionIds());
        adding = false;
        if (ok) { added = true; }
        else { attrError = err; }
    }

    private async Task BuyNow()
    {
        if (product == null) return;
        if (isFranchiseUser) { Nav.NavigateTo(CurrentFranchiseOrderUrl); return; }
        if (!ValidateRequired()) return;
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(id, out var userId))
        {
            Nav.NavigateTo($"/login?returnUrl=/{Slug}", forceLoad: true);
            return;
        }
        adding = true;
        var (ok, err) = await Cart.AddAsync(userId, product.Id, selectedModeId, BuildSelections(), SelectedOptionIds());
        adding = false;
        if (ok) { Nav.NavigateTo("/checkout"); }
        else { attrError = err; }
    }

