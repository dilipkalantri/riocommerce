@code {

    // Same source as every other logo on the site: whatever the admin uploaded on Admin › Settings,
    // falling back to the bundled asset when nothing has been.
    private string? customLogoUrl;
    private const string FallbackLogo = "/_content/RioCommerce.Web/assets/logo.png";
    private string LogoSrc => string.IsNullOrWhiteSpace(customLogoUrl) ? FallbackLogo : customLogoUrl!;

    protected override async Task OnInitializedAsync()
    {
        // Never let a settings hiccup keep the page from rendering.
        try { customLogoUrl = (await Settings.GetAsync()).LogoUrl; } catch { }
    }

    private bool menuOpen;
    private bool showEnquiry, showFomo;
    private int fomoIndex;
    private Timer? enquiryTimer, fomoTimer;
    private bool disposed;

    private readonly (string Name, string Course, string Time)[] fomo =
    {
        ("Ankita from Pune", "CA Inter Costing Regular", "3 minutes ago"),
        ("Rahul from Nagpur", "CA Foundation Economics", "5 minutes ago"),
        ("Priya from Mumbai", "CA Inter Audit Fastrack", "8 minutes ago"),
        ("Vikram from Nashik", "CA Foundation Combo", "12 minutes ago"),
        ("Sneha from Kolhapur", "CA Inter LAW", "15 minutes ago")
    };

    private void OpenMenu() => menuOpen = true;
    private void CloseMenu() => menuOpen = false;
    private void CloseEnquiry() => showEnquiry = false;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        // Enquiry popup after 2s (matches the zip's setTimeout), FOMO toast rotating every 6s.
        enquiryTimer = new Timer(_ => Apply(() => showEnquiry = true), null, 2000, Timeout.Infinite);
        fomoTimer = new Timer(_ => Apply(() => { showFomo = true; fomoIndex = (fomoIndex + 1) % fomo.Length; }), null, 4000, 6000);
    }

    private void Apply(Action change)
    {
        if (disposed) return;
        InvokeAsync(() => { change(); StateHasChanged(); });
    }

    public void Dispose()
    {
        disposed = true;
        enquiryTimer?.Dispose();
        fomoTimer?.Dispose();
    }
}
