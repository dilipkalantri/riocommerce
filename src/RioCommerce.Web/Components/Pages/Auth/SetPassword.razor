@page "/set-password"
@inject IJSRuntime JS
@implements IDisposable
<PageTitle>Set up your password — RioCommerce</PageTitle>

@*
    First-login password setup for a customer whose account came across from the old website.
    Their old password was not migrated, so /account/login recognises the account and redirects
    here with a short-lived token instead of showing "invalid password" on a password they know
    is correct. The token names the account; the server resolves the email from it, so this page
    only ever sees a masked address.
*@

<div class="otp-wrap">
    <div class="otp-card">
        <div class="otp-card__icon">👋</div>
        <h1>Welcome back@(string.IsNullOrWhiteSpace(name) ? "" : $", {name.Split(' ')[0]}")</h1>

        @if (error != null) { <div class="otp-alert otp-alert--err">@error</div> }
        @if (info != null) { <div class="otp-alert otp-alert--ok">@info</div> }

        @if (expired)
        {
            <p class="otp-card__sub">
                This password setup link is no longer valid. Head back to the login page and enter
                your email again to start over.
            </p>
            <a class="otp-btn otp-btn--link" href="/login">Back to login</a>
        }
        else if (step == 1)
        {
            <p class="otp-card__sub">
                Your RioCommerce account has moved to our new website. For your security your old
                password was not carried across — set a new one now and you're in.
            </p>
            <p class="otp-card__sub">
                We'll email a 6-digit code to <strong>@(maskedEmail ?? "your registered email address")</strong>.
            </p>
            <button class="otp-btn" disabled="@busy" @onclick="SendCode">@(busy ? "Sending…" : "Send code")</button>
        }
        else if (step == 2)
        {
            <p class="otp-card__sub">Enter the 6-digit code sent to<br /><strong>@(maskedEmail ?? "your registered email address")</strong>.</p>
            <div class="otp-boxes">
                @for (var i = 0; i < 6; i++)
                {
                    var idx = i;
                    <input id="sp-@idx" class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                           value="@digits[idx]" @oninput="(e) => OnInput(idx, e)" @onkeydown="(e) => OnKeyDown(idx, e)" />
                }
            </div>
            <button class="otp-btn" disabled="@(busy || !Complete)" @onclick="VerifyCode">@(busy ? "Verifying…" : "Continue")</button>
            <div class="otp-resend">
                @if (cooldown > 0) { <span>Resend code in @cooldown s</span> }
                else { <button class="otp-link" disabled="@busy" @onclick="SendCode">Resend code</button> }
            </div>
        }
        else
        {
            <p class="otp-card__sub">Choose the password you'll use from now on.</p>
            @*
                A real browser form post, not a fetch: this endpoint signs the customer in, and the
                auth cookie can only be written on a genuine browser request. Same shape as the
                login form. data-enhance="false" keeps Blazor's enhanced navigation out of it.
            *@
            <form method="post" action="/account/setup-password" data-enhance="false">
                <input type="hidden" name="token" value="@Token" />
                <input type="hidden" name="rurl" value="@(ReturnUrl ?? "/")" />
                <input type="hidden" name="code" value="@Code" />
                <input class="otp-input" type="password" name="password" placeholder="New password (min 6 chars)"
                       autocomplete="new-password" @bind="newPassword" @bind:event="oninput" />
                <input class="otp-input" type="password" name="confirmPassword" placeholder="Confirm new password"
                       autocomplete="new-password" @bind="confirmPassword" @bind:event="oninput" />
                @if (confirmPassword.Length > 0 && newPassword != confirmPassword)
                {
                    <div class="otp-hint">Both passwords must match.</div>
                }
                <button class="otp-btn" type="submit" disabled="@(!PasswordValid)">Set password &amp; continue</button>
            </form>
        }

        <a href="/login" class="otp-back">← Back to login</a>
    </div>
</div>

<style>
    .otp-wrap { min-height:70vh; display:flex; align-items:center; justify-content:center; padding:32px 16px; }
    .otp-card { background:#fff; border:1px solid var(--gray-200); border-radius:18px; padding:36px 32px; max-width:440px; width:100%; text-align:center; box-shadow:0 18px 48px -24px rgba(16,42,67,.35); }
    .otp-card__icon { font-size:40px; }
    .otp-card h1 { font-size:24px; font-weight:800; color:var(--navy); margin:8px 0 6px; }
    .otp-card__sub { color:var(--gray-500); font-size:14px; line-height:1.6; margin-bottom:18px; }
    .otp-input { width:100%; padding:12px 14px; border:2px solid var(--gray-200); border-radius:12px; font-size:15px; margin-bottom:12px; outline:none; }
    .otp-input:focus { border-color:var(--orange); }
    .otp-boxes { display:flex; gap:10px; justify-content:center; margin-bottom:22px; }
    .otp-box { width:48px; height:56px; text-align:center; font-size:24px; font-weight:700; color:var(--navy); border:2px solid var(--gray-200); border-radius:12px; outline:none; }
    .otp-box:focus { border-color:var(--orange); }
    .otp-btn { display:block; width:100%; padding:13px; background:var(--orange); color:#fff; border:0; border-radius:12px; font-size:15px; font-weight:700; cursor:pointer; }
    .otp-btn:disabled { opacity:.5; cursor:not-allowed; }
    .otp-btn--link { text-decoration:none; box-sizing:border-box; }
    .otp-hint { color:#991B1B; font-size:12.5px; text-align:left; margin:-4px 0 10px 2px; }
    .otp-resend { margin-top:16px; font-size:13.5px; color:var(--gray-500); }
    .otp-link { background:none; border:0; color:var(--orange); font-weight:700; cursor:pointer; font-size:13.5px; }
    .otp-back { display:inline-block; margin-top:18px; font-size:13px; color:var(--gray-500); text-decoration:none; }
    .otp-alert { border-radius:10px; padding:10px 12px; font-size:13px; margin-bottom:16px; }
    .otp-alert--err { background:#FEF2F2; color:#991B1B; border:1px solid #FECACA; }
    .otp-alert--ok { background:#ECFDF5; color:#065F46; border:1px solid #A7F3D0; }
    @@media (max-width:420px){ .otp-box{ width:42px; height:50px; font-size:20px } }
</style>

@code {
    [SupplyParameterFromQuery(Name = "t")] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "rurl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? QueryError { get; set; }

    private int step = 1;
    private bool expired;
    private string? maskedEmail, name;
    private readonly string[] digits = new string[6] { "", "", "", "", "", "" };
    private string newPassword = "", confirmPassword = "";
    private string? error, info;
    private bool busy;
    private int cooldown;
    private System.Threading.Timer? timer;

    private bool Complete => digits.All(d => d.Length == 1 && char.IsDigit(d[0]));
    private string Code => string.Concat(digits);
    private bool PasswordValid => newPassword.Length >= 6 && newPassword == confirmPassword;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Token)) { expired = true; return; }

        // Bounced back from /account/setup-password. A code was already sent and — unless it was
        // the code itself that failed — is still live, so resume on the OTP step rather than
        // making them request a fresh one.
        if (!string.IsNullOrWhiteSpace(QueryError))
        {
            error = QueryError;
            step = 2;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || expired) return;

        // Resolve who the token names. Server-side lookup, so the page receives only a masked
        // address — and an invalid token is caught here rather than after they click through.
        try
        {
            var r = await JS.InvokeAsync<InfoResult>("rc.postForm", "/api/account/setup-info",
                new Dictionary<string, string> { ["token"] = Token! });
            if (r.success) { maskedEmail = r.maskedEmail; name = r.name; }
            else { expired = true; error = r.error; }
        }
        catch (Exception ex) { error = ex.Message; }
        StateHasChanged();
    }

    private async Task SendCode()
    {
        error = null; info = null; busy = true;
        try
        {
            var r = await JS.InvokeAsync<InfoResult>("rc.postForm", "/api/account/setup-send-otp",
                new Dictionary<string, string> { ["token"] = Token! });
            if (r.success)
            {
                if (!string.IsNullOrWhiteSpace(r.maskedEmail)) maskedEmail = r.maskedEmail;
                info = "Code sent. It's valid for 10 minutes.";
                step = 2;
                StartCooldown();
            }
            else { error = r.error ?? "Could not send the code. Please try again."; }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task VerifyCode()
    {
        error = null; info = null; busy = true;
        try
        {
            var r = await JS.InvokeAsync<InfoResult>("rc.postForm", "/api/account/setup-verify-otp",
                new Dictionary<string, string> { ["token"] = Token!, ["code"] = Code });
            // Peeked, not consumed — the code is spent for real when the new password is posted.
            if (r.success) step = 3;
            else error = r.error ?? "Incorrect code.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private void OnInput(int idx, ChangeEventArgs e)
    {
        var v = (e.Value?.ToString() ?? "").Trim();
        if (v.Length > 1)
        {
            var clean = new string(v.Where(char.IsDigit).Take(6).ToArray());
            for (var i = 0; i < 6; i++) digits[i] = i < clean.Length ? clean[i].ToString() : "";
            _ = FocusAsync(Math.Min(clean.Length, 5));
            return;
        }
        digits[idx] = new string(v.Where(char.IsDigit).ToArray());
        if (digits[idx].Length == 1 && idx < 5) _ = FocusAsync(idx + 1);
    }

    private async Task OnKeyDown(int idx, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && digits[idx].Length == 0 && idx > 0)
        {
            digits[idx - 1] = "";
            await FocusAsync(idx - 1);
        }
    }

    private async Task FocusAsync(int idx)
    {
        try { await JS.InvokeVoidAsync("rc.focusEl", $"sp-{idx}"); } catch { }
        StateHasChanged();
    }

    private void StartCooldown()
    {
        cooldown = 30;
        timer?.Dispose();
        timer = new System.Threading.Timer(_ =>
        {
            cooldown--;
            if (cooldown <= 0) { timer?.Dispose(); timer = null; }
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    public void Dispose() => timer?.Dispose();

    private class InfoResult
    {
        public bool success { get; set; }
        public string? error { get; set; }
        public string? maskedEmail { get; set; }
        public string? name { get; set; }
    }
}
