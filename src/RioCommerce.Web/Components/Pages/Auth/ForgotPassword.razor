@page "/forgot-password"
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable
<PageTitle>Reset password — RioCommerce</PageTitle>

<div class="otp-wrap">
    <div class="otp-card">
        <div class="otp-card__icon">🔑</div>
        <h1>Reset your password</h1>

        @if (error != null) { <div class="otp-alert otp-alert--err">@error</div> }
        @if (info != null) { <div class="otp-alert otp-alert--ok">@info</div> }

        @if (step == 1)
        {
            <p class="otp-card__sub">Enter your registered email and we'll send you a 6-digit code.</p>
            <input class="otp-input" type="email" placeholder="you@example.com" @bind="email" @bind:event="oninput" />
            <button class="otp-btn" disabled="@(busy || string.IsNullOrWhiteSpace(email))" @onclick="SendCode">
                @(busy ? "Sending…" : "Send code")
            </button>
        }
        else if (step == 2)
        {
            <p class="otp-card__sub">Enter the 6-digit code sent to<br /><strong>@email</strong>.</p>
            <div class="otp-boxes">
                @for (var i = 0; i < 6; i++)
                {
                    var idx = i;
                    <input id="rp-@idx" class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                           value="@digits[idx]" @oninput="(e) => OnInput(idx, e)" @onkeydown="(e) => OnKeyDown(idx, e)" />
                }
            </div>
            <button class="otp-btn" disabled="@(busy || !Complete)" @onclick="VerifyResetCode">@(busy ? "Verifying…" : "Continue")</button>
            <div class="otp-resend">
                @if (cooldown > 0) { <span>Resend code in @cooldown s</span> }
                else { <button class="otp-link" disabled="@busy" @onclick="SendCode">Resend code</button> }
            </div>
        }
        else
        {
            <p class="otp-card__sub">Choose a new password for<br /><strong>@email</strong>.</p>
            <input class="otp-input" type="password" placeholder="New password (min 6 chars)" @bind="newPassword" @bind:event="oninput" />
            <input class="otp-input" type="password" placeholder="Confirm new password" @bind="confirmPassword" @bind:event="oninput" />
            <button class="otp-btn" disabled="@(busy || !PasswordValid)" @onclick="ResetPassword">
                @(busy ? "Saving…" : "Set new password")
            </button>
        }

        <a href="/login" class="otp-back">← Back to login</a>
    </div>
</div>

<style>
    .otp-wrap { min-height:70vh; display:flex; align-items:center; justify-content:center; padding:32px 16px; }
    .otp-card { background:#fff; border:1px solid var(--gray-200); border-radius:18px; padding:36px 32px; max-width:440px; width:100%; text-align:center; box-shadow:0 18px 48px -24px rgba(16,42,67,.35); }
    .otp-card__icon { font-size:40px; }
    .otp-card h1 { font-size:24px; font-weight:800; color:var(--navy); margin:8px 0 6px; }
    .otp-card__sub { color:var(--gray-500); font-size:14px; line-height:1.6; margin-bottom:22px; }
    .otp-input { width:100%; padding:12px 14px; border:2px solid var(--gray-200); border-radius:12px; font-size:15px; margin-bottom:12px; outline:none; }
    .otp-input:focus { border-color:var(--orange); }
    .otp-boxes { display:flex; gap:10px; justify-content:center; margin-bottom:22px; }
    .otp-box { width:48px; height:56px; text-align:center; font-size:24px; font-weight:700; color:var(--navy); border:2px solid var(--gray-200); border-radius:12px; outline:none; }
    .otp-box:focus { border-color:var(--orange); }
    .otp-btn { width:100%; padding:13px; background:var(--orange); color:#fff; border:0; border-radius:12px; font-size:15px; font-weight:700; cursor:pointer; }
    .otp-btn:disabled { opacity:.5; cursor:not-allowed; }
    .otp-resend { margin-top:16px; font-size:13.5px; color:var(--gray-500); }
    .otp-link { background:none; border:0; color:var(--orange); font-weight:700; cursor:pointer; font-size:13.5px; }
    .otp-back { display:inline-block; margin-top:18px; font-size:13px; color:var(--gray-500); text-decoration:none; }
    .otp-alert { border-radius:10px; padding:10px 12px; font-size:13px; margin-bottom:16px; }
    .otp-alert--err { background:#FEF2F2; color:#991B1B; border:1px solid #FECACA; }
    .otp-alert--ok { background:#ECFDF5; color:#065F46; border:1px solid #A7F3D0; }
    @@media (max-width:420px){ .otp-box{ width:42px; height:50px; font-size:20px } }
</style>

@code {
    private int step = 1;
    private string email = "";
    private readonly string[] digits = new string[6] { "", "", "", "", "", "" };
    private string newPassword = "", confirmPassword = "";
    private string? error, info;
    private bool busy;
    private int cooldown;
    private System.Threading.Timer? timer;

    private bool Complete => digits.All(d => d.Length == 1 && char.IsDigit(d[0]));
    private string Code => string.Concat(digits);
    private bool PasswordValid => newPassword.Length >= 6 && newPassword == confirmPassword;

    private async Task SendCode()
    {
        error = null; info = null; busy = true;
        try
        {
            await JS.InvokeAsync<Result>("hjc.postForm", "/api/account/forgot-otp",
                new Dictionary<string, string> { ["email"] = email });
            info = "If that email is registered, a code is on its way.";
            step = 2;
            StartCooldown();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task VerifyResetCode()
    {
        error = null; busy = true;
        try
        {
            var r = await JS.InvokeAsync<Result>("hjc.postForm", "/api/account/verify-reset-otp",
                new Dictionary<string, string> { ["email"] = email, ["code"] = Code });
            if (r.success) step = 3;                       // OTP valid → show new-password screen
            else error = r.error ?? "Incorrect code.";     // show error immediately, stay on this step
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task ResetPassword()
    {
        if (!PasswordValid) { error = "Passwords must match and be at least 6 characters."; return; }
        error = null; busy = true;
        try
        {
            var r = await JS.InvokeAsync<Result>("hjc.postForm", "/api/account/reset-otp",
                new Dictionary<string, string> { ["email"] = email, ["code"] = Code, ["password"] = newPassword });
            if (r.success)
            {
                info = "Password reset. Redirecting to login…";
                await Task.Delay(1200);
                Nav.NavigateTo("/login", forceLoad: true);
            }
            else { error = r.error ?? "Reset failed."; if ((r.error ?? "").Contains("code")) step = 2; }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private void OnInput(int idx, ChangeEventArgs e)
    {
        var v = (e.Value?.ToString() ?? "").Trim();
        if (v.Length > 1)
        {
            var clean = new string(v.Where(char.IsDigit).Take(6).ToArray());
            for (var i = 0; i < 6; i++) digits[i] = i < clean.Length ? clean[i].ToString() : "";
            _ = FocusAsync(Math.Min(clean.Length, 5));
            return;
        }
        digits[idx] = new string(v.Where(char.IsDigit).ToArray());
        if (digits[idx].Length == 1 && idx < 5) _ = FocusAsync(idx + 1);
    }

    private async Task OnKeyDown(int idx, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && digits[idx].Length == 0 && idx > 0)
        {
            digits[idx - 1] = "";
            await FocusAsync(idx - 1);
        }
    }

    private async Task FocusAsync(int idx)
    {
        try { await JS.InvokeVoidAsync("hjc.focusEl", $"rp-{idx}"); } catch { }
        StateHasChanged();
    }

    private void StartCooldown()
    {
        cooldown = 30;
        timer?.Dispose();
        timer = new System.Threading.Timer(_ =>
        {
            cooldown--;
            if (cooldown <= 0) { timer?.Dispose(); timer = null; }
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    public void Dispose() => timer?.Dispose();

    private class Result { public bool success { get; set; } public string? error { get; set; } }
}
