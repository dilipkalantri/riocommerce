@* Premium public blog card — shared by the homepage "Latest Blogs", the /blog listing
   and the related-posts strip. UI only; all data comes from BlogListItem. No inline CSS. *@

<a href="/blog/@Post.Slug" class="pb-card">
    <div class="pb-card__media">
        @if (!string.IsNullOrEmpty(Post.FeaturedImage))
        {
            <img class="pb-card__img" src="@Post.FeaturedImage" alt="@Post.Title" loading="lazy" />
        }
        else
        {
            <span class="pb-card__ph" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" /><path d="M9 7h6M9 11h6M9 15h4" /></svg>
            </span>
        }
        @if (!string.IsNullOrEmpty(Post.Category))
        {
            <span class="pb-card__badge">@Post.Category</span>
        }
    </div>
    <div class="pb-card__body">
        <h3 class="pb-card__title">@Post.Title</h3>
        @if (!string.IsNullOrEmpty(Post.Excerpt))
        {
            <p class="pb-card__excerpt">@Post.Excerpt</p>
        }
        <div class="pb-card__meta">
            @if (Post.PublishedAt is { } published)
            {
                <span class="pb-card__meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                    @published.ToLocalTime().ToString("dd MMM yyyy")
                </span>
            }
            <span class="pb-card__meta-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                @Post.ReadMinutes min read
            </span>
            @if (Post.Views > 0)
            {
                <span class="pb-card__meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                    @Post.Views
                </span>
            }
        </div>
        <span class="pb-card__cta">Read Full Blog <span class="pb-card__cta-arrow" aria-hidden="true">→</span></span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public BlogListItem Post { get; set; } = default!;
}
