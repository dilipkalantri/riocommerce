@*
    Shared motivational nudge used above the primary CTA on the Cart and Checkout pages.
    Single source of truth — change copy / styling here and both pages update together.

    Usage:
        <CheckoutMotivationCard />

    Override title/sub if a different surface needs a tailored message:
        <CheckoutMotivationCard Title="…" Description="…" />
*@

<aside class="cm-card @(Compact ? "cm-card--compact" : "")" aria-label="Next step">
    <div class="cm-card__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z"/>
            <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
            <path d="M9 12H4s.55-3.03 2-4a4.6 4.6 0 0 1 3 0"/>
            <path d="M12 15v5s3.03-.55 4-2c1-.97 1-3 1-3"/>
        </svg>
    </div>
    <div class="cm-card__body">
        <h4 class="cm-card__title">@Title</h4>
        @if (!Compact)
        {
            <p class="cm-card__sub">@Description</p>
        }
    </div>
</aside>

<style>
    /* ════════════════════════════════════════════════════════════════
       Shared motivational card — used on Cart + Checkout. Self-contained
       so it doesn't depend on the host page's CSS scope (.hjc-app /
       .checkout-v2). Inherits the same orange→blue accent design from the
       Cart page's premium summary.
       ════════════════════════════════════════════════════════════════ */
    .cm-card{position:relative;display:flex;align-items:flex-start;gap:14px;margin:16px 0 0;padding:14px 16px;border-radius:16px;isolation:isolate;background:linear-gradient(135deg,rgba(230,249,253,.85),rgba(232,241,255,.85));backdrop-filter:saturate(180%) blur(10px);box-shadow:0 12px 26px -16px rgba(11,31,58,.35);transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s cubic-bezier(.16,1,.3,1);animation:cm-fade .35s ease both}
    .cm-card::before{content:"";position:absolute;inset:0;border-radius:16px;padding:1px;pointer-events:none;background:linear-gradient(135deg,#0AA9C4 0%,#5AD9EF 35%,#0B45AB 100%);opacity:.55;-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;transition:opacity .3s}
    .cm-card:hover{transform:translateY(-2px);box-shadow:0 18px 36px -16px rgba(11,31,58,.5)}
    .cm-card:hover::before{opacity:.95}

    .cm-card__ico{width:38px;height:38px;border-radius:11px;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(135deg,#0AA9C4,#5AD9EF);box-shadow:0 10px 22px -8px rgba(10,199,229,.55);animation:cm-rocketFloat 3.6s ease-in-out infinite,cm-rocketPulse 3s ease-in-out infinite}
    .cm-card__ico svg{width:20px;height:20px;display:block}

    .cm-card__body{flex:1;min-width:0}
    .cm-card__title{margin:0;font-size:16px;font-weight:700;color:#0F2D52;line-height:1.3;letter-spacing:-.2px}
    .cm-card__sub{margin:4px 0 0;font-size:13px;color:#6B7280;line-height:1.6}

    /* Compact variant — title-only, no description. Used on the Checkout summary panel. */
    .cm-card--compact{align-items:center;padding:14px 18px}
    .cm-card--compact .cm-card__title{font-size:15.5px;font-weight:800;line-height:1.35}

    @@keyframes cm-fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
    @@keyframes cm-rocketFloat{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-3px) rotate(2deg)}}
    @@keyframes cm-rocketPulse{0%,55%,100%{box-shadow:0 10px 22px -8px rgba(10,199,229,.55)}65%{box-shadow:0 10px 22px -8px rgba(10,199,229,.55),0 0 0 8px rgba(10,199,229,.18)}}

    @@media(max-width:640px){
        .cm-card{flex-direction:column;align-items:center;text-align:center;gap:10px;padding:14px}
        .cm-card__ico{width:42px;height:42px}
        .cm-card__ico svg{width:22px;height:22px}
    }
    @@media (prefers-reduced-motion: reduce){
        .cm-card,.cm-card__ico{animation:none;transition:none}
    }
</style>

@code {
    /// <summary>Headline shown above the CTA. Default matches the spec.</summary>
    [Parameter] public string Title { get; set; } = "You Are One Step Away From Starting Your Preparation";

    /// <summary>Supporting copy. Hidden when <see cref="Compact"/> is true.</summary>
    [Parameter] public string Description { get; set; }
        = "Complete your enrollment today and get instant access to expert CA guidance, live classes, recorded lectures, hardcopy books and premium study resources.";

    /// <summary>Compact variant — title only, no description. Used on the Checkout summary panel
    /// where every pixel competes with the Pay CTA. Cart page keeps the descriptive default.</summary>
    [Parameter] public bool Compact { get; set; }
}
