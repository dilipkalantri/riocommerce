@*
    Shared support popup for the public registration wizards.

    Extracted from SchoolRegister.razor once /student/register needed the same three
    contact routes for its "no schools found in this district" dead end. The contact
    details are the support desk's, not a page's, so they live in ONE place — a phone
    number change is a single edit, not a hunt through every wizard.

    Styling is the .sr-help-* block in wwwroot/css/wizard.css, shared with the rest of
    the .sr-* wizard design system.

    Closing: the X button, or a click on the backdrop. The panel stops propagation so a
    click INSIDE it never reaches the backdrop handler.
*@

@if (Visible)
{
    <div class="sr-help-overlay" @onclick="Close">
        <div class="sr-help-modal" role="dialog" aria-modal="true" aria-labelledby="sr-help-title"
             @onclick="() => { }" @onclick:stopPropagation="true">
            <button type="button" class="sr-help-close" aria-label="Close" @onclick="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>

            <h2 id="sr-help-title" class="sr-help-title">@Title</h2>
            <p class="sr-help-sub">@Subtitle</p>

            <div class="sr-help-list">
                <div class="sr-help-item">
                    <span class="sr-help-ico sr-help-ico--call">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
                        </svg>
                    </span>
                    <span class="sr-help-text">
                        <span class="sr-help-label">Call Us</span>
                        <span class="sr-help-value">+91 84118 82618</span>
                    </span>
                    <a class="sr-help-cta" href="tel:+918411882618">Call Now</a>
                </div>

                <div class="sr-help-item">
                    <span class="sr-help-ico sr-help-ico--mail">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2.5 6.5 9.5 7 9.5-7" />
                        </svg>
                    </span>
                    <span class="sr-help-text">
                        <span class="sr-help-label">Email Support</span>
                        <span class="sr-help-value">contact@@vijaypath.org</span>
                    </span>
                    <a class="sr-help-cta" href="mailto:contact@@vijaypath.org">Send Email</a>
                </div>

                <div class="sr-help-item">
                    <span class="sr-help-ico sr-help-ico--wa">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24a8.18 8.18 0 0 1 5.82 2.42 8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.21-8.25 8.21Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.02 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z" />
                        </svg>
                    </span>
                    <span class="sr-help-text">
                        <span class="sr-help-label">WhatsApp Support</span>
                        <span class="sr-help-value">+91 84118 82618</span>
                    </span>
                    <a class="sr-help-cta" href="https://wa.me/918411882618" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Defaults match /school/register, the original caller.</summary>
    [Parameter] public string Title { get; set; } = "Need help with school registration?";
    [Parameter] public string Subtitle { get; set; } = "If your UDISE code is not found, please contact our support team.";

    private Task Close() => OnClose.InvokeAsync();
}
