@page "/checkout/payment-failed"
@inject ICheckoutService Checkout
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISiteSettingsService SettingsSvc

<SeoHead Seo="@(new SeoMetadata { Title = "Payment Failed — Vijaypath" })" />

<div class="container cart-page pay-status pay-status--fail">
    <header class="ps-hero ps-hero--fail">
        <div class="ps-hero__ring" aria-hidden="true">
            <svg class="ps-hero__mark" viewBox="0 0 52 52">
                <circle class="ps-hero__circle ps-hero__circle--fail" cx="26" cy="26" r="24" />
                <path class="ps-hero__x" d="M18 18 l16 16 M34 18 l-16 16" />
            </svg>
        </div>
        <h1 class="ps-hero__title">Payment Failed</h1>
        <p class="ps-hero__sub">Unfortunately your payment could not be completed. No course access has been granted and no invoice has been generated.</p>
        @if (!string.IsNullOrEmpty(Reason))
        {
            <div class="ps-hero__reason"><strong>Reason:</strong> @Reason</div>
        }
        @if (!string.IsNullOrEmpty(OrderNumber))
        {
            <div class="ps-hero__order">Order <strong>#@OrderNumber</strong> · Status: <strong>Pending</strong></div>
        }
    </header>

    <div class="ps-grid">
        <div class="ps-main">
            @if (loading)
            {
                <p style="color:var(--gray-400);padding:24px 0">Loading order…</p>
            }
            else if (receipt != null)
            {
                <section class="ps-card">
                    <h2 class="ps-card__title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        Order Summary
                    </h2>
                    <div class="ps-courses">
                        @foreach (var item in receipt.Items)
                        {
                            <div class="ps-course">
                                <div class="ps-course__tile" aria-hidden="true">@(string.IsNullOrWhiteSpace(item.Title) ? "•" : item.Title.Trim()[0].ToString().ToUpperInvariant())</div>
                                <div class="ps-course__body">
                                    <div class="ps-course__title">@item.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(item.ModeName))
                                    {
                                        <div class="ps-course__sub">@item.ModeName @(item.Quantity > 1 ? $"· Qty × {item.Quantity}" : "")</div>
                                    }
                                </div>
                                <div class="ps-course__amt">₹@item.LineTotal.ToString("N0")</div>
                            </div>
                        }
                    </div>
                    <div class="ps-totals">
                        <div><span>Subtotal</span><strong>₹@receipt.Subtotal.ToString("N0")</strong></div>
                        @if (receipt.Discount > 0)
                        {
                            <div class="ps-totals--save"><span>Discount</span><strong>− ₹@receipt.Discount.ToString("N0")</strong></div>
                        }
                        @if (receipt.IgstAmount > 0)
                        {
                            <div><span>IGST (18%, incl.)</span><strong>₹@receipt.IgstAmount.ToString("N0")</strong></div>
                        }
                        else
                        {
                            <div><span>CGST (9%, incl.)</span><strong>₹@receipt.CgstAmount.ToString("N0")</strong></div>
                            <div><span>SGST (9%, incl.)</span><strong>₹@receipt.SgstAmount.ToString("N0")</strong></div>
                        }
                        <div class="ps-totals__grand"><span>Amount Due</span><strong>₹@receipt.Total.ToString("N0")</strong></div>
                    </div>
                </section>
            }
            else if (!string.IsNullOrEmpty(OrderNumber))
            {
                <section class="ps-card">
                    <p style="color:var(--gray-500)">We couldn't load the order details, but you can still retry the payment from below.</p>
                </section>
            }
        </div>

        <aside class="ps-rail">
            <section class="ps-card ps-actions">
                <h3 class="ps-actions__title">What Would You Like To Do?</h3>
                @if (!string.IsNullOrEmpty(OrderNumber))
                {
                    <button type="button" class="ps-cta ps-cta--primary" disabled="@busy" @onclick="RetryAsync">
                        @if (busy)
                        {
                            <span class="ps-spinner" aria-hidden="true"></span>
                            <span>@(_popupOpen ? "Awaiting payment…" : "Re-issuing order…")</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
                            <span>Retry Payment</span>
                        }
                    </button>
                }
                <a href="/courses" class="ps-cta ps-cta--outline">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
                    Browse Courses
                </a>
                @if (!string.IsNullOrWhiteSpace(siteCfg?.ContactPhone1))
                {
                    <a href="tel:@siteCfg.ContactPhone1" class="ps-cta ps-cta--ghost">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        Contact Support
                    </a>
                }
                <a href="/courses" class="ps-cta ps-cta--ghost">
                    Continue Shopping
                </a>

                @if (!string.IsNullOrEmpty(retryError))
                {
                    <div class="ps-retry-err" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                        <span>@retryError</span>
                    </div>
                }
            </section>

            <section class="ps-card ps-help">
                <h3 class="ps-card__title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    Need Help?
                </h3>
                @if (!string.IsNullOrWhiteSpace(siteCfg?.ContactPhone1))
                {
                    <a href="tel:@siteCfg.ContactPhone1" class="ps-help__line">📞 @siteCfg.ContactPhone1</a>
                }
                @if (!string.IsNullOrWhiteSpace(siteCfg?.WhatsappNumber))
                {
                    var waNum = siteCfg.WhatsappNumber.TrimStart('+');
                    if (!waNum.StartsWith("91")) waNum = "91" + waNum;
                    <a href="https://wa.me/@waNum" target="_blank" rel="noopener" class="ps-help__line">💬 WhatsApp Support</a>
                }
                @{ var email = siteCfg?.SupportEmail ?? siteCfg?.ContactEmail; }
                @if (!string.IsNullOrWhiteSpace(email))
                {
                    <a href="mailto:@email" class="ps-help__line">📧 @email</a>
                }
            </section>
        </aside>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "o")] public string? OrderNumber { get; set; }
    [SupplyParameterFromQuery(Name = "r")] public string? Reason { get; set; }

    private OrderReceipt? receipt;
    private bool loading = true;
    private bool placing;
    private bool _popupOpen;
    private string? retryError;
    private Guid _userId;
    private SiteSettings? siteCfg;

    private bool busy => placing || _popupOpen;

    protected override async Task OnInitializedAsync()
    {
        try { siteCfg = await SettingsSvc.GetAsync(); } catch { }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(id, out _userId) && !string.IsNullOrEmpty(OrderNumber))
        {
            receipt = await Checkout.GetReceiptAsync(_userId, OrderNumber);
            if (receipt != null && receipt.PaymentStatus == PaymentStatus.Success)
            {
                Nav.NavigateTo($"/checkout/payment-success?order={Uri.EscapeDataString(receipt.OrderNumber)}", replace: true);
                return;
            }
        }
        loading = false;
    }

    private async Task RetryAsync()
    {
        if (busy || string.IsNullOrEmpty(OrderNumber)) return;
        retryError = null;
        _popupOpen = true;
        StateHasChanged();

        try
        {
            // JS owns the retry flow: POST /retry-order → popup OR redirect → server settle →
            // window.location.replace. We never come back to this Blazor circuit. Pick the
            // gateway the order was placed with so a Razorpay order retries on Razorpay and
            // an Easebuzz order retries on Easebuzz.
            if (receipt?.PaymentMode == PaymentMode.Easebuzz)
            {
                await JS.InvokeVoidAsync("rc.retryEasebuzz", OrderNumber);
            }
            else
            {
                var prefill = new { name = receipt?.StudentName, email = receipt?.StudentEmail, contact = receipt?.StudentPhone };
                await JS.InvokeVoidAsync("rc.retryRazorpay", OrderNumber, prefill);
            }
        }
        catch (Exception ex)
        {
            _popupOpen = false;
            placing = false;
            retryError = ex.Message;
            StateHasChanged();
        }
    }
}

<style>
    .pay-status{--ps-fail:#DC2626;--ps-fail-2:#F87171;--ps-warn:#D97706;--ps-warn-2:#FBBF24;--ps-primary:#163A70;--ps-ink:#0F1B33;--ps-mute:#64748B;--ps-line:#E5ECF4;--ps-bg:#F8FAFC;background:linear-gradient(180deg,#F8FAFC 0%,#FDFEFF 360px);padding-bottom:30px}
    .pay-status .ps-hero{position:relative;text-align:center;color:#fff;border-radius:28px;padding:42px 24px 32px;margin:18px 0 22px;overflow:hidden;box-shadow:0 24px 60px -30px rgba(220,38,38,.5)}
    .pay-status .ps-hero--fail{background:linear-gradient(135deg,#9F1239 0%,#DC2626 60%,#F87171 100%)}
    .pay-status .ps-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(900px 320px at 100% -10%,rgba(255,255,255,.15),transparent 60%),radial-gradient(700px 240px at -10% 110%,rgba(0,0,0,.18),transparent 60%);pointer-events:none}
    .pay-status .ps-hero__ring{position:relative;width:96px;height:96px;margin:0 auto 12px;border-radius:50%;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.22);display:inline-flex;align-items:center;justify-content:center;animation:psPulseFail 2.2s ease-out infinite}
    .pay-status .ps-hero__mark{width:72px;height:72px}
    .pay-status .ps-hero__circle--fail{fill:#fff;stroke:#FECACA;stroke-width:2;animation:psDraw .55s ease-out both}
    .pay-status .ps-hero__x{fill:none;stroke:#DC2626;stroke-width:6;stroke-linecap:round;animation:psStrokeIn .4s .25s ease-out both}
    .pay-status .ps-hero__title{position:relative;font-size:36px;font-weight:800;letter-spacing:-.5px;margin:6px 0 6px}
    .pay-status .ps-hero__sub{position:relative;margin:0 auto 12px;font-size:14px;color:rgba(255,255,255,.92);max-width:580px;line-height:1.55;font-weight:500}
    .pay-status .ps-hero__reason{position:relative;display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.28);color:#fff;font-size:12.5px;font-weight:600;padding:7px 14px;border-radius:999px;margin-top:6px;max-width:90%}
    .pay-status .ps-hero__order{position:relative;margin-top:10px;font-size:12.5px;color:rgba(255,255,255,.85);font-weight:500}
    .pay-status .ps-hero__order strong{color:#fff;font-weight:800;letter-spacing:.4px}

    .pay-status .ps-grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:20px;align-items:start}
    .pay-status .ps-main{display:flex;flex-direction:column;gap:16px}
    .pay-status .ps-rail{display:flex;flex-direction:column;gap:16px;position:sticky;top:18px}
    .pay-status .ps-card{background:#fff;border:1px solid var(--ps-line);border-radius:22px;padding:22px;box-shadow:0 10px 28px -22px rgba(15,27,51,.22)}
    .pay-status .ps-card__title{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:700;color:var(--ps-ink);margin:0 0 14px}
    .pay-status .ps-card__title svg{width:18px;height:18px;color:var(--ps-primary)}

    .pay-status .ps-courses{display:flex;flex-direction:column;gap:10px;margin-bottom:10px}
    .pay-status .ps-course{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px;border-radius:14px;background:#F8FAFC;border:1px solid var(--ps-line)}
    .pay-status .ps-course__tile{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#163A70,#1f4d92);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800}
    .pay-status .ps-course__title{font-size:14px;font-weight:700;color:var(--ps-ink);line-height:1.35}
    .pay-status .ps-course__sub{font-size:12px;color:var(--ps-mute);font-weight:500;margin-top:2px}
    .pay-status .ps-course__amt{font-size:15px;font-weight:800;color:var(--ps-ink)}

    .pay-status .ps-totals{display:flex;flex-direction:column;gap:6px;padding-top:10px;border-top:1px dashed var(--ps-line)}
    .pay-status .ps-totals > div{display:flex;justify-content:space-between;font-size:13px;color:var(--ps-mute);font-weight:500}
    .pay-status .ps-totals strong{color:var(--ps-ink);font-weight:700}
    .pay-status .ps-totals--save,.pay-status .ps-totals--save strong{color:#0B45AB}
    .pay-status .ps-totals__grand{margin-top:6px;padding-top:8px;border-top:1px dashed var(--ps-line);font-size:14px}
    .pay-status .ps-totals__grand strong{color:var(--ps-fail);font-size:17px;font-weight:800}

    .pay-status .ps-actions__title{font-size:13px;font-weight:700;color:var(--ps-mute);text-transform:uppercase;letter-spacing:.6px;margin:0 0 12px}
    .pay-status .ps-cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;height:48px;padding:0 18px;border-radius:14px;font-size:14px;font-weight:700;text-decoration:none;cursor:pointer;border:1.5px solid transparent;margin-bottom:10px;transition:transform .15s,box-shadow .2s,filter .2s,background .2s,border-color .2s,color .2s}
    .pay-status .ps-cta svg{width:16px;height:16px}
    .pay-status .ps-cta:hover{transform:translateY(-1px)}
    .pay-status .ps-cta--primary{background:linear-gradient(135deg,#0AA9C4,#0B45AB);color:#fff;box-shadow:0 12px 24px -12px rgba(10,169,196,.55)}
    .pay-status .ps-cta--primary[disabled]{opacity:.7;cursor:wait;transform:none}
    .pay-status .ps-cta--outline{background:#fff;color:var(--ps-primary);border-color:#DBE5F2}
    .pay-status .ps-cta--outline:hover{background:#EFF4FB;border-color:var(--ps-primary)}
    .pay-status .ps-cta--ghost{background:transparent;color:var(--ps-mute);border-color:var(--ps-line)}
    .pay-status .ps-cta--ghost:hover{color:var(--ps-ink);background:#F8FAFC}
    .pay-status .ps-spinner{width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;animation:psSpin .8s linear infinite}

    .pay-status .ps-retry-err{margin-top:6px;padding:10px 12px;border-radius:12px;background:#FEF2F2;border:1px solid #FECACA;color:#B91C1C;font-size:12.5px;font-weight:600;display:flex;align-items:flex-start;gap:8px}
    .pay-status .ps-retry-err svg{width:16px;height:16px;flex:0 0 auto;margin-top:1px}

    .pay-status .ps-help__line{display:block;padding:8px 0;font-size:13.5px;font-weight:600;color:var(--ps-ink);text-decoration:none;border-bottom:1px solid var(--ps-line)}
    .pay-status .ps-help__line:last-child{border-bottom:0}
    .pay-status .ps-help__line:hover{color:var(--ps-primary)}

    @@keyframes psPulseFail{0%{box-shadow:0 0 0 0 rgba(255,255,255,.45)}70%{box-shadow:0 0 0 18px rgba(255,255,255,0)}100%{box-shadow:0 0 0 0 rgba(255,255,255,0)}}
    @@keyframes psDraw{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}
    @@keyframes psStrokeIn{from{opacity:0;transform:scale(.7)}to{opacity:1;transform:scale(1)}}
    @@keyframes psSpin{to{transform:rotate(360deg)}}

    @@media(max-width:860px){
        .pay-status .ps-grid{grid-template-columns:1fr}
        .pay-status .ps-rail{position:static}
    }
    @@media(max-width:640px){
        .pay-status .ps-hero{padding:30px 16px 24px;border-radius:22px}
        .pay-status .ps-hero__title{font-size:26px}
        .pay-status .ps-hero__sub{font-size:13px}
        .pay-status .ps-card{padding:18px;border-radius:18px}
    }
</style>
