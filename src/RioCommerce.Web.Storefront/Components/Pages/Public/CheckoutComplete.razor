@page "/checkout/complete/{OrderNumber}"
@page "/checkout/success/{OrderNumber}"
@page "/checkout/payment-success"
@inject ICheckoutService Checkout
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject ISiteSettingsService SettingsSvc

<SeoHead Seo="@(new SeoMetadata { Title = $"Order {OrderNumber} — RioCommerce" })" />

<div class="container cart-page complete-v2">
    @if (loading)
    {
        <p style="color:var(--gray-400);padding:40px 0">Loading your order…</p>
    }
    else if (receipt == null)
    {
        <div class="cart-empty">
            <div style="font-size:42px">🔍</div>
            <p>We couldn't find that order.</p>
            <a href="/account/orders" class="btn btn-primary" style="margin-top:12px">My Orders</a>
        </div>
    }
    else
    {
        var paid = receipt.PaymentStatus == PaymentStatus.Success;
        var transId = receipt.OrderNumber; @* gateway txn id isn't on OrderReceipt — fall back to order # as the canonical reference *@

        @* ─── Premium gradient hero with animated success tick + chips ─── *@
        <header class="ok-hero @(paid ? "" : "ok-hero--pending")">
            @if (paid && showConfetti)
            {
                <div class="ok-confetti" aria-hidden="true">
                    @for (var i = 0; i < 32; i++)
                    {
                        <span style="--i:@i"></span>
                    }
                </div>
            }
            <div class="ok-hero__ring" aria-hidden="true">
                <svg class="ok-hero__tick" viewBox="0 0 52 52">
                    <circle class="ok-hero__tick-circle" cx="26" cy="26" r="24" />
                    <path class="ok-hero__tick-check" d="M14 27 l8 8 l16 -18" />
                </svg>
            </div>
            <h1 class="ok-hero__title">
                @if (paid) { <span>🎉</span> }
                @(paid ? "Payment Successful!" : "Order Reserved")
            </h1>
            <p class="ok-hero__sub">
                @if (paid)
                {
                    @:Your enrollment is confirmed. Welcome to RioCommerce.
                }
                else
                {
                    @:Complete the payment at the center to activate your courses.
                }
            </p>
            <div class="ok-hero__order">Order <strong>#@receipt.OrderNumber</strong></div>
            <div class="ok-hero__chips">
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Course @(paid ? "Activated" : "Reserved")</span>
                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Secure Payment</span>
                @if (!string.IsNullOrEmpty(receipt.InvoiceNumber))
                {
                    <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v18l3-2 3 2 3-2 3 2V8z"/><path d="M14 2v6h6"/></svg> Invoice Ready</span>
                }
            </div>
        </header>

        <div class="ok-grid">
            <div class="ok-main">
                @* ─── Order Details ─── *@
                <section class="ok-card">
                    <h2 class="ok-card__title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h4"/></svg>
                        Order Details
                    </h2>
                    <div class="ok-meta">
                        <div class="ok-meta__row">
                            <span class="ok-meta__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
                            <div><span class="ok-meta__lbl">Order Number</span><span class="ok-meta__val">@receipt.OrderNumber</span></div>
                        </div>
                        @if (!string.IsNullOrEmpty(receipt.InvoiceNumber))
                        {
                            <div class="ok-meta__row">
                                <span class="ok-meta__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v18l3-2 3 2 3-2 3 2V8z"/><path d="M14 2v6h6"/></svg></span>
                                <div><span class="ok-meta__lbl">Invoice Number</span><span class="ok-meta__val">@receipt.InvoiceNumber</span></div>
                            </div>
                        }
                        @if (receipt.PaymentMode.HasValue)
                        {
                            <div class="ok-meta__row">
                                <span class="ok-meta__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
                                <div><span class="ok-meta__lbl">Payment Method</span><span class="ok-meta__val">@receipt.PaymentMode</span></div>
                            </div>
                        }
                        @* The instrument used at the gateway (UPI / Credit Card / …), when reported. *@
                        @if (!string.IsNullOrWhiteSpace(receipt.GatewayPaymentMode))
                        {
                            <div class="ok-meta__row">
                                <span class="ok-meta__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
                                <div><span class="ok-meta__lbl">Payment Mode</span><span class="ok-meta__val">@receipt.GatewayPaymentMode</span></div>
                            </div>
                        }
                        <div class="ok-meta__row">
                            <span class="ok-meta__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg></span>
                            <div><span class="ok-meta__lbl">Payment Status</span><span class="ok-meta__val ok-meta__val--@(paid ? "ok" : "warn")">@receipt.PaymentStatus</span></div>
                        </div>
                        <div class="ok-meta__row">
                            <span class="ok-meta__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></span>
                            <div><span class="ok-meta__lbl">Order Status</span><span class="ok-meta__val">@receipt.Status</span></div>
                        </div>
                        <div class="ok-meta__row">
                            <span class="ok-meta__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
                            <div><span class="ok-meta__lbl">Date &amp; Time</span><span class="ok-meta__val">@receipt.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</span></div>
                        </div>
                        <div class="ok-meta__row">
                            <span class="ok-meta__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 7-10 5L2 7"/><path d="M2 7v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7"/></svg></span>
                            <div><span class="ok-meta__lbl">Transaction Ref</span><span class="ok-meta__val">@transId</span></div>
                        </div>
                    </div>
                </section>

                @* ─── Enrolled Course Cards ─── *@
                <section class="ok-card">
                    <h2 class="ok-card__title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        Enrolled Course@(receipt.Items.Count == 1 ? "" : "s")
                        <span class="ok-card__count">@receipt.Items.Count</span>
                    </h2>
                    <div class="ok-course-list">
                        @foreach (var item in receipt.Items)
                        {
                            <article class="ok-course">
                                <div class="ok-course__media" aria-hidden="true">
                                    <span>@(string.IsNullOrWhiteSpace(item.Title) ? "•" : item.Title.Trim()[0].ToString().ToUpperInvariant())</span>
                                </div>
                                <div class="ok-course__body">
                                    <h3 class="ok-course__title">@item.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(item.ModeName))
                                    {
                                        <div class="ok-course__chips">
                                            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M2 9h20"/></svg> @item.ModeName</span>
                                            @if (item.Quantity > 1) { <span>Qty &times; @item.Quantity</span> }
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Attributes))
                                    {
                                        <div class="ok-course__attrs">@item.Attributes</div>
                                    }
                                </div>
                                <div class="ok-course__price">
                                    <div class="ok-course__amt">₹@item.LineTotal.ToString("N0")</div>
                                    <span class="ok-course__badge">@(paid ? "Paid" : "Reserved")</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>

                @* ─── Next Steps timeline ─── *@
                <section class="ok-card">
                    <h2 class="ok-card__title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                        What happens next?
                    </h2>
                    <ol class="ok-steps">
                        <li class="ok-step @(paid ? "is-done" : "")">
                            <span class="ok-step__dot"></span>
                            <div class="ok-step__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
                            <div class="ok-step__txt">
                                <strong>Course Activated</strong>
                                <small>within a few minutes</small>
                            </div>
                        </li>
                        <li class="ok-step">
                            <span class="ok-step__dot"></span>
                            <div class="ok-step__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div>
                            <div class="ok-step__txt">
                                <strong>Notes Dispatch</strong>
                                <small>within configured timeline</small>
                            </div>
                        </li>
                        <li class="ok-step">
                            <span class="ok-step__dot"></span>
                            <div class="ok-step__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
                            <div class="ok-step__txt">
                                <strong>WhatsApp Group</strong>
                                <small>invitation sent shortly</small>
                            </div>
                        </li>
                        <li class="ok-step">
                            <span class="ok-step__dot"></span>
                            <div class="ok-step__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg></div>
                            <div class="ok-step__txt">
                                <strong>Start Learning</strong>
                                <small>Go to My Courses</small>
                            </div>
                        </li>
                    </ol>
                </section>

                @* ─── Share + Support row ─── *@
                <div class="ok-row2">
                    <section class="ok-card ok-share">
                        <h2 class="ok-card__title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/></svg>
                            Share your CA journey
                        </h2>
                        <p class="ok-share__sub">Tell your study buddies you just enrolled.</p>
                        <div class="ok-share__btns">
                            <a href="@($"https://wa.me/?text={Uri.EscapeDataString($"I just enrolled in {siteCfg?.CompanyName ?? "our platform"} 🎉 (Order #{receipt.OrderNumber})")}")" target="_blank" rel="noopener" class="ok-share__btn ok-share__btn--wa">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                WhatsApp
                            </a>
                            <a href="@($"https://t.me/share/url?text={Uri.EscapeDataString($"I just enrolled in {siteCfg?.CompanyName ?? "our platform"} 🎉")}")" target="_blank" rel="noopener" class="ok-share__btn ok-share__btn--tg">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-11 11"/><path d="m22 2-7 20-4-9-9-4z"/></svg>
                                Telegram
                            </a>
                            <a href="@($"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(siteCfg?.WebsiteUrl ?? "/")}")" target="_blank" rel="noopener" class="ok-share__btn ok-share__btn--fb">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                                Facebook
                            </a>
                            <button type="button" class="ok-share__btn ok-share__btn--link" @onclick="CopyLinkAsync">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                                @(copied ? "Copied!" : "Copy Link")
                            </button>
                        </div>
                    </section>

                    <section class="ok-card ok-help">
                        <h2 class="ok-card__title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                            Need Help?
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(siteCfg?.ContactPhone1))
                        {
                            <a href="tel:@siteCfg.ContactPhone1" class="ok-help__line">
                                <span class="ok-help__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                                <span><strong>Call Support</strong><small>@siteCfg.ContactPhone1</small></span>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(siteCfg?.WhatsappNumber))
                        {
                            var waNum = siteCfg.WhatsappNumber.TrimStart('+');
                            if (!waNum.StartsWith("91")) waNum = "91" + waNum;
                            <a href="https://wa.me/@waNum" target="_blank" rel="noopener" class="ok-help__line">
                                <span class="ok-help__ico ok-help__ico--wa"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                                <span><strong>WhatsApp Support</strong><small>instant reply</small></span>
                            </a>
                        }
                        @{ var supportEmail = siteCfg?.SupportEmail ?? siteCfg?.ContactEmail; }
                        @if (!string.IsNullOrWhiteSpace(supportEmail))
                        {
                            <a href="mailto:@supportEmail" class="ok-help__line">
                                <span class="ok-help__ico ok-help__ico--mail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg></span>
                                <span><strong>Email</strong><small>@supportEmail</small></span>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(siteCfg?.BusinessHours))
                        {
                            <div class="ok-help__hours">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                @siteCfg.BusinessHours
                            </div>
                        }
                    </section>
                </div>
            </div>

            @* ─── Sticky Payment Summary rail ─── *@
            <aside class="ok-rail">
                <section class="ok-card ok-sum">
                    <div class="ok-sum__head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.27 6.96 8.73 5.04 8.73-5.04"/></svg>
                        Payment Summary
                    </div>
                    <div class="ok-sum__body">
                        <div class="ok-sum__row"><span>Subtotal</span><strong>₹@receipt.Subtotal.ToString("N0")</strong></div>
                        @if (receipt.Discount > 0)
                        {
                            <div class="ok-sum__row ok-sum__row--save"><span>Discount @(receipt.CouponCode != null ? $"({receipt.CouponCode})" : "")</span><strong>− ₹@receipt.Discount.ToString("N0")</strong></div>
                        }
                        @if (receipt.IgstAmount > 0)
                        {
                            <div class="ok-sum__row"><span>IGST (18%, incl.)</span><strong>₹@receipt.IgstAmount.ToString("N0")</strong></div>
                        }
                        else
                        {
                            <div class="ok-sum__row"><span>CGST (9%, incl.)</span><strong>₹@receipt.CgstAmount.ToString("N0")</strong></div>
                            <div class="ok-sum__row"><span>SGST (9%, incl.)</span><strong>₹@receipt.SgstAmount.ToString("N0")</strong></div>
                        }
                        <div class="ok-sum__total">
                            <span>Total Paid</span><strong>₹@receipt.Total.ToString("N0")</strong>
                        </div>

                        <div class="ok-sum__meta">
                            @if (receipt.PaymentMode.HasValue)
                            {
                                <div class="ok-sum__metarow"><span>Method</span><strong>@receipt.PaymentMode</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(receipt.GatewayPaymentMode))
                            {
                                <div class="ok-sum__metarow"><span>Mode</span><strong>@receipt.GatewayPaymentMode</strong></div>
                            }
                            <div class="ok-sum__metarow"><span>Status</span>
                                <span class="ok-pill @(paid ? "ok-pill--ok" : "ok-pill--warn")">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                                    @receipt.PaymentStatus
                                </span>
                            </div>
                        </div>

                        @* ─── Action buttons ─── *@
                        <a href="/account/courses" class="ok-cta ok-cta--primary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                            Go To My Courses
                        </a>
                        @if (!string.IsNullOrEmpty(receipt.InvoiceNumber))
                        {
                            <a href="@($"/api/me/orders/{receipt.OrderNumber}/invoice.pdf")" target="_blank" rel="noopener" class="ok-cta ok-cta--green">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>
                                Download Invoice
                            </a>
                            <button type="button" class="ok-cta ok-cta--blue" @onclick="() => showInvoice = true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
                                View Invoice
                            </button>
                        }
                        <a href="/account/orders" class="ok-cta ok-cta--outline">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                            My Orders
                        </a>
                        <a href="/courses/ca-foundation" class="ok-cta ok-cta--ghost">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                            Continue Shopping
                        </a>

                        <ul class="ok-sum__trust">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> SSL Secure</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Safe Payment</li>
                        </ul>
                    </div>
                </section>
            </aside>
        </div>

        @* ─── Invoice modal ─── *@
        @if (showInvoice && !string.IsNullOrEmpty(receipt.InvoiceNumber))
        {
            <div class="ok-modal" role="dialog" aria-modal="true" aria-labelledby="ok-invoice-title" @onclick="() => showInvoice = false">
                <div class="ok-modal__card" @onclick:stopPropagation="true">
                    <header class="ok-modal__head">
                        <div>
                            <div class="ok-modal__eyebrow">INVOICE</div>
                            <div class="ok-modal__no" id="ok-invoice-title">#@receipt.InvoiceNumber</div>
                        </div>
                        <button class="ok-modal__close" @onclick="() => showInvoice = false" aria-label="Close">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                        </button>
                    </header>

                    <div class="ok-modal__body ok-print">
                        <div class="ok-inv__top">
                            <div class="ok-inv__brand">
                                <div class="ok-inv__brand-name">@(siteCfg?.CompanyName ?? "My Store")</div>
                                <div class="ok-inv__brand-meta">GST Invoice</div>
                            </div>
                            <div class="ok-inv__order">
                                <div><span>Order #</span><strong>@receipt.OrderNumber</strong></div>
                                <div><span>Date</span><strong>@receipt.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                                <div><span>Status</span><strong>@receipt.PaymentStatus</strong></div>
                            </div>
                        </div>

                        <div class="ok-inv__cols">
                            <div>
                                <h4>Billed To</h4>
                                <p>
                                    <strong>@(receipt.BillingName ?? receipt.StudentName)</strong><br />
                                    @receipt.StudentPhone @(string.IsNullOrWhiteSpace(receipt.StudentEmail) ? "" : " · " + receipt.StudentEmail)<br />
                                    @(string.Join(", ", new[] { receipt.BillingAddress, receipt.BillingCity, receipt.BillingState, receipt.BillingPincode }.Where(x => !string.IsNullOrWhiteSpace(x))))
                                    @if (!string.IsNullOrWhiteSpace(receipt.GstNumber)) { <br /> <span>GSTIN: @receipt.GstNumber</span> }
                                </p>
                            </div>
                            <div>
                                <h4>Payment</h4>
                                <p>
                                    Method: <strong>@(receipt.PaymentMode?.ToString() ?? "—")</strong><br />
                                    @if (!string.IsNullOrWhiteSpace(receipt.GatewayPaymentMode))
                                    {
                                        <text>Mode: <strong>@receipt.GatewayPaymentMode</strong><br /></text>
                                    }
                                    Status: <strong>@receipt.PaymentStatus</strong><br />
                                    Order Status: <strong>@receipt.Status</strong>
                                </p>
                            </div>
                        </div>

                        <table class="ok-inv__table">
                            <thead>
                                <tr><th>Item</th><th>Qty</th><th class="r">Unit</th><th class="r">Amount</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var it in receipt.Items)
                                {
                                    <tr>
                                        <td>
                                            <strong>@it.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(it.ModeName)) { <div class="ok-inv__sub">@it.ModeName</div> }
                                            @if (!string.IsNullOrWhiteSpace(it.Attributes)) { <div class="ok-inv__sub">@it.Attributes</div> }
                                        </td>
                                        <td>@it.Quantity</td>
                                        <td class="r">₹@it.UnitPrice.ToString("N0")</td>
                                        <td class="r">₹@it.LineTotal.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="ok-inv__totals">
                            <div><span>Subtotal</span><strong>₹@receipt.Subtotal.ToString("N0")</strong></div>
                            @if (receipt.Discount > 0)
                            {
                                <div><span>Discount</span><strong>− ₹@receipt.Discount.ToString("N0")</strong></div>
                            }
                            @if (receipt.IgstAmount > 0)
                            {
                                <div><span>IGST (18%, incl.)</span><strong>₹@receipt.IgstAmount.ToString("N0")</strong></div>
                            }
                            else
                            {
                                <div><span>CGST (9%, incl.)</span><strong>₹@receipt.CgstAmount.ToString("N0")</strong></div>
                                <div><span>SGST (9%, incl.)</span><strong>₹@receipt.SgstAmount.ToString("N0")</strong></div>
                            }
                            <div class="ok-inv__grand"><span>Total</span><strong>₹@receipt.Total.ToString("N0")</strong></div>
                        </div>

                        <p class="ok-inv__foot">Thank you for choosing @(siteCfg?.CompanyName ?? "us"). For any queries about this invoice, contact @(siteCfg?.SupportEmail ?? siteCfg?.ContactEmail ?? "support").</p>
                    </div>

                    <footer class="ok-modal__foot">
                        <button class="ok-cta ok-cta--ghost" @onclick="PrintInvoiceAsync">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                            Print
                        </button>
                        <a href="@($"/api/me/orders/{receipt.OrderNumber}/invoice.pdf")" target="_blank" rel="noopener" class="ok-cta ok-cta--green">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>
                            Download PDF
                        </a>
                    </footer>
                </div>
            </div>
        }
    }
</div>

<style>
    /* ════════════════════════════════════════════════════════════════
       CHECKOUT COMPLETE — premium redesign (scoped to .complete-v2)
       ════════════════════════════════════════════════════════════════ */
    .complete-v2{--ok-primary:#163A70;--ok-primary-2:#1E5CC8;--ok-accent:#0AA9C4;--ok-success:#0AC7E5;--ok-ink:#0F1B33;--ok-mute:#64748B;--ok-line:#E5ECF4;--ok-bg:#F8FAFC;--ok-radius:24px;background:linear-gradient(180deg,#F8FAFC 0%,#FDFEFF 360px);padding-bottom:30px}

    /* ── Hero ── */
    .complete-v2 .ok-hero{position:relative;text-align:center;color:#fff;border-radius:28px;padding:48px 24px 38px;margin:18px 0 22px;overflow:hidden;background:linear-gradient(135deg,#0F3D91 0%,#163A70 50%,#1E5CC8 100%);box-shadow:0 24px 60px -30px rgba(15,61,145,.55)}
    .complete-v2 .ok-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(900px 320px at 100% -10%,rgba(10,169,196,.20),transparent 60%),radial-gradient(700px 240px at -10% 110%,rgba(34,197,94,.18),transparent 60%);pointer-events:none}
    .complete-v2 .ok-hero--pending{background:linear-gradient(135deg,#163A70 0%,#1f4d92 60%,#2a5fb0 100%)}
    .complete-v2 .ok-hero__ring{position:relative;width:104px;height:104px;margin:0 auto 14px;border-radius:50%;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.22);display:inline-flex;align-items:center;justify-content:center;animation:okPulse 2.2s ease-out infinite}
    .complete-v2 .ok-hero__ring::after{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,rgba(34,197,94,.35),transparent 60%);animation:okGlow 2.2s ease-out infinite}
    .complete-v2 .ok-hero__tick{width:76px;height:76px}
    .complete-v2 .ok-hero__tick-circle{fill:#0B45AB;stroke:#5AD9EF;stroke-width:2;animation:okDraw .55s ease-out both}
    .complete-v2 .ok-hero__tick-check{fill:none;stroke:#fff;stroke-width:5;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:48;stroke-dashoffset:48;animation:okCheck .45s .35s ease-out forwards}
    .complete-v2 .ok-hero__title{position:relative;font-size:42px;font-weight:800;letter-spacing:-.6px;margin:8px 0 6px;display:inline-flex;align-items:center;gap:10px}
    .complete-v2 .ok-hero__sub{position:relative;margin:0 auto 8px;font-size:15px;color:rgba(255,255,255,.85);max-width:560px;line-height:1.55;font-weight:500}
    .complete-v2 .ok-hero__order{position:relative;display:inline-flex;align-items:center;font-size:12.5px;color:rgba(255,255,255,.7);background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.18);padding:6px 12px;border-radius:999px;letter-spacing:.4px}
    .complete-v2 .ok-hero__order strong{margin-left:6px;color:#fff;font-weight:800;letter-spacing:.6px}
    .complete-v2 .ok-hero__chips{position:relative;display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:18px}
    .complete-v2 .ok-hero__chips span{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);color:#fff;font-size:12.5px;font-weight:600;padding:7px 13px;border-radius:999px;backdrop-filter:blur(8px);animation:okFade .6s ease both}
    .complete-v2 .ok-hero__chips svg{width:14px;height:14px;color:#5AD9EF}

    /* ── Confetti ── */
    .complete-v2 .ok-confetti{position:absolute;inset:0;pointer-events:none;overflow:hidden}
    .complete-v2 .ok-confetti span{position:absolute;top:-12px;width:8px;height:14px;border-radius:2px;left:calc((var(--i) * 3.1%) + 1%);background:hsl(calc(var(--i) * 38),85%,62%);transform:rotate(0);animation:okConfetti 3s cubic-bezier(.2,.6,.3,1) calc(var(--i) * .04s) both}

    /* ── Layout ── */
    .complete-v2 .ok-grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:22px;align-items:start}
    .complete-v2 .ok-main{display:flex;flex-direction:column;gap:18px}
    .complete-v2 .ok-rail{position:sticky;top:18px}

    /* ── Card base ── */
    .complete-v2 .ok-card{background:#fff;border:1px solid var(--ok-line);border-radius:var(--ok-radius);padding:24px;box-shadow:0 10px 28px -22px rgba(15,27,51,.22);animation:okFade .4s ease both;transition:transform .15s,box-shadow .2s}
    .complete-v2 .ok-card:hover{transform:translateY(-1px);box-shadow:0 16px 36px -22px rgba(15,27,51,.28)}
    .complete-v2 .ok-card__title{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:700;color:var(--ok-ink);margin:0 0 14px;letter-spacing:-.1px}
    .complete-v2 .ok-card__title svg{width:18px;height:18px;color:var(--ok-accent)}
    .complete-v2 .ok-card__count{margin-left:auto;font-size:11.5px;font-weight:700;color:var(--ok-primary);background:#EFF4FB;border:1px solid #DBE5F2;padding:4px 10px;border-radius:999px}

    /* ── Order Details meta grid ── */
    .complete-v2 .ok-meta{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .complete-v2 .ok-meta__row{display:flex;align-items:flex-start;gap:10px;padding:12px;border-radius:14px;background:#F8FAFC;border:1px solid var(--ok-line)}
    .complete-v2 .ok-meta__ico{width:32px;height:32px;border-radius:10px;background:#fff;border:1px solid var(--ok-line);color:var(--ok-primary);display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
    .complete-v2 .ok-meta__ico svg{width:16px;height:16px}
    .complete-v2 .ok-meta__lbl{display:block;font-size:11px;font-weight:700;color:var(--ok-mute);text-transform:uppercase;letter-spacing:.5px}
    .complete-v2 .ok-meta__val{display:block;font-size:13.5px;font-weight:700;color:var(--ok-ink);margin-top:2px;word-break:break-word}
    .complete-v2 .ok-meta__val--ok{color:#0B45AB}
    .complete-v2 .ok-meta__val--warn{color:#B45309}

    /* ── Enrolled Course cards ── */
    .complete-v2 .ok-course-list{display:flex;flex-direction:column;gap:12px}
    .complete-v2 .ok-course{display:grid;grid-template-columns:80px minmax(0,1fr) auto;gap:14px;align-items:center;padding:14px;border-radius:18px;background:#F8FAFC;border:1px solid var(--ok-line);transition:transform .15s,box-shadow .2s,border-color .2s}
    .complete-v2 .ok-course:hover{transform:translateY(-1px);box-shadow:0 8px 18px -14px rgba(15,27,51,.25);border-color:#cad6e6}
    .complete-v2 .ok-course__media{width:80px;height:80px;border-radius:14px;background:linear-gradient(135deg,#163A70,#1f4d92);color:#fff;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:800;letter-spacing:-1px;box-shadow:0 8px 16px -10px rgba(22,58,112,.45);position:relative;overflow:hidden}
    .complete-v2 .ok-course__media::after{content:"";position:absolute;inset:0;background:radial-gradient(120px 60px at 100% 0,rgba(10,169,196,.32),transparent 60%)}
    .complete-v2 .ok-course__body{min-width:0;display:flex;flex-direction:column;gap:6px}
    .complete-v2 .ok-course__title{margin:0;font-size:14.5px;font-weight:700;color:var(--ok-ink);line-height:1.35}
    .complete-v2 .ok-course__chips{display:flex;flex-wrap:wrap;gap:6px}
    .complete-v2 .ok-course__chips span{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:var(--ok-mute);background:#fff;border:1px solid var(--ok-line);padding:3px 9px;border-radius:999px}
    .complete-v2 .ok-course__chips svg{width:11px;height:11px;color:var(--ok-primary)}
    .complete-v2 .ok-course__attrs{font-size:12px;color:var(--ok-mute);font-weight:500}
    .complete-v2 .ok-course__price{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
    .complete-v2 .ok-course__amt{font-size:18px;font-weight:800;color:var(--ok-ink);letter-spacing:-.2px}
    .complete-v2 .ok-course__badge{font-size:11px;font-weight:800;color:#fff;background:linear-gradient(135deg,#0B45AB,#0A5BCF);padding:3px 10px;border-radius:999px;letter-spacing:.4px;box-shadow:0 4px 10px -6px rgba(22,163,74,.55)}

    /* ── Next Steps timeline ── */
    .complete-v2 .ok-steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;position:relative}
    .complete-v2 .ok-steps::before{content:"";position:absolute;left:32px;right:32px;top:34px;height:2px;background:repeating-linear-gradient(to right,var(--ok-line) 0 6px,transparent 6px 12px);z-index:0}
    .complete-v2 .ok-step{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;padding-top:10px;z-index:1}
    .complete-v2 .ok-step__ico{width:48px;height:48px;border-radius:50%;background:#fff;border:2px solid var(--ok-line);color:var(--ok-primary);display:flex;align-items:center;justify-content:center;margin-bottom:8px;transition:all .25s}
    .complete-v2 .ok-step__ico svg{width:18px;height:18px}
    .complete-v2 .ok-step.is-done .ok-step__ico{background:linear-gradient(135deg,#0B45AB,#0AC7E5);border-color:#5AD9EF;color:#fff;box-shadow:0 8px 18px -8px rgba(11,69,171,.55)}
    .complete-v2 .ok-step__dot{display:none}
    .complete-v2 .ok-step__txt{display:flex;flex-direction:column;gap:2px;font-size:12.5px;color:var(--ok-mute)}
    .complete-v2 .ok-step__txt strong{font-size:13.5px;color:var(--ok-ink);font-weight:700}
    .complete-v2 .ok-step__txt small{font-size:11.5px;color:var(--ok-mute);font-weight:500}

    /* ── Row of two cards (share + help) ── */
    .complete-v2 .ok-row2{display:grid;grid-template-columns:1fr 1fr;gap:18px}

    /* Share */
    .complete-v2 .ok-share__sub{margin:0 0 12px;font-size:12.5px;color:var(--ok-mute);font-weight:500}
    .complete-v2 .ok-share__btns{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .complete-v2 .ok-share__btn{display:inline-flex;align-items:center;gap:8px;justify-content:center;padding:10px 12px;border-radius:12px;font-size:12.5px;font-weight:700;text-decoration:none;background:#fff;border:1.5px solid var(--ok-line);color:var(--ok-ink);cursor:pointer;transition:transform .15s,border-color .2s,background .2s,box-shadow .2s}
    .complete-v2 .ok-share__btn:hover{transform:translateY(-1px);box-shadow:0 8px 18px -12px rgba(15,27,51,.3)}
    .complete-v2 .ok-share__btn svg{width:14px;height:14px}
    .complete-v2 .ok-share__btn--wa:hover{border-color:#5AD9EF;background:#E6F9FD;color:#0B45AB}
    .complete-v2 .ok-share__btn--tg:hover{border-color:#93C5FD;background:#EFF6FF;color:#1D4ED8}
    .complete-v2 .ok-share__btn--fb:hover{border-color:#A5B4FC;background:#EEF2FF;color:#1E3A8A}
    .complete-v2 .ok-share__btn--link:hover{border-color:#9DC1F2;background:#F2FBFE;color:var(--ok-accent)}

    /* Help */
    .complete-v2 .ok-help__line{display:flex;align-items:center;gap:12px;padding:12px;margin-bottom:8px;border-radius:14px;background:#F8FAFC;border:1px solid var(--ok-line);text-decoration:none;color:var(--ok-ink);transition:transform .15s,background .2s,border-color .2s}
    .complete-v2 .ok-help__line:hover{transform:translateY(-1px);background:#F2FBFE;border-color:#B8E7F2}
    .complete-v2 .ok-help__ico{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#FFF1E0,#FFE3C7);color:var(--ok-accent);display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
    .complete-v2 .ok-help__ico--wa{background:linear-gradient(135deg,#E6F9FD,#C9F1F9);color:#0B45AB}
    .complete-v2 .ok-help__ico--mail{background:linear-gradient(135deg,#DBE9FE,#BFDBFE);color:#1D4ED8}
    .complete-v2 .ok-help__ico svg{width:16px;height:16px}
    .complete-v2 .ok-help__line strong{display:block;font-size:13px;font-weight:700;color:var(--ok-ink)}
    .complete-v2 .ok-help__line small{display:block;font-size:11.5px;color:var(--ok-mute);font-weight:500;margin-top:1px}
    .complete-v2 .ok-help__hours{margin-top:6px;display:flex;align-items:center;gap:6px;padding-top:10px;border-top:1px dashed var(--ok-line);font-size:12px;color:var(--ok-mute);font-weight:600}
    .complete-v2 .ok-help__hours svg{width:14px;height:14px;color:var(--ok-primary)}

    /* ── Payment Summary rail ── */
    .complete-v2 .ok-sum{padding:0;overflow:hidden}
    .complete-v2 .ok-sum__head{display:flex;align-items:center;gap:8px;padding:18px 22px;background:linear-gradient(135deg,#163A70,#1f4d92);color:#fff;font-size:16px;font-weight:700}
    .complete-v2 .ok-sum__head svg{width:18px;height:18px;color:#FFB76E}
    .complete-v2 .ok-sum__body{padding:18px 22px 22px}
    .complete-v2 .ok-sum__row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:7px 0;font-size:13.5px;color:var(--ok-mute);font-weight:500}
    .complete-v2 .ok-sum__row strong{color:var(--ok-ink);font-weight:700}
    .complete-v2 .ok-sum__row--save,.complete-v2 .ok-sum__row--save strong{color:#0B45AB}
    .complete-v2 .ok-sum__total{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:10px;padding:14px 16px;background:linear-gradient(135deg,#F2FBFE,#E6F9FD);border-radius:14px;border:1px solid #B8E7F2}
    .complete-v2 .ok-sum__total span{font-size:14px;font-weight:700;color:var(--ok-ink)}
    .complete-v2 .ok-sum__total strong{font-size:20px;font-weight:800;color:var(--ok-accent);letter-spacing:-.3px}
    .complete-v2 .ok-sum__meta{margin-top:14px;padding-top:12px;border-top:1px dashed var(--ok-line);display:flex;flex-direction:column;gap:8px}
    .complete-v2 .ok-sum__metarow{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--ok-mute);font-weight:500}
    .complete-v2 .ok-sum__metarow strong{color:var(--ok-ink);font-weight:700}
    .complete-v2 .ok-pill{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:800;padding:4px 10px;border-radius:999px;letter-spacing:.3px}
    .complete-v2 .ok-pill svg{width:12px;height:12px}
    .complete-v2 .ok-pill--ok{background:#E6F9FD;color:#0B45AB;border:1px solid #C9F1F9}
    .complete-v2 .ok-pill--warn{background:#FEF3C7;color:#92400E;border:1px solid #FDE68A}

    /* ── Action buttons ── */
    .complete-v2 .ok-cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;height:48px;padding:0 18px;border-radius:14px;font-size:14px;font-weight:700;text-decoration:none;cursor:pointer;border:1.5px solid transparent;margin-top:10px;transition:transform .15s,box-shadow .2s,filter .2s,background .2s,border-color .2s,color .2s}
    .complete-v2 .ok-cta svg{width:16px;height:16px}
