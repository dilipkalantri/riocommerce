@code {
    [Parameter] public string OrderNumber { get; set; } = string.Empty;
    // /checkout/payment-success?order=RIO-1053 — accept the order number from the query string too.
    [SupplyParameterFromQuery(Name = "order")] public string? OrderQuery { get; set; }

    private OrderReceipt? receipt;
    private bool loading = true;
    private bool showInvoice;
    private bool showConfetti = true;
    private bool copied;
    private SiteSettings? siteCfg;

    protected override async Task OnInitializedAsync()
    {
        try { siteCfg = await SettingsSvc.GetAsync(); } catch { }

        if (string.IsNullOrWhiteSpace(OrderNumber) && !string.IsNullOrWhiteSpace(OrderQuery))
            OrderNumber = OrderQuery;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(id, out var userId) && !string.IsNullOrWhiteSpace(OrderNumber))
            receipt = await Checkout.GetReceiptAsync(userId, OrderNumber);
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && receipt != null && receipt.PaymentStatus == PaymentStatus.Success)
        {
            // Pure-CSS confetti — auto-hide after the animation finishes to keep the DOM lean.
            await Task.Delay(3200);
            showConfetti = false;
            StateHasChanged();
        }
    }

    private async Task CopyLinkAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", siteCfg?.WebsiteUrl ?? "/");
            copied = true;
            StateHasChanged();
            await Task.Delay(1800);
            copied = false;
            StateHasChanged();
        }
        catch { /* clipboard not available — silent */ }
    }

    private async Task PrintInvoiceAsync()
    {
        try { await JS.InvokeVoidAsync("window.print"); } catch { }
    }
}
