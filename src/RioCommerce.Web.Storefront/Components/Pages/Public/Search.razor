@page "/search"
@inject HttpClient Http
@implements IDisposable

<SeoHead Seo="@(new SeoMetadata { Title = "Search Courses — RioCommerce" })" />

<div class="container search-page">
    <div class="search-hero">
        <h1>Find Your Course</h1>
        <div class="search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input value="@query" @oninput="OnInput" @onkeydown="OnKey" placeholder="Search by course, subject or faculty…" autocomplete="off" />
            @if (showSuggest && suggestions.Count > 0)
            {
                <div class="search-suggest">
                    @foreach (var s in suggestions)
                    {
                        <a href="/@s.Slug" class="search-suggest__item">
                            <span class="search-suggest__title">@s.Title</span>
                            @if (!string.IsNullOrEmpty(s.FacultyName)) { <span class="search-suggest__meta">@s.FacultyName</span> }
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <div class="filter-bar2">
        <select class="filter-select" @onchange="OnLevel">
            <option value="">All Levels</option>
            <option value="@((int)CourseLevel.Beginner)" selected="@(levelEnum == CourseLevel.Beginner)">Beginner</option>
            <option value="@((int)CourseLevel.Intermediate)" selected="@(levelEnum == CourseLevel.Intermediate)">Intermediate</option>
            @* Listed after Intermediate to match the rest of the site. The VALUE is the enum
               ordinal, which for Advanced is 4 because the enum is append-only — see CourseLevel.cs.
               Test Series is deliberately still absent here; this filter has always been a curated
               subset rather than every level. *@
            <option value="@((int)CourseLevel.Advanced)" selected="@(levelEnum == CourseLevel.Advanced)">Advanced</option>
            <option value="@((int)CourseLevel.Books)" selected="@(levelEnum == CourseLevel.Books)">Books</option>
        </select>
        <select class="filter-select" @onchange="OnType">
            <option value="">All Types</option>
            <option value="@((int)CourseType.Regular)" selected="@(typeEnum == CourseType.Regular)">Regular</option>
            @* Fastrack retired (migration 0034) — no product carries it, so the filter would only
               ever return an empty page. The enum member stays; only the choice is gone. *@
            <option value="@((int)CourseType.Combo)" selected="@(typeEnum == CourseType.Combo)">Combo</option>
            <option value="@((int)CourseType.FaceToFace)" selected="@(typeEnum == CourseType.FaceToFace)">Face To Face</option>
        </select>
        <select class="filter-select" @onchange="OnSubject">
            <option value="">All Subjects</option>
            @if (filters != null) { @foreach (var s in filters.Subjects) { <option value="@s.Id" selected="@(s.Id == subjectId)">@s.Name</option> } }
        </select>
        <select class="filter-select" @onchange="OnFaculty">
            <option value="">All Faculty</option>
            @if (filters != null) { @foreach (var f in filters.Faculty) { <option value="@f.Id" selected="@(f.Id == facultyId)">@f.Name</option> } }
        </select>
        <button class="btn btn-primary btn-sm" @onclick="RunSearch">Search</button>
    </div>

    <div class="search-count">
        @(loading ? "Searching…" : $"{totalCount} result{(totalCount == 1 ? "" : "s")}")@(string.IsNullOrWhiteSpace(query) ? "" : $" for \"{query.Trim()}\"")
    </div>

    <div class="course-grid">
        @if (loading)
        {
            <p style="text-align:center;grid-column:1/-1;color:var(--gray-400)">Searching…</p>
        }
        else if (items.Count == 0)
        {
            <p style="text-align:center;grid-column:1/-1;color:var(--gray-400)">No courses match your search. Try different keywords or filters.</p>
        }
        else
        {
            @foreach (var p in items) { <CourseCard Product="p" /> }
        }
    </div>

    @if (TotalPages > 1)
    {
        <div class="pagination">
            <button class="pg-btn" disabled="@(page <= 1)" @onclick="() => GoTo(page - 1)">← Prev</button>
            @for (var i = 1; i <= TotalPages; i++)
            {
                var n = i;
                <button class="pg-btn @(n == page ? "active" : "")" @onclick="() => GoTo(n)">@n</button>
            }
            <button class="pg-btn" disabled="@(page >= TotalPages)" @onclick="() => GoTo(page + 1)">Next →</button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private List<ProductListItem> items = new();
    private List<ProductSuggestion> suggestions = new();
    private FilterOptions? filters;
    private CourseLevel? levelEnum;
    private CourseType? typeEnum;
    private Guid? subjectId, facultyId;
    private string query = "";
    private bool showSuggest, loading;
    private int page = 1, totalCount;
    private const int PageSize = 9;
    private CancellationTokenSource? _debounce;

    private int TotalPages => (int)Math.Ceiling(totalCount / (double)PageSize);

    protected override async Task OnInitializedAsync()
    {
        try { var r = await Http.GetFromJsonAsync<ApiResponse<FilterOptions>>("/api/meta/filters"); filters = r?.Data; }
        catch { }
        query = Q ?? "";
        await Load();
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        showSuggest = true;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(250, token);
            if (token.IsCancellationRequested) return;
            await LoadSuggestions();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LoadSuggestions()
    {
        if (query.Trim().Length < 2) { suggestions = new(); return; }
        try
        {
            var r = await Http.GetFromJsonAsync<ApiResponse<List<ProductSuggestion>>>($"/api/products/suggest?q={Uri.EscapeDataString(query.Trim())}");
            suggestions = r?.Data ?? new();
        }
        catch { suggestions = new(); }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunSearch();
        else if (e.Key == "Escape") showSuggest = false;
    }

    private async Task RunSearch() { showSuggest = false; page = 1; await Load(); }

    private async Task Load()
    {
        loading = true; StateHasChanged();
        var url = $"/api/products?Page={page}&PageSize={PageSize}";
        if (levelEnum.HasValue) url += $"&Level={(int)levelEnum}";
        if (typeEnum.HasValue) url += $"&CourseType={(int)typeEnum}";
        if (subjectId.HasValue) url += $"&SubjectId={subjectId}";
        if (facultyId.HasValue) url += $"&FacultyId={facultyId}";
        if (!string.IsNullOrWhiteSpace(query)) url += $"&Search={Uri.EscapeDataString(query.Trim())}";
        try
        {
            var r = await Http.GetFromJsonAsync<ApiResponse<PagedResult<ProductListItem>>>(url);
            items = r?.Data?.Items ?? new();
            totalCount = r?.Data?.TotalCount ?? 0;
        }
        catch { items = new(); totalCount = 0; }
        loading = false;
    }

    private async Task OnLevel(ChangeEventArgs e) { levelEnum = int.TryParse(e.Value?.ToString(), out var v) ? (CourseLevel)v : null; await CascadeFilters(); await RunSearch(); }
    // Course type is not part of the approved cascade — it stays independent.
    private async Task OnType(ChangeEventArgs e) { typeEnum = int.TryParse(e.Value?.ToString(), out var v) ? (CourseType)v : null; await RunSearch(); }
    private async Task OnSubject(ChangeEventArgs e) { subjectId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await CascadeFilters(); await RunSearch(); }
    private async Task OnFaculty(ChangeEventArgs e) { facultyId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await CascadeFilters(); await RunSearch(); }

    /// <summary>
    /// Re-reads the Subject and Faculty lists for what is now picked, dropping only selections the
    /// new lists no longer offer.
    ///
    /// <para>The search text is deliberately NOT sent: it stays independent of the catalog
    /// relationships, so results satisfy the text AND the filters rather than the filters shrinking
    /// to whatever the text happened to match.</para>
    /// </summary>
    private async Task CascadeFilters()
    {
        var url = "/api/meta/filters?";
        if (facultyId.HasValue) url += $"facultyId={facultyId}&";
        if (subjectId.HasValue) url += $"subjectId={subjectId}&";
        if (levelEnum.HasValue) url += $"level={(int)levelEnum.Value}";

        try
        {
            var r = await Http.GetFromJsonAsync<ApiResponse<FilterOptions>>(url);
            if (r?.Data is not { } fresh) return;
            filters = fresh;

            if (facultyId is { } f && fresh.Faculty.All(x => x.Id != f)) facultyId = null;
            if (subjectId is { } s && fresh.Subjects.All(x => x.Id != s)) subjectId = null;
        }
        catch { /* keep the lists we already have rather than emptying the filter bar */ }
    }
    private async Task GoTo(int p) { if (p < 1 || p > TotalPages) return; page = p; await Load(); }

    public void Dispose() => _debounce?.Cancel();
}
