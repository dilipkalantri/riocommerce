<!-- Blogs -->
@if (blogs is { Count: > 0 })
{
    <section class="section section--gray">
        <div class="section__inner">
            <div class="section__header reveal">
                <div class="section__label">Latest Blogs</div>
                <h2 class="section__title">CA Exam Tips &amp; Updates</h2>
            </div>
            @* pb-grid--home scopes the compact mobile tile layout to this section only.
               BlogCard/.pb-grid are shared with /blog and the related-posts strip, which
               keep their existing design. *@
            <div class="pb-grid pb-grid--home reveal">
                @foreach (var b in blogs)
                {
                    <BlogCard Post="b" />
                }
            </div>
            @if (blogTotal > blogs.Count)
            {
                <div class="pb-more reveal">
                    <a href="/blog" class="pb-btn">View All Blogs <span class="pb-btn__arrow" aria-hidden="true">→</span></a>
                </div>
            }
        </div>
    </section>
}

<!-- Footer CTA -->
<section class="vp-footer-cta">
    <div style="max-width:800px;margin:0 auto;text-align:center" class="reveal">
        <h2>Ready to Start Your Scholarship Journey?</h2>
        <p>Join thousands of students who have achieved their dreams with our guidance.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <a href="/courses" class="hero__course-btn hero__course-btn--primary">Explore Courses</a>
            <a href="/contact" class="hero__course-btn hero__course-btn--outline">Contact Us</a>
        </div>
    </div>
</section>

@code {
    private List<ProductListItem>? featured;
    private List<BlogListItem>? blogs;   // latest 3 published posts for the homepage section
    private int blogTotal;               // total published posts — drives the "View All Blogs" button

    private SeoMetadata seo = new()
    {
        Title = "Vijaypath — Scholarship Preparation Platform",
        Description = "India's trusted platform for scholarship preparation. Expert faculty, live classes, study material & personalised mentorship.",
        Keywords = "scholarship, preparation, talent test, Vijaypath, education"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<ApiResponse<List<ProductListItem>>>("/api/products/featured?count=4");
            featured = r?.Data ?? new();
        }
        catch { featured = new(); }
        try
        {
            // Latest 3 published blogs; TotalCount tells us whether to show "View All Blogs".
            var br = await Http.GetFromJsonAsync<ApiResponse<PagedResult<BlogListItem>>>("/api/content/blog?page=1&pageSize=3");
            blogs = br?.Data?.Items ?? new();
            blogTotal = br?.Data?.TotalCount ?? 0;
        }
        catch { blogs = new(); blogTotal = 0; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-scan for scroll-reveal / counters / magnetic targets (idempotent on the JS side).
        try { await JS.InvokeVoidAsync("rc.homeFx"); } catch { }
    }

}
