@page "/"
@inject HttpClient Http
@inject IJSRuntime JS

<SeoHead Seo="@seo" />

@* Homepage banner slider — renders below the header, homepage only. *@
<HeroBanner />

<!-- Hero -->
@* Premium hero. Structure only changed inside this section: routes, CTAs and the three existing
   student images are the same, re-composed rather than replaced. All new styling lives in
   vijaypath.css under the .hero block. *@
<section class="hero">
    @* Decorative only — blurred colour fields + dot grid for depth. aria-hidden so screen
       readers skip them entirely. *@
    <div class="hero__glow" aria-hidden="true">
        <span class="hero__blob hero__blob--purple"></span>
        <span class="hero__blob hero__blob--orange"></span>
        <span class="hero__blob hero__blob--cyan"></span>
        <span class="hero__dots"></span>
    </div>

    <div class="hero__inner">
        <div class="hero__content">
            <span class="hero__eyebrow">
                <span class="hero__eyebrow-dot"></span>
                Scholarship Exam Preparation
            </span>

            <h1 class="hero__title">
                Your Path to<br />
                <span class="highlight">Scholarship</span><br />
                Success
            </h1>

            <p class="hero__subtitle">
                India's trusted platform for scholarship preparation. Expert faculty, live classes,
                study material &amp; personalised mentorship.
            </p>

            <div class="hero__course-btns">
                <a href="/student/register" class="hero__course-btn hero__course-btn--primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                    Register as Student
                    <svg class="hero__course-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
                <a href="/school/register" class="hero__course-btn hero__course-btn--outline">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V9l7-5 7 5v12"/><path d="M10 21v-5h4v5"/></svg>
                    Register Your School
                </a>
                <a href="/courses" class="hero__course-btn hero__course-btn--ghost">
                    View Courses
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
            </div>

            @* Qualitative only — no invented counts. The real figures live in the Impact band. *@
            <ul class="hero__trust">
                @foreach (var t in new[] { "Scholarship Focused", "Expert Faculty", "Live Learning", "Personalised Mentorship" })
                {
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
                        @t
                    </li>
                }
            </ul>
        </div>

        @* One dominant portrait with two supporting cards overlapping it, plus two badges. *@
        <div class="hero__photos">
            <figure class="hero__photo-card hero__photo-card--main">
                <img src="_content/RioCommerce.Web.Storefront/images/vijaypath-hero-girl.jpg"
                     alt="Student preparing for a scholarship exam" loading="eager" fetchpriority="high" />
            </figure>

            <figure class="hero__photo-card hero__photo-card--boy">
                <img src="_content/RioCommerce.Web.Storefront/images/vijaypath-hero-boy.jpg"
                     alt="Student holding a globe" loading="eager" />
            </figure>

            <figure class="hero__photo-card hero__photo-card--grp">
                <img src="_content/RioCommerce.Web.Storefront/images/vijaypath-hero-group.jpg"
                     alt="Students learning together" loading="lazy" />
            </figure>

            <div class="hero__badge hero__badge--trophy">
                <span class="hero__badge-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                </span>
                <span class="hero__badge-txt">
                    <strong>Scholarship</strong>
                    <small>Success Journey</small>
                </span>
            </div>

            <div class="hero__badge hero__badge--book">
                <span class="hero__badge-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </span>
                <span class="hero__badge-txt"><strong>Smart Learning</strong></span>
            </div>
        </div>
    </div>
</section>

<!-- Purple strip -->
<div class="vp-strip reveal">
    Empowering students across India with quality scholarship preparation
</div>

<!-- Founder / vision -->
@* Leadership section. Content, image asset and copy are unchanged from before — this is a
   presentation upgrade only. Scroll-reveal reuses the shared .reveal / rc.homeFx observer;
   the directional variants just override the starting transform, since .reveal--in resets
   transform to none either way. *@
<section class="vp-founder">
    <div class="vp-founder__glow" aria-hidden="true">
        <span class="vp-founder__aura vp-founder__aura--purple"></span>
        <span class="vp-founder__aura vp-founder__aura--orange"></span>
        <span class="vp-founder__grid"></span>
    </div>

    <div class="vp-founder__intro">
        <span class="vp-founder__eyebrow reveal">Meet the vision behind Vijaypath</span>
        <h2 class="vp-founder__heading reveal" data-delay="1">Our Visionary Leader</h2>
        <p class="vp-founder__lead reveal" data-delay="2">
            Building meaningful learning and scholarship opportunities for students across India.
        </p>
    </div>

    <div class="vp-founder__card">
        <div class="vp-founder__media reveal vp-founder__media--in">
            <span class="vp-founder__blob" aria-hidden="true"></span>
            <span class="vp-founder__ring" aria-hidden="true"></span>
            <span class="vp-founder__dots vp-founder__dots--left" aria-hidden="true"></span>
            @* Transparent PNG generated from the supplied JPEG by flood-filling the
               connected background white (the shirt is enclosed by darker pixels, so
               it is never reached and stays opaque). A real alpha channel means the
               portrait can sit over the blob without tinting or a white box. *@
            <img class="vp-founder__photo"
                 src="_content/RioCommerce.Web.Storefront/images/vijaypath-founder.png"
                 alt="Dr. Vijay Bhatkar" loading="lazy" decoding="async" />
            <span class="vp-founder__chip">Vision &bull; Leadership &bull; Education</span>
        </div>

        <div class="vp-founder__body">
            <span class="vp-founder__dots vp-founder__dots--right" aria-hidden="true"></span>
            <span class="vp-founder__badge reveal vp-founder__body--in">Founder &amp; Visionary</span>
            <h3 class="vp-founder__name reveal vp-founder__body--in" data-delay="1">Dr. Vijay Bhatkar</h3>
            <p class="vp-founder__role reveal vp-founder__body--in" data-delay="2">Founder, Vijaypath</p>
            <p class="vp-founder__text reveal vp-founder__body--in" data-delay="3">
                A visionary leader and educationist, Dr. Vijay Bhatkar founded Vijaypath with a
                mission to make quality learning and scholarship opportunities accessible to
                every deserving student across India.
            </p>
            <figure class="vp-founder__quote reveal" data-delay="4">
                <blockquote>
                    Our mission is to empower every student with the right guidance,
                    opportunities, and resources to achieve their dreams.
                </blockquote>
                <figcaption>&ndash; Dr. Vijay Bhatkar</figcaption>
            </figure>
        </div>
    </div>
</section>

