<!-- Most Popular Courses -->
<section class="section section--gray trending-section">
    <div class="trending-bg" aria-hidden="true">
        <span class="trending-blob trending-blob--blue"></span>
        <span class="trending-blob trending-blob--orange"></span>
    </div>
    <div class="section__inner">
        <div class="section__header reveal">
            <div class="section__label">★ Most Popular Courses</div>
            <h2 class="section__title">Most Popular Courses</h2>
            <p class="section__subtitle">Explore our most popular courses, designed by expert faculty.</p>
        </div>
        <div class="course-grid">
            @if (featured == null)
            {
                @for (var i = 0; i < 4; i++)
                {
                    <div class="course-card course-card--skel"><div class="skel" style="height:240px"></div><div style="padding:18px"><div class="skel" style="height:14px;width:40%;margin-bottom:8px"></div><div class="skel" style="height:18px;width:90%;margin-bottom:6px"></div><div class="skel" style="height:18px;width:70%;margin-bottom:12px"></div><div class="skel" style="height:24px;width:55%"></div></div></div>
                }
            }
            else if (featured.Count == 0)
            {
                <p style="text-align:center;grid-column:1/-1;color:var(--gray-400)">No courses yet. Add products from the admin panel.</p>
            }
            else
            {
                @foreach (var p in featured) { <CourseCard Product="p" /> }
            }
        </div>
        <div style="text-align:center;margin-top:34px">
            <a href="/courses" class="btn btn-outline">View All Courses →</a>
        </div>
    </div>
</section>

