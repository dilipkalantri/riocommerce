@page "/"
@inject HttpClient Http
@inject IJSRuntime JS

<SeoHead Seo="@seo" />

@* Homepage banner slider — renders below the header, homepage only. *@
<HeroBanner />

<!-- Hero -->
<section class="hero">
    <div class="hero__inner">
        <div class="hero__content">
            <h1 class="hero__title reveal" data-delay="1">Your Path to <span class="highlight">Scholarship</span> Success</h1>
            <p class="hero__subtitle reveal" data-delay="2">
                India's trusted platform for scholarship preparation. Expert faculty, live classes, study material &amp; personalised mentorship.
            </p>
            <div class="hero__course-btns reveal" data-delay="3">
                <a href="/courses" class="hero__course-btn hero__course-btn--primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 2.7 3 6 3s6-2 6-3v-5"/></svg>
                    View Courses
                </a>
                <a href="/about" class="hero__course-btn hero__course-btn--outline">
                    About Us
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>
        <div class="hero__photos">
            <div class="hero__photo-card hero__photo-card--girl">
                <img src="_content/RioCommerce.Web.Storefront/images/vijaypath-hero-girl.jpg" alt="Student preparing for scholarship exam" loading="eager" />
            </div>
            <div class="hero__photo-card hero__photo-card--boy" style="grid-row: span 2">
                <img src="_content/RioCommerce.Web.Storefront/images/vijaypath-hero-boy.jpg" alt="Student with globe" loading="eager" />
            </div>
            <div class="hero__photo-card hero__photo-card--grp">
                <img src="_content/RioCommerce.Web.Storefront/images/vijaypath-hero-group.jpg" alt="Students studying together" loading="eager" />
            </div>
        </div>
    </div>
</section>

<!-- Purple strip -->
<div class="vp-strip reveal">
    Empowering students across India with quality scholarship preparation
</div>

<!-- Founder / vision -->
<section class="vp-founder">
    <div class="vp-founder__card reveal">
        <div class="vp-founder__media">
            <span class="vp-founder__blob" aria-hidden="true"></span>
            <span class="vp-founder__dots vp-founder__dots--left" aria-hidden="true"></span>
            @* Transparent PNG generated from the supplied JPEG by flood-filling the
               connected background white (the shirt is enclosed by darker pixels, so
               it is never reached and stays opaque). A real alpha channel means the
               portrait can sit over the blob without tinting or a white box. *@
            <img class="vp-founder__photo"
                 src="_content/RioCommerce.Web.Storefront/images/vijaypath-founder.png"
                 alt="Dr. Vijay Bhatkar" loading="lazy" decoding="async" />
        </div>

        <div class="vp-founder__body">
            <span class="vp-founder__dots vp-founder__dots--right" aria-hidden="true"></span>
            <span class="vp-founder__badge">Founder &amp; Visionary</span>
            <h2 class="vp-founder__name">Dr. Vijay Bhatkar</h2>
            <p class="vp-founder__role">Founder, Vijaypath</p>
            <p class="vp-founder__text">
                A visionary leader and educationist, Dr. Vijay Bhatkar founded Vijaypath with a
                mission to make quality learning and scholarship opportunities accessible to
                every deserving student across India.
            </p>
            <figure class="vp-founder__quote">
                <blockquote>
                    Our mission is to empower every student with the right guidance,
                    opportunities, and resources to achieve their dreams.
                </blockquote>
                <figcaption>&ndash; Dr. Vijay Bhatkar</figcaption>
            </figure>
        </div>
    </div>
</section>

